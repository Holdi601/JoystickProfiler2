// Input map preset.
// It is not recommended to change anything here,
// but it is still possible on your own risk.

&actions = action, command, invert|
chattoall,                                        key_return,                                       0| // Send chat messages to all
chattofriendly,                                   key_rcontrol+key_return,                          0| // Send chat messages to friendly
cam_rotate_pitch,                                 mouse_axis_y,                                     0| // Rotate camera up/down
cam_rotate_pitch,                                 joy0_pov0_180/joy0_pov0_0,                        0|
cam_zoom,                                         key_lshift+mouse_axis_z,                          0| // Camera zoom
cam_trans_fb,                                     mouse_b1+mouse_axis_y,                            0| // Move free camera forward/backward
all_guns_fire,                                    mouse_b0,                                         0| // Fire all guns
all_guns_fire,                                    joy0_b0,                                          0|
bc_head_cvc,                                      joy0_b1,                                          0| // Pilot head: center view
rpc_pitch,                                        joy0_axis_y,                                      1| // Pitch
rpc_roll,                                         joy0_axis_x,                                      0| // Roll
rpc_yaw,                                          joy1_axis_rz,                                     0| // Yaw
rpc_all_engines_throttles,                        joy0_axis_z,                                      1| // Throttle
rpc_all_engines_throttles,                        mouse_axis_z,                                     0|
rpc_yaw,                                          joy1_axis_z,                                      0|
gear,                                             joy2_b3,                                          0| // Gear (a device that is not connected)
