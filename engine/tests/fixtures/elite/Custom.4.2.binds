<?xml version="1.0" encoding="UTF-8" ?>
<Root PresetName="Custom" MajorVersion="4" MinorVersion="2">
	<KeyboardLayout>en-GB</KeyboardLayout>
	<MouseXMode Value="Bindings_MouseYaw" />
	<YawAxisRaw>
		<Binding Device="12345678" Key="Joy_ZAxis" />
		<Inverted Value="0" />
		<Deadzone Value="0.00000000" />
	</YawAxisRaw>
	<PitchAxisRaw>
		<Binding Device="25BB00D8" Key="Joy_YAxis" />
		<Inverted Value="1" />
		<Deadzone Value="0.04700000" />
	</PitchAxisRaw>
	<PrimaryFire>
		<Primary Device="Keyboard" Key="Key_Space" />
		<Secondary Device="12345678" Key="Joy_1" />
	</PrimaryFire>
	<SecondaryFire>
		<Primary Device="{NoDevice}" Key="" />
		<Secondary Device="12345678" Key="Joy_2" />
	</SecondaryFire>
	<CycleNextTarget>
		<Primary Device="Keyboard" Key="Key_G" />
		<Secondary Device="12345678" Key="Joy_POV1Right">
			<Modifier Device="12345678" Key="Pos_Joy_RZAxis" />
		</Secondary>
	</CycleNextTarget>
	<UseBoostJuice>
		<Primary Device="Keyboard" Key="Key_Tab" />
		<Secondary Device="ABCD0001" Key="Joy_3" />
	</UseBoostJuice>
	<HumanoidJumpButton>
		<Primary Device="12345678" Key="Joy_5" />
		<Secondary Device="{NoDevice}" Key="" />
	</HumanoidJumpButton>
</Root>
