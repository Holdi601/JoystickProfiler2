<?xml version="1.0" encoding="utf-8"?>
<!-- A Joystick Gremlin R13 profile (profile version 9) written after Gremlin's documented format for JoyPro's import
     tests (engine vjoy import-gremlin, docs/virtual-joystick.md "Coming from Joystick Gremlin"): remaps of axes,
     buttons and hats to vJoy, a response curve, a keyboard mapping, a merged axis, a device matched by GUID, one by
     name only and one that is not connected, a mouse action and a plugin JoyPro cannot run. -->
<profile version="9">
    <devices>
        <device device-guid="{11111111-2222-3333-4444-000000000001}" label="" name="VJ Stick" type="joystick">
            <mode name="Default">
                <axis description="Roll" id="1">
                    <container type="basic">
                        <action-set>
                            <response-curve deadzone="-1.0 -0.05 0.05 1.0">
                                <mapping type="cubic-spline">
                                    <control-point x="-1.0" y="-1.0"/>
                                    <control-point x="-0.5" y="-0.25"/>
                                    <control-point x="0.0" y="0.0"/>
                                    <control-point x="0.5" y="0.25"/>
                                    <control-point x="1.0" y="1.0"/>
                                </mapping>
                            </response-curve>
                            <remap axis="1" axis-type="absolute" vjoy="1"/>
                        </action-set>
                    </container>
                </axis>
                <axis description="" id="2">
                    <container type="basic">
                        <action-set>
                            <remap axis="2" axis-type="absolute" vjoy="1"/>
                        </action-set>
                    </container>
                </axis>
                <button description="Trigger" id="1">
                    <container type="basic">
                        <action-set>
                            <remap button="1" vjoy="1"/>
                        </action-set>
                    </container>
                </button>
                <button description="" id="2">
                    <container type="basic">
                        <action-set>
                            <remap button="2" vjoy="1"/>
                            <map-to-keyboard>
                                <key extended="False" scan-code="42"/>
                                <key extended="False" scan-code="30"/>
                            </map-to-keyboard>
                        </action-set>
                    </container>
                </button>
                <button description="" id="3">
                    <container type="basic">
                        <action-set>
                            <map-to-mouse button-id="1" motion-input="False"/>
                        </action-set>
                    </container>
                </button>
                <hat description="" id="1">
                    <container type="basic">
                        <action-set>
                            <remap hat="1" vjoy="1"/>
                        </action-set>
                    </container>
                </hat>
            </mode>
        </device>
        <device device-guid="{AAAAAAAA-0000-0000-0000-00000000BEEF}" label="" name="VJ Throttle" type="joystick">
            <mode name="Default">
                <axis description="Throttle" id="3">
                    <container type="basic">
                        <action-set>
                            <remap axis="3" axis-type="relative" axis-scaling="0.5" vjoy="1"/>
                        </action-set>
                    </container>
                </axis>
            </mode>
        </device>
        <device device-guid="{BBBBBBBB-0000-0000-0000-00000000CAFE}" label="" name="Saitek Pro Flight Rudder Pedals" type="joystick">
            <mode name="Default">
                <axis description="Rudder" id="3">
                    <container type="basic">
                        <action-set>
                            <remap axis="6" axis-type="absolute" vjoy="1"/>
                        </action-set>
                    </container>
                </axis>
            </mode>
        </device>
    </devices>
    <vjoy-devices/>
    <merge-axis mode="Default" operation="sum">
        <vjoy axis="7" vjoy-id="1"/>
        <lower axis="1" device-guid="{BBBBBBBB-0000-0000-0000-00000000CAFE}" device-name="Saitek Pro Flight Rudder Pedals"/>
        <upper axis="2" device-guid="{BBBBBBBB-0000-0000-0000-00000000CAFE}" device-name="Saitek Pro Flight Rudder Pedals"/>
    </merge-axis>
    <settings>
        <startup-mode>Default</startup-mode>
        <default-delay>0.05</default-delay>
    </settings>
    <plugins>
        <plugin file-name="C:\Gremlin\plugins\trim.py"/>
    </plugins>
</profile>
