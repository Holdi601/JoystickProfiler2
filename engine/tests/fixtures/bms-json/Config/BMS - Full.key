SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "BMS - Full"
SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "3. LEFT AUX CONSOLE"
SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "======== 3.05     GEAR PANEL ========"
SimHookToggle 310 0 0x25 2 0 0 1 "GEAR: HOOK Switch - Toggle"
SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "5. RIGHT CONSOLE"
SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "======== 5.11     FLIGHT STICK  ========"
SimTriggerFirstDetent -1 0 0x35 2 0 0 1 "STICK: FIRST TRIGGER DETENT"
SimPickle -1 0 0x39 0 0 0 1 "STICK: WEAPON RELEASE (Pickle)"
SimDMSUp -1 0 0xC7 2 0 0 1 "STICK: DMS Up"
SimHotasPinkyShift -1 0 0XFFFFFFFF 0 0 0 1 "STICK: PINKY SWITCH (DX SHIFT)"
SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "6. MISCELLANEOUS"
SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "======== 6.06     SIMULATION & HARDWARE ========"
TimeAccelerate -1 0 0xF 0 0 0 1 "SIM: Time Acceleration - Toggle 2x"
SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "7. VIEWS"
SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "======== 7.01     VIEW GENERAL CONTROL ========"
OTWViewLeft -1 0 0x4B 1 0 0 1 "VIEWGEN: Rotate View Left"
