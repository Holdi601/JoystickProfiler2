SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "BMS - Full-F15ABCD"
SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "2. LEFT CONSOLE"
SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "======== 2.02     BIT PANEL ========"
SimF15BitReset 115 0 0XFFFFFFFF 0 0 0 1 "BIT: RCALL/RSET Switch - RSET (Reset)"
SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "3. CENTER CONSOLE"
SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "======== 3.07    HOOK SWITCH ========"
SimHookToggle 310 0 0x25 2 0 0 1 "HOOK: Switch - Toggle"
SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "6. VIEWS"
SimDoNothing -1 0 0XFFFFFFFF 0 0 0 -1 "======== 6.01     VIEW GENERAL CONTROL ========"
OTWViewLeft -1 0 0x4B 1 0 0 1 "VIEWGEN: Rotate View Left"
