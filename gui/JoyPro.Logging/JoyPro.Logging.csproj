<Project Sdk="Microsoft.NET.Sdk">
  <!-- The shared background log (docs/logging.md): one C# 7.3 file the engine compiles too. JoyPro.Ffb.Core (GUI,
       JoyPro.Ffb) and JoyPro.Watch (GUI, tray host) use it through this small library, so the type exists once. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>JoyPro.Logging</RootNamespace>
    <AssemblyName>JoyPro.Logging</AssemblyName>
    <Version>2.4.2</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\engine\JoyProLog.cs" Link="JoyProLog.cs" />
    <!-- The one data folder (%LOCALAPPDATA%\JoyPro2 or JOYPRO_DATA_DIR) and the move of the old %LOCALAPPDATA%\JoyPro. -->
    <Compile Include="..\..\engine\JoyProDataFolder.cs" Link="JoyProDataFolder.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoyPro.Ffb.Core.Tests" />
    <InternalsVisibleTo Include="JoyPro.Gui.Tests" />
  </ItemGroup>
</Project>
