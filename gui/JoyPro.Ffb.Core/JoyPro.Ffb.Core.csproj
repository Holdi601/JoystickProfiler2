<Project Sdk="Microsoft.NET.Sdk">
  <!-- Custom force feedback, phase 2: graph model, evaluator, persistence, telemetry sources with record/replay and a
       mock output backend. No hardware output yet. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JoyPro.Ffb.Core</RootNamespace>
    <Version>2.0.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoyPro.Ffb.Core.Tests" />
    <InternalsVisibleTo Include="JoyPro.Gui.Tests" />
  </ItemGroup>

  <!-- The shared background log (docs/logging.md), in its own small library (also used by JoyPro.Watch). -->
  <ItemGroup>
    <ProjectReference Include="..\JoyPro.Logging\JoyPro.Logging.csproj" />
  </ItemGroup>
</Project>
