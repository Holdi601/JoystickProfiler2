<!--
    The shared looks of the redesigned pages (tokens in Design.axaml; icons in Icons.axaml):
      Border.surface             a card on the page (surface color, 12 px corners, 16 px padding); .tight = 12 px padding
      Border.sunken              an inner area of a card (lists, previews)
      Border.callout + .info/.warn/.error/.ok   a notice with a colored left edge
      Border.iconBadge (+ .large) a rounded square with the section's icon (PathIcon inside)
      TextBlock.pageTitle / .pageSubtitle / .h2 / .muted / .caption / .label / .mono
      Border.chip + .game/.aircraft/.device/.modifier/.group/.axis/.ok/.warn   colored chips (TextBlock / PathIcon inside)
      Border.keycap              an input as a key cap ("JOY_BTN5")
      Border.emptyState          the "nothing here yet" box with an icon, a title, a hint and actions
      Border.stat + TextBlock.statValue/.statLabel   the Start page's counters
      Button.small / Button.ghost / Button.danger, ToggleButton.filterChip, ListBox.cards, TextBox.search
      Border.segmented > ToggleButton   a mode / section switch (Layout page)
      Border.canvasHost / .floatingLabel / .toolbar / .statusbar   the device picture region and its bars
      Border.keycap.small, ListBox.compact, Button.preview (a picture card that opens on click)
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Collapsible headers (every Expander of the app): the whole header row is the toggle, the chevron too. The chevron
         takes no clicks of its own (they reach the header's toggle), the row shows the hand. -->
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.surface">
        <Setter Property="Background" Value="{DynamicResource JP.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JP.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.surface.tight">
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.sunken">
        <Setter Property="Background" Value="{DynamicResource JP.SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JP.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.raised">
        <Setter Property="Background" Value="{DynamicResource JP.SurfaceRaisedBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Notices: a tinted card with a colored left edge -->
    <Style Selector="Border.callout">
        <Setter Property="Background" Value="{DynamicResource JP.AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusInfoBrush}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.callout.warn">
        <Setter Property="Background" Value="{DynamicResource JP.Chip.WarnBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusWarnBrush}" />
    </Style>
    <Style Selector="Border.callout.error">
        <Setter Property="Background" Value="{DynamicResource JP.DangerFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
    </Style>
    <Style Selector="Border.callout.ok">
        <Setter Property="Background" Value="{DynamicResource JP.Chip.OkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusOkBrush}" />
    </Style>

    <!-- Section icons -->
    <Style Selector="Border.iconBadge">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{DynamicResource JP.AccentSoftBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.iconBadge > PathIcon">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Foreground" Value="{DynamicResource JP.AccentTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.iconBadge.large">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.iconBadge.large > PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="Border.iconBadge.warn">
        <Setter Property="Background" Value="{DynamicResource JP.Chip.WarnBrush}" />
    </Style>
    <Style Selector="Border.iconBadge.warn > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.WarnTextBrush}" />
    </Style>
    <Style Selector="Border.iconBadge.ok">
        <Setter Property="Background" Value="{DynamicResource JP.Chip.OkBrush}" />
    </Style>
    <Style Selector="Border.iconBadge.ok > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.OkTextBrush}" />
    </Style>

    <!-- Typography -->
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.22}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.pageSubtitle">
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.13}" />
        <Setter Property="Foreground" Value="{DynamicResource JP.TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.15}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.13}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource JP.TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.11.5}" />
        <Setter Property="Foreground" Value="{DynamicResource JP.TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.12}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource JP.TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource JP.MonoFont}" />
    </Style>
    <Style Selector="TextBlock.warnText">
        <Setter Property="Foreground" Value="{DynamicResource JP.WarnTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Chips -->
    <!-- A chip that opens something (the relation's function picker): the chip itself is the button -->
    <Style Selector="Button.chipButton">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chipButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.chipButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.chipButton:pointerover Border.chip">
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.chip">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource JP.Chip.GroupBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.chip TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.11}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.GroupTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.chip PathIcon">
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.GroupTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip.game">
        <Setter Property="Background" Value="{DynamicResource JP.Chip.GameBrush}" />
    </Style>
    <Style Selector="Border.chip.game TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.GameTextBrush}" />
    </Style>
    <Style Selector="Border.chip.game PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.GameTextBrush}" />
    </Style>
    <Style Selector="Border.chip.aircraft">
        <Setter Property="Background" Value="{DynamicResource JP.Chip.AircraftBrush}" />
    </Style>
    <Style Selector="Border.chip.aircraft TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.AircraftTextBrush}" />
    </Style>
    <Style Selector="Border.chip.aircraft PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.AircraftTextBrush}" />
    </Style>
    <Style Selector="Border.chip.device">
        <Setter Property="Background" Value="{DynamicResource JP.Chip.DeviceBrush}" />
    </Style>
    <Style Selector="Border.chip.device TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.DeviceTextBrush}" />
    </Style>
    <Style Selector="Border.chip.device PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.DeviceTextBrush}" />
    </Style>
    <Style Selector="Border.chip.modifier">
        <Setter Property="Background" Value="{DynamicResource JP.Chip.ModifierBrush}" />
    </Style>
    <Style Selector="Border.chip.modifier TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.ModifierTextBrush}" />
    </Style>
    <Style Selector="Border.chip.modifier PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.ModifierTextBrush}" />
    </Style>
    <Style Selector="Border.chip.axis">
        <Setter Property="Background" Value="{DynamicResource JP.Chip.AxisBrush}" />
    </Style>
    <Style Selector="Border.chip.axis TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.AxisTextBrush}" />
    </Style>
    <Style Selector="Border.chip.axis PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.AxisTextBrush}" />
    </Style>
    <!-- "Recommended": the one action to take in a game (suggestions, search, catalog) -->
    <Style Selector="Border.chip.recommended">
        <Setter Property="Background" Value="{DynamicResource JP.AccentBrush}" />
    </Style>
    <Style Selector="Border.chip.recommended TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource JP.OnAccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.chip.ok">
        <Setter Property="Background" Value="{DynamicResource JP.Chip.OkBrush}" />
    </Style>
    <Style Selector="Border.chip.ok TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.OkTextBrush}" />
    </Style>
    <Style Selector="Border.chip.ok PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.OkTextBrush}" />
    </Style>
    <Style Selector="Border.chip.warn">
        <Setter Property="Background" Value="{DynamicResource JP.Chip.WarnBrush}" />
    </Style>
    <Style Selector="Border.chip.warn TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.WarnTextBrush}" />
    </Style>
    <Style Selector="Border.chip.warn PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource JP.Chip.WarnTextBrush}" />
    </Style>

    <!-- Inputs as key caps -->
    <Style Selector="Border.keycap">
        <Setter Property="Background" Value="{DynamicResource JP.KeycapBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JP.KeycapBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,3" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,1,7,1" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.keycap TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource JP.MonoFont}" />
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.11.5}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource JP.KeycapTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.keycap.large">
        <Setter Property="Padding" Value="12,4,12,4" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1,1,1,4" />
    </Style>
    <Style Selector="Border.keycap.large TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.16}" />
    </Style>

    <!-- Empty states -->
    <Style Selector="Border.emptyState">
        <Setter Property="Background" Value="{DynamicResource JP.SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JP.BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24,20" />
    </Style>
    <Style Selector="Border.emptyState PathIcon.emptyIcon">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource JP.AccentTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Counters -->
    <Style Selector="Border.stat">
        <Setter Property="Background" Value="{DynamicResource JP.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JP.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinWidth" Value="150" />
    </Style>
    <Style Selector="TextBlock.statValue">
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.24}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.statLabel">
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.11.5}" />
        <Setter Property="Foreground" Value="{DynamicResource JP.TextMutedBrush}" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button.small, ToggleButton.small">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.12}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- A device card of the Start page: the whole row is the button (opens the Layout page with the device) -->
    <Style Selector="Button.deviceCard">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- Red text on the surface color with a red frame: Fluent's gray button face is too dark for red text in the light theme. -->
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource JP.DangerTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource JP.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource JP.SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource JP.DangerTextBrush}" />
    </Style>
    <Style Selector="Button.icon.iconOnly">
        <Setter Property="Padding" Value="7" />
    </Style>
    <!-- Icon-only buttons (Tag = the icon, no text; the tooltip says what it does) -->
    <Style Selector="Button.icon.iconOnly, ToggleButton.icon.iconOnly">
        <Setter Property="Padding" Value="7" />
        <Setter Property="Content" Value="" />
    </Style>
    <Style Selector="Button.icon.iconOnly">
        <Setter Property="ContentTemplate">
            <DataTemplate x:DataType="x:String">
                <PathIcon Width="16" Height="16" Data="{Binding $parent[Button].Tag}" />
            </DataTemplate>
        </Setter>
    </Style>
    <!-- A disabled icon-only button (Forward with nothing ahead, Redo with nothing to redo) looks disabled like a text
         button: its icon fades (the icon has its own color, so the button's disabled text color does not reach it). -->
    <Style Selector="Button.icon.iconOnly:disabled PathIcon">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="ToggleButton.icon.iconOnly">
        <Setter Property="ContentTemplate">
            <DataTemplate x:DataType="x:String">
                <PathIcon Width="16" Height="16" Data="{Binding $parent[ToggleButton].Tag}" />
            </DataTemplate>
        </Setter>
    </Style>

    <!-- Filter chips (group filters) -->
    <Style Selector="ToggleButton.filterChip">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.12}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- A chip with a text (Classes="filterChip trimmed"): cut with "..." where its row is narrow (a big text size), never chopped off -->
    <Style Selector="ToggleButton.filterChip.trimmed">
        <Setter Property="ContentTemplate">
            <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
        </Setter>
    </Style>

    <!-- What the search found in a card's actions (MainWindowViewModel.SearchMatches.cs): one compact line per action,
         the searched word in the accent; a click opens the action. The action it opened is tinted. -->
    <Style Selector="Button.searchHit">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource JP.TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.11.5}" />
    </Style>
    <Style Selector="Button.searchHit /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.searchHit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource JP.AccentSoftBrush}" />
    </Style>
    <Style Selector="Border.searchHits">
        <Setter Property="BorderBrush" Value="{DynamicResource JP.AccentBrush}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="Padding" Value="2,0,0,0" />
    </Style>
    <Style Selector="StackPanel.searchHit">
        <Setter Property="Background" Value="{DynamicResource JP.AccentSoftBrush}" />
    </Style>

    <!-- Lists of cards: rounded rows, the selected one tinted with the accent -->
    <Style Selector="ListBox.cards">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource JP.SurfaceAltBrush}" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource JP.AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JP.AccentBrush}" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource JP.AccentSoftBrush}" />
    </Style>
    <!-- Where a dragged card lands (the relation editor's action order): a line above or below the card under the pointer -->
    <Style Selector="ListBox.cards ListBoxItem.dropAbove /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderThickness" Value="0,3,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource JP.AccentBrush}" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem.dropBelow /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderThickness" Value="0,0,0,3" />
        <Setter Property="BorderBrush" Value="{DynamicResource JP.AccentBrush}" />
    </Style>

    <!-- An expander's title wraps to a second line where its column is narrow (a big text size), never cut off -->
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Follow input's note over the bind list -->
    <Style Selector="Border.followToast">
        <Setter Property="Background" Value="{DynamicResource JP.ToastBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JP.WarnBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="BoxShadow" Value="0 4 14 0 #50000000" />
    </Style>

    <!-- A list row whose input is pressed (or whose axis moves) right now: amber, pulsing while held (live input) -->
    <Style Selector="Border.liveRow">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="3,1" />
        <Setter Property="Margin" Value="-3,-1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.liveRow.live">
        <Setter Property="BorderBrush" Value="{DynamicResource JP.WarnBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource JP.LiveRowBrush}" />
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate">
                <!-- The frame pulses (an animation cannot take the theme's colours: they change at run time). -->
                <KeyFrame Cue="0%">
                    <Setter Property="BorderThickness" Value="1.5" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="BorderThickness" Value="2.5" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Segmented switch (modes, page sections): ToggleButtons in a pill, the checked one filled with the accent -->
    <Style Selector="Border.segmented">
        <Setter Property="Background" Value="{DynamicResource JP.SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JP.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.segmented ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.12.5}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource JP.TextMutedBrush}" />
    </Style>
    <Style Selector="Border.segmented ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource JP.SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource JP.TextBrush}" />
    </Style>
    <Style Selector="Border.segmented ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource JP.AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource JP.OnAccentTextBrush}" />
    </Style>
    <Style Selector="Border.segmented ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource JP.AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource JP.OnAccentTextBrush}" />
    </Style>

    <!-- The device picture region (DeviceMarkerCanvas / DeviceReferenceView host) and labels floating on it -->
    <Style Selector="Border.canvasHost">
        <Setter Property="Background" Value="{DynamicResource JP.SurfaceAltBrush}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.floatingLabel">
        <Setter Property="Background" Value="{DynamicResource JP.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JP.BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="BoxShadow" Value="0 4 14 0 #33000000" />
    </Style>
    <Style Selector="Border.toolbar">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BorderBrush" Value="{DynamicResource JP.BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.statusbar">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource JP.BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.keycap.small">
        <Setter Property="Padding" Value="5,0,5,0" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
    </Style>
    <Style Selector="Border.keycap.small TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.10.5}" />
    </Style>
    <!-- Editable cells of a legend row -->
    <Style Selector="TextBox.cell">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FontSize" Value="{DynamicResource JP.FontSize.12}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.compact ListBoxItem">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <Style Selector="Button.preview">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- The hint in an empty text box: Fluent draws the text color at half opacity (3.9:1 on white); the muted text color
         reads better in both themes and still looks like a hint. The template sets the opacity itself, so only a selector with a state (:empty) is strong enough to change it. -->
    <Style Selector="TextBox:empty /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource JP.TextMutedBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Search boxes: a magnifier in front -->
    <Style Selector="TextBox.search">
        <Setter Property="InnerLeftContent">
            <Template>
                <PathIcon Data="{DynamicResource Icon.Search}" Width="14" Height="14" Margin="10,0,0,0" Opacity="0.65" />
            </Template>
        </Setter>
    </Style>
</Styles>
