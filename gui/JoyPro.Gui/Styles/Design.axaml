<!--
    JoyPro's design tokens: the colors of surfaces, borders, text and the colored chips, for the dark and the light theme
    (navy and blue like the banner in Branding.axaml). DesignStyles.axaml turns them into the shared looks (cards, section
    headers, chips, key caps, empty states, stat tiles). Use them with {DynamicResource ...} so a theme switch follows.
    Spacing scale of the pages: 4 / 8 / 12 / 16 / 24.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="JP.PageBackgroundBrush" Color="#0B1220" />
            <SolidColorBrush x:Key="JP.SurfaceBrush" Color="#111A2D" />
            <SolidColorBrush x:Key="JP.SurfaceAltBrush" Color="#0D1526" />
            <SolidColorBrush x:Key="JP.SurfaceRaisedBrush" Color="#16223A" />
            <SolidColorBrush x:Key="JP.BorderBrush" Color="#22314D" />
            <SolidColorBrush x:Key="JP.BorderStrongBrush" Color="#33476E" />
            <SolidColorBrush x:Key="JP.TextBrush" Color="#E5ECF6" />
            <SolidColorBrush x:Key="JP.TextMutedBrush" Color="#93A4BF" />
            <SolidColorBrush x:Key="JP.AccentBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="JP.AccentSoftBrush" Color="#2E3B82F6" />
            <SolidColorBrush x:Key="JP.AccentTextBrush" Color="#93C5FD" />
            <SolidColorBrush x:Key="JP.DangerTextBrush" Color="#FCA5A5" />
            <SolidColorBrush x:Key="JP.WarnTextBrush" Color="#FCD34D" />
            <SolidColorBrush x:Key="JP.OkTextBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="JP.OkFillBrush" Color="#15803D" />

            <SolidColorBrush x:Key="JP.Chip.GameBrush" Color="#336366F1" />
            <SolidColorBrush x:Key="JP.Chip.GameTextBrush" Color="#C7D2FE" />
            <SolidColorBrush x:Key="JP.Chip.AircraftBrush" Color="#300EA5E9" />
            <SolidColorBrush x:Key="JP.Chip.AircraftTextBrush" Color="#BAE6FD" />
            <SolidColorBrush x:Key="JP.Chip.DeviceBrush" Color="#3014B8A6" />
            <SolidColorBrush x:Key="JP.Chip.DeviceTextBrush" Color="#99F6E4" />
            <SolidColorBrush x:Key="JP.Chip.ModifierBrush" Color="#33F59E0B" />
            <SolidColorBrush x:Key="JP.Chip.ModifierTextBrush" Color="#FDE68A" />
            <SolidColorBrush x:Key="JP.Chip.GroupBrush" Color="#3394A3B8" />
            <SolidColorBrush x:Key="JP.Chip.GroupTextBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="JP.Chip.AxisBrush" Color="#33A855F7" />
            <SolidColorBrush x:Key="JP.Chip.AxisTextBrush" Color="#E9D5FF" />
            <SolidColorBrush x:Key="JP.Chip.OkBrush" Color="#2E22C55E" />
            <SolidColorBrush x:Key="JP.Chip.OkTextBrush" Color="#86EFAC" />
            <SolidColorBrush x:Key="JP.Chip.WarnBrush" Color="#33F97316" />
            <SolidColorBrush x:Key="JP.Chip.WarnTextBrush" Color="#FDBA74" />

            <SolidColorBrush x:Key="JP.KeycapBrush" Color="#1B2742" />
            <SolidColorBrush x:Key="JP.KeycapBorderBrush" Color="#3A4D75" />
            <SolidColorBrush x:Key="JP.KeycapTextBrush" Color="#E5ECF6" />

            <!-- Fluent's expanders on the surfaces of the pages -->
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#111A2D" />
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#16223A" />
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#0D1526" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#22314D" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="#33476E" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="#33476E" />
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="#0D1526" />
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#22314D" />

            <!-- Fluent's selected list row (the accent at 60 %) is too bright for the muted second line: a deep blue. -->
            <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#1D3461" />
            <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#22407A" />
            <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#1A2E56" />

            <!-- Every colour of the GUI is one of these tokens (Services/ThemeService.cs lists them for the theme editor). -->
            <SolidColorBrush x:Key="JP.ImageWellBrush" Color="#1A94A3B8" />
            <SolidColorBrush x:Key="JP.OverlayDimBrush" Color="#99000000" />
            <SolidColorBrush x:Key="JP.OnAccentTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="JP.WarnBorderBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="JP.DangerFillBrush" Color="#26EF4444" />
            <SolidColorBrush x:Key="JP.Dot.OkBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="JP.Dot.WarnBrush" Color="#D97706" />
            <SolidColorBrush x:Key="JP.Dot.OffBrush" Color="#9CA3AF" />
            <SolidColorBrush x:Key="JP.StepTodoBrush" Color="#475569" />
            <SolidColorBrush x:Key="JP.ToastBackgroundBrush" Color="#E61E293B" />
            <SolidColorBrush x:Key="JP.LiveRowBrush" Color="#55F59E0B" />
            <SolidColorBrush x:Key="JP.LiveRowPulseBrush" Color="#88F59E0B" />

            <!-- The header banner: navy in both themes -->
            <SolidColorBrush x:Key="JP.Banner.BackgroundBrush" Color="#0B1220" />
            <SolidColorBrush x:Key="JP.Banner.GlowBrush" Color="#132A4C" />
            <SolidColorBrush x:Key="JP.Banner.AccentBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="JP.Banner.TextBrush" Color="#CBD5E1" />
            <LinearGradientBrush x:Key="JP.Banner.GradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#0B1220" Offset="0" />
                <GradientStop Color="#132A4C" Offset="0.55" />
                <GradientStop Color="#0B1220" Offset="1" />
            </LinearGradientBrush>

            <!-- The bottom bar and its page buttons -->
            <SolidColorBrush x:Key="JP.BottomBar.BackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="JP.Nav.ButtonBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="JP.Nav.TextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="JP.Nav.SelectedBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="JP.Nav.SelectedTextBrush" Color="#FFFFFF" />

            <!-- The engine output (a console: dark in both themes) -->
            <SolidColorBrush x:Key="JP.Console.BackgroundBrush" Color="#020617" />
            <SolidColorBrush x:Key="JP.Console.TextBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="JP.Console.BorderBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="JP.Console.SelectionBrush" Color="#1D4ED8" />

            <!-- Charts (axis curves, force feedback, detents, telemetry): dark panels in both themes -->
            <SolidColorBrush x:Key="JP.Chart.PanelBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="JP.Chart.GridBrush" Color="#1E293B" />
            <SolidColorBrush x:Key="JP.Chart.AxisBrush" Color="#64748B" />
            <SolidColorBrush x:Key="JP.Chart.CurveBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="JP.Chart.ReferenceBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="JP.Chart.PointBrush" Color="#F43F5E" />
            <SolidColorBrush x:Key="JP.Chart.LabelBrush" Color="#94A3B8" />

            <!-- Markers on the device pictures -->
            <SolidColorBrush x:Key="JP.Marker.ButtonBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="JP.Marker.AxisBrush" Color="#C084FC" />
            <SolidColorBrush x:Key="JP.Marker.HatBrush" Color="#2DD4BF" />
            <SolidColorBrush x:Key="JP.Marker.SliderBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="JP.Marker.BoundBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="JP.Marker.FreeBrush" Color="#E6334155" />
            <SolidColorBrush x:Key="JP.Marker.HighlightBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="JP.Marker.BadgeBrush" Color="#EB0F172A" />
            <SolidColorBrush x:Key="JP.Marker.LabelBrush" Color="#F8FAFC" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="JP.PageBackgroundBrush" Color="#EEF2F7" />
            <SolidColorBrush x:Key="JP.SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="JP.SurfaceAltBrush" Color="#F6F8FB" />
            <SolidColorBrush x:Key="JP.SurfaceRaisedBrush" Color="#F1F5FA" />
            <SolidColorBrush x:Key="JP.BorderBrush" Color="#DAE2EC" />
            <SolidColorBrush x:Key="JP.BorderStrongBrush" Color="#BCC8D8" />
            <SolidColorBrush x:Key="JP.TextBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="JP.TextMutedBrush" Color="#4B5A70" />
            <SolidColorBrush x:Key="JP.AccentBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="JP.AccentSoftBrush" Color="#1F2563EB" />
            <SolidColorBrush x:Key="JP.AccentTextBrush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="JP.DangerTextBrush" Color="#B91C1C" />
            <SolidColorBrush x:Key="JP.WarnTextBrush" Color="#B45309" />
            <SolidColorBrush x:Key="JP.OkTextBrush" Color="#15803D" />
            <SolidColorBrush x:Key="JP.OkFillBrush" Color="#15803D" />

            <SolidColorBrush x:Key="JP.Chip.GameBrush" Color="#E0E7FF" />
            <SolidColorBrush x:Key="JP.Chip.GameTextBrush" Color="#3730A3" />
            <SolidColorBrush x:Key="JP.Chip.AircraftBrush" Color="#E0F2FE" />
            <SolidColorBrush x:Key="JP.Chip.AircraftTextBrush" Color="#075985" />
            <SolidColorBrush x:Key="JP.Chip.DeviceBrush" Color="#CCFBF1" />
            <SolidColorBrush x:Key="JP.Chip.DeviceTextBrush" Color="#115E59" />
            <SolidColorBrush x:Key="JP.Chip.ModifierBrush" Color="#FEF3C7" />
            <SolidColorBrush x:Key="JP.Chip.ModifierTextBrush" Color="#92400E" />
            <SolidColorBrush x:Key="JP.Chip.GroupBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="JP.Chip.GroupTextBrush" Color="#334155" />
            <SolidColorBrush x:Key="JP.Chip.AxisBrush" Color="#F3E8FF" />
            <SolidColorBrush x:Key="JP.Chip.AxisTextBrush" Color="#6B21A8" />
            <SolidColorBrush x:Key="JP.Chip.OkBrush" Color="#DCFCE7" />
            <SolidColorBrush x:Key="JP.Chip.OkTextBrush" Color="#166534" />
            <SolidColorBrush x:Key="JP.Chip.WarnBrush" Color="#FFEDD5" />
            <SolidColorBrush x:Key="JP.Chip.WarnTextBrush" Color="#9A3412" />

            <SolidColorBrush x:Key="JP.KeycapBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="JP.KeycapBorderBrush" Color="#B8C4D6" />
            <SolidColorBrush x:Key="JP.KeycapTextBrush" Color="#0F172A" />

            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#F1F5FA" />
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#E8EEF5" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#DAE2EC" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="#BCC8D8" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="#BCC8D8" />
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="#F6F8FB" />
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#DAE2EC" />

            <!-- Every colour of the GUI is one of these tokens (Services/ThemeService.cs lists them for the theme editor). -->
            <SolidColorBrush x:Key="JP.ImageWellBrush" Color="#1A64748B" />
            <SolidColorBrush x:Key="JP.OverlayDimBrush" Color="#99000000" />
            <SolidColorBrush x:Key="JP.OnAccentTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="JP.WarnBorderBrush" Color="#D97706" />
            <SolidColorBrush x:Key="JP.DangerFillBrush" Color="#1FEF4444" />
            <SolidColorBrush x:Key="JP.Dot.OkBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="JP.Dot.WarnBrush" Color="#D97706" />
            <SolidColorBrush x:Key="JP.Dot.OffBrush" Color="#9CA3AF" />
            <SolidColorBrush x:Key="JP.StepTodoBrush" Color="#475569" />
            <SolidColorBrush x:Key="JP.ToastBackgroundBrush" Color="#E61E293B" />
            <SolidColorBrush x:Key="JP.LiveRowBrush" Color="#55F59E0B" />
            <SolidColorBrush x:Key="JP.LiveRowPulseBrush" Color="#88F59E0B" />

            <!-- The header banner: navy in both themes -->
            <SolidColorBrush x:Key="JP.Banner.BackgroundBrush" Color="#0B1220" />
            <SolidColorBrush x:Key="JP.Banner.GlowBrush" Color="#132A4C" />
            <SolidColorBrush x:Key="JP.Banner.AccentBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="JP.Banner.TextBrush" Color="#CBD5E1" />
            <LinearGradientBrush x:Key="JP.Banner.GradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#0B1220" Offset="0" />
                <GradientStop Color="#132A4C" Offset="0.55" />
                <GradientStop Color="#0B1220" Offset="1" />
            </LinearGradientBrush>

            <!-- The bottom bar and its page buttons -->
            <SolidColorBrush x:Key="JP.BottomBar.BackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="JP.Nav.ButtonBrush" Color="#1F0F172A" />
            <SolidColorBrush x:Key="JP.Nav.TextBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="JP.Nav.SelectedBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="JP.Nav.SelectedTextBrush" Color="#FFFFFF" />

            <!-- The engine output (a console: dark in both themes) -->
            <SolidColorBrush x:Key="JP.Console.BackgroundBrush" Color="#020617" />
            <SolidColorBrush x:Key="JP.Console.TextBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="JP.Console.BorderBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="JP.Console.SelectionBrush" Color="#1D4ED8" />

            <!-- Charts (axis curves, force feedback, detents, telemetry): dark panels in both themes -->
            <SolidColorBrush x:Key="JP.Chart.PanelBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="JP.Chart.GridBrush" Color="#1E293B" />
            <SolidColorBrush x:Key="JP.Chart.AxisBrush" Color="#64748B" />
            <SolidColorBrush x:Key="JP.Chart.CurveBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="JP.Chart.ReferenceBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="JP.Chart.PointBrush" Color="#F43F5E" />
            <SolidColorBrush x:Key="JP.Chart.LabelBrush" Color="#94A3B8" />

            <!-- Markers on the device pictures -->
            <SolidColorBrush x:Key="JP.Marker.ButtonBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="JP.Marker.AxisBrush" Color="#C084FC" />
            <SolidColorBrush x:Key="JP.Marker.HatBrush" Color="#2DD4BF" />
            <SolidColorBrush x:Key="JP.Marker.SliderBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="JP.Marker.BoundBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="JP.Marker.FreeBrush" Color="#E6334155" />
            <SolidColorBrush x:Key="JP.Marker.HighlightBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="JP.Marker.BadgeBrush" Color="#EB0F172A" />
            <SolidColorBrush x:Key="JP.Marker.LabelBrush" Color="#F8FAFC" />

        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Text sizes, fonts and weights: ThemeService.ApplyTypography sets them from the text size and the theme's fonts
         (JoyPro's size times the text size). The XAML uses {DynamicResource JP.FontSize.12} instead of FontSize="12". -->
    <x:Double x:Key="JP.FontSize.9">9</x:Double>
    <x:Double x:Key="JP.FontSize.10">10</x:Double>
    <x:Double x:Key="JP.FontSize.10.5">10.5</x:Double>
    <x:Double x:Key="JP.FontSize.11">11</x:Double>
    <x:Double x:Key="JP.FontSize.11.5">11.5</x:Double>
    <x:Double x:Key="JP.FontSize.12">12</x:Double>
    <x:Double x:Key="JP.FontSize.12.5">12.5</x:Double>
    <x:Double x:Key="JP.FontSize.13">13</x:Double>
    <x:Double x:Key="JP.FontSize.14">14</x:Double>
    <x:Double x:Key="JP.FontSize.15">15</x:Double>
    <x:Double x:Key="JP.FontSize.16">16</x:Double>
    <x:Double x:Key="JP.FontSize.17">17</x:Double>
    <x:Double x:Key="JP.FontSize.18">18</x:Double>
    <x:Double x:Key="JP.FontSize.19">19</x:Double>
    <x:Double x:Key="JP.FontSize.20">20</x:Double>
    <x:Double x:Key="JP.FontSize.22">22</x:Double>
    <x:Double x:Key="JP.FontSize.24">24</x:Double>
    <x:Double x:Key="JP.FontSize.30">30</x:Double>
    <x:Double x:Key="JP.FontSize.44">44</x:Double>
    <FontWeight x:Key="JP.UiFontWeight">Normal</FontWeight>
    <x:Double x:Key="JP.LineSpacing">0</x:Double>
    <x:Double x:Key="JP.PageMinHeight">0</x:Double>
    <FontFamily x:Key="JP.MonoFont">Consolas, Cascadia Mono, Courier New</FontFamily>
    <!-- Nearly transparent: a line that is easy to hit with the mouse but not seen (not a colour of the theme). -->
    <SolidColorBrush x:Key="JP.HitTestBrush" Color="#01FFFFFF" />
</ResourceDictionary>
