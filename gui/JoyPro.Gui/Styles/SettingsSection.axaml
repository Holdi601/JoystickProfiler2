<!--
    The look of a Settings section (Views/Controls/SettingsSection.cs): a card with a header row
      drag handle | open/closed arrow, icon and title (click opens or closes) | the section's own buttons | menu
    A click anywhere on the header row (the arrow, the title, the empty space, the drag handle without dragging) opens or
    closes it, except on its buttons.
    and the settings below it while the section is open. :dragging dims it while it is moved.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:JoyPro.Gui.Views.Controls"
                    xmlns:l="using:JoyPro.Gui.Localization">

    <ControlTheme x:Key="{x:Type controls:SettingsSection}" TargetType="controls:SettingsSection">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Card" Background="{DynamicResource JP.SurfaceBrush}" BorderBrush="{DynamicResource JP.BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="6,4,8,4">
                    <StackPanel Spacing="0">
                        <Grid x:Name="PART_Header" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4" MinHeight="40" Background="Transparent" Cursor="Hand">
                            <Border x:Name="PART_Grip" Background="Transparent" Width="22" VerticalAlignment="Stretch" Cursor="SizeAll"
                                    ToolTip.Tip="{l:T 'Drag to move this section, click to open or close it'}">
                                <PathIcon Data="{StaticResource Icon.Grip}" Width="14" Height="14" Opacity="0.55" VerticalAlignment="Center" />
                            </Border>
                            <!-- No Button: the whole row (chevron, icon, title, empty space) is one toggle with one pointer handler
                                 (SettingsSection.OnHeaderPressed/Released); Enter or Space toggles it from the keyboard. -->
                            <Border x:Name="PART_Toggle" Grid.Column="1" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="4,6"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="8" Focusable="True">
                                <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
                                    <Panel Width="16" Height="16" VerticalAlignment="Center" Background="Transparent">
                                        <PathIcon x:Name="PART_Closed" Data="{StaticResource Icon.ChevronRight}" Width="16" Height="16" />
                                        <PathIcon x:Name="PART_Opened" Data="{StaticResource Icon.ChevronDown}" Width="16" Height="16" IsVisible="False" />
                                    </Panel>
                                    <PathIcon Data="{TemplateBinding Icon}" Width="20" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <ContentPresenter x:Name="PART_HeaderContent" Grid.Column="2" Content="{TemplateBinding HeaderContent}" VerticalAlignment="Center" IsVisible="False" />
                            <Button x:Name="PART_Menu" Grid.Column="3" Classes="icon iconOnly ghost" Tag="{StaticResource Icon.More}" VerticalAlignment="Center"
                                    ToolTip.Tip="{l:T 'Move this section'}" />
                        </Grid>
                        <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="26,4,0,8" IsVisible="False" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:open /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:open /template/ ContentPresenter#PART_HeaderContent">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:open /template/ PathIcon#PART_Opened">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:open /template/ PathIcon#PART_Closed">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:open /template/ Border#PART_Card">
            <Setter Property="BorderBrush" Value="{DynamicResource JP.BorderStrongBrush}" />
        </Style>
        <Style Selector="^:dragging">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Grip:pointerover PathIcon">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^ /template/ Grid#PART_Header:pointerover Border#PART_Toggle">
            <Setter Property="Background" Value="{DynamicResource JP.SurfaceRaisedBrush}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Toggle:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource JP.AccentBrush}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
