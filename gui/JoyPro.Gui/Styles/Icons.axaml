<!--
    JoyPro's icon set: one place for every symbol of the GUI, so all pages look alike and other pages can reuse them.
    Use:  <PathIcon Data="{StaticResource Icon.Export}" />  or a button with Classes="icon" Tag="{StaticResource Icon.Export}"
          (IconStyles.axaml puts the icon left of the button text).
    The shapes are 24x24 path data in the style of Material Design Icons (Pictogrammers, Apache License 2.0); a few
    (joystick, axis curve, sun, moon, keycap) are drawn for JoyPro. No pictures are downloaded.
    Status colors (ok / warning / error / info) are brushes below; PathIcon.ok/.warn/.error/.info use them.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

