<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:JoyPro.Gui.Localization"
             xmlns:vm="using:JoyPro.Gui.ViewModels"
             xmlns:models="using:JoyPro.Gui.Models"
             xmlns:controls="using:JoyPro.Gui.Views.Controls"
             xmlns:local="using:JoyPro.Gui.Views"
             xmlns:views="using:JoyPro.Gui.Views"
             x:Class="JoyPro.Gui.Views.VirtualJoystickView"
             x:DataType="vm:MainWindowViewModel">
    <!-- Virtual joystick (vJoy + HidHide): docs/virtual-joystick.md, MainWindowViewModel.VirtualJoystick.cs. -->
    <Border CornerRadius="12" Padding="10">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <TextBlock Text="{l:T 'Virtual joystick (vJoy + HidHide)'}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="#1A38BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VirtualJoystickForwarderText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding VirtualJoystickForwarderText}" />
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding StartVirtualJoystickCommand}" Content="{l:T 'Start'}" MinWidth="90" IsEnabled="{Binding CanStartVirtualJoystick}"
                            ToolTip.Tip="{l:T 'Hides your physical devices from the games set to Virtual (Windows asks once for administrator rights) and copies their inputs to vJoy live. Press it before you start the game.'}" />
                    <Button Command="{Binding TestVirtualJoystickCommand}" Content="{l:T 'Test'}" MinWidth="90" IsEnabled="{Binding CanStartVirtualJoystick}"
                            ToolTip.Tip="{l:T 'Reads your devices and shows below what the virtual joystick would get. vJoy and HidHide are not touched.'}" />
                    <Button Command="{Binding StopVirtualJoystickCommand}" Content="{l:T 'Stop'}" MinWidth="90" IsEnabled="{Binding VirtualJoystickRunning}"
                            ToolTip.Tip="{l:T 'Stops forwarding (the virtual joystick goes neutral) and gives HidHide back exactly the setup it had before.'}" />
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding VirtualJoystickMessage}" TextWrapping="Wrap" FontWeight="SemiBold"
                       IsVisible="{Binding VirtualJoystickMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TabControl Grid.Row="2">
                <TabItem Header="{l:T 'Overview'}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Margin="0,8,8,0">
                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{l:T 'What is this?'}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:T 'Some games only take a few joysticks, pick up the wrong ones or mix up their order. In virtual mode JoyPro puts every axis, button and hat that a game\'s binds use onto one virtual joystick (vJoy; more than one only when one is not enough). The game then sees just that device, and the binds always stay where they are.'}" />
                                    <TextBlock Text="{l:T 'How to use it'}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:T '1. Switch the game to Virtual below.'}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:T '2. Export the game again (Export page). JoyPro writes the binds to the virtual joystick; your profile keeps your real devices.'}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:T '3. Press Start before you start the game. JoyPro hides your real devices from that game with HidHide (Windows asks once for administrator rights) and copies every input to the virtual joystick in real time.'}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:T '4. Press Stop when you are done. HidHide gets back exactly the setup it had before; nothing stays hidden.'}" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.8" Text="{l:T 'Only the games set to Virtual stop seeing your real devices. Every other program (JoyPro, SimHub, Discord, other games) keeps seeing them. Curves, dead zones and inversions stay in the game\'s own settings as JoyPro exports them: the virtual joystick passes the raw values on 1:1.'}" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{l:T 'Status'}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Command="{Binding RefreshVirtualJoystickCommand}" Content="{l:T 'Refresh'}" MinWidth="110"
                                                ToolTip.Tip="{l:T 'Checks vJoy, HidHide and your devices (read-only: nothing is changed)'}" />
                                    </Grid>
                                    <TextBlock Text="{Binding VJoyStatusText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VJoyDevicesText}" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                                    <TextBlock Text="{Binding HidHideStatusText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ViGEmStatusText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VirtualJoystickSessionText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VirtualJoystickRateText}" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding ConfigureVJoyCommand}" Content="{l:T 'Set up vJoy for the table'}" IsVisible="{Binding VirtualJoystickNeedsConfig}"
                                                ToolTip.Tip="{l:T 'Runs vJoyConfig once (Windows asks for administrator rights) so the vJoy devices have the axes, buttons and hats the table needs. It never takes anything away from a device.'}" />
                                        <Button Command="{Binding RestoreHidHideCommand}" Content="{l:T 'Restore HidHide'}" IsVisible="{Binding VirtualJoystickSessionActive}"
                                                ToolTip.Tip="{l:T 'Gives HidHide back the setup it had before JoyPro changed it (for example after JoyPro or the PC crashed).'}" />
                                        <Button Command="{Binding SetUpVJoyMaximumCommand}" Content="{l:T 'Set up vJoy for maximum'}" IsVisible="{Binding !VJoyAtMaximum}"
                                                ToolTip.Tip="{l:T '8 axes, 128 buttons and 4 hats on each vJoy device JoyPro uses (one administrator prompt). Windows must restart before it takes effect; JoyPro never restarts Windows.'}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding VJoyMaximumText}" TextWrapping="Wrap" FontSize="12" Foreground="#B45309"
                                               IsVisible="{Binding VJoyMaximumText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding VirtualJoystickNeedsText}" TextWrapping="Wrap" FontSize="12"
                                               IsVisible="{Binding VirtualJoystickNeedsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{l:T 'What this page needs'}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Command="{Binding RefreshComponentsCommand}" Content="{l:T 'Check again'}" MinWidth="110"
                                                ToolTip.Tip="{l:T 'Looks at what is installed and running (read-only)'}" />
                                    </Grid>
                                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                               Text="{l:T 'Free drivers, not part of JoyPro: vJoy for games set to vJoy, ViGEmBus for games set to Xbox pad, HidHide to hide your real devices from those games. Install the ones you need with one click: JoyPro downloads the official installer, checks it and runs it (Windows asks once for administrator rights; a driver may need a restart). After installing, press Refresh above.'}" />
                                    <ItemsControl ItemsSource="{Binding VirtualJoystickComponents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ComponentItem">
                                                <controls:ComponentCard />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{l:T 'Games'}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.8" Text="{l:T 'Native: the game uses your real devices (as before). vJoy: the game uses one virtual joystick. Xbox pad: the game gets one virtual Xbox 360 controller - for games that only read Xbox controllers (XInput) or only one device; your sticks drive its two sticks, two triggers, D-pad and 14 buttons (what does not fit is listed on the Mapping tab). After switching, export the game again.'}" />
                                    <ItemsControl ItemsSource="{Binding VirtualJoystickGames}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:VirtualJoystickGameItem">
                                                <Grid ColumnDefinitions="240,210,*" ColumnSpacing="10" Margin="0,3">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" MinWidth="190" VerticalAlignment="Center"
                                                              ToolTip.Tip="{l:T 'Native: your real devices. vJoy: one virtual DirectInput joystick. Xbox pad: one virtual Xbox 360 controller (for games that only take XInput or one device; needs ViGEmBus).'}" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RelationsText}" FontSize="12" Opacity="0.8" />
                                                        <TextBlock Text="{Binding ExesText}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding XboxNote}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" IsVisible="{Binding IsXbox}" />
                                                        <TextBlock Text="{Binding InputLimitText}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                                                   IsVisible="{Binding InputLimitText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        <TextBlock Text="{Binding FunctionsText}" FontSize="12" Opacity="0.7"
                                                                   IsVisible="{Binding FunctionsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        <TextBlock Text="{Binding LimitWarningsText}" FontSize="12" TextWrapping="Wrap" Foreground="#B45309" IsVisible="{Binding HasLimitWarnings}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowSuggestion}">
                                                            <TextBlock Text="{Binding SuggestionText}" FontSize="12" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" Foreground="#B45309" />
                                                            <Button Content="{l:T 'Use it'}" Command="{Binding ApplySuggestionCommand}" Padding="8,2" VerticalAlignment="Center"
                                                                    ToolTip.Tip="{l:T 'Switches this game to the suggested virtual mode. Export the game again afterwards.'}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{l:T 'Options'}" FontSize="16" FontWeight="SemiBold" />
                                    <CheckBox IsChecked="{Binding VirtualJoystickHideDevices}" Content="{l:T 'Hide the real devices from the games set to Virtual (HidHide)'}"
                                              ToolTip.Tip="{l:T 'Off: the games see your real devices and the virtual joystick, which can give double input. Recommended: on.'}" />
                                    <CheckBox IsChecked="{Binding VirtualJoystickAutoStart}" Content="{l:T 'Start and stop by itself when a game set to Virtual starts and ends'}"
                                              ToolTip.Tip="{l:T 'JoyPro looks for the game every 3 seconds while this is on. Pressing Start before the game is still the safest: some games only look for devices when they start.'}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{l:T 'Mapping'}">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="0,8,8,0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding VirtualJoystickSlotsHeader}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding UpdateVirtualJoystickMappingCommand}" Content="{l:T 'Update mapping'}"
                                    ToolTip.Tip="{l:T 'Gives new inputs a slot and saves the table in the profile. Inputs that already have a slot never move.'}" />
                        </Grid>
                        <TextBlock Grid.Row="1" TextWrapping="Wrap" Opacity="0.8"
                                   Text="{l:T 'Each physical input the virtual games use gets a fixed place on the virtual joystick. An axis keeps its own axis where it is free (X stays X). The table is saved in your profile, so the game\'s binds stay the same from run to run.'}" />
                        <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="6">
                            <Grid RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="2*,1.2*,2*,*" ColumnSpacing="8" Margin="4,2">
                                    <TextBlock Text="{l:T 'Physical input'}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{l:T 'Virtual input'}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{l:T 'Used by'}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="{l:T 'State'}" FontWeight="SemiBold" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding VirtualJoystickSlots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:VirtualJoystickSlotItem">
                                                <Grid ColumnDefinitions="2*,1.2*,2*,*" ColumnSpacing="8" Margin="4,2">
                                                    <TextBlock Text="{Binding PhysicalText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Source}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding VirtualText}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding RelationsText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RelationsText}" Opacity="0.85" />
                                                    <TextBlock Grid.Column="3" Text="{Binding StateText}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="{l:T 'Functions'}">
                    <Grid ColumnDefinitions="340,*" ColumnSpacing="12" Margin="0,8,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                           Text="{l:T 'Virtual functions run inside the virtual joystick, between your devices and what the game gets: axis bands as buttons, button cycles, toggles, short/long/double press, shift layers, axis tools, turbo, macros and hat helpers. Each one gets free virtual buttons or axes; bind relations to them like to any vJoy button.'}" />
                                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{l:T 'Add a function'}" FontSize="16" FontWeight="SemiBold" />
                                        <ComboBox ItemsSource="{Binding VirtualFunctionGames}" SelectedItem="{Binding VirtualFunctionGame}" PlaceholderText="{l:T 'game in virtual mode'}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:VirtualJoystickGameItem">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ListBox ItemsSource="{Binding VirtualFunctionTypes}" SelectedItem="{Binding NewVirtualFunctionType}" MaxHeight="340">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:VfTypeOption">
                                                    <Grid ColumnDefinitions="30,*" ColumnSpacing="6" ToolTip.Tip="{Binding Example}">
                                                        <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Content="{l:T 'Add function'}" Command="{Binding AddVirtualFunctionCommand}" IsEnabled="{Binding CanAddVirtualFunction}" HorizontalAlignment="Stretch"
                                                ToolTip.Tip="{l:T 'Adds the function with free virtual outputs; then choose its inputs in the editor.'}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding VirtualFunctionsHeader}" FontSize="16" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding VirtualFunctions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:VirtualFunctionListItem">
                                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6" ToolTip.Tip="{Binding ProblemsText}">
                                                <Grid ColumnDefinitions="30,*" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding GameName}" FontSize="11" Opacity="0.75" />
                                                        <TextBlock Text="{Binding OutputsText}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding LiveText}" FontSize="11" Foreground="#16A34A"
                                                                   IsVisible="{Binding LiveText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                            <Button Content="{l:T 'Edit'}" Padding="8,2" Command="{Binding $parent[local:VirtualJoystickView].((vm:MainWindowViewModel)DataContext).EditVirtualFunctionCommand}" CommandParameter="{Binding}" />
                                                            <Button Content="{l:T 'On / off'}" Padding="8,2" Command="{Binding $parent[local:VirtualJoystickView].((vm:MainWindowViewModel)DataContext).ToggleVirtualFunctionCommand}" CommandParameter="{Binding}" />
                                                            <Button Content="{l:T 'Remove'}" Padding="8,2" Command="{Binding $parent[local:VirtualJoystickView].((vm:MainWindowViewModel)DataContext).DeleteVirtualFunctionCommand}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                            <TextBlock Text="{Binding VirtualFunctionMessage}" TextWrapping="Wrap" FontWeight="SemiBold"
                                       IsVisible="{Binding VirtualFunctionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasVirtualFunctionEditor}">
                                <Button Content="{l:T 'Save'}" Command="{Binding SaveVirtualFunctionCommand}" MinWidth="90"
                                        ToolTip.Tip="{l:T 'Saves the function in the profile. A running virtual joystick takes it after Stop and Start (or Test).'}" />
                                <Button Content="{l:T 'Close'}" Command="{Binding CloseVirtualFunctionEditorCommand}" MinWidth="90" ToolTip.Tip="{l:T 'Closes the editor without saving.'}" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" IsVisible="{Binding !HasVirtualFunctionEditor}" TextWrapping="Wrap" Opacity="0.7"
                                       Text="{l:T 'Pick a function on the left (Edit), or add one. The editor shows the inputs, the virtual outputs, the settings and a preview: \'Try it\' runs the function here; with Test or Start the editor shows your real devices live.'}" />
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasVirtualFunctionEditor}">
                                <views:VirtualFunctionEditorView DataContext="{Binding VirtualFunctionEditor}" Margin="0,0,8,0" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="{l:T 'Live test'}">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8" Margin="0,8,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <CheckBox IsChecked="{Binding VirtualJoystickLiveView}" Content="{l:T 'Show the virtual joystick live'}" />
                            <TextBlock Text="{Binding VirtualJoystickStatsText}" VerticalAlignment="Center" Opacity="0.8" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" TextWrapping="Wrap" Opacity="0.8"
                                   Text="{l:T 'Press Test (nothing is changed) or Start, then move your sticks and press buttons: the bars and buttons below are what the game gets from the virtual joystick.'}" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding VirtualJoystickLive}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:VirtualJoystickLiveDevice">
                                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{Binding Axes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:VirtualJoystickAxisItem">
                                                            <Grid ColumnDefinitions="50,*,60" ColumnSpacing="8" Margin="0,1">
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Value}" Height="12" />
                                                                <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{l:T 'Buttons pressed: {0}', Arg0={Binding ButtonsText}}" TextWrapping="Wrap" />
                                                <TextBlock Text="{l:T 'Hats: {0}', Arg0={Binding HatsText}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Expander Grid.Row="3" Header="{l:T 'Forwarder log'}">
                            <ListBox ItemsSource="{Binding VirtualJoystickLog}" MaxHeight="180" FontFamily="Consolas" FontSize="12" />
                        </Expander>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
