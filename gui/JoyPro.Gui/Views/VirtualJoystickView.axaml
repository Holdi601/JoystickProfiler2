<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:JoyPro.Gui.Localization"
             xmlns:vm="using:JoyPro.Gui.ViewModels"
             xmlns:models="using:JoyPro.Gui.Models"
             xmlns:controls="using:JoyPro.Gui.Views.Controls"
             xmlns:local="using:JoyPro.Gui.Views"
             xmlns:views="using:JoyPro.Gui.Views"
             x:Class="JoyPro.Gui.Views.VirtualJoystickView"
             x:DataType="vm:MainWindowViewModel">
    <!-- Virtual joystick (vJoy + HidHide): docs/virtual-joystick.md, MainWindowViewModel.VirtualJoystick.cs. -->
    <Border CornerRadius="12" Padding="10">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <!-- Only Xbox controller games: the page is the pretend controller's (no vJoy, no HidHide). -->
                <Panel VerticalAlignment="Center">
                    <TextBlock Text="{l:T 'Virtual joystick (vJoy + HidHide)'}" FontSize="{DynamicResource JP.FontSize.22}" FontWeight="Bold" IsVisible="{Binding VirtualJoystickShowsVJoySteps}" />
                    <TextBlock Text="{l:T 'Pretend controller'}" FontSize="{DynamicResource JP.FontSize.22}" FontWeight="Bold" IsVisible="{Binding VirtualJoystickPadOnly}" />
                </Panel>
                <Border Grid.Column="1" Background="{DynamicResource JP.AccentSoftBrush}" BorderBrush="{DynamicResource JP.AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VirtualJoystickForwarderText, Converter={x:Static l:TConverter.Instance}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding VirtualJoystickForwarderText, Converter={x:Static l:TConverter.Instance}}" />
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding StartVirtualJoystickCommand}" Content="{l:T 'Start'}" MinWidth="90" IsEnabled="{Binding CanStartVirtualJoystick}"
                            ToolTip.Tip="{Binding VirtualJoystickStartTip}" />
                    <Button Command="{Binding TestVirtualJoystickCommand}" Content="{l:T 'Test'}" MinWidth="90" IsEnabled="{Binding CanStartVirtualJoystick}"
                            ToolTip.Tip="{l:T 'Reads your devices and shows below what the virtual joystick would get. vJoy and HidHide are not touched.'}" />
                    <Button Command="{Binding StopVirtualJoystickCommand}" Content="{l:T 'Stop'}" MinWidth="90" IsEnabled="{Binding VirtualJoystickRunning}"
                            ToolTip.Tip="{l:T 'Stops forwarding (the virtual joystick goes neutral) and gives HidHide back exactly the setup it had before.'}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding VirtualJoystickMessage}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center"
                           IsVisible="{Binding VirtualJoystickMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <!-- After a failed start nothing is tried again by itself (no repeated administrator prompts): the user decides. -->
                <Button Grid.Column="1" Command="{Binding StartVirtualJoystickCommand}" Content="{l:T 'Try again'}" MinWidth="90" VerticalAlignment="Center"
                        IsVisible="{Binding VirtualJoystickCanRetry}" />
            </Grid>
            <TabControl Grid.Row="2">
                <TabItem x:Name="VirtualJoystickOverviewTab" Header="{l:T 'Overview'}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Margin="0,8,8,0">
                            <Border BorderBrush="{DynamicResource JP.BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{l:T 'What is this?'}" FontSize="{DynamicResource JP.FontSize.16}" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" IsVisible="{Binding VirtualJoystickPadOnly}"
                                               Text="{l:T 'Your game only knows an Xbox controller. JoyPro makes a pretend Xbox controller and drives it with your stick and throttle. The game sees the controller, not your stick.'}" />
                                    <TextBlock TextWrapping="Wrap" IsVisible="{Binding VirtualJoystickShowsVJoySteps}" Text="{l:T 'Some games only take a few joysticks, pick up the wrong ones or mix up their order. In virtual mode JoyPro puts every axis, button and hat that a game\'s binds use onto one virtual joystick (vJoy; more than one only when one is not enough). The game then sees just that device, and the binds always stay where they are.'}" />
                                    <TextBlock Text="{l:T 'How to use it'}" FontSize="{DynamicResource JP.FontSize.16}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <StackPanel Spacing="6" IsVisible="{Binding VirtualJoystickShowsVJoySteps}">
                                        <TextBlock TextWrapping="Wrap" Text="{l:T 'Xbox controller games (ACE COMBAT): skip steps 1 and 2.'}" IsVisible="{Binding HasXboxGames}" FontStyle="Italic" />
                                        <TextBlock TextWrapping="Wrap" Text="{l:T '1. Switch the game to Virtual below.'}" />
                                        <TextBlock TextWrapping="Wrap" Text="{l:T '2. Export the game again (Export page). JoyPro writes the binds to the virtual joystick; your profile keeps your real devices.'}" />
                                        <TextBlock TextWrapping="Wrap" Text="{l:T '3. Press Start before you start the game. JoyPro hides your real devices from that game with HidHide (Windows asks once for administrator rights) and copies every input to the virtual joystick in real time.'}" />
                                        <TextBlock TextWrapping="Wrap" Margin="16,0,0,0" Text="{Binding VirtualXboxPadTimingNote}" IsVisible="{Binding HasVirtualXboxPadTimingNote}" />
                                        <TextBlock TextWrapping="Wrap" Text="{l:T '4. Press Stop when you are done. HidHide gets back exactly the setup it had before; nothing stays hidden.'}" />
                                    </StackPanel>
                                    <!-- Only Xbox pad games: they are on the pad by themselves and get no export; Start after the
                                         title screen, said the same way as in the pad tour and the help. -->
                                    <StackPanel Spacing="6" IsVisible="{Binding VirtualJoystickPadOnly}">
                                        <TextBlock TextWrapping="Wrap" Text="{l:T '1. Your game only knows an Xbox controller, so it uses the pretend controller by itself. Nothing to switch, nothing to export.'}" />
                                        <TextBlock TextWrapping="Wrap" Text="{l:T '2. Start the game and wait for its title screen. Hold Alt and press Tab to come back here. Then press Start: JoyPro sends your stick and throttle to the pretend controller. Alt+Tab takes you back to the game.'}" />
                                        <TextBlock TextWrapping="Wrap" Text="{l:T '3. Too early? Press Stop, then Start. Press Stop when you are done.'}" />
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" Opacity="0.8" IsVisible="{Binding VirtualJoystickShowsExpertParts}" Text="{l:T 'Only the games set to Virtual stop seeing your real devices. Every other program (JoyPro, SimHub, Discord, other games) keeps seeing them. Curves, dead zones and inversions stay in the game\'s own settings as JoyPro exports them: vJoy passes the raw values on 1:1. On the virtual Xbox pad JoyPro applies each axis curve itself (Binds page, Axis response), because those games get no export.'}" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource JP.BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{l:T 'Status'}" FontSize="{DynamicResource JP.FontSize.16}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <!-- JoyPro reads the status by itself; the button is for experts (pad-only players: under Show details). -->
                                        <Button Grid.Column="1" Command="{Binding RefreshVirtualJoystickCommand}" Content="{l:T 'Refresh'}" MinWidth="110"
                                                ToolTip.Tip="{l:T 'Checks vJoy, HidHide and your devices (read-only: nothing is changed)'}" IsVisible="{Binding VirtualJoystickShowsExpertParts}" />
                                    </Grid>
                                    <!-- vJoy, HidHide, the session, the forwarding rate and the tunnel mean nothing for a player whose
                                         games are all on the pretend controller: shown only under Show details then. -->
                                    <TextBlock x:Name="VirtualJoystickViGEmStatus" Text="{Binding ViGEmStatusText}" TextWrapping="Wrap" />
                                    <StackPanel Spacing="6" IsVisible="{Binding VirtualJoystickShowsExpertParts}">
                                        <TextBlock Text="{Binding VJoyStatusText, Converter={x:Static l:TConverter.Instance}}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding VJoyDevicesText}" TextWrapping="Wrap" Opacity="0.8" FontSize="{DynamicResource JP.FontSize.12}" />
                                        <TextBlock Text="{Binding HidHideStatusText}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding VirtualJoystickSessionText, Converter={x:Static l:TConverter.Instance}}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding VirtualJoystickRateText}" TextWrapping="Wrap" Opacity="0.8" FontSize="{DynamicResource JP.FontSize.12}" />
                                        <TextBlock Text="{Binding VirtualJoystickTunnelText}" TextWrapping="Wrap" FontSize="{DynamicResource JP.FontSize.12}"
                                                   IsVisible="{Binding VirtualJoystickTunnelText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding VirtualJoystickTunnelWarnings}" TextWrapping="Wrap" FontSize="{DynamicResource JP.FontSize.12}" Foreground="{DynamicResource JP.WarnTextBrush}"
                                                   IsVisible="{Binding VirtualJoystickTunnelWarnings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding ConfigureVJoyCommand}" Content="{l:T 'Set up vJoy for the table'}" IsVisible="{Binding VirtualJoystickNeedsConfig}"
                                                ToolTip.Tip="{l:T 'Runs vJoyConfig once (Windows asks for administrator rights) so the vJoy devices have the axes, buttons and hats the table needs. It never takes anything away from a device.'}" />
                                        <Button Command="{Binding RestoreHidHideCommand}" Content="{l:T 'Restore HidHide'}" IsVisible="{Binding VirtualJoystickSessionActive}"
                                                ToolTip.Tip="{l:T 'Gives HidHide back the setup it had before JoyPro changed it (for example after JoyPro or the PC crashed).'}" />
                                        <Button Command="{Binding SetUpVJoyMaximumCommand}" Content="{l:T 'Set up vJoy for maximum'}" IsVisible="{Binding !VJoyAtMaximum}"
                                                ToolTip.Tip="{l:T '8 axes, 128 buttons and 4 hats on each vJoy device JoyPro uses (one administrator prompt). Windows must restart before it takes effect; JoyPro never restarts Windows.'}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding VJoyMaximumText}" TextWrapping="Wrap" FontSize="{DynamicResource JP.FontSize.12}" Foreground="{DynamicResource JP.WarnTextBrush}"
                                               IsVisible="{Binding VJoyMaximumText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding VirtualJoystickNeedsText}" TextWrapping="Wrap" FontSize="{DynamicResource JP.FontSize.12}"
                                               IsVisible="{Binding VirtualJoystickNeedsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding VirtualJoystickNeedsDetails}" TextWrapping="Wrap" FontSize="{DynamicResource JP.FontSize.12}" Opacity="0.8"
                                               IsVisible="{Binding VirtualJoystickShowsExpertParts}" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource JP.BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="10" IsVisible="{Binding VirtualJoystickShowsExpertParts}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{l:T 'What this page needs'}" FontSize="{DynamicResource JP.FontSize.16}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Command="{Binding RefreshComponentsCommand}" Content="{l:T 'Check again'}" MinWidth="110"
                                                ToolTip.Tip="{l:T 'Looks at what is installed and running (read-only)'}" />
                                    </Grid>
                                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                               Text="{l:T 'Free drivers, not part of JoyPro: vJoy for games set to vJoy, ViGEmBus for games set to Xbox pad, HidHide to hide your real devices from those games. Install the ones you need with one click: JoyPro downloads the official installer, checks it and runs it (Windows asks once for administrator rights; a driver may need a restart). After installing, press Refresh above.'}" />
                                    <ItemsControl x:Name="VirtualJoystickComponentsList" ItemsSource="{Binding VirtualJoystickComponents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ComponentItem">
                                                <controls:ComponentCard />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource JP.BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{l:T 'Games'}" FontSize="{DynamicResource JP.FontSize.16}" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.8" IsVisible="{Binding VirtualJoystickShowsExpertParts}" Text="{l:T 'Native: the game uses your real devices (as before). vJoy: the game uses one virtual joystick. Xbox pad: the game gets one virtual Xbox 360 controller - for games that only read Xbox controllers (XInput) or only one device; your sticks drive its two sticks, two triggers, D-pad and 14 buttons (what does not fit is listed on the Mapping tab). After switching, export the game again.'}" />
                                    <Border x:Name="VirtualJoystickViGEmNeeded" IsVisible="{Binding VirtualJoystickNeedsViGEm}" BorderBrush="{DynamicResource JP.WarnTextBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding VirtualJoystickViGEmMissingText}" TextWrapping="Wrap" Foreground="{DynamicResource JP.WarnTextBrush}" />
                                            <controls:ComponentCard DataContext="{Binding VirtualJoystickViGEmComponent}" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Spacing="4" IsVisible="{Binding HasSeveralXboxGames}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{l:T 'Xbox pad table for Start and Test:'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <ComboBox x:Name="VirtualJoystickXboxPadGamePicker" ItemsSource="{Binding VirtualJoystickXboxGames}" SelectedItem="{Binding VirtualJoystickXboxPadGame}" MinWidth="240">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:VirtualJoystickGameItem">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource JP.FontSize.12}" Opacity="0.8"
                                                   Text="{l:T 'Several games are on the Xbox pad and each keeps its own pad table. One table is live at a time: with auto start the table of the game that runs; Start and Test take the running game\'s table, else the one picked here.'}" />
                                    </StackPanel>
                                    <ItemsControl x:Name="VirtualJoystickGamesList" ItemsSource="{Binding VirtualJoystickGames}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:VirtualJoystickGameItem">
                                                <Grid ColumnDefinitions="240,210,*" ColumnSpacing="10" Margin="0,3">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" MinWidth="190" VerticalAlignment="Center"
                                                              IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).VirtualJoystickShowsExpertParts, FallbackValue=True}"
                                                              ToolTip.Tip="{l:T 'Native: your real devices. vJoy: one virtual DirectInput joystick. Xbox pad: one virtual Xbox 360 controller (for games that only take XInput or one device; needs ViGEmBus).'}" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RelationsText}" FontSize="{DynamicResource JP.FontSize.12}" Opacity="0.8" />
                                                        <TextBlock Text="{Binding ExesText}" FontSize="{DynamicResource JP.FontSize.12}" Opacity="0.7" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding AutoModeText}" FontSize="{DynamicResource JP.FontSize.12}" TextWrapping="Wrap" IsVisible="{Binding ShowAutoMode}" />
                                                        <TextBlock Text="{Binding XboxNote}" FontSize="{DynamicResource JP.FontSize.12}" Opacity="0.7" TextWrapping="Wrap" IsVisible="{Binding IsXbox}" />
                                                        <TextBlock Text="{Binding InputLimitText}" FontSize="{DynamicResource JP.FontSize.12}" Opacity="0.7" TextWrapping="Wrap"
                                                                   IsVisible="{Binding InputLimitText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        <TextBlock Text="{Binding FunctionsText}" FontSize="{DynamicResource JP.FontSize.12}" Opacity="0.7"
                                                                   IsVisible="{Binding FunctionsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        <TextBlock Text="{Binding LimitWarningsText}" FontSize="{DynamicResource JP.FontSize.12}" TextWrapping="Wrap" Foreground="{DynamicResource JP.WarnTextBrush}" IsVisible="{Binding HasLimitWarnings}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowSuggestion}">
                                                            <TextBlock Text="{Binding SuggestionText}" FontSize="{DynamicResource JP.FontSize.12}" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" Foreground="{DynamicResource JP.WarnTextBrush}" />
                                                            <Button Content="{l:T 'Use it'}" Command="{Binding ApplySuggestionCommand}" Padding="8,2" VerticalAlignment="Center"
                                                                    ToolTip.Tip="{l:T 'Switches this game to the suggested virtual mode. Export the game again afterwards.'}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource JP.BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{l:T 'Options'}" FontSize="{DynamicResource JP.FontSize.16}" FontWeight="SemiBold" />
                                    <CheckBox IsChecked="{Binding VirtualJoystickHideDevices}" Content="{l:T 'Hide the real devices from the games set to Virtual (HidHide)'}" IsVisible="{Binding VirtualJoystickShowsExpertParts}"
                                              ToolTip.Tip="{l:T 'Off: the games see your real devices and the virtual joystick, which can give double input. Recommended: on.'}" />
                                    <CheckBox IsChecked="{Binding VirtualJoystickAutoStart}" Content="{l:T 'Start and stop by itself when a game set to Virtual starts and ends'}"
                                              ToolTip.Tip="{Binding VirtualJoystickAutoStartTip}" IsVisible="{Binding !VirtualJoystickPadOnly}" />
                                    <CheckBox IsChecked="{Binding VirtualJoystickAutoStart}" Content="{l:T 'Start and stop by itself when the game starts and ends'}"
                                              ToolTip.Tip="{Binding VirtualJoystickAutoStartTip}" IsVisible="{Binding VirtualJoystickPadOnly}" />
                                    <!-- Pad-only players: the expert parts of this page (vJoy, HidHide, the modes) on request, kept over a restart. -->
                                    <CheckBox x:Name="VirtualJoystickShowDetailsBox" IsChecked="{Binding VirtualJoystickShowDetails}" Content="{l:T 'Show details for experts (vJoy, HidHide, modes)'}"
                                              IsVisible="{Binding VirtualJoystickPadOnly}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="VirtualJoystickMappingTab" Header="{l:T 'Mapping'}">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="0,8,8,0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding VirtualJoystickSlotsHeader}" FontSize="{DynamicResource JP.FontSize.16}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding UpdateVirtualJoystickMappingCommand}" Content="{l:T 'Update mapping'}"
                                    ToolTip.Tip="{l:T 'Gives new inputs a slot and saves the table in the profile. Inputs that already have a slot never move.'}" />
                        </Grid>
                        <TextBlock Grid.Row="1" TextWrapping="Wrap" Opacity="0.8"
                                   Text="{l:T 'Each physical input the virtual games use gets a fixed place on the virtual joystick. An axis keeps its own axis where it is free (X stays X). The table is saved in your profile, so the game\'s binds stay the same from run to run.'}" />
                        <Border Grid.Row="2" BorderBrush="{DynamicResource JP.BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                            <Grid RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="2*,1.2*,2*,*" ColumnSpacing="8" Margin="4,2">
                                    <TextBlock Text="{l:T 'Physical input'}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{l:T 'Virtual input'}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{l:T 'Used by'}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="{l:T 'State'}" FontWeight="SemiBold" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding VirtualJoystickSlots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:VirtualJoystickSlotItem">
                                                <Grid ColumnDefinitions="2*,1.2*,2*,*" ColumnSpacing="8" Margin="4,2">
                                                    <TextBlock Text="{Binding PhysicalText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Source}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding VirtualText}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding RelationsText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RelationsText}" Opacity="0.85" />
                                                    <TextBlock Grid.Column="3" Text="{Binding StateText}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="VirtualJoystickFunctionsTab" Header="{l:T 'Functions'}">
                    <Grid ColumnDefinitions="340,*" ColumnSpacing="12" Margin="0,8,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                           Text="{l:T 'Virtual functions run inside the virtual joystick, between your devices and what the game gets: remaps, axis bands as buttons, button cycles, toggles, short/long/double press, shift layers, axis tools, turbo, macros and hat helpers. A function can read another function\'s output, and modes give an input a different job per mode, like in Joystick Gremlin.'}" />
                                <Border BorderBrush="{DynamicResource JP.BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{l:T 'Add a function'}" FontSize="{DynamicResource JP.FontSize.16}" FontWeight="SemiBold" />
                                        <ComboBox ItemsSource="{Binding VirtualFunctionGames}" SelectedItem="{Binding VirtualFunctionGame}" PlaceholderText="{l:T 'game in virtual mode'}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:VirtualJoystickGameItem">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ListBox ItemsSource="{Binding VirtualFunctionTypes}" SelectedItem="{Binding NewVirtualFunctionType}" MaxHeight="300">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:VfTypeOption">
                                                    <Grid ColumnDefinitions="30,*" ColumnSpacing="6" ToolTip.Tip="{Binding Example}">
                                                        <TextBlock Text="{Binding Icon}" FontSize="{DynamicResource JP.FontSize.18}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Summary}" FontSize="{DynamicResource JP.FontSize.11}" Opacity="0.75" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Content="{l:T 'Add function'}" Command="{Binding AddVirtualFunctionCommand}" IsEnabled="{Binding CanAddVirtualFunction}" HorizontalAlignment="Stretch"
                                                ToolTip.Tip="{l:T 'Adds the function with free virtual outputs; then choose its inputs in the editor.'}" />
                                    </StackPanel>
                                </Border>

                                <!-- Modes (layers) of the chosen game. -->
                                <Border BorderBrush="{DynamicResource JP.BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding VirtualModesHeader}" FontSize="{DynamicResource JP.FontSize.16}" FontWeight="SemiBold" />
                                        <TextBlock TextWrapping="Wrap" Opacity="0.8" FontSize="{DynamicResource JP.FontSize.12}"
                                                   Text="{l:T 'Modes give your inputs a different job per situation (Combat, Landing ...). A mode switch function changes the mode; a mode gets the functions of the mode it inherits from unless it has its own function on that input.'}" />
                                        <TextBlock Text="{Binding VirtualFunctionCurrentModeText}" FontWeight="SemiBold" Foreground="{DynamicResource JP.OkTextBrush}"
                                                   IsVisible="{Binding VirtualFunctionCurrentModeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <ItemsControl ItemsSource="{Binding VirtualFunctionModes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:VfModeItem">
                                                    <Border BorderBrush="{DynamicResource JP.BorderStrongBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                                <TextBox Text="{Binding EditName}" MinWidth="80" ToolTip.Tip="{l:T 'The mode\'s name; type a new one and press Rename'}" />
                                                                <Button Grid.Column="1" Content="{l:T 'Rename'}" Padding="6,2"
                                                                        Command="{Binding $parent[local:VirtualJoystickView].((vm:MainWindowViewModel)DataContext).RenameVirtualModeCommand}" CommandParameter="{Binding}" />
                                                                <Button Grid.Column="2" Content="×" Padding="8,2" ToolTip.Tip="{l:T 'Removes the mode (asks first)'}"
                                                                        Command="{Binding $parent[local:VirtualJoystickView].((vm:MainWindowViewModel)DataContext).RemoveVirtualModeCommand}" CommandParameter="{Binding}" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                                <TextBlock Text="{l:T 'inherits'}" VerticalAlignment="Center" Opacity="0.8" FontSize="{DynamicResource JP.FontSize.12}" />
                                                                <ComboBox Grid.Column="1" ItemsSource="{Binding ParentOptions}" SelectedItem="{Binding Parent}" HorizontalAlignment="Stretch" />
                                                                <Button Grid.Column="2" Content="{l:T 'At start'}" Padding="6,2" IsVisible="{Binding !IsStart}"
                                                                        ToolTip.Tip="{l:T 'The forwarder starts in this mode'}"
                                                                        Command="{Binding $parent[local:VirtualJoystickView].((vm:MainWindowViewModel)DataContext).SetVirtualStartModeCommand}" CommandParameter="{Binding}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding StartText}" IsVisible="{Binding IsStart}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource JP.FontSize.12}" />
                                                            </Grid>
                                                            <TextBlock Text="{l:T 'running now'}" IsVisible="{Binding IsCurrent}" Foreground="{DynamicResource JP.OkTextBrush}" FontSize="{DynamicResource JP.FontSize.12}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{l:T 'No modes yet: every function works all the time.'}" IsVisible="{Binding !HasVirtualModes}" Opacity="0.7" FontSize="{DynamicResource JP.FontSize.12}" />
                                        <TextBox Text="{Binding NewVirtualModeName}" Watermark="{l:T 'new mode, e.g. Combat'}" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                            <TextBlock Text="{l:T 'inherits'}" VerticalAlignment="Center" Opacity="0.8" FontSize="{DynamicResource JP.FontSize.12}" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding VirtualModeParentOptions}" SelectedItem="{Binding NewVirtualModeParent}" HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="{l:T 'The mode it inherits from'}" />
                                            <Button Grid.Column="2" Content="{l:T 'Add mode'}" Command="{Binding AddVirtualModeCommand}" Padding="10,2" IsEnabled="{Binding VirtualFunctionGame, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Joystick Gremlin profile import. -->
                                <Border BorderBrush="{DynamicResource JP.BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{l:T 'Coming from Joystick Gremlin?'}" FontSize="{DynamicResource JP.FontSize.16}" FontWeight="SemiBold" />
                                        <TextBlock TextWrapping="Wrap" Opacity="0.8" FontSize="{DynamicResource JP.FontSize.12}"
                                                   Text="{l:T 'Import a Gremlin profile (.xml, R13 or R14) into the game chosen above: modes, remaps, curves, macros, merged axes, tempo, chain and toggle containers become virtual functions. You see the report before anything is saved.'}" />
                                        <CheckBox IsChecked="{Binding GremlinReplace}" Content="{l:T 'Replace the game\'s functions and modes'}" />
                                        <Button Content="{l:T 'Import a Gremlin profile...'}" Click="ImportGremlinClicked" HorizontalAlignment="Stretch"
                                                IsEnabled="{Binding VirtualFunctionGame, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding VirtualFunctionsHeader}" FontSize="{DynamicResource JP.FontSize.16}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding VirtualFunctions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:VirtualFunctionListItem">
                                            <Border BorderBrush="{DynamicResource JP.BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6" ToolTip.Tip="{Binding ProblemsText}">
                                                <Grid ColumnDefinitions="30,*" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding Icon}" FontSize="{DynamicResource JP.FontSize.18}" VerticalAlignment="Top" HorizontalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding GameName}" FontSize="{DynamicResource JP.FontSize.11}" Opacity="0.75" />
                                                        <TextBlock Text="{Binding OutputsText}" FontSize="{DynamicResource JP.FontSize.11}" Opacity="0.75" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ModesText}" FontSize="{DynamicResource JP.FontSize.11}" Opacity="0.85" TextWrapping="Wrap"
                                                                   IsVisible="{Binding ModesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        <TextBlock Text="{Binding ChainText}" FontSize="{DynamicResource JP.FontSize.11}" Opacity="0.85" TextWrapping="Wrap"
                                                                   IsVisible="{Binding ChainText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource JP.FontSize.11}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding LiveText}" FontSize="{DynamicResource JP.FontSize.11}" Foreground="{DynamicResource JP.OkTextBrush}"
                                                                   IsVisible="{Binding LiveText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                            <Button Content="{l:T 'Edit'}" Padding="8,2" Command="{Binding $parent[local:VirtualJoystickView].((vm:MainWindowViewModel)DataContext).EditVirtualFunctionCommand}" CommandParameter="{Binding}" />
                                                            <Button Content="{l:T 'On / off'}" Padding="8,2" Command="{Binding $parent[local:VirtualJoystickView].((vm:MainWindowViewModel)DataContext).ToggleVirtualFunctionCommand}" CommandParameter="{Binding}" />
                                                            <Button Content="{l:T 'Remove'}" Padding="8,2" Command="{Binding $parent[local:VirtualJoystickView].((vm:MainWindowViewModel)DataContext).DeleteVirtualFunctionCommand}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                                <ToggleButton Content="{l:T 'Graph of all functions'}" IsChecked="{Binding VirtualFunctionShowGraph}" MinWidth="120"
                                              ToolTip.Tip="{l:T 'Every function of the game as a node: drag an output to an input to chain functions'}" />
                                <ToggleButton Grid.Column="1" Content="{l:T 'Editor'}" IsChecked="{Binding !VirtualFunctionShowGraph}" MinWidth="90" IsEnabled="{Binding HasVirtualFunctionEditor}"
                                              ToolTip.Tip="{l:T 'The function you opened with Edit: inputs, outputs, settings, modes and a preview'}" />
                                <Button Grid.Column="3" Content="{l:T 'Save'}" Command="{Binding SaveVirtualFunctionCommand}" MinWidth="90" IsVisible="{Binding VirtualFunctionShowEditor}"
                                        ToolTip.Tip="{l:T 'Saves the function in the profile. A running virtual joystick takes it after Stop and Start (or Test).'}" />
                                <Button Grid.Column="4" Content="{l:T 'Close'}" Command="{Binding CloseVirtualFunctionEditorCommand}" MinWidth="90" IsVisible="{Binding VirtualFunctionShowEditor}"
                                        ToolTip.Tip="{l:T 'Closes the editor without saving.'}" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding VirtualFunctionMessage}" TextWrapping="Wrap" FontWeight="SemiBold"
                                       IsVisible="{Binding VirtualFunctionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <!-- The Gremlin import's report: nothing is saved until Import. -->
                            <Border Grid.Row="2" BorderBrush="{DynamicResource JP.AccentBrush}" Background="{DynamicResource JP.AccentSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="10" IsVisible="{Binding HasGremlinReport}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{l:T 'Joystick Gremlin profile: what JoyPro makes of it'}" FontSize="{DynamicResource JP.FontSize.16}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding GremlinReportText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{l:T 'Not imported (JoyPro cannot do this):'}" FontWeight="SemiBold" IsVisible="{Binding HasGremlinNotImported}" Foreground="{DynamicResource JP.WarnTextBrush}" />
                                    <ItemsControl ItemsSource="{Binding GremlinNotImported}" IsVisible="{Binding HasGremlinNotImported}" MaxHeight="180">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" FontSize="{DynamicResource JP.FontSize.12}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{l:T 'Imported, but different:'}" FontWeight="SemiBold" IsVisible="{Binding HasGremlinNotes}" />
                                    <ItemsControl ItemsSource="{Binding GremlinNotes}" IsVisible="{Binding HasGremlinNotes}" MaxHeight="140">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" FontSize="{DynamicResource JP.FontSize.12}" Opacity="0.85" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{l:T 'Import'}" Command="{Binding ConfirmGremlinImportCommand}" MinWidth="90" Classes="accent" />
                                        <Button Content="{l:T 'Cancel'}" Command="{Binding CancelGremlinImportCommand}" MinWidth="90" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="6" IsVisible="{Binding VirtualFunctionShowGraph}">
                                <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="{DynamicResource JP.FontSize.12}"
                                           Text="{l:T 'Drag from an output dot (right edge) to an input dot (left edge) of another function to chain them. Click a wire, then its × (or Delete) to disconnect. × on a function removes it; double-click a function to edit its devices, outputs and settings.'}" />
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <controls:VirtualFunctionGraphView Functions="{Binding VirtualFunctionGraph}" Host="{Binding}" MinHeight="260" />
                                </ScrollViewer>
                            </Grid>
                            <TextBlock Grid.Row="3" IsVisible="{Binding VirtualFunctionShowHint}" TextWrapping="Wrap" Opacity="0.7"
                                       Text="{l:T 'Pick a function on the left (Edit), or add one. The editor shows the inputs, the virtual outputs, the settings and a preview: \'Try it\' runs the function here; with Test or Start the editor shows your real devices live.'}" />
                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" IsVisible="{Binding VirtualFunctionShowEditor}">
                                <views:VirtualFunctionEditorView DataContext="{Binding VirtualFunctionEditor}" Margin="0,0,8,0" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="VirtualJoystickLiveTestTab" Header="{l:T 'Live test'}">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8" Margin="0,8,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <CheckBox IsChecked="{Binding VirtualJoystickLiveView}" Content="{l:T 'Show the virtual joystick live'}" IsVisible="{Binding !VirtualJoystickPadOnly}" />
                            <CheckBox IsChecked="{Binding VirtualJoystickLiveView}" Content="{l:T 'Show the pretend controller live'}" IsVisible="{Binding VirtualJoystickPadOnly}" />
                            <TextBlock Text="{Binding VirtualJoystickStatsText}" VerticalAlignment="Center" Opacity="0.8" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" TextWrapping="Wrap" Opacity="0.8"
                                   Text="{l:T 'Press Test (nothing is changed) or Start, then move your sticks and press buttons: the bars and buttons below are what the game gets from the virtual joystick.'}" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding VirtualJoystickLive}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:VirtualJoystickLiveDevice">
                                        <Border BorderBrush="{DynamicResource JP.BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource JP.FontSize.16}" FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{Binding Axes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:VirtualJoystickAxisItem">
                                                            <Grid ColumnDefinitions="50,*,60,*" ColumnSpacing="8" Margin="0,1">
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Value}" Height="12" />
                                                                <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="3" Text="{Binding Mapping}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="{DynamicResource JP.FontSize.12}" IsVisible="{Binding HasMapping}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Controls}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:VirtualJoystickPadControlItem">
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource JP.FontSize.12}" Classes.pressed="{Binding Pressed}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                    <ItemsControl.Styles>
                                                        <Style Selector="TextBlock">
                                                            <Setter Property="Opacity" Value="0.7" />
                                                        </Style>
                                                        <Style Selector="TextBlock.pressed">
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource JP.AccentBrush}" />
                                                        </Style>
                                                    </ItemsControl.Styles>
                                                </ItemsControl>
                                                <TextBlock Text="{l:T 'Buttons pressed: {0}', Arg0={Binding ButtonsText}}" TextWrapping="Wrap" />
                                                <TextBlock Text="{l:T 'Hats: {0}', Arg0={Binding HatsText}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Expander Grid.Row="3" Header="{l:T 'Forwarder log'}">
                            <ListBox ItemsSource="{Binding VirtualJoystickLog}" MaxHeight="180" FontFamily="{DynamicResource JP.MonoFont}" FontSize="{DynamicResource JP.FontSize.12}" />
                        </Expander>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
