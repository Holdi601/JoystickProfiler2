
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JoyPro.Gui.ViewModels"
        xmlns:models="using:JoyPro.Gui.Models"
        xmlns:controls="using:JoyPro.Gui.Views.Controls"
        xmlns:views="using:JoyPro.Gui.Views"
        xmlns:dr="using:JoyPro.DeviceReference"
        xmlns:l="using:JoyPro.Gui.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="RootWindow"
        x:Class="JoyPro.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{l:T 'JoyPro2 Commander'}"
        Icon="/Assets/joypro2_gui.ico"
        Width="1500"
        Height="950"
        MinWidth="1200"
        MinHeight="760"
        Background="{DynamicResource JP.PageBackgroundBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBox#EngineOutputTextBox">
            <Setter Property="Background" Value="#020617" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="CaretBrush" Value="#E2E8F0" />
            <Setter Property="SelectionBrush" Value="#1D4ED8" />
            <Setter Property="SelectionForegroundBrush" Value="#F8FAFC" />
        </Style>
        <Style Selector="TextBox#EngineOutputTextBox:focus">
            <Setter Property="Background" Value="#020617" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#0EA5E9" />
        </Style>
        <Style Selector="TextBox#EngineOutputTextBox:pointerover">
            <Setter Property="Background" Value="#020617" />
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>
        <Style Selector="TextBox#EngineOutputTextBox /template/ ScrollViewer#PART_ScrollViewer">
            <Setter Property="Background" Value="#020617" />
        </Style>
        <!-- The banner: full size on a tall window; on a low one (1280x800) a slim strip, so the page gets the room. -->
        <Style Selector="Border#BrandBanner">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="64" />
        </Style>
        <Style Selector="Viewbox#BrandViewbox">
            <Setter Property="MaxHeight" Value="84" />
        </Style>
        <ContainerQuery Name="RootLayout" Query="max-height:880">
            <Style Selector="Border#BrandBanner">
                <Setter Property="Padding" Value="12,2" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
            <Style Selector="Viewbox#BrandViewbox">
                <Setter Property="MaxHeight" Value="40" />
            </Style>
            <!-- At that size the tagline would be too small to read. -->
            <Style Selector="TextBlock#BrandTagline">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>
    </Window.Styles>

    <Grid x:Name="RootLayoutGrid" RowDefinitions="Auto,*,6,Auto,Auto" RowSpacing="10" Margin="12"
          Container.Name="RootLayout" Container.Sizing="Height">

        <Border Grid.Row="0" CornerRadius="12" Padding="0,0,0,4">
            <StackPanel Spacing="8">
                <!-- Banner: the JoyPro mark (Styles/Branding.axaml) and wordmark; it shrinks with the window (Viewbox, never grows). -->
                <Border x:Name="BrandBanner" Background="{StaticResource Brand.BannerBrush}" CornerRadius="12" BorderBrush="{StaticResource Brand.AccentBrush}"
                        BorderThickness="0,0,0,2">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Viewbox x:Name="BrandViewbox" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Image Source="{StaticResource Brand.Logo}" Width="80" Height="80" />
                                <StackPanel VerticalAlignment="Center" Spacing="8">
                                    <!-- The title "JOYPRO 2" drawn as vector paths in the style of the mark (Brand.Wordmark). -->
                                    <Image x:Name="BrandWordmark" Source="{StaticResource Brand.Wordmark}" Height="40" HorizontalAlignment="Left"
                                           ToolTip.Tip="{l:T 'JoyPro 2'}" />
                                    <TextBlock x:Name="BrandTagline" Text="{l:T 'One profile for all your devices, in every flight and space game'}" FontSize="14" Foreground="#CBD5E1" />
                                </StackPanel>
                            </StackPanel>
                        </Viewbox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Command="{Binding SetThemeLightCommand}" Classes="icon" Tag="{StaticResource Icon.Sun}" Content="{l:T 'Light'}" ToolTip.Tip="{l:T 'Light colors'}" />
                            <Button Command="{Binding SetThemeDarkCommand}" Classes="icon" Tag="{StaticResource Icon.Moon}" Content="{l:T 'Dark'}" ToolTip.Tip="{l:T 'Dark colors'}" />
                            <Button Command="{Binding SetThemeSystemCommand}" Classes="icon" Tag="{StaticResource Icon.Contrast}" Content="{l:T 'System'}" ToolTip.Tip="{l:T 'Follow the Windows setting'}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The open profile: its name in big letters, the full path below (and as a tooltip), the profile actions
                     on the right; the rarely used ones in "More", the expert options in a panel that opens below. -->
                <Border Classes="surface" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Panel>
                            <Border Classes="iconBadge ok" IsVisible="{Binding HasProfile}">
                                <PathIcon Data="{StaticResource Icon.File}" />
                            </Border>
                            <Border Classes="iconBadge warn" IsVisible="{Binding !HasProfile}">
                                <PathIcon Data="{StaticResource Icon.Info}" />
                            </Border>
                        </Panel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{Binding ProfileDisplayHint}">
                            <TextBlock Text="{Binding ProfileDisplayName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ProfileDisplayHint}" Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="OpenProfileClicked" Classes="icon" Tag="{StaticResource Icon.FolderOpen}" Content="{l:T 'Open profile...'}"
                                    ToolTip.Tip="{l:T 'Open a JoyPro profile (.pr0file)'}" />
                            <Button Click="NewProfileClicked" Classes="icon" Tag="{StaticResource Icon.Plus}" Content="{l:T 'New profile'}"
                                    ToolTip.Tip="{l:T 'Start an empty profile (it gets a name in Documents\\JoyPro2\\profiles; More &gt; Rename... gives it yours). Tip: importing from a game (Start page) makes one for you.'}" />
                            <!-- Autosave (docs/profile-history.md): no Save button, the state instead. Ctrl+S still saves at once. -->
                            <Border Classes="chip ok" IsVisible="{Binding IsProfileSaved}" ToolTip.Tip="{Binding SaveStateTip}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SaveStateText}" />
                            </Border>
                            <Border Classes="chip" IsVisible="{Binding IsProfileSaving}" ToolTip.Tip="{Binding SaveStateTip}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SaveStateText}" />
                            </Border>
                            <Border Classes="chip warn" IsVisible="{Binding HasProfileSaveError}" ToolTip.Tip="{Binding SaveStateTip}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SaveStateText}" />
                            </Border>
                            <Button Command="{Binding UndoLastChangeCommand}" Classes="icon" Tag="{StaticResource Icon.Undo}" Content="{l:T 'Undo'}"
                                    IsEnabled="{Binding CanUndo}" ToolTip.Tip="{l:T '{}{0} (Ctrl+Z)', Arg0={Binding UndoLabel}}" />
                            <Button Command="{Binding RedoLastChangeCommand}" Classes="icon iconOnly" Tag="{StaticResource Icon.Redo}"
                                    IsEnabled="{Binding CanRedo}" ToolTip.Tip="{l:T '{}{0} (Ctrl+Y)', Arg0={Binding RedoLabel}}" />
                            <ToggleButton Classes="icon" Tag="{StaticResource Icon.History}" Content="{l:T 'History'}" IsChecked="{Binding IsHistoryPanelOpen}"
                                          IsEnabled="{Binding HasProfile}" ToolTip.Tip="{l:T 'Every version of this profile: what changed, compare, restore, keep'}" />
                            <Button Classes="icon" Tag="{StaticResource Icon.More}" Content="{l:T 'More'}" ToolTip.Tip="{l:T 'More profile actions'}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="{l:T 'Open last profile'}" Command="{Binding OpenLastProfileCommand}" IsEnabled="{Binding CanOpenLastProfile}"
                                                  ToolTip.Tip="{Binding LastProfilePath}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.History}" Width="14" Height="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{l:T 'Save as...'}" Click="SaveProfileAsClicked" IsEnabled="{Binding HasProfile}"
                                                  ToolTip.Tip="{l:T 'Save a copy under another name; JoyPro works on the copy from then on'}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Save}" Width="14" Height="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{l:T 'Rename...'}" Click="RenameProfileClicked" IsEnabled="{Binding HasProfile}"
                                                  ToolTip.Tip="{l:T 'Give the profile file another name (its history goes along)'}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Pencil}" Width="14" Height="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{l:T 'Add another profile...'}" Click="MergeProfileClicked"
                                                  ToolTip.Tip="{l:T 'Merge another .pr0file into this one (asks first; a copy of your profile is kept). What wins: Profile options.'}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Merge}" Width="14" Height="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{l:T 'Reload'}" Command="{Binding RefreshAllCommand}" ToolTip.Tip="{l:T 'Read the profile, devices and games again'}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{l:T 'Close profile'}" Command="{Binding ClearWorkspaceCommand}" ToolTip.Tip="{l:T 'Close the profile in JoyPro (the file stays)'}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Close}" Width="14" Height="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{l:T 'Check for updates'}" Command="{Binding CheckForUpdatesCommand}" ToolTip.Tip="{l:T 'Asks GitHub for a newer JoyPro; it is offered with what changed'}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Sync}" Width="14" Height="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{l:T 'About JoyPro'}" Command="{Binding OpenAboutCommand}" ToolTip.Tip="{l:T 'Version, build, license and updates (Settings)'}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Info}" Width="14" Height="14" /></MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <ToggleButton Classes="icon" Tag="{StaticResource Icon.Cog}" Content="{l:T 'Options'}" IsChecked="{Binding ShowProfileOptions}"
                                          ToolTip.Tip="{l:T 'Profile and engine options (for experts)'}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="surface tight" IsVisible="{Binding ShowProfileOptions}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Cog}" /></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="h2" Text="{l:T 'Profile and engine options'}" />
                                <TextBlock Classes="caption" Text="{l:T 'For experts: the paths JoyPro uses and how it repairs a profile when it loads. Normal use needs none of this.'}" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="icon ghost small" Tag="{StaticResource Icon.Close}" Content="{l:T 'Close'}" Command="{Binding ToggleProfileOptionsCommand}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Classes="label" Text="{l:T 'When you add another profile and both have the same relation'}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MergeModeOptions}" SelectedItem="{Binding SelectedMergeModeOption}" MinWidth="220"
                                      ToolTip.Tip="{l:T 'When both profiles have the same relation'}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChoiceOption">
                                        <TextBlock Text="{Binding Title}" ToolTip.Tip="{Binding Description}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                            <TextBlock Classes="label" Text="{l:T 'Engine'}" />
                            <TextBox Grid.Column="1" Text="{Binding EnginePath}" Watermark="{l:T 'Path to engine.exe (empty = the one next to JoyPro)'}" />
                            <TextBlock Grid.Column="2" Classes="label" Text="{l:T 'Profile file'}" />
                            <TextBox Grid.Column="3" Text="{Binding ProfilePath}" Watermark="Path to .pr0file" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Classes="label" Text="{l:T 'Merge profile file'}" />
                            <TextBox Grid.Column="1" Text="{Binding MergeRightProfilePath}" Watermark="{l:T 'Profile to add (Add another profile... picks it)'}" />
                            <Button Grid.Column="2" Command="{Binding MergeProfileCommand}" Content="{l:T 'Merge'}" />
                            <Button Grid.Column="3" Command="{Binding SaveLastProfileCommand}" Content="{l:T 'Save as last profile'}" ToolTip.Tip="engine profile save-last" />
                        </Grid>
                        <WrapPanel ItemWidth="190" ItemHeight="30">
                            <CheckBox Content="{l:T 'Auto Profile On Import'}" IsChecked="{Binding AutoCreateProfileOnImport}" />
                            <CheckBox Content="{l:T 'Load Corrections'}" IsChecked="{Binding UseLoadCorrections}" />
                            <CheckBox Content="{l:T 'Auto Add DB Items'}" IsChecked="{Binding AutoAddDbItems}" IsEnabled="{Binding UseLoadCorrections}" />
                            <CheckBox Content="{l:T 'Remap Missing Devices'}" IsChecked="{Binding RemapMissingDevices}" IsEnabled="{Binding UseLoadCorrections}" />
                            <CheckBox Content="{l:T 'Status Updates'}" IsChecked="{Binding IncludeStatusUpdates}" />
                            <CheckBox Content="{l:T 'Benchmark'}" IsChecked="{Binding IncludeBenchmark}" />
                        </WrapPanel>
                        <Grid ColumnDefinitions="Auto,160,Auto,160,Auto,*" ColumnSpacing="8" IsEnabled="{Binding UseLoadCorrections}">
                            <TextBlock Classes="label" Text="{l:T 'Correction Mode'}" />
                            <ComboBox Grid.Column="1" SelectedItem="{Binding CorrectionMode}">
                                <x:String>strict</x:String>
                                <x:String>balanced</x:String>
                                <x:String>aggressive</x:String>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Classes="label" Text="{l:T 'Auto Threshold'}" />
                            <TextBox Grid.Column="3" Text="{Binding CorrectionAutoThreshold}" Watermark="0..200" />
                            <TextBlock Grid.Column="4" Classes="label" Text="{l:T 'Correction Report'}" />
                            <TextBox Grid.Column="5" Text="{Binding CorrectionReportPath}" Watermark="{l:T 'Optional report path'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- History (docs/profile-history.md): every save of the profile is a version. Left the versions (newest
                     first), right what a version changed or what differs from now. -->
                <Border Classes="surface tight" IsVisible="{Binding IsHistoryPanelOpen}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                            <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.History}" /></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="h2" Text="{l:T 'History'}" />
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="{l:T 'Every change is saved and becomes a version. Restore one (that is a change too, so Undo brings you back), see what it changed, compare it with now, or keep it for good. Old versions are thinned out: all of the last day, then one per hour for 7 days, one per day for 60 days, one per week after that.'}" />
                                <TextBlock Classes="caption" Text="{Binding HistoryUsageText}" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="icon small" Tag="{StaticResource Icon.Delete}" Content="{l:T 'Clean up'}" Command="{Binding CleanUpHistoryCommand}"
                                    ToolTip.Tip="{l:T 'Thin out the old versions of all profiles now (kept versions stay). JoyPro also does it by itself in the background.'}" />
                            <Button Grid.Column="3" Classes="icon ghost small" Tag="{StaticResource Icon.Close}" Content="{l:T 'Close'}" Command="{Binding ToggleHistoryPanelCommand}" />
                        </Grid>
                        <TextBlock Classes="caption" Text="{Binding HistoryEmptyText}" IsVisible="{Binding !HasHistoryVersions}" />
                        <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12" IsVisible="{Binding HasHistoryVersions}">
                            <ListBox ItemsSource="{Binding HistoryVersions}" MaxHeight="330">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:HistoryVersionItem">
                                        <Grid ColumnDefinitions="118,*,Auto" ColumnSpacing="8">
                                            <TextBlock Classes="caption" Text="{Binding WhenText}" ToolTip.Tip="{Binding WhenTip}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420" ToolTip.Tip="{Binding Title}" />
                                                    <Border Classes="chip ok" IsVisible="{Binding IsCurrent}" ToolTip.Tip="{l:T 'The profile is at this version now'}"><TextBlock Text="{l:T 'now'}" /></Border>
                                                    <Border Classes="chip" IsVisible="{Binding Keep}" ToolTip.Tip="{l:T 'Never cleaned up'}"><TextBlock Text="{l:T 'kept'}" /></Border>
                                                </StackPanel>
                                                <TextBlock Classes="caption" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Summary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Classes="small ghost" Content="{l:T 'Details'}" Command="{Binding #RootWindow.DataContext.ShowHistoryVersionChangesCommand}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="{l:T 'What this version changed'}" />
                                                <Button Classes="small ghost" Content="{l:T 'Compare'}" Command="{Binding #RootWindow.DataContext.CompareHistoryVersionCommand}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="{l:T 'What is different now'}" />
                                                <ToggleButton Classes="small" Content="{l:T 'Keep'}" IsChecked="{Binding Keep, Mode=OneWay}" Command="{Binding #RootWindow.DataContext.ToggleHistoryKeepCommand}" CommandParameter="{Binding}"
                                                              ToolTip.Tip="{Binding KeepTip}" />
                                                <Button Classes="small" Content="{l:T 'Restore'}" IsEnabled="{Binding CanRestore}" Command="{Binding #RootWindow.DataContext.RestoreHistoryVersionCommand}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="{l:T 'Make the profile as it was then (Undo brings you back)'}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource JP.BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <Panel>
                                    <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !HasHistoryCompare}"
                                               Text="{l:T 'Details shows what a version changed; Compare shows what is different between that version and the profile now.'}" />
                                    <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasHistoryCompare}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding HistoryCompareTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <Button Grid.Column="1" Classes="icon ghost small iconOnly" Tag="{StaticResource Icon.Close}" Command="{Binding CloseHistoryCompareCommand}" ToolTip.Tip="{l:T 'Close'}" />
                                        </Grid>
                                        <ScrollViewer Grid.Row="1" MaxHeight="290" Margin="0,6,0,0">
                                            <ItemsControl ItemsSource="{Binding HistoryCompareLines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Panel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Replace a device (MainWindowViewModel.DeviceReplace.cs): what moved after the profile opened (devices
                     with a new ID) or after Replace device, with Undo. -->
                <Border Classes="callout" IsVisible="{Binding HasDeviceRemapNotice}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <PathIcon Data="{StaticResource Icon.Swap}" Width="18" Height="18" Classes="info" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding DeviceRemapNoticeTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding DeviceRemapNoticeItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DeviceRemapNoticeItem">
                                        <TextBlock Text="{Binding Text}" ToolTip.Tip="{Binding Tip}" TextWrapping="Wrap" FontSize="12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding DeviceRemapSkippedText}" IsVisible="{Binding HasDeviceRemapSkipped}" TextWrapping="Wrap" FontSize="12" Foreground="#D97706" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <Button Content="{l:T 'Replace device...'}" Classes="small" Command="{Binding OpenReplaceDeviceCommand}" IsEnabled="{Binding CanRun}"
                                    ToolTip.Tip="{l:T 'Move the binds of a device yourself, input by input (a new stick, a device that was not moved)'}" />
                            <Button Content="{l:T 'Undo'}" Classes="small" Command="{Binding UndoDeviceRemapCommand}" IsVisible="{Binding CanUndoDeviceRemap}" IsEnabled="{Binding CanRun}"
                                    ToolTip.Tip="{l:T 'Put the binds back on the old devices'}" />
                            <Button Content="{l:T 'OK'}" Classes="small" Command="{Binding DismissDeviceRemapNoticeCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- The pages: clipped, so a long page never draws over the output panel or the bottom bar. -->
        <Grid Grid.Row="1" ClipToBounds="True">

                <!-- Start: the dashboard. Profile counts, what to do next, your games (import wizard), connected devices,
                     recent activity per game and the game watcher (MainWindowViewModel.Design.cs, GameHub.cs). -->
                <Border IsVisible="{Binding IsStartStage}" Padding="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Margin="0,0,12,8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Classes="iconBadge large"><PathIcon Data="{StaticResource Icon.Home}" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="pageTitle" Text="{l:T 'Start'}" />
                                    <TextBlock Classes="pageSubtitle" Text="{l:T 'Your profile at a glance: what is set up, what to do next, and your games. Import takes the binds you made in a game into JoyPro; Export writes them back.'}" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="icon" Tag="{StaticResource Icon.Refresh}" Content="{l:T 'Refresh'}" Command="{Binding RefreshDashboardCommand}"
                                        IsEnabled="{Binding CanRun}" ToolTip.Tip="{l:T 'Look at your devices and the recent activity again'}" />
                            </Grid>

                            <!-- Notices -->
                            <Border Classes="callout error" IsVisible="{Binding HasMissingRequirements}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource Icon.Error}" Width="18" Height="18" Classes="error" />
                                        <TextBlock Classes="h3" Text="{l:T 'Components missing'}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding RequirementsStatus}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding RequirementItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}" Classes="mono" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding InstallMissingRequirementsCommand}" Content="{l:T 'Install Missing'}" Classes="accent" IsVisible="{Binding HasInstallableRequirements}" />
                                        <Button Command="{Binding CheckRequirementsCommand}" Content="{l:T 'Check Again'}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="callout warn" IsVisible="{Binding HasCrashReports}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <PathIcon Data="{StaticResource Icon.Bug}" Width="18" Height="18" Classes="warn" />
                                    <TextBlock Grid.Column="1" Text="{Binding CrashReportNotice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding ReportLastCrashCommand}" Content="{l:T 'Report It...'}" />
                                        <Button Command="{Binding DismissCrashReportsCommand}" Content="{l:T 'Dismiss'}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Classes="callout" IsVisible="{Binding UpdateAvailable}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <PathIcon Data="{StaticResource Icon.Import}" Width="18" Height="18" Classes="info" />
                                    <TextBlock Grid.Column="1" Text="{Binding UpdateStatus}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding InstallUpdateCommand}" Content="{l:T 'Install Update'}" Classes="accent" />
                                        <Button Command="{Binding OpenReleasePageCommand}" Content="{l:T 'What\'s New'}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Classes="callout warn" IsVisible="{Binding HasDbUpdates}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource Icon.Database}" Width="18" Height="18" Classes="warn" />
                                        <TextBlock Classes="h3" Text="{l:T 'Command lists to build or update (JoyPro reads them from your installed games)'}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding DbUpdateItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DbUpdateItem">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Content="{Binding RefreshLabel}" Classes="small" IsVisible="{Binding CanRefresh}"
                                                            Command="{Binding #RootWindow.DataContext.RefreshDbUpdateCommand}" CommandParameter="{Binding}"
                                                            ToolTip.Tip="{l:T 'Reads the game\'s commands from its own files into JoyPro\'s list (DCS is read without starting the game)'}" />
                                                    <Button Grid.Column="2" Content="{l:T 'Keep DB'}" Classes="small" IsVisible="{Binding CanKeep}"
                                                            Command="{Binding #RootWindow.DataContext.AcceptDbUpdateCommand}" CommandParameter="{Binding}"
                                                            ToolTip.Tip="{l:T 'This game\'s current build counts as known; its DB stays as it is'}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding BuildMissingCommandListsCommand}" Content="{l:T 'Build All Missing Lists'}" Classes="small accent" IsEnabled="{Binding CanRun}" IsVisible="{Binding HasMissingCommandLists}"
                                                ToolTip.Tip="{l:T 'Builds the command list of every installed game that has none yet, from the game\'s own files'}" />
                                        <Button Command="{Binding CheckDbUpdatesCommand}" Content="{l:T 'Check Again'}" Classes="small" IsEnabled="{Binding CanRun}" />
                                        <Button Command="{Binding AcceptDbUpdatesCommand}" Content="{l:T 'Keep All DBs, Hide Notice'}" Classes="small" IsEnabled="{Binding CanRun}" ToolTip.Tip="{l:T 'Marks the current game builds as known without refreshing the DBs'}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- What the running command does now, how far it is, time, details, Cancel (BusyProgressPanel);
                                 from one second on or with the first progress line, so short calls do not make the page jump. -->
                            <Border x:Name="StartBusyArea" Classes="callout" IsVisible="{Binding BusyProgress.ShowPanel}">
                                <controls:BusyProgressPanel DataContext="{Binding BusyProgress}" />
                            </Border>

                            <!-- Profile at a glance -->
                            <WrapPanel ItemSpacing="12" LineSpacing="12">
                                <Border Classes="stat" ToolTip.Tip="{l:T 'Relations: game commands that share one button or axis of your devices'}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Link}" /></Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="statValue" Text="{Binding ProfileRelationCount}" />
                                            <TextBlock Classes="statLabel" Text="{l:T 'relations, {0} axes', Arg0={Binding ProfileAxisCount}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="stat" MinWidth="200">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Classes="iconBadge ok"><PathIcon Data="{StaticResource Icon.Gamepad}" /></Border>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="statValue" Text="{Binding ProfileBoundCount}" />
                                            <TextBlock Classes="statLabel" Text="{Binding ProfileBoundText}" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProfileBoundPercent}" Height="4" MinWidth="120" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="stat">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Keycap}" /></Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="statValue" Text="{Binding ModifierCount}" />
                                            <TextBlock Classes="statLabel" Text="{l:T 'modifiers'}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="stat">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Joystick}" /></Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="statValue" Text="{Binding ConnectedDeviceCount}" />
                                            <TextBlock Classes="statLabel" Text="{l:T 'devices connected'}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="stat">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Airplane}" /></Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="statValue" Text="{Binding InstalledGameCount}" />
                                            <TextBlock Classes="statLabel" Text="{l:T 'games installed'}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </WrapPanel>

                            <Grid ColumnDefinitions="*,16,360">
                                <StackPanel Spacing="16">
                                    <!-- Next steps -->
                                    <Border Classes="surface" IsVisible="{Binding HasNextSteps}">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Lightbulb}" /></Border>
                                                <TextBlock Classes="h2" Text="{l:T 'Next steps'}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding NextSteps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:NextStepItem">
                                                        <Border Classes="raised" Margin="0,0,0,8" Padding="12,10">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                                <Border Classes="iconBadge"><PathIcon Data="{Binding Icon}" /></Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                    <TextBlock Classes="h3" Text="{Binding Title}" TextWrapping="Wrap" />
                                                                    <TextBlock Classes="caption" Text="{Binding Detail}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Content="{Binding ActionLabel}" Command="{Binding Command}" CommandParameter="{Binding CommandParameter}"
                                                                        Classes.accent="{Binding IsPrimary}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Your games + the import wizard (MainWindowViewModel.GameHub.cs): 1 pick a game, 2 how, 3 done. -->
                                    <Border Classes="surface">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                                <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Gamepad}" /></Border>
                                                <TextBlock Grid.Column="1" Classes="h2" Text="{l:T 'Your games'}" />
                                                <!-- How far JoyPro supports each game (MainWindowViewModel.SupportedGames.cs, docs/games/support.md): opens in the browser. -->
                                                <Button Grid.Column="5" Classes="icon small" Tag="{StaticResource Icon.Info}" Content="{l:T 'Supported games'}" Command="{Binding OpenSupportedGamesCommand}"
                                                        IsEnabled="{Binding CanRun}" ToolTip.Tip="{l:T 'Every game JoyPro knows, what it can do for each (import, export, curves, settings, virtual joystick ...) and how it was tested, in your browser'}" />
                                                <!-- Setup wizard (MainWindowViewModel.SetupWizard.cs, docs/setup-wizard.md): relations and binds for the watched games. -->
                                                <Button Grid.Column="4" Classes="icon small accent" Tag="{StaticResource Icon.Wand}" Content="{l:T 'Set up my devices automatically...'}" Command="{Binding OpenSetupWizardCommand}"
                                                        IsEnabled="{Binding CanRun}" ToolTip.Tip="{l:T 'Binds the most important functions of the games you watch to your devices: roles, priorities, modifiers, realism; you review before anything changes'}" />
                                                <!-- Watch all / none (MainWindowViewModel.GameSync.cs WatchAllGames): mixed when only some games are ticked. -->
                                                <CheckBox Grid.Column="2" Name="WatchAllGamesBox" Content="{l:T 'Watch all'}" IsChecked="{Binding WatchAllGames}" VerticalAlignment="Center"
                                                          IsVisible="{Binding HasWatchableGameCards}"
                                                          ToolTip.Tip="{l:T 'Watch every installed game for changes (tick) or none of them (untick). Each card has its own box.'}" />
                                                <Button Grid.Column="3" Classes="icon small" Tag="{StaticResource Icon.Refresh}" Content="{l:T 'Look again'}" Command="{Binding RefreshGameCardsCommand}"
                                                        IsEnabled="{Binding CanRun}" ToolTip.Tip="{l:T 'Find your games again (Steam, launchers, your folders)'}" />
                                            </Grid>

                                            <!-- Steps of the import wizard -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Classes="step" Classes.done="{Binding !IsImportWizardPickStep}"><TextBlock Text="1" /></Border>
                                                <TextBlock Text="{l:T 'Pick a game'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <PathIcon Data="{StaticResource Icon.ArrowRight}" Width="14" Height="14" Opacity="0.5" />
                                                <Border Classes="step" Classes.done="{Binding IsImportWizardDoneStep}"><TextBlock Text="2" /></Border>
                                                <TextBlock Text="{l:T 'Choose how'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <PathIcon Data="{StaticResource Icon.ArrowRight}" Width="14" Height="14" Opacity="0.5" />
                                                <Border Classes="step" Classes.done="{Binding IsImportWizardDoneStep}"><TextBlock Text="3" /></Border>
                                                <TextBlock Text="{l:T 'Done'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <!-- Step 3: done. The result stays on top of the game cards (they never go away after an import), until closed. -->
                                            <Border Classes="callout" Classes.ok="{Binding !ImportWizardFailed}" Classes.error="{Binding ImportWizardFailed}" IsVisible="{Binding IsImportWizardDoneStep}">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <Panel>
                                                            <PathIcon Data="{StaticResource Icon.Ok}" Width="32" Height="32" Classes="ok" IsVisible="{Binding !ImportWizardFailed}" />
                                                            <PathIcon Data="{StaticResource Icon.Error}" Width="32" Height="32" Classes="error" IsVisible="{Binding ImportWizardFailed}" />
                                                        </Panel>
                                                        <TextBlock Grid.Column="1" Text="{Binding ImportWizardResult}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                                        <Button Classes="icon accent" Tag="{StaticResource Icon.Link}" Content="{l:T 'See my relations'}" Command="{Binding FinishImportWizardCommand}" IsVisible="{Binding !ImportWizardFailed}" />
                                                        <Button Classes="icon" Tag="{StaticResource Icon.ArrowLeft}" Content="{l:T 'Try again'}" Command="{Binding ImportWizardBackCommand}" IsVisible="{Binding ImportWizardFailed}" />
                                                        <Button Classes="icon" Tag="{StaticResource Icon.Close}" Content="{l:T 'Close'}" Command="{Binding RestartImportWizardCommand}"
                                                                ToolTip.Tip="{l:T 'Hide this result; your games stay below'}" />
                                                        <Button Classes="icon" Tag="{StaticResource Icon.Export}" Content="{l:T 'Export to games'}" Command="{Binding GoExportCommand}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Step 1: the game cards (also after an import, under its result) -->
                                            <StackPanel Spacing="8" IsVisible="{Binding ShowGameCardList}">
                                                <TextBlock Classes="caption" Text="{l:T 'Import takes the binds you already made in a game into JoyPro (a profile is made for you if none is open). Export writes them back. Update reads a game\'s new commands after a game update. Undo export puts the game\'s files back from before the last export. Watch for changes: JoyPro notices when you change binds in a ticked game and offers to take them over.'}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !WatchGameConfigs}">
                                                    <PathIcon Data="{StaticResource Icon.Warning}" Width="13" Height="13" Classes="warn" />
                                                    <TextBlock Text="{Binding GameWatchHint}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Classes="emptyState" IsVisible="{Binding !HasGameCards}">
                                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                        <PathIcon Classes="emptyIcon" Data="{StaticResource Icon.Search}" />
                                                        <TextBlock Classes="h3" HorizontalAlignment="Center" Text="{l:T 'No games yet'}" />
                                                        <TextBlock Classes="caption" TextAlignment="Center" Text="{l:T 'No games yet? JoyPro is still looking, or press Look again. A game in another folder: Settings &gt; Games.'}" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- VTOL VR: install the BYOJoystick mod from the Steam Workshop (consent first; JoyPro ships nothing of it) -->
                                                <Border Classes="raised" Padding="12" IsVisible="{Binding ByojPanelVisible}">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Classes="h3" Text="{l:T 'BYOJoystick for VTOL VR'}" />
                                                            <Button Grid.Column="1" Classes="ghost small" Content="{l:T 'Close'}" Command="{Binding CloseByojCommand}" />
                                                        </Grid>
                                                        <TextBlock TextWrapping="Wrap" Text="{l:T 'VTOL VR binds only rudder and toe brakes itself. The free BYOJoystick mod by sicsix lets you fly it with your HOTAS (stick, throttle, every switch, per aircraft and seat), and JoyPro then writes its binding files. It runs with the free VTOL VR Mod Loader.'}" />
                                                        <TextBlock TextWrapping="Wrap" Text="{l:T 'Official source: {0} (Steam Workshop; source code: github.com/sicsix/BYOJoystick)', Arg0={Binding ByojSource}}" />
                                                        <TextBlock TextWrapping="Wrap" Text="{l:T 'Size: {0}', Arg0={Binding ByojSize}}" IsVisible="{Binding ByojSize, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        <Expander Header="{l:T 'License'}">
                                                            <TextBlock TextWrapping="Wrap" Text="{Binding ByojLicense}" />
                                                        </Expander>
                                                        <TextBlock TextWrapping="Wrap" Classes="caption" Text="{l:T 'How: JoyPro backs up your BYOJ files, then opens Steam: install the Mod Loader if asked, then press Subscribe on the BYO Joystick page. Steam downloads the mod, checks it and puts it where the Mod Loader finds it. JoyPro then reads the mod\'s command list (nothing of the mod is copied into JoyPro).'}" />
                                                        <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding ByojDetails}" />
                                                        <CheckBox IsChecked="{Binding ByojConsent}" IsVisible="{Binding !ByojInstalled}"
                                                                  Content="{l:T 'I have read what BYOJoystick is and its license situation, and I want to install it from the Steam Workshop'}" />
                                                        <WrapPanel ItemSpacing="8" LineSpacing="6">
                                                            <Button Classes="icon accent" Tag="{StaticResource Icon.Import}" Content="{l:T 'Install BYOJoystick'}" Command="{Binding InstallByojCommand}" IsVisible="{Binding !ByojInstalled}" />
                                                            <Button Classes="icon" Tag="{StaticResource Icon.Refresh}" Content="{l:T 'Check again'}" Command="{Binding CheckByojCommand}"
                                                                    ToolTip.Tip="{l:T 'Look for the installed mod and build JoyPro\'s VTOL VR command list from it'}" />
                                                        </WrapPanel>
                                                        <TextBlock TextWrapping="Wrap" Text="{Binding ByojStatus}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding GameCards}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:GameCardItem">
                                                            <Border Classes="sunken" Width="300" Margin="0,0,12,12" Padding="10">
                                                                <Grid ColumnDefinitions="64,*" ColumnSpacing="12">
                                                                    <Border Width="64" Height="96" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource JP.SurfaceRaisedBrush}" VerticalAlignment="Top">
                                                                        <Panel>
                                                                            <controls:GameBadge GameId="{Binding GameId}" Title="{Binding Name}" Logo="{Binding Logo}" />
                                                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                                        </Panel>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Spacing="5">
                                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                            <Button Grid.Column="1" Classes="icon iconOnly ghost small" Tag="{StaticResource Icon.EyeOff}" Padding="4" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                                                                    Command="{Binding #RootWindow.DataContext.HideGameCardCommand}" CommandParameter="{Binding}" IsEnabled="{Binding #RootWindow.DataContext.CanRun}"
                                                                                    ToolTip.Tip="{l:T 'Hide this game: it leaves the cards, the export, the watcher and the setup suggestions (your binds for it stay). \'Hidden games\' below the cards shows it again.'}" />
                                                                        </Grid>
                                                                        <Border Classes="chip ok" IsVisible="{Binding Installed}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                <PathIcon Data="{StaticResource Icon.Check}" />
                                                                                <TextBlock Text="{Binding InstallText}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border Classes="chip warn" IsVisible="{Binding NotInstalled}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                <PathIcon Data="{StaticResource Icon.Warning}" />
                                                                                <TextBlock Text="{Binding InstallText}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <CheckBox Classes="watchGame" IsChecked="{Binding Watch}" IsEnabled="{Binding CanWatch}" ToolTip.Tip="{Binding WatchTip}"
                                                                                  ToolTip.ShowOnDisabled="True" Padding="4,0,0,0" MinHeight="0">
                                                                            <TextBlock Text="{l:T 'Watch for changes'}" FontSize="12" />
                                                                        </CheckBox>
                                                                        <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding NeedsDbUpdate}">
                                                                            <PathIcon Data="{StaticResource Icon.Info}" Width="13" Height="13" Classes="info" />
                                                                            <TextBlock Text="{Binding UpdateHint}" FontSize="11" TextWrapping="Wrap" MaxWidth="190" />
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasResult}">
                                                                            <PathIcon Data="{StaticResource Icon.Ok}" Width="13" Height="13" Classes="ok" IsVisible="{Binding ResultOk}" />
                                                                            <PathIcon Data="{StaticResource Icon.Error}" Width="13" Height="13" Classes="error" IsVisible="{Binding ResultFailed}" />
                                                                            <TextBlock Text="{Binding Result}" FontSize="11" TextWrapping="Wrap" MaxWidth="190" />
                                                                        </StackPanel>
                                                                        <WrapPanel Margin="0,2,0,0" ItemSpacing="4" LineSpacing="4">
                                                                            <Button Classes="icon small accent" Tag="{StaticResource Icon.Import}" Content="{l:T 'Import'}"
                                                                                    Command="{Binding #RootWindow.DataContext.StartImportWizardCommand}" CommandParameter="{Binding}" IsEnabled="{Binding CanImport}"
                                                                                    ToolTip.Tip="{l:T 'Take the binds you made in this game into JoyPro'}" />
                                                                            <Button Classes="icon small" Tag="{StaticResource Icon.Export}" Content="{l:T 'Export'}"
                                                                                    Command="{Binding #RootWindow.DataContext.ExportGameCardCommand}" CommandParameter="{Binding}" IsEnabled="{Binding Installed}"
                                                                                    ToolTip.Tip="{l:T 'Write your profile into this game (Export page)'}" />
                                                                            <Button Classes="icon small" Tag="{StaticResource Icon.Database}" Content="{l:T 'Update'}"
                                                                                    Command="{Binding #RootWindow.DataContext.UpdateGameCommandListCommand}" CommandParameter="{Binding}" IsVisible="{Binding CanRefresh}" IsEnabled="{Binding CanRefreshNow}"
                                                                                    ToolTip.Tip="{l:T 'Read the game\'s new commands (after a game update). The game is not started.'}" />
                                                                            <Button Classes="icon small" Tag="{StaticResource Icon.Undo}" Content="{l:T 'Undo export'}"
                                                                                    Command="{Binding #RootWindow.DataContext.UndoGameCardExportCommand}" CommandParameter="{Binding}" IsEnabled="{Binding Installed}"
                                                                                    ToolTip.Tip="{l:T 'Put the game\'s control files back from before JoyPro\'s last export (asks first)'}" />
                                                                            <Button Classes="icon small" Tag="{StaticResource Icon.Import}" Content="{l:T 'Install BYOJoystick'}"
                                                                                    Command="{Binding #RootWindow.DataContext.OpenByojCommand}" CommandParameter="{Binding}" IsVisible="{Binding OffersModInstall}"
                                                                                    ToolTip.Tip="{l:T 'Full HOTAS support in VTOL VR needs the BYOJoystick mod (Steam Workshop). JoyPro shows what it is and its license first; Steam downloads it.'}" />
                                                                        </WrapPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- Hidden games (the card's hide button, the game setup, Settings > Games): shown again with one click. -->
                                                <Expander x:Name="HiddenGamesExpander" IsVisible="{Binding HasHiddenGames}" HorizontalAlignment="Stretch" IsExpanded="{Binding HiddenGamesExpanded}">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <PathIcon Data="{StaticResource Icon.EyeOff}" Width="16" Height="16" Opacity="0.7" />
                                                            <TextBlock Text="{Binding HiddenGamesTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Text="{l:T 'not on the cards, not exported, not watched; your binds for them stay'}" Classes="caption" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding HiddenGameInstalls}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:GameInstallItem">
                                                                <Border Classes="raised" Width="300" Margin="0,0,12,8" Padding="8">
                                                                    <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="10">
                                                                        <Border Width="32" Height="48" CornerRadius="5" ClipToBounds="True" Background="{DynamicResource JP.SurfaceAltBrush}" Opacity="0.7">
                                                                            <Panel>
                                                                                <controls:GameBadge GameId="{Binding GameId}" Title="{Binding Name}" />
                                                                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                                            </Panel>
                                                                        </Border>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.8" />
                                                                        <Button Grid.Column="2" Classes="icon small" Tag="{StaticResource Icon.Eye}" Content="{l:T 'Show again'}" VerticalAlignment="Center"
                                                                                Command="{Binding #RootWindow.DataContext.ShowHiddenGameCommand}" CommandParameter="{Binding}" IsEnabled="{Binding #RootWindow.DataContext.CanRun}"
                                                                                ToolTip.Tip="{l:T 'Back on the cards, in the export and the watcher'}" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </StackPanel>

                                            <!-- Step 2: how to import -->
                                            <StackPanel Spacing="10" IsVisible="{Binding IsImportWizardOptionsStep}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                    <Border Width="56" Height="84" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource JP.SurfaceRaisedBrush}">
                                                        <Panel>
                                                            <controls:GameBadge GameId="{Binding ImportWizardGame.GameId}" Title="{Binding ImportWizardGame.Name}" Logo="{Binding ImportWizardGame.Logo}" />
                                                            <Image Source="{Binding ImportWizardGame.Cover}" Stretch="UniformToFill" />
                                                        </Panel>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ImportWizardTitle}" FontSize="18" FontWeight="SemiBold" />
                                                        <TextBlock Classes="caption" Text="{l:T 'JoyPro reads the game\'s control files. The game itself is not changed.'}" />
                                                    </StackPanel>
                                                </Grid>
                                                <RadioButton IsChecked="{Binding ImportWizardAddToProfile}">
                                                    <StackPanel>
                                                        <TextBlock Text="{l:T 'Add to my profile (recommended)'}" FontWeight="SemiBold" />
                                                        <TextBlock Classes="caption" Text="{l:T 'What you already have in JoyPro stays; the game\'s binds are added.'}" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton IsChecked="{Binding ImportWizardStartOver}">
                                                    <StackPanel>
                                                        <TextBlock Text="{l:T 'Start over from this game'}" FontWeight="SemiBold" />
                                                        <TextBlock Classes="caption" Text="{l:T 'The relations of your profile are replaced by what the game has (JoyPro keeps a copy of your profile first).'}" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <CheckBox IsChecked="{Binding ImportWizardKeyboard}" IsVisible="{Binding ImportWizardOffersKeyboard}"
                                                          Content="{l:T 'Also take the keyboard keys (flight commands only; device binds are always taken)'}" />
                                                <CheckBox IsChecked="{Binding ImportIncludeDisconnected}" IsVisible="{Binding ImportWizardOffersDisconnected}"
                                                          Content="{l:T 'Also import devices that are not connected'}"
                                                          ToolTip.Tip="{l:T 'MSFS keeps the binds of every device it ever saw. Off: only the devices connected now.'}" />
                                                <CheckBox IsChecked="{Binding ImportIncludeSimDefaults}" IsVisible="{Binding ImportWizardOffersDisconnected}"
                                                          Content="{l:T 'Also import default presets the sim may not use'}"
                                                          ToolTip.Tip="{l:T 'Devices you never changed in MSFS run on a preset the sim ships. JoyPro takes it when the sim records that it uses it. On: also when that is not known (this can add binds the sim does not have).'}" />
                                                <StackPanel Spacing="6" IsVisible="{Binding ImportWizardIsDcs}">
                                                    <CheckBox Content="{l:T 'All my DCS aircraft'}" IsChecked="{Binding ImportAllDcsPlanes}" />
                                                    <Border Classes="sunken" Padding="6" IsVisible="{Binding ShowDcsPlaneSelection}">
                                                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl ItemsSource="{Binding ImportPlaneOptions}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:SelectableTagItem">
                                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Width="200" Margin="0,0,6,2" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Classes="icon" Tag="{StaticResource Icon.ArrowLeft}" Content="{l:T 'Back'}" Command="{Binding ImportWizardBackCommand}" />
                                                    <Button Classes="icon" Tag="{StaticResource Icon.Eye}" Content="{l:T 'Look first'}" Command="{Binding PreviewImportWizardCommand}" IsEnabled="{Binding CanRun}"
                                                            ToolTip.Tip="{l:T 'Shows what the game has, without changing your profile'}" />
                                                    <Button Classes="icon accent" Tag="{StaticResource Icon.Import}" Content="{l:T 'Import now'}" Command="{Binding RunImportWizardCommand}" IsEnabled="{Binding CanRun}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                            <Expander Header="{l:T 'Expert import: paths, device filters and game values'}" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8" Margin="0,6,0,0">
                                    <TextBlock Classes="hint" Text="{l:T 'The same imports as the cards above, with every option of the engine: your own paths, only some devices, axis values from the game, and the games JoyPro reads through its game list.'}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="{l:T 'DCS Path'}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding ImportDcsPath}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="{l:T 'IL2 Path'}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding ImportIl2Path}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="{l:T 'Star Citizen Path'}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding ImportStarCitizenPath}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="{l:T 'Star Citizen Source'}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding StarCitizenSourcePath}" Watermark="{l:T 'Optional actionmaps/defaultProfile source'}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="{l:T 'DCS Planes'}" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" Content="{l:T 'Import all DCS planes'}" IsChecked="{Binding ImportAllDcsPlanes}" />
                            </Grid>

                            <StackPanel IsVisible="{Binding ShowDcsPlaneSelection}" Spacing="6">
                                <TextBlock Text="{l:T 'Select DCS aircraft to import'}" FontWeight="SemiBold" />
                                <Border Classes="sunken" Padding="6">
                                    <ScrollViewer Height="130" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ImportPlaneOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:SelectableTagItem">
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2,0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="{l:T 'Additional planes CSV'}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding ImportPlanesCsv}" Watermark="{l:T 'Optional: A-10C_2,FA-18C_hornet'}" />
                                </Grid>
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="{l:T 'Device Filter'}" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" Content="{l:T 'Use selected devices only'}" IsChecked="{Binding ImportUseSelectedDevices}" />
                            </Grid>

                            <StackPanel IsVisible="{Binding ShowImportDeviceSelection}" Spacing="6">
                                <TextBlock Text="{l:T 'Select devices to import'}" FontWeight="SemiBold" />
                                <Border Classes="sunken" Padding="6">
                                    <ScrollViewer Height="120" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ImportDeviceOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:SelectableTagItem">
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2,0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{l:T 'Ignore devices'}" FontWeight="SemiBold" />
                                <Border Classes="sunken" Padding="6">
                                    <ScrollViewer Height="120" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ImportIgnoreDeviceOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:SelectableTagItem">
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2,0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <WrapPanel>
                                <CheckBox Content="{l:T 'Merge into profile'}" IsChecked="{Binding ImportMerge}" Margin="0,0,10,0" />
                                <CheckBox Content="{l:T 'Include defaults'}" IsChecked="{Binding ImportIncludeDefaults}" Margin="0,0,10,0" />
                                <CheckBox Content="{l:T 'DCS: import keyboard commands'}" IsChecked="{Binding ImportKeyboardCommands}" Margin="0,0,10,0" />
                                <CheckBox Content="{l:T 'SC: include keyboard commands (ship controls only)'}" IsChecked="{Binding ImportStarCitizenIncludeKeyboard}" Margin="0,0,10,0" />
                                <CheckBox Content="{l:T 'DCS: ignore *_easy aircraft'}" IsChecked="{Binding ImportIgnoreEasyPlanes}" Margin="0,0,10,0" />
                                <CheckBox Content="{l:T 'Import inverted'}" IsChecked="{Binding ImportInverted}" Margin="0,0,10,0" />
                                <CheckBox Content="{l:T 'Import slider'}" IsChecked="{Binding ImportSlider}" Margin="0,0,10,0" />
                                <CheckBox Content="{l:T 'Import curvature'}" IsChecked="{Binding ImportCurvature}" Margin="0,0,10,0" />
                                <CheckBox Content="{l:T 'Import deadzone'}" IsChecked="{Binding ImportDeadzone}" Margin="0,0,10,0" />
                                <CheckBox Content="{l:T 'Import sat-x'}" IsChecked="{Binding ImportSaturationX}" Margin="0,0,10,0" />
                                <CheckBox Content="{l:T 'Import sat-y'}" IsChecked="{Binding ImportSaturationY}" Margin="0,0,10,0" />
                            </WrapPanel>
                            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                       Text="{l:T 'The inverted/slider/curvature/deadzone/saturation boxes only take values set in the game. Binds JoyPro exported itself always come back with their names, groups, modifiers and curves.'}" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="{l:T 'Per-Game Operations'}" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="130,140,120,120,140" ColumnSpacing="8">
                                    <TextBlock Text="DCS" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Command="{Binding RefreshDcsWorkspaceCommand}" Content="{l:T 'Refresh DCS'}" IsEnabled="{Binding CanRunDcs}" />
                                    <Button Grid.Column="2" Command="{Binding ScanDcsCommand}" Content="{l:T 'Scan'}" IsEnabled="{Binding CanRunDcs}" />
                                    <Button Grid.Column="3" Command="{Binding ImportDcsCommand}" Content="{l:T 'Import'}" IsEnabled="{Binding CanRunDcs}" />
                                    <Button Grid.Column="4" Command="{Binding ExportDcsCommand}" Content="{l:T 'Export'}" IsEnabled="{Binding CanRunDcs}" />
                                </Grid>
                                <Grid ColumnDefinitions="130,140,120,120,140" ColumnSpacing="8">
                                    <TextBlock Text="IL2" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Command="{Binding RefreshIl2WorkspaceCommand}" Content="{l:T 'Refresh IL2'}" IsEnabled="{Binding CanRunIl2}" />
                                    <Button Grid.Column="2" Command="{Binding ScanIl2Command}" Content="{l:T 'Scan'}" IsEnabled="{Binding CanRunIl2}" />
                                    <Button Grid.Column="3" Command="{Binding ImportIl2Command}" Content="{l:T 'Import'}" IsEnabled="{Binding CanRunIl2}" />
                                    <Button Grid.Column="4" Command="{Binding ExportIl2Command}" Content="{l:T 'Export'}" IsEnabled="{Binding CanRunIl2}" />
                                </Grid>
                                <Grid ColumnDefinitions="130,140,120,120,140" ColumnSpacing="8">
                                    <TextBlock Text="{l:T 'Star Citizen'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Command="{Binding RefreshStarCitizenWorkspaceCommand}" Content="{l:T 'Refresh SC'}" IsEnabled="{Binding CanRunStarCitizen}" />
                                    <Button Grid.Column="2" Command="{Binding ScanStarCitizenCommand}" Content="{l:T 'Scan'}" IsEnabled="{Binding CanRunStarCitizen}" />
                                    <Button Grid.Column="3" Command="{Binding ImportStarCitizenCommand}" Content="{l:T 'Import'}" IsEnabled="{Binding CanRunStarCitizen}" />
                                    <Button Grid.Column="4" Command="{Binding ExportStarCitizenCommand}" Content="{l:T 'Export'}" IsEnabled="{Binding CanRunStarCitizen}" />
                                </Grid>
                                <TextBlock Text="{Binding NotInstalledHint}" TextWrapping="Wrap" Foreground="#D97706"
                                           IsVisible="{Binding NotInstalledHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>

                            <Border Classes="sunken">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{l:T 'Other Games'}" FontWeight="SemiBold" />
                                    <TextBlock Text="{l:T 'WARDOGS, Arma, War Thunder, X-Plane 12 and 11, MSFS 2024 and 2020, Falcon BMS, IL-2 Korea, X4, Elite Dangerous, VTOL VR, Nuclear Option. Only flight controls are written; everything else in the game files stays as it is.'}" TextWrapping="Wrap" Opacity="0.8" />
                                    <Grid ColumnDefinitions="Auto,260,Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{l:T 'Game'}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RegistryGames}" SelectedItem="{Binding SelectedRegistryGame}" HorizontalAlignment="Stretch" PlaceholderText="{l:T 'Load Games first'}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:RegistryGameItem">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Column="2" Text="{l:T 'File / Folder'}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3" Text="{Binding RegistryGamePath}" Watermark="{l:T 'Empty = the file the engine finds'}" />
                                        <Button Grid.Column="4" Command="{Binding DetectRegistryGamePathCommand}" Content="{l:T 'Detect'}" IsEnabled="{Binding CanRun}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding SelectedRegistryGameSupportsProfiles}">
                                        <TextBlock Text="{l:T 'Game Profile'}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding RegistryGameProfileName}" Watermark="{l:T 'Profile name in the game, needed when a device has several profiles'}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding SelectedRegistryGameSupportsAircraft}">
                                        <TextBlock Text="{l:T 'Export Aircraft'}" VerticalAlignment="Center" />
                                        <AutoCompleteBox Grid.Column="1" Text="{Binding RegistryGameAircraft}" ItemsSource="{Binding RegistryGameAircraftOptions}" FilterMode="Contains" MinimumPrefixLength="0"
                                                         Watermark="{l:T 'Empty = relations for all aircraft only. An aircraft key also exports the relations limited to it (the sim\'s presets apply to every aircraft).'}" />
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedRegistryGameNotes}" TextWrapping="Wrap" Opacity="0.8" />
                                    <WrapPanel>
                                        <Button Command="{Binding RefreshRegistryGamesCommand}" Content="{l:T 'Load Games'}" IsEnabled="{Binding CanRun}" Margin="0,0,8,6" />
                                        <Button Command="{Binding ScanRegistryGameCommand}" Content="{l:T 'Scan'}" IsEnabled="{Binding CanRunRegistryGame}" Margin="0,0,8,6" />
                                        <Button Command="{Binding ImportRegistryGameCommand}" Content="{l:T 'Import'}" IsEnabled="{Binding CanRunRegistryGame}" Margin="0,0,8,6" />
                                        <Button Command="{Binding ExportRegistryGameCommand}" Content="{l:T 'Export'}" IsEnabled="{Binding CanRunRegistryGame}" Margin="0,0,8,6" />
                                        <CheckBox Content="{l:T 'Export as dry run (show changes only)'}" IsChecked="{Binding RegistryGameDryRun}" Margin="0,0,8,6" />
                                        <CheckBox Content="{l:T 'Include keyboard binds (flight actions only)'}" IsChecked="{Binding RegistryGameIncludeKeyboard}" Margin="0,0,8,6" />
                                        <CheckBox Content="{l:T 'Also import devices that are not connected'}" IsChecked="{Binding ImportIncludeDisconnected}" IsVisible="{Binding SelectedRegistryGameKeepsDisconnectedDevices}"
                                                  ToolTip.Tip="{l:T 'MSFS keeps the binds of every device it ever saw. Off: only the devices connected now.'}" Margin="0,0,8,6" />
                                        <CheckBox Content="{l:T 'Also import default presets the sim may not use'}" IsChecked="{Binding ImportIncludeSimDefaults}" IsVisible="{Binding SelectedRegistryGameKeepsDisconnectedDevices}"
                                                  ToolTip.Tip="{l:T 'Devices you never changed in MSFS run on a preset the sim ships. JoyPro takes it when the sim records that it uses it. On: also when that is not known (this can add binds the sim does not have).'}" Margin="0,0,8,6" />
                                        <CheckBox Content="{l:T 'Nuke: remove all binds from devices JoyPro does not use'}" IsChecked="{Binding ExportNukeUntouchedDevices}" Margin="0,0,8,6" />
                                        <CheckBox Content="{l:T 'Write into my MSFS profiles'}" IsChecked="{Binding MsfsWriteUserProfiles}" IsVisible="{Binding SelectedRegistryGameIsMsfs2024}"
                                                  ToolTip.Tip="{l:T 'The export puts the binds into the profile MSFS 2024 uses for each device and category (Steam or Microsoft Store), backed up first. Off: only import files.'}" Margin="0,0,8,6" />
                                        <CheckBox Content="{l:T 'Also write MSFS import files for every device'}" IsChecked="{Binding MsfsAlwaysImportFiles}" IsVisible="{Binding SelectedRegistryGameIsMsfs2024}"
                                                  ToolTip.Tip="{l:T 'Off: import files only where JoyPro could not write your profile.'}" Margin="0,0,8,6" />
                                    </WrapPanel>
                                    <Border IsVisible="{Binding HasMsfsProfileUpdates}" BorderBrush="{DynamicResource JP.AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{l:T 'Your MSFS 2024 profiles'}" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding MsfsProfileUpdates}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border IsVisible="{Binding HasMsfsImportFiles}" BorderBrush="{DynamicResource JP.AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding MsfsImportFilesHint}" TextWrapping="Wrap" />
                                            <WrapPanel>
                                                <TextBlock Text="{Binding MsfsImportFilesFolder}" TextWrapping="Wrap" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button Command="{Binding OpenMsfsImportFilesFolderCommand}" Content="{l:T 'Open folder'}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding SelectedRegistryGameSupportsRefresh}">
                                        <TextBlock Text="{l:T 'DB Source'}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding RegistryGameDbSource}" Watermark="{l:T 'Where the action list comes from (see the game notes); empty = the game\'s own file'}" />
                                        <Button Grid.Column="2" Command="{Binding RefreshRegistryGameDbCommand}" Content="{l:T 'Refresh DB'}" IsEnabled="{Binding CanRunRegistryGame}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                                </StackPanel>
                            </Expander>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="16">
                                    <!-- Connected devices with their pictures (engine hud devices) -->
                                    <Border Classes="surface">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Joystick}" /></Border>
                                                <TextBlock Grid.Column="1" Classes="h2" Text="{l:T 'Your devices'}" />
                                                <Button Grid.Column="2" Classes="ghost small" Content="{l:T 'Manage'}" Command="{Binding GoSettingsCommand}" ToolTip.Tip="{l:T 'Settings &gt; Devices: move binds to another device, remove an old one'}" />
                                            </Grid>
                                            <TextBlock Classes="caption" IsVisible="{Binding !HasDashboardDevices}"
                                                       Text="{l:T 'No devices found yet. Connect your sticks, throttle and pedals and press Refresh.'}" />
                                            <!-- One card per device: the device reference's model and picture (as on the Layout page); a click opens the Layout page with it -->
                                            <ItemsControl ItemsSource="{Binding DashboardDevices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:DeviceCardItem">
                                                        <StackPanel>
                                                        <Button Classes="deviceCard" Margin="-6,0,-6,4" ToolTip.Tip="{Binding Tooltip}"
                                                                Command="{Binding #RootWindow.DataContext.OpenDeviceCardInLayoutCommand}" CommandParameter="{Binding}">
                                                            <Grid ColumnDefinitions="108,*" ColumnSpacing="12">
                                                                <Border Width="108" Height="108" CornerRadius="10" Background="{DynamicResource JP.SurfaceAltBrush}"
                                                                        BorderBrush="{DynamicResource JP.BorderBrush}" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Top">
                                                                    <Panel>
                                                                        <PathIcon Data="{StaticResource Icon.Joystick}" Width="32" Height="32" Opacity="0.55" IsVisible="{Binding HasNoPicture}" />
                                                                        <controls:DeviceThumbnail Picture="{Binding Picture}" Schematic="{Binding Schematic}" Margin="6" />
                                                                    </Panel>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Classes="caption" Text="{Binding DeviceName}" TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowsDeviceName}" />
                                                                    <TextBlock Classes="caption" Text="{Binding InputsText}" />
                                                                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" Margin="0,2,0,0">
                                                                        <Border Classes="chip device" IsVisible="{Binding HasKindLabel}"><TextBlock Text="{Binding KindLabel}" /></Border>
                                                                        <Border Classes="chip ok" IsVisible="{Binding InProfile}"><TextBlock Text="{l:T 'In your profile'}" /></Border>
                                                                        <Border Classes="chip warn" IsVisible="{Binding !InProfile}"><TextBlock Text="{l:T 'Not used yet'}" /></Border>
                                                                        <Border Classes="chip warn" IsVisible="{Binding NeedsGrip}"><TextBlock Text="{l:T 'Which grip?'}" /></Border>
                                                                    </WrapPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                        <!-- Asked once per device before the maker's photo is downloaded (DevicePhotoConsent) -->
                                                        <Border Classes="raised" Padding="8" Margin="0,0,0,8" IsVisible="{Binding AsksPhotoConsent}">
                                                            <StackPanel Spacing="6">
                                                                <TextBlock Text="{Binding PhotoConsentText}" TextWrapping="Wrap" FontSize="12" />
                                                                <WrapPanel ItemSpacing="6" LineSpacing="4">
                                                                    <Button Content="{l:T 'Yes'}" Classes="small accent" Command="{Binding #RootWindow.DataContext.CardPhotoYesCommand}" CommandParameter="{Binding}" />
                                                                    <Button Content="{l:T 'No'}" Classes="small" Command="{Binding #RootWindow.DataContext.CardPhotoNoCommand}" CommandParameter="{Binding}" />
                                                                    <Button Content="{l:T 'Always for all my devices'}" Classes="small" Command="{Binding #RootWindow.DataContext.CardPhotoAlwaysCommand}" CommandParameter="{Binding}" />
                                                                    <Button Content="{l:T 'Never'}" Classes="small" Command="{Binding #RootWindow.DataContext.CardPhotoNeverCommand}" CommandParameter="{Binding}" />
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasOtherDevices}"
                                                       Text="{l:T 'Also connected (keyboards, mice and other devices JoyPro does not use): {0}', Arg0={Binding OtherDevicesText}}" />
                                            <!-- 3D views of the connected devices from JoyPro's releases (the Layout page has the same offer) -->
                                            <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding HasDevice3DOffer}">
                                                <TextBlock Classes="caption" Text="{Binding Device3DOfferText}" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" />
                                                <Button Classes="small accent" Content="{l:T 'Download'}" Command="{Binding AcceptDevice3DCommand}" />
                                                <Button Classes="small" Content="{l:T 'Not now'}" Command="{Binding DismissDevice3DCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Recent activity per game (engine sync status) and the game watcher -->
                                    <Border Classes="surface">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.History}" /></Border>
                                                <TextBlock Classes="h2" Text="{l:T 'Recent activity'}" />
                                            </StackPanel>
                                            <TextBlock Classes="caption" IsVisible="{Binding !HasRecentActivity}"
                                                       Text="{l:T 'Nothing yet. After you export to a game or import from it, it shows up here.'}" />
                                            <ItemsControl ItemsSource="{Binding RecentActivity}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ActivityItem">
                                                        <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="10" Margin="0,0,0,8">
                                                            <Border Width="30" Height="44" CornerRadius="5" ClipToBounds="True">
                                                                <controls:GameBadge GameId="{Binding GameId}" Title="{Binding Game}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock Text="{Binding Game}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Classes="caption" Text="{Binding What}" />
                                                                <TextBlock Classes="warnText" FontSize="11" Text="{Binding ChangedText}" IsVisible="{Binding ChangedSince}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Classes="caption" Text="{Binding WhenText}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Classes="raised" Padding="10,8">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <PathIcon Data="{StaticResource Icon.Eye}" Width="16" Height="16" Classes="info" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Classes="h3" Text="{l:T 'Game watcher'}" />
                                                        <TextBlock Classes="caption" Text="{Binding GameWatchStatus}" />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding WatchGameConfigs}" OnContent="{l:T 'On'}" OffContent="{l:T 'Off'}" VerticalAlignment="Center"
                                                                  ToolTip.Tip="{l:T 'After a game closes, JoyPro asks whether to take the binds you changed in the game into your profile'}" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- HUD -->
                                    <Border Classes="surface">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Monitor}" /></Border>
                                                <TextBlock Classes="h2" Text="HUD" />
                                            </StackPanel>
                                            <TextBlock Classes="caption"
                                                       Text="{l:T 'Your sticks, throttles and pedals live on screen (or for streaming): pictures that tilt with the stick, levers and axes that move, buttons that light up, and what each pressed button does in the game.'}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Command="{Binding ToggleOverlayCommand}" Content="{Binding OverlayToggleLabel}" Classes="accent" />
                                                <Button Command="{Binding GoHudCommand}" Content="{l:T 'Open HUD designer'}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding OverlayStatus}" Classes="caption" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>

                                    <Expander Header="{l:T 'Information for experts'}" HorizontalAlignment="Stretch">
                                        <WrapPanel Margin="0,6,0,0" ItemSpacing="6" LineSpacing="6">
                                            <Button Command="{Binding RunEngineSummaryCommand}" Content="{l:T 'Engine Summary'}" Classes="small" IsEnabled="{Binding CanRun}" />
                                            <Button Command="{Binding RunProfileSummaryCommand}" Content="{l:T 'Profile Summary'}" Classes="small" IsEnabled="{Binding CanRun}" />
                                            <Button Command="{Binding RefreshDevicesCommand}" Content="{l:T 'List Devices'}" Classes="small" IsEnabled="{Binding CanRun}" />
                                            <Button Command="{Binding RefreshDbGamesCommand}" Content="{l:T 'List DB Games'}" Classes="small" IsEnabled="{Binding CanRun}" />
                                            <Button Command="{Binding RefreshDbPlanesCommand}" Content="{l:T 'List DB Planes'}" Classes="small" IsEnabled="{Binding CanRun}" />
                                        </WrapPanel>
                                    </Expander>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Relations (MainWindowViewModel.RelationBuilder.cs, docs/relation-builder.md), JoyPro 1 style: the relations on
                     the left (search, group chips, multi-select with bulk actions); on the right the open relation (name edited
                     in place, its actions) and one of three panels: Add actions (one search over every game, tick rows, Add
                     selected), Suggested for this relation, and the JoyPro assistant. Binding stays on the Binds page. The
                     whole-profile tool (Auto-build relations from all my actions) takes the editor's place while it is open. -->
                <Border IsVisible="{Binding IsRelationsStage}" Padding="0,4,0,0">
                    <Grid x:Name="RelationsPaneGrid" ColumnDefinitions="300,12,*">
                        <Border Classes="surface" Padding="12">
                            <Grid x:Name="RelationsLeftGrid" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
                                    <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Link}" /></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Classes="h2" FontSize="18" FontWeight="Bold" Text="{l:T 'Relations'}" />
                                        <TextBlock Classes="caption" Text="{l:T '{}{0} in your profile', Arg0={Binding ProfileRelationCount}}" />
                                    </StackPanel>
                                    <!-- Follow input (the same switch as on the Binds page): pressing a button selects its relation here too. -->
                                    <!-- Manage with AI: a request for the whole profile becomes a checked plan (docs/ai-plans.md) -->
                                    <ToggleButton Grid.Column="2" Classes="filterChip" VerticalAlignment="Center" Padding="7,4" Command="{Binding ShowManageWithAiCommand}"
                                                  IsChecked="{Binding IsAiPlanPanelOpen, Mode=OneWay}"
                                                  ToolTip.Tip="{l:T 'Manage with AI: say what to do with your relations (rename, delete, create, groups, aircraft); you see every step before anything changes'}">
                                        <PathIcon Data="{StaticResource Icon.Wand}" Width="13" Height="13" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="RelationsFollowInputToggle" Grid.Column="3" Classes="filterChip" VerticalAlignment="Center"
                                                  IsChecked="{Binding FollowInputOnBinds}"
                                                  ToolTip.Tip="{l:T 'Follow input: press a button or move an axis a long way and the list jumps to its relation; press it again for the next relation on it (without modifiers first). Not while recording or typing. Settings > Binds switches it off for good.'}">
                                        <PathIcon Data="{StaticResource Icon.Cursor}" Width="13" Height="13" />
                                    </ToggleButton>
                                    <Button Grid.Column="4" Classes="icon accent small" Tag="{StaticResource Icon.Plus}" Content="{l:T 'New'}" Command="{Binding StartNewRelationCommand}"
                                            ToolTip.Tip="{l:T 'New relation: give it a name, then tick its actions in the search over every game (Ctrl+N)'}" />
                                </Grid>
                                <TextBox x:Name="RelationSearchBox" Grid.Row="1" Classes="search" Text="{Binding RelationSearchText}" Watermark="{l:T 'Search relations (Ctrl+F)'}"
                                         ToolTip.Tip="{l:T 'Shows only the relations whose name, game, aircraft, group, device, input or modifier has these words'}" />
                                <!-- Filters: groups, games and their aircraft, devices, bound, axis / button (ListFilterViewModel) -->
                                <!-- The pane is narrow: the sort button goes under the filters -->
                                <StackPanel Grid.Row="2" Spacing="4">
                                    <controls:ListFilterBar x:Name="RelationFilterBar" DataContext="{Binding RelationFilter}" />
                                    <controls:ListSortBar x:Name="RelationSortBar" HorizontalAlignment="Left" DataContext="{Binding RelationSort}" />
                                </StackPanel>

                                <!-- Several relations ticked (Ctrl/Shift+click): what to do with all of them -->
                                <Border Grid.Row="3" Classes="callout" IsVisible="{Binding HasRelationMultiSelection}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <TextBlock Text="{Binding RelationMassSelectionSummary}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Classes="icon small danger" Tag="{StaticResource Icon.Delete}" Content="{l:T 'Delete'}" Command="{Binding DeleteSelectedRelationsCommand}"
                                                ToolTip.Tip="{l:T 'Delete the selected relations (asks first; Ctrl+Z undoes it) - Del'}" />
                                        <Button Grid.Column="2" Classes="small" Content="{l:T 'Clear'}" Click="ClearRelationSelectionClicked" ToolTip.Tip="{l:T 'Unselect all'}" />
                                    </Grid>
                                </Border>

                                <Panel Grid.Row="4">
                                    <ListBox x:Name="RelationsListBox"
                                             Classes="cards"
                                             ItemsSource="{Binding Relations}"
                                             SelectedItem="{Binding SelectedRelation}"
                                             SelectionMode="Multiple"
                                             SelectionChanged="RelationsListSelectionChanged"
                                             KeyDown="RelationsListKeyDown"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             MinHeight="120">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:RelationListItem">
                                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5" ToolTip.Tip="{Binding Groups}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Classes="chip warn" IsVisible="{Binding IsUnbound}" ToolTip.Tip="{l:T 'Not on a button or axis yet: bind it on the Binds page'}">
                                                            <TextBlock Text="{l:T 'not bound'}" />
                                                        </Border>
                                                    </Grid>
                                                    <!-- "WarBRD · BTN 8" and the modifiers held with it as chips: a long device name shortens (the full
                                                         name is in the tooltip), the input and every modifier always show; the chips wrap to a second line. -->
                                                    <WrapPanel Grid.Row="1" ItemSpacing="4" LineSpacing="4" IsVisible="{Binding IsBound}">
                                                        <Border Classes="keycap" ToolTip.Tip="{Binding BindTooltip}">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding BindInputPart}" />
                                                                <TextBlock Text="{Binding BindDevice}" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding ModifierChips}" IsVisible="{Binding HasModifierChips}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <Border Classes="chip modifier" ToolTip.Tip="{l:T 'Modifier: hold it for this bind'}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                                            <PathIcon Data="{StaticResource Icon.Shift}" />
                                                                            <TextBlock Text="{Binding}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </WrapPanel>
                                                    <!-- Type, games and the aircraft chip wrap (a relation of many games kept the aircraft chip, and its
                                                         tooltip, out of reach). -->
                                                    <WrapPanel Grid.Row="2" ItemSpacing="4" LineSpacing="4">
                                                        <Border Classes="chip axis" IsVisible="{Binding IsAxis}"><TextBlock Text="{l:T 'Axis'}" /></Border>
                                                        <ItemsControl ItemsSource="{Binding GameList}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <Border Classes="chip game"><TextBlock Text="{Binding}" /></Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <!-- The tooltip lists the aircraft (the tooltip wraps a long list) -->
                                                        <Border Classes="chip aircraft" IsVisible="{Binding HasPlanes}" ToolTip.Tip="{Binding PlanesTooltip}">
                                                            <TextBlock Text="{Binding PlanesText}" />
                                                        </Border>
                                                    </WrapPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Follow input: which input jumped where ("BTN 8 on WarBRD: Gear (1/3)"), for a moment. -->
                                    <Border Classes="followToast" IsVisible="{Binding HasFollowInputToast}" IsHitTestVisible="False"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8,0,8,14">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <PathIcon Data="{StaticResource Icon.Gamepad}" Width="14" Height="14" Foreground="White" />
                                            <TextBlock Text="{Binding FollowInputToast}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="240" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="emptyState" IsVisible="{Binding HasNoRelations}" VerticalAlignment="Top">
                                        <StackPanel Spacing="10">
                                            <PathIcon Classes="emptyIcon" Data="{StaticResource Icon.Link}" />
                                            <TextBlock Classes="h2" HorizontalAlignment="Center" Text="{l:T 'No relations yet'}" />
                                            <TextBlock Classes="caption" TextAlignment="Center" TextWrapping="Wrap"
                                                       Text="{l:T 'A relation is one function (e.g. the throttle) of all your games and aircraft, on one input. Make one, let JoyPro group everything, or import a game.'}" />
                                            <Button Classes="icon accent" HorizontalAlignment="Center" Tag="{StaticResource Icon.Plus}" Content="{l:T 'New relation'}" Command="{Binding StartNewRelationCommand}" />
                                            <Button Classes="icon" HorizontalAlignment="Center" Tag="{StaticResource Icon.Wand}" Content="{l:T 'Group all automatically'}" Command="{Binding StartAutoGroupCommand}" />
                                            <Button Classes="icon ghost" HorizontalAlignment="Center" Tag="{StaticResource Icon.Import}" Content="{l:T 'Import from a game'}" Command="{Binding GoStartCommand}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Classes="caption" IsVisible="{Binding HasNoRelationMatches}" Margin="4,8" TextAlignment="Center" TextWrapping="Wrap"
                                               Text="{l:T 'No relation matches the search and the filters. Clear all shows every relation again.'}" />
                                </Panel>

                                <!-- Rarely used list tools in flyouts: bulk changes of the selected relations and their groups -->
                                <!-- A wrap panel: a long translation puts the second button on its own line instead of cutting a word. -->
                                <WrapPanel Grid.Row="5" ItemSpacing="8" LineSpacing="6" IsVisible="{Binding HasAnyRelations}">
                                    <Button Classes="icon" Tag="{StaticResource Icon.Merge}" Content="{l:T 'Bulk changes'}" ToolTip.Tip="{l:T 'Delete, duplicate, merge, split or rename the selected relations (or all, or a query)'}">
                                        <Button.Flyout>
                                            <Flyout Placement="TopEdgeAlignedLeft">
                                                <Border Width="420">
                                                <StackPanel Margin="0,6,0,0" Spacing="8">
                                                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:T 'Ctrl+click or Shift+click relations in the list, then pick what happens to all of them.'}" />
                                                    <TextBlock Text="{Binding RelationMassSelectionSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                                        <TextBlock Classes="label" Text="{l:T 'Do'}" />
                                                        <ComboBox Grid.Column="1" SelectedItem="{Binding RelationMassOperation}" HorizontalAlignment="Stretch">
                                                            <x:String>delete</x:String>
                                                            <x:String>duplicate</x:String>
                                                            <x:String>merge</x:String>
                                                            <x:String>split</x:String>
                                                            <x:String>add-prefix</x:String>
                                                            <x:String>add-postfix</x:String>
                                                            <x:String>remove-part</x:String>
                                                            <x:String>export</x:String>
                                                        </ComboBox>
                                                        <TextBlock Grid.Row="1" Classes="label" Text="{l:T 'Value'}" />
                                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RelationMassValue}" Watermark="{l:T 'Name, prefix, text or file (merge, add-prefix, ...)'}" />
                                                        <TextBlock Grid.Row="2" Classes="label" Text="{l:T 'On'}" />
                                                        <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding RelationMassTarget}" HorizontalAlignment="Stretch">
                                                            <x:String>selected</x:String>
                                                            <x:String>all</x:String>
                                                            <x:String>query</x:String>
                                                        </ComboBox>
                                                        <TextBlock Grid.Row="3" Classes="label" Text="{l:T 'Query'}" IsEnabled="{Binding IsRelationMassQueryTarget}" />
                                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RelationMassQuery}" IsEnabled="{Binding IsRelationMassQueryTarget}" Watermark="{l:T 'Only used when On is query'}" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding IsRelationMassSplit}">
                                                        <TextBlock Classes="label" Text="{l:T 'Planes'}" />
                                                        <TextBox Grid.Column="1" Text="{Binding RelationMassPlanesCsv}" Watermark="{l:T 'Planes that move into the new relation, e.g. FA-18C_hornet, F-16C_50'}" />
                                                    </Grid>
                                                    <Button Command="{Binding RunRelationMassOperationCommand}" Content="{l:T 'Run Mass Operation'}" HorizontalAlignment="Left" />
                                                </StackPanel>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Classes="icon" Tag="{StaticResource Icon.Tag}" Content="{l:T 'Groups'}" ToolTip.Tip="{l:T 'Add, remove and rename the groups of the selected relations'}">
                                        <Button.Flyout>
                                            <Flyout Placement="TopEdgeAlignedLeft">
                                                <Border Width="520">
                                                <StackPanel Spacing="6" Margin="0,6,0,0">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="{l:T 'Add groups'}" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Text="{Binding RelationGroupAddCsv}" Watermark="Group1,Group2" />
                                                        <Button Grid.Column="2" Command="{Binding AddRelationGroupsCommand}" Content="{l:T 'Add'}" />
                                                    </Grid>
                                                    <Expander Header="{l:T 'Remove Groups (select one or more)'}">
                                                        <StackPanel Margin="0,6,0,0" Spacing="6">
                                                            <ListBox ItemsSource="{Binding RelationGroupRemoveCandidates}" MinHeight="84" MaxHeight="140">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:SelectableTagItem">
                                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2,8,2" />
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                            <WrapPanel>
                                                                <Button Command="{Binding RemoveRelationGroupsCommand}" Content="{l:T 'Remove Selected'}" Margin="0,0,8,0" />
                                                                <Button Command="{Binding RemoveAllRelationGroupsCommand}" Content="{l:T 'Remove All'}" Margin="0,0,8,0" />
                                                                <Button Command="{Binding ClearGroupRemoveSelectionCommand}" Content="{l:T 'Clear Selection'}" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Expander>
                                                    <Grid ColumnDefinitions="Auto,220,Auto,*,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="{l:T 'Rename'}" VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RelationGroupNames}" SelectedItem="{Binding RelationGroupRenameOld}" />
                                                        <TextBlock Grid.Column="2" Text="{l:T 'To'}" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="3" Text="{Binding RelationGroupRenameNew}" />
                                                        <Button Grid.Column="4" Command="{Binding RenameGroupCommand}" Content="{l:T 'Rename'}" />
                                                    </Grid>
                                                    <Button Command="{Binding ListSelectedRelationGroupsCommand}" Content="{l:T 'List Groups (Selected or All)'}" HorizontalAlignment="Left" />
                                                </StackPanel>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1"
                                      Width="6"
                                      Background="Transparent"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch"
                                      ResizeDirection="Columns"
                                      ResizeBehavior="PreviousAndNext"
                                      ShowsPreview="True" />

                        <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="10" MinHeight="0">
                            <!-- The whole profile at once, each with one line of what it does -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <Button Classes="icon accent" Tag="{StaticResource Icon.Plus}" Command="{Binding StartNewRelationCommand}" Content="{l:T 'New relation'}"
                                            ToolTip.Tip="{l:T 'A new relation: type its name, search what it does, tick the actions of every game and press Create relation (Ctrl+N)'}" />
                                    <TextBlock Classes="caption" FontSize="11" Text="{l:T 'Name it, then tick its actions.'}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <WrapPanel>
                                    <ToggleButton Classes="icon" Tag="{StaticResource Icon.Wand}" Command="{Binding ToggleOrganizeCommand}" IsChecked="{Binding IsOrganizeOpen, Mode=OneWay}"
                                                  Content="{l:T 'Auto-build relations from all my actions...'}" HorizontalAlignment="Left" Margin="0,0,8,0"
                                                  ToolTip.Tip="{l:T 'For the whole profile at once: JoyPro puts the same function of every aircraft and game into one relation (throttle, gear, flares ...), or groups what you describe. You see the result before anything changes.'}" />
                                    <!-- Edit with AI: the open relation only -->
                                    <Button Classes="icon small" Tag="{StaticResource Icon.Wand}" Content="{l:T 'Edit with AI'}" Command="{Binding ShowEditWithAiCommand}" Margin="0,0,8,0"
                                            IsVisible="{Binding SelectedRelation, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center"
                                            ToolTip.Tip="{l:T 'Change the open relation by saying it: actions, aircraft ticks, name, groups, axis tuning; you see before and after first'}" />
                                    <!-- The local AI model at a glance: a click stops it -->
                                    <Button Classes="filterChip" Command="{Binding StopLlmServerCommand}" IsVisible="{Binding LlmServerRunning}" VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding LlmServerStatusText}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding LlmServerChipText}" VerticalAlignment="Center" FontSize="11" />
                                            <TextBlock Text="{l:T 'Stop'}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    </WrapPanel>
                                    <TextBlock Classes="caption" FontSize="11" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                                               Text="{l:T 'Opens a wizard here (your relation\'s view comes back when you close it). Puts the same function of every game and aircraft into one relation; preview first, nothing changes until you apply.'}" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="icon" Tag="{StaticResource Icon.More}" Content="{l:T 'More'}" VerticalAlignment="Top" ToolTip.Tip="{l:T 'Refresh, import and export relations, save'}">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="{l:T 'Refresh relations'}" Command="{Binding RefreshRelationsCommand}" />
                                            <MenuItem Header="{l:T 'Show selected in output'}" Command="{Binding ShowSelectedRelationCommand}" />
                                            <MenuItem Header="{l:T 'Clear selection'}" Click="ClearRelationSelectionClicked" />
                                            <MenuItem Header="{l:T 'Next relation with suggestions'}" Command="{Binding NextRelationWithSuggestionsCommand}" />
                                            <MenuItem Header="{l:T 'Suggest missing for every relation...'}" Command="{Binding SuggestMissingForAllCommand}"
                                                      ToolTip.Tip="{l:T 'Every relation with the games and aircraft it lacks (no AI): review, tick, add'}" />
                                            <Separator />
                                            <MenuItem Header="{l:T 'Import...'}" Command="{Binding OpenImportWorkspaceCommand}" />
                                            <MenuItem Header="{l:T 'Import Relations JSON...'}" Click="ImportRelationsJsonClicked" ToolTip.Tip="{l:T 'Adds relations (with their binds) from a JSON file to the profile'}" />
                                            <MenuItem Header="{l:T 'Export Relations JSON...'}" Click="ExportRelationsJsonClicked" ToolTip.Tip="{l:T 'Saves all relations of the profile to a JSON file'}" />
                                            <Separator />
                                            <MenuItem Header="{l:T 'Save Profile'}" Command="{Binding SaveProfileCommand}" />
                                            <MenuItem Header="{l:T 'Merge Profile'}" Command="{Binding MergeProfileCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <!-- "Auto-build relations from all my actions" takes the place of the editor while it is open -->
                            <ScrollViewer Grid.Row="1" IsVisible="{Binding IsAnyRelationToolOpen}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12" Margin="0,0,10,0">
                                <!-- Manage with AI (whole profile) / Edit with AI (the open relation): a checked plan, one checkbox per step -->
                                <Border IsVisible="{Binding IsAiPlanPanelOpen}" Classes="surface">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Wand}" /></Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Classes="h2" Text="{Binding AiPlanTitle}" />
                                                <TextBlock Classes="caption" Text="{Binding AiPlanHint}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="icon ghost small" Tag="{StaticResource Icon.Close}" Content="{l:T 'Close'}" Command="{Binding CloseAiPlanCommand}" ToolTip.Tip="{l:T 'Back to the relation editor'}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding AiPlanText}" Watermark="{l:T 'What should change?'}" AcceptsReturn="False" />
                                            <Button Grid.Column="1" Classes="accent" Command="{Binding AskAiPlanCommand}" Content="{l:T 'Make a plan'}"
                                                    ToolTip.Tip="{l:T 'JoyPro (offline rules or your local AI model) makes a plan; nothing changes before you apply it'}" />
                                        </Grid>
                                        <TextBlock Classes="caption" Text="{Binding LlmServerStatusText}" IsVisible="{Binding LlmEnabled}" />
                                        <TextBlock Classes="caption" Text="{l:T 'The local AI model is off: only the simple requests of the examples work. Switch it on under Auto-build relations from all my actions > By description.'}"
                                                   IsVisible="{Binding !LlmEnabled}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AiPlanStatus}" TextWrapping="Wrap"
                                                   IsVisible="{Binding AiPlanStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <ItemsControl ItemsSource="{Binding AiPlanSteps}" IsVisible="{Binding HasAiPlanSteps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AiPlanStepItem">
                                                    <Border Classes="callout" Margin="0,2" Padding="8,6">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsValid}" VerticalAlignment="Top" />
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding HasChange}">
                                                                    <TextBlock Text="{l:T 'Before'}" Opacity="0.7" FontSize="12" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Before}" TextWrapping="Wrap" FontSize="12" />
                                                                </Grid>
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding HasChange}">
                                                                    <TextBlock Text="{l:T 'After'}" Opacity="0.7" FontSize="12" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding After}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#DC2626" TextWrapping="Wrap" FontSize="12" />
                                                                <TextBlock Text="{Binding Warnings}" IsVisible="{Binding HasWarnings}" Foreground="#D97706" TextWrapping="Wrap" FontSize="12" />
                                                                <Expander Header="{l:T 'Details'}" IsVisible="{Binding HasDetails}" HorizontalAlignment="Stretch" Padding="6,2">
                                                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="12" Opacity="0.85" />
                                                                </Expander>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- A fill step: summary, filters, relations with their proposed actions -->
                                        <StackPanel Spacing="6" IsVisible="{Binding HasAiFill}">
                                            <TextBlock Text="{Binding AiFillSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <WrapPanel>
                                                <TextBlock Text="{l:T 'Aircraft'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ComboBox ItemsSource="{Binding AiFillAircraftChoices}" SelectedItem="{Binding AiFillAircraftFilter}" MinWidth="180" Margin="0,0,12,0" />
                                                <TextBlock Text="{l:T 'Confidence'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ComboBox ItemsSource="{Binding AiFillConfidenceChoices}" SelectedItem="{Binding AiFillConfidenceFilter}" MinWidth="130"
                                                          ToolTip.Tip="{l:T 'high: rules and AI agree or the manual-checked catalog; medium: one path; ambiguous: the paths disagree (unticked)'}" />
                                            </WrapPanel>
                                            <ItemsControl ItemsSource="{Binding AiFillRelations}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:AiFillRelationItem">
                                                        <Expander IsVisible="{Binding IsVisible}" IsExpanded="{Binding IsExpanded}" HorizontalAlignment="Stretch" Margin="0,1">
                                                            <Expander.Header>
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <CheckBox IsChecked="{Binding IsSelected}" IsThreeState="True" />
                                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{l:T 'ambiguous'}" Foreground="#D97706" VerticalAlignment="Center" IsVisible="{Binding HasAmbiguous}" />
                                                                </StackPanel>
                                                            </Expander.Header>
                                                            <StackPanel Spacing="2">
                                                                <ItemsControl ItemsSource="{Binding Actions}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:AiFillActionItem">
                                                                            <Grid ColumnDefinitions="Auto,170,*,150" ColumnSpacing="8" Margin="0,1" IsVisible="{Binding IsVisible}">
                                                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding Where}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                                <StackPanel Grid.Column="2">
                                                                                    <TextBlock Text="{Binding Line}" TextWrapping="Wrap" />
                                                                                    <TextBlock Text="{Binding Why}" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />
                                                                                </StackPanel>
                                                                                <TextBlock Grid.Column="3" Text="{Binding SourceText}" FontSize="11" TextWrapping="Wrap" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="{l:T 'No match for: {0}', Arg0={Binding NoMatch}}" IsVisible="{Binding HasNoMatch}" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <WrapPanel IsVisible="{Binding HasAiPlanSteps}">
                                            <Button Classes="accent" Command="{Binding ApplyAiPlanCommand}" Content="{l:T 'Apply selected'}" Margin="0,0,8,0"
                                                    ToolTip.Tip="{l:T 'Runs the ticked steps as one change (Ctrl+Z undoes all of them)'}" />
                                            <Button Command="{Binding DiscardAiPlanCommand}" Content="{l:T 'Discard'}" ToolTip.Tip="{l:T 'Forget this plan; nothing changes'}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border IsVisible="{Binding IsAutoGroupPanelOpen}" Classes="surface">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Wand}" /></Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Classes="h2" Text="{l:T 'Auto-build relations from all my actions'}" />
                                                <TextBlock Classes="caption" Text="{l:T 'A wizard for the whole profile, shown here in place of your relation. Close it to get back to your relation.'}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <ToggleButton Classes="filterChip" Content="{l:T 'By function (Auto Group)'}" IsChecked="{Binding IsAutoGroupPanelOpen, Mode=OneWay}" Command="{Binding ShowOrganizeByFunctionCommand}" />
                                                <ToggleButton Classes="filterChip" Content="{l:T 'By description'}" IsChecked="{Binding IsDescribeGroupPanelOpen, Mode=OneWay}" Command="{Binding ShowOrganizeByDescriptionCommand}" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Classes="icon small" Tag="{StaticResource Icon.Close}" Content="{l:T 'Close and back to my relation'}" Command="{Binding CloseRelationToolsCommand}" ToolTip.Tip="{l:T 'Closes the wizard; your relation\'s view comes back'}" />
                                        </Grid>
                                        <TextBlock Classes="caption"
                                                   Text="{l:T 'Puts the same function of every DCS aircraft and every other game into one relation (verified against the manuals and game docs). Your existing relations keep their binds and only get the missing aircraft; commands you already use elsewhere stay where they are. Free slots are filled the way you do it in your profile.'}" />
                                        <WrapPanel>
                                            <TextBlock Text="{l:T 'Preset'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox ItemsSource="{Binding AutoGroupPresets}" SelectedItem="{Binding SelectedAutoGroupPreset}" MinWidth="320" Margin="0,0,12,0" />
                                            <CheckBox IsChecked="{Binding AutoGroupIncludeSubstitutes}" Content="{l:T 'Fill free slots with substitutes'}" Margin="0,0,12,0" />
                                            <CheckBox IsChecked="{Binding AutoGroupReplace}" Content="{l:T 'Replace earlier Auto Group relations'}" ToolTip.Tip="{l:T 'Removes relations tagged AutoGroup first (your own relations are never removed)'}" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBlock Text="{l:T 'Only aircraft / games (optional)'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding AutoGroupPlanes}" Watermark="{l:T 'e.g. F-16C_50|FA-18C_hornet|StarCitizen|MSFS'}" MinWidth="320" Margin="0,0,12,0" />
                                            <Button Command="{Binding PreviewAutoGroupCommand}" Content="{l:T 'Preview'}" Margin="0,0,8,0" />
                                            <Button Command="{Binding ApplyAutoGroupCommand}" Content="{l:T 'Apply'}" />
                                        </WrapPanel>
                                        <TextBox Text="{Binding AutoGroupPreview}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MaxHeight="380" MinHeight="80" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 IsVisible="{Binding AutoGroupPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Border>
                                <Border IsVisible="{Binding IsDescribeGroupPanelOpen}" Classes="surface">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Wand}" /></Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Classes="h2" Text="{l:T 'Auto-build relations from all my actions'}" />
                                                <TextBlock Classes="caption" Text="{l:T 'By description: several relations from one sentence, shown here in place of your relation. Close it to get back to your relation.'}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <ToggleButton Classes="filterChip" Content="{l:T 'By function (Auto Group)'}" IsChecked="{Binding IsAutoGroupPanelOpen, Mode=OneWay}" Command="{Binding ShowOrganizeByFunctionCommand}" />
                                                <ToggleButton Classes="filterChip" Content="{l:T 'By description'}" IsChecked="{Binding IsDescribeGroupPanelOpen, Mode=OneWay}" Command="{Binding ShowOrganizeByDescriptionCommand}" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Classes="icon small" Tag="{StaticResource Icon.Close}" Content="{l:T 'Close and back to my relation'}" Command="{Binding CloseRelationToolsCommand}" ToolTip.Tip="{l:T 'Closes the wizard; your relation\'s view comes back'}" />
                                        </Grid>
                                        <TextBlock Classes="caption"
                                                   Text="{l:T 'Describe what to group, the way you would say it: \'speed brake in and out on all jets\', \'gear up/down of every DCS warbird\', \'all trim hat up actions for helicopters\', \'flaps for all MSFS airliners and IL-2 bombers\'. JoyPro finds the functions and aircraft in its manual-checked catalog and shows every command with the reason. Commands you already use in another relation stay there.'}" />
                                        <WrapPanel>
                                            <TextBox Text="{Binding DescribeGroupText}" Watermark="{l:T 'Describe what to group'}" MinWidth="460" Margin="0,0,12,0" />
                                            <Button Command="{Binding PreviewDescribeGroupCommand}" Content="{l:T 'Preview'}" Margin="0,0,8,0" />
                                            <Button Command="{Binding CreateDescribeGroupCommand}" Content="{l:T 'Create'}" IsEnabled="{Binding HasDescribeGroupProposals}" ToolTip.Tip="{l:T 'Creates the ticked relations (unticked commands are left out)'}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding DescribeGroupStatus}" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace"
                                                   IsVisible="{Binding DescribeGroupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <ScrollViewer MaxHeight="420" IsVisible="{Binding HasDescribeGroupProposals}">
                                            <ItemsControl ItemsSource="{Binding DescribeGroupProposals}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:DescribeGroupProposalItem">
                                                        <Expander Margin="0,2" HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded}">
                                                            <Expander.Header>
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <CheckBox IsChecked="{Binding IsSelected}" />
                                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Expander.Header>
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="{l:T 'Understood from {0}', Arg0={Binding Why}}" Opacity="0.75" TextWrapping="Wrap" />
                                                                <ItemsControl ItemsSource="{Binding Nodes}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:DescribeGroupNodeItem">
                                                                            <Grid ColumnDefinitions="Auto,220,60,*" ColumnSpacing="8" Margin="0,2">
                                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" />
                                                                                <StackPanel Grid.Column="1">
                                                                                    <TextBlock Text="{Binding Where}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                                    <TextBlock Text="{Binding Id}" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />
                                                                                </StackPanel>
                                                                                <TextBlock Grid.Column="2" Text="{Binding ConfidenceText}" ToolTip.Tip="{l:T 'Confidence (catalog status x how well the aircraft fits the description)'}" />
                                                                                <StackPanel Grid.Column="3">
                                                                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12" />
                                                                                    <TextBlock Text="{Binding Kept}" IsVisible="{Binding HasKept}" Foreground="#D97706" TextWrapping="Wrap" FontSize="12" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="{Binding Missing}" IsVisible="{Binding HasMissing}" Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
                                                            </StackPanel>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <Expander Header="{l:T 'Local AI model (optional)'}" HorizontalAlignment="Stretch" IsExpanded="{Binding IsLlmSectionExpanded}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Classes="caption"
                                                           Text="{l:T 'The offline rules always work. A free open-source language model can help with unusual descriptions: it only picks from the functions and aircraft the rules found, and JoyPro checks every answer. It runs on this PC only while you use it (it stops after the idle minutes below) and is not part of JoyPro: it is downloaded only when you click Download, or you use a llama.cpp and model you already have.'}" />
                                                <CheckBox IsChecked="{Binding LlmEnabled}" Content="{l:T 'Use local AI model'}" />
                                                <TextBlock Text="{Binding LlmStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LlmHardwareText}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LlmRecommendationText}" TextWrapping="Wrap" />
                                                <WrapPanel>
                                                    <TextBlock Text="{l:T 'Model'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <ComboBox ItemsSource="{Binding LlmModels}" SelectedItem="{Binding SelectedLlmModel}" MinWidth="420" Margin="0,0,12,0" />
                                                    <TextBlock Text="{l:T 'Runtime'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <ComboBox ItemsSource="{Binding LlmRuntimeChoices}" SelectedItem="{Binding SelectedLlmRuntime}" MinWidth="110" Margin="0,0,12,0"
                                                              ToolTip.Tip="{l:T 'auto = Vulkan build with a graphics card (small download), else CPU; cuda = NVIDIA build with the CUDA runtime (about 600 MB)'}" />
                                                    <Button Command="{Binding RefreshLlmStatusCommand}" Content="{l:T 'Refresh'}" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding LlmLicenseText}" TextWrapping="Wrap" Opacity="0.85" />
                                                <WrapPanel>
                                                    <CheckBox IsChecked="{Binding LlmLicenseAccepted}" Content="{l:T 'I accept the size and the licenses above'}" Margin="0,0,12,0" />
                                                    <Button Command="{Binding DownloadLlmModelCommand}" Content="{l:T 'Download and switch on'}" Margin="0,0,8,0" IsEnabled="{Binding LlmLicenseAccepted}"
                                                            ToolTip.Tip="{l:T 'Downloads llama.cpp and the model, checks the SHA-256 checksums and switches the local AI model on'}" />
                                                    <Button Command="{Binding CancelLlmDownloadCommand}" Content="{l:T 'Cancel download'}" Margin="0,0,8,0" IsVisible="{Binding IsLlmDownloading}" />
                                                    <Button Command="{Binding RemoveLlmModelCommand}" Content="{l:T 'Remove model'}" />
                                                </WrapPanel>
                                                <!-- Running or stopped, the model and its memory, Stop now, the idle stop -->
                                                <Border Classes="surface" Padding="8,6">
                                                    <WrapPanel>
                                                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#16A34A" IsVisible="{Binding LlmServerRunning}" />
                                                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#9CA3AF"
                                                                 IsVisible="{Binding !LlmServerRunning}" />
                                                        <TextBlock Text="{Binding LlmServerStatusText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Margin="0,0,12,0" />
                                                        <Button Command="{Binding StopLlmServerCommand}" Content="{l:T 'Stop now'}" IsEnabled="{Binding LlmServerRunning}" Margin="0,0,12,0"
                                                                ToolTip.Tip="{l:T 'Ends the local AI model at once and frees its memory (the next request loads it again)'}" />
                                                        <TextBlock Text="{l:T 'Stop after'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <NumericUpDown Value="{Binding LlmIdleMinutes}" Minimum="0.5" Maximum="120" Increment="1" FormatString="0.#" Width="110"
                                                                       ToolTip.Tip="{l:T 'The model stays loaded this long after a request, so the next one answers faster'}" />
                                                        <TextBlock Text="{l:T 'idle minutes'}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                    </WrapPanel>
                                                </Border>
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding LlmDownloadPercent}" Height="10" IsVisible="{Binding IsLlmDownloading}" />
                                                <TextBlock Text="{Binding LlmDownloadText}" TextWrapping="Wrap"
                                                           IsVisible="{Binding LlmDownloadText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Text="{l:T 'Already have llama.cpp and a GGUF model?'}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                                <TextBlock Classes="caption"
                                                           Text="{l:T 'Use your own llama-server.exe and .gguf file instead of a download. JoyPro starts it on this PC for a request and stops it after the idle minutes above.'}" />
                                                <WrapPanel>
                                                    <TextBlock Text="llama-server.exe" VerticalAlignment="Center" Width="110" />
                                                    <TextBox Text="{Binding LlmLocalServerPath}" Watermark="C:\llama.cpp\llama-server.exe" MinWidth="420" Margin="0,0,8,0" />
                                                    <Button Content="{l:T 'Browse...'}" Click="BrowseLlmServerClicked" />
                                                </WrapPanel>
                                                <WrapPanel>
                                                    <TextBlock Text="{l:T 'GGUF model'}" VerticalAlignment="Center" Width="110" />
                                                    <TextBox Text="{Binding LlmLocalModelPath}" Watermark="model.gguf" MinWidth="420" Margin="0,0,8,0" />
                                                    <Button Content="{l:T 'Browse...'}" Click="BrowseLlmModelClicked" />
                                                </WrapPanel>
                                                <WrapPanel>
                                                    <Button Command="{Binding FindLocalLlmCommand}" Content="{l:T 'Find on this PC'}" Margin="0,0,8,0" ToolTip.Tip="{l:T 'Looks for llama-server.exe and GGUF models in the usual folders (read-only) and picks the pair that suits this PC'}" />
                                                    <Button Command="{Binding UseLocalLlmCommand}" Content="{l:T 'Use these files'}" Margin="0,0,8,0" />
                                                    <Button Command="{Binding ClearLocalLlmCommand}" Content="{l:T 'Stop using them'}" IsVisible="{Binding IsLlmUsingLocal}" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding LlmLocalText}" TextWrapping="Wrap"
                                                           IsVisible="{Binding LlmLocalText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- The editor: the open relation on the left, Add actions / Suggested / the assistant on the right -->
                            <Border x:Name="RelationNodeEditorGrid" Grid.Row="1" Classes="surface" IsVisible="{Binding IsNoRelationToolOpen}" MinHeight="0" Padding="12">
                                <Grid ColumnDefinitions="5*,14,7*" MinHeight="0">
                                    <!-- Left: the open relation (name in place, its actions), a new relation's name, or how to start -->
                                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8" MinHeight="0">
                                        <!-- The profile check (relations check-aircraft): the open relation's question, and a link for all relations -->
                                        <StackPanel Grid.Row="1" Spacing="6">
                                            <Border x:Name="RelationCheckBanner" Classes="callout" Padding="8,6" IsVisible="{Binding HasAircraftCheckNotice}">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <PathIcon Data="{StaticResource Icon.Info}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" Foreground="{DynamicResource StatusInfoBrush}" />
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="{Binding RelationCheckHeadline}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding RelationCheckText}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <WrapPanel ItemSpacing="6" LineSpacing="4" Margin="24,0,0,0">
                                                        <Button Classes="small accent" Command="{Binding OnlyWhereSameMeaningCommand}"
                                                                ToolTip.Tip="{l:T 'Switches this relation off in those aircraft, except the ones ticked use here in the list. They stay listed, one tick brings one back; Ctrl+Z undoes it.'}" >
                                                            <TextBlock Text="{Binding RelationCheckOnlyLabel}" TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                        <Button Classes="small" Content="{l:T 'Keep for all'}" Command="{Binding KeepRelationCheckForAllCommand}"
                                                                ToolTip.Tip="{l:T 'The relation stays for all these aircraft; JoyPro does not ask about them again'}" />
                                                        <Button Classes="small ghost" Content="{l:T 'Ask me later'}" Command="{Binding DismissAircraftCheckCommand}"
                                                                ToolTip.Tip="{l:T 'Hide this question for now'}" />
                                                    </WrapPanel>
                                                    <Button Classes="small ghost" Margin="24,0,0,0" Padding="4,0" Content="{Binding RelationCheckToggleText}" Command="{Binding ToggleRelationCheckExpandedCommand}" />
                                                    <ScrollViewer Margin="24,0,0,0" MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding RelationCheckExpanded}">
                                                        <ItemsControl ItemsSource="{Binding RelationCheckItems}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:AircraftCheckItem">
                                                                    <StackPanel Spacing="2">
                                                                        <TextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding Header}" IsVisible="{Binding #RootWindow.DataContext.HasSeveralRelationCheckItems}" />
                                                                        <ItemsControl ItemsSource="{Binding Planes}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:AircraftCheckPlane">
                                                                                    <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="8" Margin="0,1">
                                                                                        <TextBlock Text="{Binding Plane}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Plane}" />
                                                                                        <TextBlock Grid.Column="1" Text="{Binding TitleText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding TitleText}" />
                                                                                        <CheckBox Grid.Column="2" Content="{l:T 'use here'}" IsChecked="{Binding UseHere}" VerticalAlignment="Center"
                                                                                                  ToolTip.Tip="{l:T 'Keep this relation in this aircraft too'}" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>
                                            <Button Classes="small ghost" HorizontalAlignment="Left" Padding="4,0" IsVisible="{Binding HasProfileCheckLink}" Content="{Binding ProfileCheckLinkText}"
                                                    Command="{Binding ToggleProfileCheckCommand}"
                                                    ToolTip.Tip="{l:T 'Every relation with aircraft where its command does something else'}" />
                                            <Border Classes="sunken" Padding="8,6" IsVisible="{Binding ProfileCheckExpanded}">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding AircraftCheckText}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Classes="small" Content="{l:T 'Switch them all off'}" Command="{Binding RepairAircraftCommand}" VerticalAlignment="Center"
                                                                ToolTip.Tip="{l:T 'Switches those aircraft off in every one of these actions: they stay listed, one tick brings one back; Ctrl+Z undoes it.'}" />
                                                    </Grid>
                                                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding AircraftCheckItems}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:AircraftCheckItem">
                                                                    <Button Classes="ghost small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                            Command="{Binding #RootWindow.DataContext.OpenAircraftCheckRelationCommand}" CommandParameter="{Binding}"
                                                                            ToolTip.Tip="{l:T 'Open this relation'}">
                                                                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>
                                            <!-- MSFS 2024 import: binds the sim has only in some aircraft's profiles came in for all aircraft -->
                                            <Border Classes="callout" Padding="8,6" IsVisible="{Binding HasMsfsAircraftOnlyBinds}">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                        <TextBlock Text="{Binding MsfsAircraftOnlyTitle}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Classes="small accent" Content="{l:T 'Limit all'}" Command="{Binding LimitAllMsfsAircraftOnlyBindsCommand}" VerticalAlignment="Center"
                                                                ToolTip.Tip="{l:T 'Each of them only for the aircraft whose profiles in the sim had it. Ctrl+Z undoes one at a time.'}" />
                                                        <Button Grid.Column="2" Classes="small ghost" Content="{l:T 'Keep for all aircraft'}" Command="{Binding DismissMsfsAircraftOnlyBindsCommand}" VerticalAlignment="Center"
                                                                ToolTip.Tip="{l:T 'Hide this notice'}" />
                                                    </Grid>
                                                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding MsfsAircraftOnlyBinds}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:MsfsAircraftOnlyBind">
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,1">
                                                                        <TextBlock Classes="caption" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                        <Button Grid.Column="1" Classes="small ghost" Content="{l:T 'Limit to these aircraft'}" VerticalAlignment="Center"
                                                                                Command="{Binding #RootWindow.DataContext.LimitMsfsAircraftOnlyBindCommand}" CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Panel>
                                            <StackPanel IsVisible="{Binding HasRelationSelected}" Spacing="6">
                                                <TextBox x:Name="RelationNameEditBox" Text="{Binding BuilderRenameText}" FontSize="17" FontWeight="Bold"
                                                         KeyDown="RelationNameEditKeyDown" LostFocus="RelationNameEditLostFocus"
                                                         ToolTip.Tip="{l:T 'The relation\'s name: click to change it, Enter saves, Esc cancels (Ctrl+Z undoes a rename)'}" />
                                                <WrapPanel ItemSpacing="6" LineSpacing="4">
                                                    <Border Classes="chip axis" IsVisible="{Binding SelectedRelation.IsAxis}" ToolTip.Tip="{l:T 'An axis relation: only axes go in'}"><TextBlock Text="{l:T 'Axis'}" /></Border>
                                                    <Border Classes="chip" IsVisible="{Binding !SelectedRelation.IsAxis}" ToolTip.Tip="{l:T 'A button relation: only buttons go in'}"><TextBlock Text="{l:T 'Button'}" /></Border>
                                                    <Border Classes="keycap" IsVisible="{Binding SelectedRelation.IsBound}" ToolTip.Tip="{Binding SelectedRelation.BindTooltip}">
                                                        <DockPanel MaxWidth="360">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedRelation.BindInputPart}" />
                                                            <TextBlock Text="{Binding SelectedRelation.BindDevice}" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Border>
                                                    <ItemsControl ItemsSource="{Binding SelectedRelation.ModifierChips}" IsVisible="{Binding SelectedRelation.HasModifierChips}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Classes="chip modifier" VerticalAlignment="Center" ToolTip.Tip="{l:T 'Modifier: hold it for this bind'}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                                        <PathIcon Data="{StaticResource Icon.Shift}" />
                                                                        <TextBlock Text="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Classes="small ghost" IsVisible="{Binding SelectedRelation.IsUnbound}" Content="{l:T 'Not bound yet: Binds page'}" Command="{Binding BindSelectedRelationCommand}"
                                                            ToolTip.Tip="{l:T 'Binding happens on the Binds page: this opens it with this relation selected'}" />
                                                    <Border Classes="chip ok" IsVisible="{Binding HasBuilderFunction}" ToolTip.Tip="{l:T 'The function JoyPro reads from its actions: {0}', Arg0={Binding BuilderFunctionText}}">
                                                        <TextBlock Text="{Binding BuilderFunctionText}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </WrapPanel>
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                                    <TextBlock Classes="h3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{l:T 'Its actions ({0})', Arg0={Binding RelationNodes.Count}}" />
                                                    <Button Grid.Column="3" Classes="icon small danger iconOnly" Tag="{StaticResource Icon.Delete}" Command="{Binding DeleteSelectedRelationCommand}"
                                                            ToolTip.Tip="{l:T 'Delete this relation (asks first; Ctrl+Z undoes it)'}" />
                                                    <Button Grid.Column="1" Classes="icon small accent" Tag="{StaticResource Icon.Lightbulb}" Content="{Binding SuggestMissingLabel}" Command="{Binding SuggestMissingCommand}"
                                                            ToolTip.Tip="{l:T 'Expand this relation: the same function in the games and aircraft it does not have yet, without the actions other relations use (no AI). Tick, add.'}" />
                                                    <Button Grid.Column="2" Classes="icon small" Tag="{StaticResource Icon.Wand}" Content="{l:T 'Expand with AI'}" Command="{Binding ExpandWithAiCommand}"
                                                            ToolTip.Tip="{l:T 'Explain in your own words what else belongs in this relation, or what does not: the JoyPro assistant adds or removes it at once (one Undo takes it back)'}" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel IsVisible="{Binding ShowNewRelationCard}" Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Classes="h2" Text="{l:T 'New relation'}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Classes="icon ghost small" Tag="{StaticResource Icon.Close}" Content="{l:T 'Cancel'}" Command="{Binding CloseNewRelationFormCommand}"
                                                            ToolTip.Tip="{l:T 'Do not make a new relation'}" />
                                                </Grid>
                                                <TextBox x:Name="NewRelationNameBox" Text="{Binding RelationNameInput}" Watermark="{l:T 'Its name, e.g. Throttle ALL'}"
                                                         ToolTip.Tip="{l:T 'The new relation\'s name (left empty: it is named after its first action)'}" />
                                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                                           Text="{l:T 'Search on the right what it does, tick the actions of every game that belong, then press Create relation.'}" />
                                                <TextBlock Classes="warnText" FontSize="11.5" TextWrapping="Wrap" Text="{Binding RelationCreateValidationMessage}" IsVisible="{Binding HasRelationCreateValidationMessage}" />
                                            </StackPanel>
                                            <StackPanel IsVisible="{Binding ShowStartSmall}" Spacing="6">
                                                <TextBlock Classes="h2" Text="{l:T 'Pick a relation or make one'}" TextWrapping="Wrap" />
                                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                                           Text="{l:T 'A relation is one function (e.g. the throttle) of all your games and aircraft. It goes on one input of one of your devices; you bind it on the Binds page.'}" />
                                            </StackPanel>
                                        </Panel>

                                        <Panel Grid.Row="2" MinHeight="0">
                                            <ListBox x:Name="RelationNodeList" Classes="cards" ItemsSource="{Binding RelationNodes}" SelectedItem="{Binding SelectedRelationNode}" IsVisible="{Binding ShowRelationNodeList}"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:RelationNodeItem">
                                                      <StackPanel Spacing="4">
                                                        <!-- A click on the action opens (or closes) its aircraft: what the id means in each, a tick each -->
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Background="Transparent" Tapped="RelationNodeHeaderTapped">
                                                            <Panel VerticalAlignment="Center" Width="34" Height="34">
                                                                <controls:GameBadge GameId="{Binding Game}" Title="{Binding GameLabel}" />
                                                                <Image Source="{Binding GameCover}" Stretch="UniformToFill" IsVisible="{Binding GameCover, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                            </Panel>
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TitlesSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TitlesDisplay}" />
                                                                <TextBlock Classes="caption" Text="{Binding DetailsText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PlanesDisplay}" />
                                                            </StackPanel>
                                                            <!-- The chevron: the action's aircraft open or close (the whole header row does the same) -->
                                                            <Button x:Name="RelationNodeChevron" Grid.Column="2" Classes="small ghost" Padding="4" VerticalAlignment="Center" IsVisible="{Binding HasAircraft}"
                                                                    Command="{Binding #RootWindow.DataContext.ToggleNodeAircraftCommand}" CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{l:T 'Show or hide the aircraft of this action'}">
                                                                <Panel Width="14" Height="14">
                                                                    <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="14" Height="14" IsVisible="{Binding !Aircraft.IsExpanded, FallbackValue=True}" />
                                                                    <PathIcon Data="{StaticResource Icon.ChevronUp}" Width="14" Height="14" IsVisible="{Binding Aircraft.IsExpanded, FallbackValue=False}" />
                                                                </Panel>
                                                            </Button>
                                                            <Button Grid.Column="3" Classes="icon small ghost iconOnly" Tag="{StaticResource Icon.Close}"
                                                                    Command="{Binding #RootWindow.DataContext.RemoveNodeCommand}" CommandParameter="{Binding}" VerticalAlignment="Center"
                                                                    ToolTip.Tip="{l:T 'Remove this action from the relation (Ctrl+Z undoes it)'}" />
                                                        </Grid>
                                                        <!-- Its aircraft: "82 of 84 aircraft", mixed meanings flagged, editable at any time -->
                                                        <StackPanel Margin="42,0,0,0" Spacing="4" IsVisible="{Binding HasAircraft}">
                                                            <Border Classes="callout" Padding="8,4" IsVisible="{Binding IsMixed}">
                                                                <TextBlock Text="{Binding MixedText}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" />
                                                            </Border>
                                                            <WrapPanel ItemSpacing="6" LineSpacing="4">
                                                                <Button Classes="small ghost" Padding="4,0" Command="{Binding Aircraft.ToggleExpandedCommand}"
                                                                        ToolTip.Tip="{l:T 'Every aircraft with this id, each with its own title and category: tick the ones this action is for'}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <PathIcon Data="{StaticResource Icon.Airplane}" Width="12" Height="12" />
                                                                        <TextBlock Text="{Binding Aircraft.ExpandLabel, FallbackValue=''}" FontSize="11.5" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <TextBlock Classes="caption" FontSize="11" Text="{Binding ExcludedText}" IsVisible="{Binding HasExcluded}" VerticalAlignment="Center" />
                                                                <Button Classes="small accent" Content="{l:T 'Apply'}" IsVisible="{Binding Aircraft.HasChanges, FallbackValue=False}"
                                                                        Command="{Binding #RootWindow.DataContext.ApplyNodeAircraftCommand}" CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{l:T 'Saves the ticks: the action is exported for the ticked aircraft only (Ctrl+Z undoes it)'}" />
                                                                <Button Classes="small ghost" Content="{l:T 'Reset'}" IsVisible="{Binding Aircraft.HasChanges, FallbackValue=False}"
                                                                        Command="{Binding #RootWindow.DataContext.ResetNodeAircraftCommand}" CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{l:T 'Back to the ticks the relation has'}" />
                                                            </WrapPanel>
                                                            <Panel IsVisible="{Binding Aircraft.IsExpanded, FallbackValue=False}">
                                                                <controls:AircraftSelectorPanel DataContext="{Binding Aircraft}" />
                                                            </Panel>
                                                        </StackPanel>
                                                      </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Border Classes="sunken" Padding="10" IsVisible="{Binding HasBuilderNoNodes}" VerticalAlignment="Top">
                                                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:T 'No actions yet. Search on the right, tick what belongs and press Add selected.'}" />
                                            </Border>
                                            <Grid x:Name="RelationStartSteps" IsVisible="{Binding HasNoRelationSelected}" VerticalAlignment="Top" Margin="0,6,0,0" ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                                <Border Classes="keycap"><TextBlock Text="1" /></Border>
                                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{l:T 'New relation: give it a name.'}" />
                                                <Border Grid.Row="1" Classes="keycap"><TextBlock Text="2" /></Border>
                                                <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="{l:T 'Add actions: search what it does in every game, tick what belongs, press Create relation.'}" />
                                                <Border Grid.Row="2" Classes="keycap"><TextBlock Text="3" /></Border>
                                                <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Text="{l:T 'Suggested for this relation: JoyPro shows the same function in your other games. Or ask the JoyPro assistant.'}" />
                                                <Border Grid.Row="3" Classes="keycap"><TextBlock Text="4" /></Border>
                                                <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Text="{l:T 'Bind it to an input of your devices on the Binds page. Ctrl+Z undoes any change.'}" />
                                            </Grid>
                                        </Panel>

                                        <Expander Grid.Row="3" Header="{Binding BuilderDismissedHeader}" IsVisible="{Binding HasBuilderDismissed}" HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="{l:T 'Suggestions you dismissed for this relation: they are not suggested again'}">
                                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding BuilderDismissed}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:BuilderDismissedItem">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,2">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                                                                    <TextBlock Classes="caption" Text="{Binding Where}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Classes="small ghost" Content="{l:T 'Restore'}" VerticalAlignment="Center"
                                                                        Command="{Binding #RootWindow.DataContext.RestoreBuilderDismissedCommand}" CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{l:T 'It may be suggested again'}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Expander>
                                    </Grid>

                                    <!-- Right: Add actions, Suggested for this relation, the JoyPro assistant -->
                                    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" RowSpacing="6" MinHeight="0">
                                        <WrapPanel ItemSpacing="6" LineSpacing="6">
                                            <ToggleButton Classes="icon" Tag="{StaticResource Icon.Search}" Content="{l:T 'Add actions'}" IsChecked="{Binding IsBuilderAddPanel, Mode=OneWay}"
                                                          Command="{Binding ShowBuilderFindCommand}"
                                                          ToolTip.Tip="{l:T 'Search every game and aircraft at once, tick what belongs and add it with one click (Ctrl+Shift+F)'}" />
                                            <ToggleButton Classes="icon" Tag="{StaticResource Icon.Lightbulb}" Content="{Binding BuilderSuggestedTabLabel}" IsChecked="{Binding IsBuilderSuggestedPanel, Mode=OneWay}"
                                                          Command="{Binding ShowBuilderSuggestedCommand}" IsEnabled="{Binding HasRelationSelected}"
                                                          ToolTip.Tip="{l:T 'What means the same in your other games and aircraft, from JoyPro\'s function catalog, each with the reason'}" />
                                            <ToggleButton Classes="icon" Tag="{StaticResource Icon.Database}" Content="{l:T 'Catalog'}" IsChecked="{Binding IsBuilderCatalogPanel, Mode=OneWay}"
                                                          Command="{Binding OpenCatalogCommand}"
                                                          ToolTip.Tip="{l:T 'Browse everything a game or aircraft has, by its own categories, and see what is bound already: tick what you want and add it'}" />
                                            <ToggleButton Classes="icon" Tag="{StaticResource Icon.Send}" Content="{l:T 'JoyPro assistant'}" IsChecked="{Binding IsBuilderAssistantPanel, Mode=OneWay}"
                                                          Command="{Binding ShowBuilderAssistantCommand}"
                                                          ToolTip.Tip="{l:T 'Say in a sentence what you want: JoyPro creates and fills relations directly, one Undo per answer. Free sentences need the optional local AI model.'}" />
                                        </WrapPanel>
                                        <Panel Grid.Row="1">
                                            <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsBuilderSuggestedPanel}"
                                                       Text="{l:T 'The same function in the games and aircraft this relation does not have yet first (no AI). Tick and Add ticked, Add, or dismiss (x).'}" />
                                            <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsBuilderMissingAllPanel}"
                                                       Text="{l:T 'Every relation with what it lacks: actions of games and aircraft it has none for, that no other relation uses.'}" />
                                            <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsBuilderAssistantPanel}"
                                                       Text="{l:T 'Changes happen at once; Undo in an answer takes it all back.'}" />
                                            <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsBuilderCatalogPanel}"
                                                       Text="{l:T 'Everything the game or aircraft has, by its categories. Tick what belongs and press Add selected.'}" />
                                        </Panel>

                                        <!-- Add actions: one search, tick rows, Add selected -->
                                        <Grid Grid.Row="2" IsVisible="{Binding IsBuilderAddPanel}" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="6" MinHeight="0">
                                            <!-- The search, the kind (a relation holds axes or buttons) and the aircraft -->
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                                <Button Grid.Column="3" Classes="icon small" Tag="{StaticResource Icon.Database}" Content="{l:T 'Open catalog'}" Command="{Binding OpenCatalogCommand}"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="{l:T 'Browse every action of a game or aircraft by its categories (not only what the search finds)'}" />
                                                <TextBox x:Name="RelationNodeSearchTextBox" Classes="search" Text="{Binding BuilderSearchText}" KeyDown="RelationNodeSearchTextBoxKeyDown"
                                                         Watermark="{l:T 'What does it do? throttle, flare, gear ...'}"
                                                         ToolTip.Tip="{l:T 'Searches the actions of every game and aircraft while you type: the words of the title, the function and its synonyms (throttle also finds thrust and the helicopter collective)'}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                    <ToggleButton Classes="filterChip" Content="{l:T 'All'}" IsChecked="{Binding IsBuilderKindAny, Mode=OneWay}" Command="{Binding SetBuilderKindCommand}" CommandParameter="any"
                                                                  IsEnabled="{Binding CanChangeBuilderKind}" ToolTip.Tip="{l:T 'Axes and buttons. {0}', Arg0={Binding BuilderKindHint}}" />
                                                    <ToggleButton Classes="filterChip" Content="{l:T 'Axes'}" IsChecked="{Binding IsBuilderKindAxis, Mode=OneWay}" Command="{Binding SetBuilderKindCommand}" CommandParameter="axis"
                                                                  IsEnabled="{Binding CanChangeBuilderKind}" ToolTip.Tip="{l:T 'Only axes. {0}', Arg0={Binding BuilderKindHint}}" />
                                                    <ToggleButton Classes="filterChip" Content="{l:T 'Buttons'}" IsChecked="{Binding IsBuilderKindButton, Mode=OneWay}" Command="{Binding SetBuilderKindCommand}" CommandParameter="button"
                                                                  IsEnabled="{Binding CanChangeBuilderKind}" ToolTip.Tip="{l:T 'Only buttons. {0}', Arg0={Binding BuilderKindHint}}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="icon iconOnly" Tag="{StaticResource Icon.Airplane}" Command="{Binding OpenBuilderPlanePickerCommand}"
                                                        ToolTip.Tip="{l:T 'Only some aircraft: pick them here'}">
                                                    <Button.Flyout>
                                                        <Flyout Placement="BottomEdgeAlignedRight">
                                                            <StackPanel Spacing="6" Width="300">
                                                                <TextBox Text="{Binding BuilderPlaneFilterText}" Watermark="{l:T 'Type an aircraft, e.g. F-16'}" />
                                                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                    <ItemsControl ItemsSource="{Binding BuilderPlaneOptions}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="x:String">
                                                                                <Button Classes="ghost small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding}"
                                                                                        Command="{Binding #RootWindow.DataContext.AddBuilderSearchPlaneCommand}" CommandParameter="{Binding}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </ScrollViewer>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                            <!-- The picked aircraft and the games of the result (none ticked = every game): they wrap, never scroll sideways -->
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding BuilderSearchPlanes}" IsVisible="{Binding HasBuilderSearchPlanes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Button Classes="small accent" Command="{Binding #RootWindow.DataContext.RemoveBuilderSearchPlaneCommand}" CommandParameter="{Binding}"
                                                                ToolTip.Tip="{l:T 'Remove this aircraft filter'}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <PathIcon Data="{StaticResource Icon.Airplane}" Width="12" Height="12" />
                                                                <TextBlock Text="{Binding}" />
                                                                <PathIcon Data="{StaticResource Icon.Close}" Width="10" Height="10" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="4" IsVisible="{Binding HasBuilderSearchResults}">
                                                <ItemsControl ItemsSource="{Binding BuilderSearchGamesTop}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:BuilderGameChip">
                                                            <ToggleButton Classes="filterChip" Content="{Binding Label}" IsChecked="{Binding IsSelected}" ToolTip.Tip="{l:T 'Only this game (several: any of them; none: every game)'}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Grid.Column="1" Classes="small ghost" VerticalAlignment="Top" Content="{Binding BuilderMoreGamesLabel}" IsVisible="{Binding HasMoreBuilderSearchGames}"
                                                        ToolTip.Tip="{l:T 'The other games of this result'}">
                                                    <Button.Flyout>
                                                        <Flyout Placement="BottomEdgeAlignedRight">
                                                            <ItemsControl ItemsSource="{Binding BuilderSearchGamesMore}" Width="340">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:BuilderGameChip">
                                                                        <ToggleButton Classes="filterChip" Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel Spacing="2">
                                                    <Button Classes="small ghost" HorizontalAlignment="Left" Padding="2,0" IsVisible="{Binding HasBuilderDidYouMean}" Command="{Binding UseBuilderDidYouMeanCommand}"
                                                            Content="{l:T 'Did you mean: {0}?', Arg0={Binding BuilderDidYouMean}}" ToolTip.Tip="{l:T 'Search for this instead'}" />
                                                    <TextBlock Classes="caption" Text="{Binding BuilderSearchStatus}" TextWrapping="Wrap"
                                                               IsVisible="{Binding BuilderSearchStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <TextBlock Classes="caption" Text="{Binding BuilderSearchHint}" TextWrapping="Wrap"
                                                               IsVisible="{Binding BuilderSearchStatus, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" ItemSpacing="4" LineSpacing="4" VerticalAlignment="Top" IsVisible="{Binding HasBuilderSearchResults}" MaxWidth="260">
                                                    <Button Classes="small ghost" Content="{l:T 'Expand all'}" IsVisible="{Binding CanExpandAllBuilderGames}" Command="{Binding ExpandAllBuilderGamesCommand}"
                                                            ToolTip.Tip="{l:T 'Every action of every game for this search (ticks stay)'}" />
                                                    <Button Classes="small ghost" Content="{l:T 'Collapse all'}" IsVisible="{Binding CanCollapseAllBuilderGames}" Command="{Binding CollapseAllBuilderGamesCommand}"
                                                            ToolTip.Tip="{l:T 'Only the best rows of each game again (ticks stay)'}" />
                                                    <ToggleButton Classes="filterChip" Content="{l:T 'By function'}" IsChecked="{Binding BuilderGroupByFunction}"
                                                                  ToolTip.Tip="{l:T 'Group the rows by the function they are (throttle, collective ...) instead of by game'}" />
                                                </WrapPanel>
                                                <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="60" VerticalAlignment="Top" IsVisible="{Binding IsBuilderSearching}" />
                                            </Grid>
                                            <ScrollViewer x:Name="BuilderSearchScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="0">
                                                <ItemsControl ItemsSource="{Binding BuilderSearchRows}" Margin="0,0,12,0">
                                                    <ItemsControl.DataTemplates>
                                                        <DataTemplate x:DataType="models:BuilderSearchGroupItem">
                                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,8,0,2">
                                                                <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding HasTickable}" VerticalAlignment="Center"
                                                                          ToolTip.Tip="{l:T 'Select all / none: tick or untick every action of this group shown here'}" />
                                                                <Button Grid.Column="3" Classes="small ghost" Content="{Binding ExpandLabel}" IsVisible="{Binding CanExpand}" VerticalAlignment="Center"
                                                                        Command="{Binding #RootWindow.DataContext.ToggleBuilderGameExpandedCommand}" CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{Binding ExpandTooltip}" />
                                                                <Panel Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center" IsVisible="{Binding IsGame}">
                                                                    <controls:GameBadge GameId="{Binding Game}" Title="{Binding Label}" />
                                                                </Panel>
                                                                <PathIcon Grid.Column="1" Data="{StaticResource Icon.Lightbulb}" Width="16" Height="16" IsVisible="{Binding !IsGame}"
                                                                          Foreground="{DynamicResource JP.AccentTextBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding Label}" FontWeight="Bold" />
                                                                    <Run Text="  " />
                                                                    <Run Text="{Binding CountText}" Foreground="{DynamicResource JP.TextMutedBrush}" FontSize="12" />
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                        <DataTemplate x:DataType="models:BuilderSearchResultItem">
                                                          <StackPanel Margin="26,1,0,1" Spacing="2">
                                                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                      ToolTip.Tip="{Binding PlanesTooltip}">
                                                                <StackPanel Spacing="1">
                                                                    <controls:HighlightTextBlock SourceText="{Binding DisplayTitle}" Query="{Binding #RootWindow.DataContext.BuilderSearchText}" FontWeight="SemiBold"
                                                                                                 TextTrimming="CharacterEllipsis" />
                                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                                        <TextBlock Classes="caption" TextTrimming="CharacterEllipsis" Text="{Binding PlanesText}" />
                                                                        <Border Grid.Column="1" Classes="chip" Classes.ok="{Binding IsStrongMatch}" IsVisible="{Binding HasMatch}"
                                                                                ToolTip.Tip="{l:T 'How JoyPro found it: main control (the function\'s own axis in this game), exact title, same function, synonym, described, or a word match'}">
                                                                            <TextBlock Text="{Binding MatchLabel}" />
                                                                        </Border>
                                                                        <TextBlock Grid.Column="2" Classes="caption" Text="{Binding KindLabel}" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                    <TextBlock Classes="caption" FontSize="10.5" Opacity="0.75" Text="{Binding IdText}" IsVisible="{Binding HasIdText}" TextTrimming="CharacterEllipsis"
                                                                               ToolTip.Tip="{l:T 'The game\'s own id of the action'}" />
                                                                    <WrapPanel ItemSpacing="6" IsVisible="{Binding IsRecommended}">
                                                                        <Border Classes="chip recommended" ToolTip.Tip="{l:T 'The one action to take in this game (or aircraft): the function\'s main control, not a variant'}">
                                                                            <TextBlock Text="{Binding RecommendedLabel}" />
                                                                        </Border>
                                                                    </WrapPanel>
                                                                    <TextBlock Classes="warnText" FontSize="11" Text="{Binding VariantText}" IsVisible="{Binding HasVariant}" TextWrapping="Wrap" />
                                                                    <TextBlock Classes="caption" FontSize="11" Text="{Binding OnlyForText}" IsVisible="{Binding HasOnlyFor}" TextTrimming="CharacterEllipsis"
                                                                               ToolTip.Tip="{l:T 'This action exists only for these aircraft (their own controls): adding it ticks them alone'}" />
                                                                    <TextBlock Classes="caption" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding WhyText}" IsVisible="{Binding HasWhy}" Opacity="0.85" />
                                                                    <TextBlock Classes="caption" FontSize="11" Text="{Binding Explanation}" IsVisible="{Binding HasExplanation}" TextWrapping="Wrap" MaxLines="2"
                                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ExplanationTip}" />
                                                                    <TextBlock Classes="warnText" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding InOtherRelationsText}" IsVisible="{Binding HasNote}" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                            <!-- The row's aircraft, each with its own title of the id: only the ticked ones go in -->
                                                            <StackPanel Margin="28,0,0,0" Spacing="4" IsVisible="{Binding HasAircraft}">
                                                                <WrapPanel ItemSpacing="6" LineSpacing="4">
                                                                    <Button Classes="small ghost" Padding="4,0" Command="{Binding Aircraft.ToggleExpandedCommand}"
                                                                            ToolTip.Tip="{l:T 'Every aircraft with this id, each with its own title and category: tick the ones that belong'}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <PathIcon Data="{StaticResource Icon.Airplane}" Width="12" Height="12" />
                                                                            <TextBlock Text="{Binding Aircraft.ExpandLabel}" FontSize="11.5" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Border Classes="chip warn" IsVisible="{Binding Aircraft.HasDiffers}"
                                                                            ToolTip.Tip="{Binding MeaningNote}">
                                                                        <TextBlock Text="{l:T 'same id, other meaning in {0} (left out)', Arg0={Binding Aircraft.DiffersCount}}" />
                                                                    </Border>
                                                                    <Border Classes="chip" IsVisible="{Binding HasNear}"
                                                                            ToolTip.Tip="{l:T 'Aircraft whose title or category of this id differs a little (word order, one word, the category): grouped here, review them'}">
                                                                        <TextBlock Text="{Binding NearCount, StringFormat='{}{0} near'}" />
                                                                    </Border>
                                                                </WrapPanel>
                                                                <Panel IsVisible="{Binding Aircraft.IsExpanded, FallbackValue=False}">
                                                                    <controls:AircraftSelectorPanel DataContext="{Binding Aircraft}" />
                                                                </Panel>
                                                            </StackPanel>
                                                          </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.DataTemplates>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <Grid Grid.Row="5" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" IsVisible="{Binding HasBuilderSearchResults}">
                                                <Button Classes="icon accent" Tag="{StaticResource Icon.Check}" Content="{Binding BuilderAddButtonLabel}" Command="{Binding AddCheckedBuilderResultsCommand}"
                                                        IsEnabled="{Binding HasBuilderChecked}"
                                                        ToolTip.Tip="{l:T 'Puts every ticked action into the relation; for a new relation it creates it with them. Ctrl+Z undoes it.'}" />
                                                <Button Grid.Column="1" Classes="small ghost" Content="{l:T 'Tick all shown'}" Command="{Binding CheckAllShownBuilderResultsCommand}"
                                                        ToolTip.Tip="{l:T 'Ticks every action in the list (narrow the list with the game chips first)'}" />
                                                <Button Grid.Column="2" Classes="small ghost" HorizontalAlignment="Left" Content="{l:T 'Clear ticks'}" Command="{Binding ClearBuilderChecksCommand}"
                                                        IsVisible="{Binding HasBuilderChecked}" ToolTip.Tip="{l:T 'Unticks everything'}" />
                                            </Grid>
                                        </Grid>

                                        <!-- Suggest missing for every relation: a review list (relations suggest, all, missing) -->
                                        <controls:MissingReviewPanel Grid.Row="2" IsVisible="{Binding IsBuilderMissingAllPanel}" />

                                        <!-- The catalog: every action of a game or aircraft by its categories (engine relations browse) -->
                                        <controls:CatalogBrowserPanel Grid.Row="2" IsVisible="{Binding IsBuilderCatalogPanel}" />

                                        <!-- Suggested for this relation (engine relations suggest) -->
                                        <Grid Grid.Row="2" IsVisible="{Binding IsBuilderSuggestedPanel}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6" MinHeight="0">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <TextBlock Classes="caption" Text="{Binding BuilderSuggestStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="icon small" Tag="{StaticResource Icon.Check}" Content="{Binding BuilderAddTickedLabel}"
                                                        Command="{Binding AddTickedBuilderSuggestionsCommand}" IsEnabled="{Binding HasBuilderTicked}"
                                                        ToolTip.Tip="{l:T 'Adds the ticked suggestions (Ctrl+Z undoes it)'}" />
                                                <Button Grid.Column="2" Classes="icon small accent" Tag="{StaticResource Icon.Check}" Content="{Binding BuilderAddAllLabel}"
                                                        Command="{Binding AddAllBuilderSuggestionsCommand}" IsEnabled="{Binding CanAddAllSuggestions}"
                                                        ToolTip.Tip="{l:T 'Adds every suggestion shown that no other relation uses (Ctrl+Z undoes it)'}" />
                                            </Grid>
                                            <WrapPanel Grid.Row="1" ItemSpacing="4" LineSpacing="4">
                                                <ItemsControl ItemsSource="{Binding BuilderSuggestionGames}" IsVisible="{Binding HasBuilderSuggestionGames}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:BuilderGameChip">
                                                            <ToggleButton Classes="filterChip" Content="{Binding Label}" IsChecked="{Binding IsSelected}" ToolTip.Tip="{l:T 'Show only this game (several: any of them)'}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ToggleButton Classes="filterChip" Content="{Binding BuilderWeakLabel}" IsChecked="{Binding BuilderShowWeakMatches}"
                                                              ToolTip.Tip="{l:T 'Also actions whose title only looks similar (weaker evidence)'}" />
                                            </WrapPanel>
                                            <Border Grid.Row="2" Classes="callout warn" IsVisible="{Binding HasRelationMisfits}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{l:T 'Looks wrong in this relation'}" FontWeight="SemiBold" />
                                                    <ItemsControl ItemsSource="{Binding RelationMisfits}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:RelationMisfitItem">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Classes="caption" Text="{Binding Reason}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                        <Button Classes="small" Content="{Binding MoveLabel}" IsVisible="{Binding CanMove}"
                                                                                Command="{Binding #RootWindow.DataContext.MoveMisfitCommand}" CommandParameter="{Binding}"
                                                                                ToolTip.Tip="{l:T 'Moves it to the relation of its function'}" />
                                                                        <Button Classes="small ghost" Content="{l:T 'Remove'}"
                                                                                Command="{Binding #RootWindow.DataContext.RemoveMisfitCommand}" CommandParameter="{Binding}"
                                                                                ToolTip.Tip="{l:T 'Takes it out of this relation'}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <Panel Grid.Row="3" MinHeight="0">
                                                <!-- Sections: games and aircraft the relation lacks first, then what other relations use, then the rest -->
                                                <ScrollViewer IsVisible="{Binding HasBuilderSuggestions}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="0">
                                                <ItemsControl ItemsSource="{Binding BuilderSuggestionSections}" Margin="0,0,12,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:SuggestionSectionItem">
                                                          <StackPanel Spacing="4" Margin="0,4,0,6">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" ToolTip.Tip="{Binding Hint}">
                                                                <CheckBox IsChecked="{Binding IsChecked}" IsVisible="{Binding Tickable}" VerticalAlignment="Center"
                                                                          ToolTip.Tip="{l:T 'Tick or untick every suggestion of this section'}" />
                                                                <TextBlock Grid.Column="1" Classes="h3" Text="{Binding Header}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Items}">
                                                                <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:BuilderSuggestionItem">
                                                          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsShown}">
                                                          <!-- An alternative sits indented under the recommended action of its game -->
                                                          <Border Width="24" IsVisible="{Binding IsAlternative}" />
                                                          <Border Grid.Column="1" Classes="raised" Padding="8,6" Margin="0,0,0,4">
                                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" ToolTip.Tip="{Binding Reasons}">
                                                                <CheckBox IsChecked="{Binding IsChecked}" IsVisible="{Binding !HasConflict}" VerticalAlignment="Center"
                                                                          ToolTip.Tip="{l:T 'Tick it for Add ticked'}" />
                                                                <Panel Grid.Column="1" Width="34" Height="34" VerticalAlignment="Center">
                                                                    <controls:GameBadge GameId="{Binding Game}" Title="{Binding GameLabel}" />
                                                                    <Image Source="{Binding Picture}" Stretch="UniformToFill" IsVisible="{Binding Picture, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                                </Panel>
                                                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Classes="caption" FontSize="10.5" Opacity="0.8" Text="{Binding FunctionAndId}" IsVisible="{Binding HasFunctionAndId}" TextTrimming="CharacterEllipsis"
                                                                               ToolTip.Tip="{l:T 'The function JoyPro reads it as, and the game\'s own id of the action'}" />
                                                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                                                                        <Border Classes="chip recommended" IsVisible="{Binding IsRecommended}"
                                                                                ToolTip.Tip="{l:T 'The one action to take in this game (or aircraft): the function\'s main control, not a variant'}">
                                                                            <TextBlock Text="{Binding RecommendedLabel}" />
                                                                        </Border>
                                                                        <Panel Grid.Column="1">
                                                                            <Border Classes="chip ok" IsVisible="{Binding IsHigh}"><TextBlock Text="{l:T 'High {0}', Arg0={Binding ScoreText}}" /></Border>
                                                                            <Border Classes="chip warn" IsVisible="{Binding IsMedium}"><TextBlock Text="{l:T 'Medium {0}', Arg0={Binding ScoreText}}" /></Border>
                                                                            <Border Classes="chip" IsVisible="{Binding IsLow}"><TextBlock Text="{l:T 'Weak {0}', Arg0={Binding ScoreText}}" /></Border>
                                                                        </Panel>
                                                                        <TextBlock Grid.Column="2" Classes="caption" VerticalAlignment="Center" Text="{Binding Where}" TextTrimming="CharacterEllipsis" />
                                                                    </Grid>
                                                                    <TextBlock Classes="warnText" FontSize="11.5" Text="{Binding VariantText}" IsVisible="{Binding HasVariant}" TextWrapping="Wrap" />
                                                                    <TextBlock Classes="caption" FontSize="11" Text="{Binding Explanation}" IsVisible="{Binding HasExplanation}" TextWrapping="Wrap" MaxLines="2"
                                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ExplanationTip}" />
                                                                    <TextBlock Classes="caption" FontSize="11.5" Text="{Binding MissingText}" IsVisible="{Binding IsMissing}" TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource JP.AccentTextBrush}" />
                                                                    <TextBlock Classes="caption" Text="{Binding Why}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Classes="warnText" Text="{Binding ConflictText}" IsVisible="{Binding HasConflict}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Classes="caption" FontSize="11" Text="{Binding MeaningNote}" IsVisible="{Binding HasMeaningNote}" TextTrimming="CharacterEllipsis"
                                                                               ToolTip.Tip="{l:T 'Aircraft where the same id means something else are not in this suggestion'}" />
                                                                    <Button Classes="small ghost" HorizontalAlignment="Left" Padding="4,0" IsVisible="{Binding HasAlternatives}"
                                                                            Content="{Binding AlternativesLabel}" Command="{Binding ToggleAlternativesCommand}"
                                                                            ToolTip.Tip="{l:T 'The other actions of this game for the same thing, each with how it differs'}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <Button Classes="icon small accent" Tag="{StaticResource Icon.Plus}" Content="{l:T 'Add'}" IsVisible="{Binding !HasConflict}"
                                                                            Command="{Binding #RootWindow.DataContext.AddBuilderSuggestionCommand}" CommandParameter="{Binding}"
                                                                            ToolTip.Tip="{l:T 'Add to this relation'}" />
                                                                    <Button Classes="icon small" Tag="{StaticResource Icon.Swap}" Content="{l:T 'Move here'}" IsVisible="{Binding HasConflict}"
                                                                            Command="{Binding #RootWindow.DataContext.MoveBuilderSuggestionHereCommand}" CommandParameter="{Binding}"
                                                                            ToolTip.Tip="{l:T 'Takes it out of the other relation and adds it here'}" />
                                                                    <Button Classes="icon small ghost iconOnly" Tag="{StaticResource Icon.Close}"
                                                                            Command="{Binding #RootWindow.DataContext.DismissBuilderSuggestionCommand}" CommandParameter="{Binding}"
                                                                            ToolTip.Tip="{l:T 'Dismiss: never suggested again for this relation'}" />
                                                                </StackPanel>
                                                            </Grid>
                                                          </Border>
                                                          </Grid>
                                                        </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                          </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                </ScrollViewer>
                                                <StackPanel IsVisible="{Binding IsBuilderSuggestLoading}" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="6" Margin="0,16,0,0">
                                                    <ProgressBar IsIndeterminate="True" Width="160" />
                                                    <TextBlock Classes="caption" Text="{l:T 'Looking for suggestions...'}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <Border Classes="sunken" Padding="12" IsVisible="{Binding ShowBuilderSuggestEmpty}" VerticalAlignment="Top">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                        <PathIcon Data="{StaticResource Icon.Lightbulb}" Width="20" Height="20" Foreground="{DynamicResource JP.AccentTextBrush}" VerticalAlignment="Top" />
                                                        <TextBlock Grid.Column="1" Classes="caption" TextWrapping="Wrap" Text="{Binding BuilderSuggestEmptyText}" />
                                                        <Button Grid.Column="2" Classes="small ghost" Content="{l:T 'Show all games'}" Command="{Binding ClearBuilderGameFilterCommand}"
                                                                IsVisible="{Binding HasBuilderSuggestionGames}" VerticalAlignment="Top" />
                                                    </Grid>
                                                </Border>
                                            </Panel>
                                        </Grid>

                                        <!-- The JoyPro assistant (engine relations assistant) -->
                                        <Grid Grid.Row="2" IsVisible="{Binding IsBuilderAssistantPanel}" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6" MinHeight="0">
                                            <Border Classes="sunken" Padding="8">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <PathIcon Data="{StaticResource Icon.Lightbulb}" Width="16" Height="16" VerticalAlignment="Top" Foreground="{DynamicResource JP.AccentTextBrush}" />
                                                    <TextBlock Grid.Column="1" Classes="caption" TextWrapping="Wrap" Text="{Binding AssistantModeText}" />
                                                    <Button Grid.Column="2" Classes="small ghost" Content="{l:T 'AI model...'}" VerticalAlignment="Top" Command="{Binding OpenLlmSetupCommand}"
                                                            ToolTip.Tip="{l:T 'Set up the optional local AI model (download with size and license, or your own llama.cpp). Without it the offline brain does simple commands.'}" />
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" Classes="callout ok" IsVisible="{Binding HasAssistantContext}" Padding="8,4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{l:T 'Working on: {0}', Arg0={Binding AssistantContextRelation}}" />
                                                    <Button Grid.Column="1" Classes="icon small ghost iconOnly" Tag="{StaticResource Icon.Close}" Command="{Binding ClearAssistantContextCommand}"
                                                            ToolTip.Tip="{l:T 'Not this relation: the whole profile'}" />
                                                </Grid>
                                            </Border>
                                            <ScrollViewer x:Name="AssistantScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="0">
                                                <StackPanel Spacing="8" Margin="0,0,12,0">
                                                    <StackPanel Spacing="6" IsVisible="{Binding !HasAssistantMessages}">
                                                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:T 'Try one of these (click to use it):'}" />
                                                        <ItemsControl ItemsSource="{Binding AssistantExamples}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <Button Classes="ghost small" Margin="0,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                            Command="{Binding #RootWindow.DataContext.UseAssistantExampleCommand}" CommandParameter="{Binding}">
                                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding AssistantMessages}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:AssistantMessageItem">
                                                                <Panel Margin="0,3">
                                                                    <Border IsVisible="{Binding IsUser}" HorizontalAlignment="Right" Margin="48,0,0,0" Padding="10,6" CornerRadius="10"
                                                                            Background="{DynamicResource JP.AccentSoftBrush}">
                                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                                    </Border>
                                                                    <Border IsVisible="{Binding IsAssistant}" HorizontalAlignment="Stretch" Margin="0,0,24,0" Padding="10,8" CornerRadius="10"
                                                                            Background="{DynamicResource JP.SurfaceAltBrush}" BorderBrush="{DynamicResource JP.BorderBrush}" BorderThickness="1">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" IsVisible="{Binding HasText}" />
                                                                            <ItemsControl ItemsSource="{Binding Relations}" IsVisible="{Binding HasRelations}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:AssistantRelationSummary">
                                                                                        <StackPanel Spacing="0" Margin="0,2">
                                                                                            <Button Classes="ghost small" Padding="2,0" HorizontalAlignment="Left" Content="{Binding Name}" FontWeight="Bold"
                                                                                                    Command="{Binding #RootWindow.DataContext.OpenAssistantRelationCommand}" CommandParameter="{Binding Name}"
                                                                                                    ToolTip.Tip="{l:T 'Open this relation'}" />
                                                                                            <TextBlock Classes="caption" Text="{Binding Text}" TextWrapping="Wrap" />
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                            <TextBlock Classes="warnText" FontSize="11.5" Text="{Binding Notes}" TextWrapping="Wrap" IsVisible="{Binding HasNotes}" />
                                                                            <Expander Header="{Binding StepsHeader}" IsVisible="{Binding HasSteps}" HorizontalAlignment="Stretch">
                                                                                <ItemsControl ItemsSource="{Binding Steps}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="x:String">
                                                                                            <TextBlock Classes="caption" FontSize="11" Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </Expander>
                                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                                <Button Classes="icon small" Tag="{StaticResource Icon.Undo}" Content="{l:T 'Undo this'}" IsVisible="{Binding CanUndo}"
                                                                                        Command="{Binding #RootWindow.DataContext.UndoAssistantTurnCommand}" CommandParameter="{Binding}"
                                                                                        ToolTip.Tip="{l:T 'Takes back everything this answer changed'}" />
                                                                                <TextBlock Grid.Column="1" Classes="caption" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                                           Text="{Binding Method}" IsVisible="{Binding HasMethod}" />
                                                                            </Grid>
                                                                            <TextBlock Classes="caption" Text="{l:T 'Undone.'}" IsVisible="{Binding IsUndone}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Panel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAssistantRunning}">
                                                        <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" />
                                                        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{l:T 'JoyPro is working on it...'}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                <TextBox x:Name="AssistantInputBox" Text="{Binding AssistantInput}" Watermark="{Binding AssistantPlaceholder}" TextWrapping="Wrap" MaxHeight="96"
                                                         KeyDown="AssistantInputKeyDown" IsEnabled="{Binding !IsAssistantRunning}"
                                                         ToolTip.Tip="{l:T 'Say what to build or change; Enter sends'}" />
                                                <Button Grid.Column="1" Classes="icon accent" Tag="{StaticResource Icon.Send}" Content="{l:T 'Send'}" VerticalAlignment="Bottom"
                                                        Command="{Binding AskAssistantCommand}" IsEnabled="{Binding !IsAssistantRunning}"
                                                        ToolTip.Tip="{l:T 'JoyPro does it at once; Undo in the answer takes it back (Enter)'}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Bind Studio: every relation with its input on the left (search, device and group filters, sort); on the right
                     the selected one: its device and input, recording the input from the device, picking it by hand, the
                     modifiers on it, the axis response curve and the advanced behavior. -->
                <Border IsVisible="{Binding IsBindsStage}" Padding="0,4,0,0">
                    <Grid x:Name="BindsPaneGrid" ColumnDefinitions="440,12,*">
                        <Border Classes="surface" Padding="12">
                            <Grid x:Name="BindsLeftGrid" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Gamepad}" /></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Classes="h2" FontSize="18" FontWeight="Bold" Text="{l:T 'Bind Studio'}" />
                                        <TextBlock Classes="caption" Text="{Binding ProfileBoundText}" />
                                    </StackPanel>
                                    <!-- Follow input: pressing a button (or moving an axis a long way) selects its relation. -->
                                    <ToggleButton x:Name="FollowInputToggle" Grid.Column="2" Classes="filterChip" VerticalAlignment="Center"
                                                  IsChecked="{Binding FollowInputOnBinds}"
                                                  ToolTip.Tip="{l:T 'Follow input: press a button or move an axis a long way and the list jumps to its relation; press it again for the next relation on it (without modifiers first). Not while recording or typing. Settings > Binds switches it off for good.'}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <PathIcon Data="{StaticResource Icon.Cursor}" Width="13" Height="13" />
                                            <TextBlock Text="{l:T 'Follow input'}" />
                                        </StackPanel>
                                    </ToggleButton>
                                </Grid>
                                <TextBox x:Name="BindSearchBox" Grid.Row="1" Classes="search" Text="{Binding BindSearchText}" Watermark="{l:T 'Search binds (Ctrl+F)'}"
                                         ToolTip.Tip="{l:T 'Shows only the relations whose name, game, aircraft, group, device, input or modifier has these words'}" />
                                <!-- The same filters as on the Relations page, with their own ticks -->
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <controls:ListFilterBar x:Name="BindFilterBar" DataContext="{Binding BindFilter}" />
                                    <controls:ListSortBar x:Name="BindSortBar" Grid.Column="1" DataContext="{Binding BindSort}" />
                                </Grid>
                                <Panel Grid.Row="4">
                                    <ListBox x:Name="BindsListBox"
                                             Classes="cards"
                                             ItemsSource="{Binding Binds}"
                                             SelectedItem="{Binding SelectedBind}"
                                             MinHeight="160">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:BindListItem">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" ToolTip.Tip="{Binding BindTooltip}" Background="Transparent"
                                                      PointerPressed="BindRowPointerPressed" PointerMoved="CalloutRelationPointerMoved">
                                                    <Panel VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusOkBrush}" IsVisible="{Binding HasBind}" ToolTip.Tip="{l:T 'Bound'}" />
                                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusWarnBrush}" IsVisible="{Binding IsUnbound}" ToolTip.Tip="{l:T 'Not bound yet'}" />
                                                    </Panel>
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Text="{Binding RelationName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Spacing="4" ClipToBounds="True">
                                                            <Border Classes="chip axis" IsVisible="{Binding IsAxisType}"><TextBlock Text="{l:T 'Axis'}" /></Border>
                                                            <Border Classes="chip device" IsVisible="{Binding HasBind}" ToolTip.Tip="{Binding Device}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <Image Source="{Binding DeviceIcon}" Width="15" Height="15" IsVisible="{Binding HasDeviceIcon}" />
                                                                    <TextBlock Text="{Binding DeviceShort}" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ItemsControl ItemsSource="{Binding ModifierList}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <Border Classes="chip modifier" ToolTip.Tip="{l:T 'Modifier: hold it for this bind'}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                                                <PathIcon Data="{StaticResource Icon.Shift}" />
                                                                                <TextBlock Text="{Binding}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Panel Grid.Column="2" VerticalAlignment="Center">
                                                        <Border Classes="keycap" IsVisible="{Binding HasInput}"><TextBlock Text="{Binding InputShort}" /></Border>
                                                        <Border Classes="chip warn" IsVisible="{Binding IsUnbound}"><TextBlock Text="{l:T 'not bound'}" /></Border>
                                                    </Panel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Classes="caption" IsVisible="{Binding HasNoBindMatches}" Margin="4,8" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top"
                                               Text="{l:T 'No relation matches the search and the filters. Clear all shows every relation again.'}" />
                                    <!-- Follow input: which input jumped where ("BTN 8 on WarBRD: Gear (1/3)"), for a moment. -->
                                    <Border Classes="followToast" IsVisible="{Binding HasFollowInputToast}" IsHitTestVisible="False"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,14">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <PathIcon Data="{StaticResource Icon.Gamepad}" Width="14" Height="14" Foreground="White" />
                                            <TextBlock Text="{Binding FollowInputToast}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="360" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="emptyState" IsVisible="{Binding HasNoBinds}" VerticalAlignment="Top">
                                        <StackPanel Spacing="10">
                                            <PathIcon Classes="emptyIcon" Data="{StaticResource Icon.Gamepad}" />
                                            <TextBlock Classes="h2" HorizontalAlignment="Center" Text="{l:T 'Nothing to bind yet'}" />
                                            <TextBlock Classes="caption" TextAlignment="Center"
                                                       Text="{l:T 'A bind puts a relation on a button or axis of your devices. Make relations first (Relation Studio), or import a game.'}" />
                                            <Button Classes="icon accent" HorizontalAlignment="Center" Tag="{StaticResource Icon.Link}" Content="{l:T 'Go to relations'}" Command="{Binding GoRelationsCommand}" />
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1"
                                      Width="6"
                                      Background="Transparent"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch"
                                      ResizeDirection="Columns"
                                      ResizeBehavior="PreviousAndNext"
                                      ShowsPreview="True" />

                        <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="12" MinHeight="0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <WrapPanel ItemSpacing="8" LineSpacing="8">
                                    <ToggleButton Classes="icon" Tag="{StaticResource Icon.Image}" Command="{Binding ToggleVisualAssignModeCommand}" IsChecked="{Binding OpenVisualAssignMode, Mode=OneWay}"
                                                  Content="{l:T 'Visual assign'}" ToolTip.Tip="{l:T 'Pick relations on the picture of your device'}" />
                                    <Button Classes="icon" Tag="{StaticResource Icon.Close}" Command="{Binding UnbindSelectedInputCommand}" Content="{l:T 'Unbind selected input'}"
                                            ToolTip.Tip="{l:T 'Removes the selected bind\'s input from every relation that uses it'}" />
                                    <Button Classes="icon" Tag="{StaticResource Icon.Keycap}" Command="{Binding GoModifiersCommand}" Content="{l:T 'Modifiers'}"
                                            ToolTip.Tip="{l:T 'The modifier library: rename, delete, see where they are used'}" />
                                    <ToggleButton Classes="icon" Tag="{StaticResource Icon.Joystick}" Command="{Binding ToggleAutoAssignPanelCommand}" IsChecked="{Binding IsAutoAssignPanelOpen, Mode=OneWay}"
                                                  Content="{l:T 'Put relations on my buttons automatically...'}"
                                                  ToolTip.Tip="{l:T 'Auto Assign: JoyPro binds your relations to fitting controls of your devices (TMS on the TMS hat, gear on the gear lever). Preview first; nothing changes until Apply.'}" />
                                    <!-- Setup wizard (docs/setup-wizard.md): relations and binds for the watched games, device roles, priorities. -->
                                    <Button Classes="icon" Tag="{StaticResource Icon.Wand}" Command="{Binding OpenSetupWizardCommand}" Content="{l:T 'Set up my devices automatically...'}"
                                            ToolTip.Tip="{l:T 'Setup wizard: relations and binds for the games you watch in one go (device roles, aircraft priorities, modifiers, how real), then you review before anything changes'}" />
                                </WrapPanel>
                                <Button Grid.Column="1" Classes="icon" Tag="{StaticResource Icon.More}" Content="{l:T 'More'}" ToolTip.Tip="{l:T 'Refresh, import and export binds, save'}">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="{l:T 'Refresh binds'}" Command="{Binding RefreshBindsCommand}" />
                                            <MenuItem Header="{l:T 'Show selected in output'}" Command="{Binding ShowSelectedBindCommand}" />
                                            <MenuItem Header="{l:T 'Replace the selected bind\'s device...'}" Command="{Binding OpenReplaceDeviceCommand}" CommandParameter="{Binding SelectedBind.Device}"
                                                      ToolTip.Tip="{l:T 'Move every bind of that device to another device, input by input, with a preview'}" />
                                            <Separator />
                                            <MenuItem Header="{l:T 'Import Binds JSON...'}" Click="ImportBindsJsonClicked" />
                                            <MenuItem Header="{l:T 'Export Binds JSON...'}" Click="ExportBindsJsonClicked" />
                                            <Separator />
                                            <MenuItem Header="{l:T 'Save Profile'}" Command="{Binding SaveProfileCommand}" />
                                            <MenuItem Header="{l:T 'Merge Profile'}" Command="{Binding MergeProfileCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12" Margin="0,0,10,0">
                                <Border IsVisible="{Binding IsAutoAssignPanelOpen}" Classes="surface">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Joystick}" /></Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="h2" Text="{l:T 'Put relations on my buttons automatically'}" TextWrapping="Wrap" /><TextBlock Classes="caption" Text="{l:T 'Auto Assign: JoyPro binds your relations to fitting controls of your devices.'}" TextWrapping="Wrap" /></StackPanel>
                                            <Button Grid.Column="2" Classes="icon ghost small" Tag="{StaticResource Icon.Close}" Content="{l:T 'Close'}" Command="{Binding ToggleAutoAssignPanelCommand}" ToolTip.Tip="{l:T 'Close Auto Assign'}" />
                                        </Grid>
                                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                                   Text="{l:T 'Binds your relations to the best controls of your devices: TMS on the TMS hat, gear on the gear lever, trim on the trim hat. Inputs are shared between aircraft that never fly at the same time. With &quot;Keep my layout&quot; every relation goes back on the control it had before. Preview first; nothing changes until Apply.'}" />
                                        <WrapPanel>
                                            <Button Command="{Binding DetectAutoAssignDevicesCommand}" Content="{l:T 'Detect Devices'}" Margin="0,0,8,0" ToolTip.Tip="{l:T 'Recognises the connected devices from the device catalog'}" />
                                        </WrapPanel>
                                        <ItemsControl ItemsSource="{Binding AutoAssignDevices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AutoAssignDeviceItem">
                                                    <StackPanel Spacing="4" Margin="0,2,0,2">
                                                        <WrapPanel>
                                                            <CheckBox IsChecked="{Binding IsIgnored}" Content="{l:T 'Leave out'}" Margin="0,0,8,0" ToolTip.Tip="{l:T 'Do not assign anything to this device'}" />
                                                            <TextBlock Text="{Binding Device}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                            <Button Content="{l:T 'Layout'}" IsVisible="{Binding HasLayout}" Command="{Binding #RootWindow.DataContext.ShowAutoAssignDeviceLayoutCommand}" CommandParameter="{Binding}" ToolTip.Tip="{l:T 'What JoyPro knows about each input of this device (device catalog)'}" />
                                                        </WrapPanel>
                                                        <TextBlock IsVisible="{Binding NeedsGrip}" Text="{l:T 'Several grips fit this base. Pick yours:'}" Opacity="0.8" />
                                                        <ListBox IsVisible="{Binding NeedsGrip}" ItemsSource="{Binding Grips}" SelectedItem="{Binding SelectedGrip}" MaxHeight="230">
                                                            <ListBox.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ListBox.ItemsPanel>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:AutoAssignGripItem">
                                                                    <StackPanel Width="160" Spacing="2">
                                                                        <Image Source="{Binding Image}" Height="110" Stretch="Uniform" />
                                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="11" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <WrapPanel>
                                            <TextBlock Text="{l:T 'Add a device that is not connected'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding AutoAssignCatalogQuery}" Watermark="{l:T 'e.g. Warthog, Orion, Gladiator'}" MinWidth="200" Margin="0,0,8,0" />
                                            <Button Command="{Binding SearchAutoAssignCatalogCommand}" Content="{l:T 'Search Catalog'}" Margin="0,0,8,0" />
                                            <ComboBox ItemsSource="{Binding AutoAssignCatalogResults}" SelectedItem="{Binding SelectedAutoAssignCatalogItem}" MinWidth="320" Margin="0,0,8,0" />
                                            <Button Command="{Binding AddAutoAssignCatalogDeviceCommand}" Content="{l:T 'Add'}" Margin="0,0,8,0" />
                                            <Button Command="{Binding ShowAutoAssignCatalogLayoutCommand}" Content="{l:T 'Show Layout'}" ToolTip.Tip="{l:T 'What JoyPro knows about each input of the picked catalog device'}" />
                                        </WrapPanel>
                                        <Border IsVisible="{Binding HasAutoAssignLayout}" Classes="sunken" Padding="8">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Image Source="{Binding AutoAssignLayoutImage}" Width="140" MaxHeight="140" Stretch="Uniform" VerticalAlignment="Top"
                                                       IsVisible="{Binding AutoAssignLayoutImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding AutoAssignLayoutTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <Button Command="{Binding CloseAutoAssignLayoutCommand}" Content="{l:T 'Close'}" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding AutoAssignLayoutDetails}" Opacity="0.8" TextWrapping="Wrap" />
                                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding AutoAssignLayoutRows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:AutoAssignLayoutRow">
                                                                    <Grid ColumnDefinitions="110,260,*" ColumnSpacing="8" Margin="0,1">
                                                                        <TextBlock Text="{Binding Input}" FontFamily="Consolas,Menlo,monospace" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Control}" FontFamily="Consolas,Menlo,monospace" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Control}" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Details}" Opacity="0.8" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding AutoAssignAddedDevices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AutoAssignCatalogItem">
                                                    <WrapPanel Margin="0,1,0,1">
                                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <Button Content="{l:T 'Remove'}" Command="{Binding #RootWindow.DataContext.RemoveAutoAssignAddedDeviceCommand}" CommandParameter="{Binding}" />
                                                    </WrapPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <WrapPanel>
                                            <TextBlock Text="{l:T 'Modifiers at most'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox ItemsSource="{Binding AutoAssignModifierChoices}" SelectedItem="{Binding AutoAssignMaxModifiers}" Margin="0,0,12,0" />
                                            <CheckBox IsChecked="{Binding AutoAssignKeepMyLayout}" Content="{l:T 'Keep my layout'}" Margin="0,0,12,0" ToolTip.Tip="{l:T 'Relations go back on the control they had before (also after a device got a new id)'}" />
                                            <CheckBox IsChecked="{Binding AutoAssignOverwrite}" Content="{l:T 'Re-assign bound relations'}" Margin="0,0,12,0" ToolTip.Tip="{l:T 'Lays out the binds on these devices again; keyboard, vJoy and disconnected devices stay'}" />
                                            <CheckBox IsChecked="{Binding AutoAssignIncludeMissing}" IsEnabled="{Binding AutoAssignOverwrite}" Content="{l:T 'Also move binds of devices that are not connected'}" Margin="0,0,12,0" />
                                            <CheckBox IsChecked="{Binding AutoAssignOnlySelected}" Content="{l:T 'Only the selected relations'}" Margin="0,0,12,0" ToolTip.Tip="{l:T 'Assigns only the relations selected in the list; the others keep their binds and their controls stay taken'}" />
                                            <Button Command="{Binding PreviewAutoAssignCommand}" Content="{l:T 'Preview'}" Margin="0,0,8,0" />
                                            <Button Command="{Binding ExplainAutoAssignCommand}" Content="{l:T 'Explain Selected'}" Margin="0,0,8,0" ToolTip.Tip="{l:T 'Why the selected relations get their control: the best candidates with their score and what occupies them (a preview, nothing changes)'}" />
                                            <Button Command="{Binding ApplyAutoAssignCommand}" Content="{l:T 'Apply'}" />
                                        </WrapPanel>
                                        <TextBox Text="{Binding AutoAssignPreview}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                                 FontFamily="Consolas,Menlo,monospace" MaxHeight="300" MinHeight="80"
                                                 IsVisible="{Binding AutoAssignPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Border>
                                <!-- Bind on the picture: the Layout page's picture of the device (its reference: your photo, the maker's
                                     photo or JoyPro's drawing; or your layout file) on the picture canvas in Bind mode (contract:
                                     docs/ui/layout-redesign.md), the selected input and its relation picker on the right. -->
                                <Border IsVisible="{Binding OpenVisualAssignMode}" Classes="surface" Padding="0" ClipToBounds="True">
                                    <Grid RowDefinitions="Auto,560">
                                        <Border Classes="toolbar">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                                <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Image}" /></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="h2" Text="{l:T 'Bind on the picture'}" />
                                                    <TextBlock Classes="caption" Text="{Binding LayoutLegendSummary}" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding VisualAssignDeviceOptions}" SelectedItem="{Binding VisualAssignDevice}" HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center" PlaceholderText="{l:T 'Pick a device'}" />
                                                <ComboBox Grid.Column="3" ItemsSource="{Binding WorkspacePictures}" SelectedItem="{Binding SelectedWorkspacePicture}" MinWidth="150" VerticalAlignment="Center"
                                                          ToolTip.Tip="{l:T 'Your photo, the maker\'s photo, JoyPro\'s drawing or your layout file'}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:WorkspacePictureChoice">
                                                            <TextBlock Text="{Binding Title}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                                                    <Button Classes="icon small ghost" Tag="{StaticResource Icon.Pencil}" Content="{l:T 'Edit markers'}" Command="{Binding OpenVisualAssignInLayoutCommand}"
                                                            ToolTip.Tip="{l:T 'Open this picture on the Layout page: move the markers onto the real parts, your photo, the marker assistant'}" />
                                                    <Button Classes="icon small ghost iconOnly" Tag="{StaticResource Icon.Close}" Command="{Binding ToggleVisualAssignModeCommand}" ToolTip.Tip="{l:T 'Close the picture'}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,300">
                                            <Panel>
                                                <Border Classes="canvasHost">
                                                    <controls:DeviceMarkerCanvas x:Name="VisualAssignCanvas"
                                                                                 Source="{Binding WorkspaceImage}"
                                                                                 Schematic="{Binding WorkspaceSchematic}"
                                                                                 SourceWidth="{Binding WorkspaceWidth}"
                                                                                 SourceHeight="{Binding WorkspaceHeight}"
                                                                                 Markers="{Binding WorkspaceMarkers}"
                                                                                 SelectedMarker="{Binding WorkspaceSelectedMarker}"
                                                                                 Mode="Bind"
                                                                                 Zoom="{Binding VisualAssignZoom}"
                                                                                 FlashMarker="{Binding WorkspaceFlashMarker}"
                                                                                 LiveInput="{Binding WorkspaceLiveInput}"
                                                                                 RelationDroppedCommand="{Binding BindSelectedLayoutMarkerCommand}"
                                                                                 CanvasClickedCommand="{Binding LayoutCanvasClickedCommand}" />
                                                </Border>
                                                <Border Classes="canvasHost" IsVisible="{Binding ShowWorkspace3D}">
                                                    <controls:TurntableView x:Name="VisualAssignTurntable"
                                                                            Turntable="{Binding WorkspaceTurntable}"
                                                                            Parts="{Binding DeviceReference.Markers}"
                                                                            SelectedPart="{Binding DeviceReference.SelectedMarker}"
                                                                            LiveInput="{Binding WorkspaceLiveInput}"
                                                                            RelationDroppedCommand="{Binding BindSelectedLayoutMarkerCommand}" />
                                                </Border>
                                                <ToggleButton Classes="small" Content="{l:T '3D view'}" IsChecked="{Binding WorkspaceShows3D}" IsVisible="{Binding HasWorkspaceTurntable}"
                                                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                                              ToolTip.Tip="{l:T 'Turn the device around (drag; wheel zooms; double click resets); drop a relation on a part to bind it'}" />
                                                <Border Classes="emptyState" IsVisible="{Binding HasNoLayoutWorkspacePicture}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24">
                                                    <StackPanel Spacing="10">
                                                        <PathIcon Classes="emptyIcon" Data="{StaticResource Icon.Image}" />
                                                        <TextBlock Classes="h2" HorizontalAlignment="Center" Text="{l:T 'Pick a device'}" />
                                                        <TextBlock Classes="caption" TextAlignment="Center" Text="{l:T 'Its picture shows up here at once with a marker on every button and axis.'}" />
                                                    </StackPanel>
                                                </Border>
                                            </Panel>
                                            <Border Grid.Column="1" BorderBrush="{DynamicResource JP.BorderBrush}" BorderThickness="1,0,0,0" Padding="12" Background="{DynamicResource JP.SurfaceBrush}">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
                                                    <TextBlock Classes="label" Text="{l:T 'SELECTED INPUT'}" />
                                                    <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel Spacing="8" Margin="0,0,6,0">
                                                        <TextBlock Classes="caption" IsVisible="{Binding HasNoWorkspaceInput}" Text="{l:T 'Click an input on the picture (or in the list below).'}" />
                                                        <Border Classes="chip ok" IsVisible="{Binding HasVisualAssignStatus}" HorizontalAlignment="Stretch" Classes.warn="{Binding VisualAssignStatusIsError}">
                                                            <TextBlock Text="{Binding VisualAssignStatus}" TextWrapping="Wrap" />
                                                        </Border>
                                                        <StackPanel Spacing="8" IsVisible="{Binding HasWorkspaceInput}">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                <Border Classes="keycap large"><TextBlock Text="{Binding WorkspaceInputTitle}" /></Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                    <TextBlock Text="{Binding WorkspaceInputName}" Classes="caption" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding WorkspaceInputCommand}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding WorkspaceInputIsBound}" />
                                                                    <!-- Bound (green) or free (grey) under the picked modifier combination. -->
                                                                    <Border Classes="chip ok" IsVisible="{Binding VisualAssignTargetIsBound}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <PathIcon Data="{StaticResource Icon.Ok}" />
                                                                            <TextBlock Text="{Binding VisualAssignBoundState}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Classes="chip" IsVisible="{Binding VisualAssignTargetIsFree}">
                                                                        <TextBlock Text="{l:T 'Free'}" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                            <!-- One row per modifier combination (none, mod 1, mod 2, mod 1 + 2 ...): what the input does under
                                                                 exactly those modifiers; the picked row is the one Bind here binds with. -->
                                                            <StackPanel Spacing="2" IsVisible="{Binding HasVisualAssignCombos}">
                                                                <TextBlock Classes="label" Text="{l:T 'WITH MODIFIERS'}" />
                                                                <ItemsControl ItemsSource="{Binding VisualAssignCombos}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:VisualAssignComboRow">
                                                                            <Button Classes="ghost small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,3" Margin="0,1"
                                                                                    Command="{Binding #RootWindow.DataContext.SelectVisualAssignComboCommand}" CommandParameter="{Binding}"
                                                                                    ToolTip.Tip="{l:T 'Bind here binds with these modifiers'}">
                                                                                <Border CornerRadius="4" Padding="4,2"
                                                                                        Classes.picked="{Binding IsSelected}">
                                                                                    <Border.Styles>
                                                                                        <Style Selector="Border">
                                                                                            <Setter Property="Background" Value="Transparent" />
                                                                                        </Style>
                                                                                        <Style Selector="Border.picked">
                                                                                            <Setter Property="Background" Value="{DynamicResource JP.Chip.GameBrush}" />
                                                                                        </Style>
                                                                                    </Border.Styles>
                                                                                    <Grid ColumnDefinitions="14,96,*" ColumnSpacing="6">
                                                                                        <Ellipse Width="9" Height="9" Fill="#22C55E" IsVisible="{Binding IsBound}" VerticalAlignment="Center" />
                                                                                        <Ellipse Width="9" Height="9" Stroke="#94A3B8" StrokeThickness="1.4" IsVisible="{Binding IsFree}" VerticalAlignment="Center" />
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                                        <TextBlock Grid.Column="2" Text="{Binding Display}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                                                   Classes.muted="{Binding IsFree}" />
                                                                                    </Grid>
                                                                                </Border>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                            <ListBox Classes="cards compact" ItemsSource="{Binding SelectedPartRows}" SelectedItem="{Binding DeviceReference.SelectedLegendRow}"
                                                                     IsVisible="{Binding HasSelectedPartRows}">
                                                                <ListBox.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ListBox.ItemsPanel>
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:ReferenceLegendRow">
                                                                        <Border Classes="liveRow" Classes.live="{Binding IsLive}">
                                                                        <TextBlock Text="{Binding Name}" FontSize="12" ToolTip.Tip="{Binding InputText}" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                            <TextBlock Classes="label" Text="{l:T 'OR PICK ANOTHER RELATION'}" />
                                                            <TextBox Classes="search" Text="{Binding LayoutBindSearch}" Watermark="{l:T 'Search what it should do'}" />
                                                            <ListBox Classes="cards compact" ItemsSource="{Binding LayoutBindCandidates}" SelectedItem="{Binding SelectedLayoutBindCandidate}" MaxHeight="120">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Background="Transparent"
                                                                                   PointerPressed="CalloutRelationPointerPressed" PointerMoved="CalloutRelationPointerMoved"
                                                                                   ToolTip.Tip="{l:T 'Drag onto an input on the picture to bind it there'}" />
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    </ScrollViewer>
                                                    <!-- What Bind here does and the buttons: always in view under the selected input. -->
                                                    <StackPanel Grid.Row="2" Spacing="6" IsVisible="{Binding HasWorkspaceInput}">
                                                        <TextBlock Classes="caption" Text="{Binding VisualAssignPreview}" IsVisible="{Binding HasVisualAssignPreview}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                            <Button Classes="icon small accent" Tag="{StaticResource Icon.Link}" Content="{l:T 'Bind here'}" Command="{Binding BindSelectedLayoutMarkerCommand}"
                                                                    CommandParameter="{x:Null}" HorizontalAlignment="Stretch" ToolTip.Tip="{l:T 'Binds the relation picked on the left (or in the list) to this input'}" />
                                                            <Button Grid.Column="1" Classes="icon small" Tag="{StaticResource Icon.Close}" Content="{l:T 'Free'}" Command="{Binding FreeSelectedLayoutMarkerCommand}" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="3" Classes="label" Text="{l:T 'ALL INPUTS'}" />
                                                    <Panel Grid.Row="4">
                                                        <ListBox Classes="cards compact" ItemsSource="{Binding ReferenceLegendItems}" SelectedItem="{Binding DeviceReference.SelectedLegendRow}"
                                                                 IsVisible="{Binding LayoutShowsReference}">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:ReferenceLegendRow">
                                                                    <Border Classes="liveRow" Classes.live="{Binding IsLive}">
                                                                    <Grid ColumnDefinitions="12,Auto,*" ColumnSpacing="6">
                                                                        <Ellipse Width="9" Height="9" Fill="#22C55E" IsVisible="{Binding IsBound}" VerticalAlignment="Center" ToolTip.Tip="{l:T 'Bound'}" />
                                                                        <Ellipse Width="9" Height="9" Stroke="#94A3B8" StrokeThickness="1.4" IsVisible="{Binding IsFree}" VerticalAlignment="Center" ToolTip.Tip="{l:T 'Free'}" />
                                                                        <Border Grid.Column="1" Classes="keycap small" VerticalAlignment="Center"><TextBlock Text="{Binding InputText}" /></Border>
                                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding Command}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource JP.Chip.OkTextBrush}" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsBound}" />
                                                                            <TextBlock Classes="caption" Text="{l:T 'free'}" IsVisible="{Binding IsFree}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <ListBox Classes="cards compact" ItemsSource="{Binding LayoutLegendItems}" SelectedItem="{Binding SelectedLayoutEditorMarker}"
                                                                 IsVisible="{Binding LayoutShowsLayoutFile}">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:LayoutEditorMarkerItem">
                                                                    <Border Classes="liveRow" Classes.live="{Binding IsLive}">
                                                                    <Grid ColumnDefinitions="12,88,*" ColumnSpacing="6">
                                                                        <Ellipse Width="9" Height="9" Fill="#22C55E" IsVisible="{Binding IsBound}" VerticalAlignment="Center" />
                                                                        <Ellipse Width="9" Height="9" Stroke="#94A3B8" StrokeThickness="1.4" IsVisible="{Binding !IsBound}" VerticalAlignment="Center" />
                                                                        <Border Grid.Column="1" Classes="keycap" HorizontalAlignment="Left"><TextBlock Text="{Binding ShortLabel}" /></Border>
                                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Command}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource JP.Chip.OkTextBrush}" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsBound}" />
                                                                            <TextBlock Classes="caption" Text="{l:T 'free'}" IsVisible="{Binding !IsBound}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </Panel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                    <Border Classes="emptyState" IsVisible="{Binding HasNoBindSelected}">
                                        <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="520">
                                            <PathIcon Classes="emptyIcon" Data="{StaticResource Icon.Gamepad}" />
                                            <TextBlock Classes="h2" HorizontalAlignment="Center" Text="{l:T 'Pick a relation on the left'}" />
                                            <TextBlock Classes="caption" TextAlignment="Center"
                                                       Text="{l:T 'Then press Record and press the button (or move the axis) on your device. A modifier and an axis curve are optional.'}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- The selected bind: device picture, relation, device, input and modifiers -->
                                    <Border Classes="surface" IsVisible="{Binding HasBindSelected}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                            <Border Width="96" Height="96" CornerRadius="12" Background="{DynamicResource JP.SurfaceAltBrush}" ClipToBounds="True">
                                                <Panel>
                                                    <PathIcon Data="{StaticResource Icon.Joystick}" Width="40" Height="40" Opacity="0.5" IsVisible="{Binding !HasSelectedBindDevicePicture}" />
                                                    <Image Source="{Binding SelectedBindDevicePicture}" Stretch="Uniform" Margin="6" />
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding SelectedBind.RelationName}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <Border Classes="chip axis" IsVisible="{Binding SelectedBind.IsAxisType}"><TextBlock Text="{l:T 'Axis'}" /></Border>
                                                    <Border Classes="chip" IsVisible="{Binding !SelectedBind.IsAxisType}"><TextBlock Text="{l:T 'Button'}" /></Border>
                                                </StackPanel>
                                                <WrapPanel ItemSpacing="8" LineSpacing="6">
                                                    <Border Classes="chip device" IsVisible="{Binding SelectedBind.HasBind}" ToolTip.Tip="{Binding SelectedBind.Device}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <PathIcon Data="{StaticResource Icon.Joystick}" />
                                                            <TextBlock Text="{Binding SelectedBind.DeviceShort}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Classes="keycap large" IsVisible="{Binding SelectedBind.HasInput}"><TextBlock Text="{Binding SelectedBind.InputLabel}" /></Border>
                                                    <Border Classes="chip warn" IsVisible="{Binding SelectedBind.IsUnbound}"><TextBlock Text="{l:T 'Not bound yet: press Record below'}" /></Border>
                                                    <ItemsControl ItemsSource="{Binding SelectedBind.ModifierList}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Classes="chip modifier">
                                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                                        <PathIcon Data="{StaticResource Icon.Shift}" />
                                                                        <TextBlock Text="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- The peek at the relation's actions: per game, title, aircraft, axis / button (read-only) -->
                                    <Border x:Name="BindPeekPanel" Classes="surface" Padding="12,8" IsVisible="{Binding HasBindSelected}">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <TextBlock Classes="h3" Text="{Binding BindPeekTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" Classes="small ghost" Content="{l:T 'Open in Relations'}" Command="{Binding OpenBindPeekInRelationsCommand}"
                                                        ToolTip.Tip="{l:T 'Opens this relation in the relation editor to change its actions'}" />
                                                <Button Grid.Column="2" Classes="small ghost" Content="{Binding BindPeekToggleText}" Command="{Binding ToggleBindPeekCommand}"
                                                        ToolTip.Tip="{l:T 'Show or hide the actions of this relation'}" />
                                            </Grid>
                                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsBindPeekOpen}">
                                                <ItemsControl ItemsSource="{Binding BindPeekGroups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:BindPeekGroup">
                                                            <StackPanel Spacing="2" Margin="0,0,0,4">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <controls:GameBadge GameId="{Binding Game}" Title="{Binding Header}" Width="20" Height="20" />
                                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <ItemsControl ItemsSource="{Binding Actions}" Margin="26,0,0,0" MaxWidth="720" HorizontalAlignment="Left">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:BindPeekAction">
                                                                            <StackPanel Spacing="1" Margin="0,1">
                                                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Title}" />
                                                                                    <Button Grid.Column="1" Classes="small ghost" Padding="4,0" Content="{Binding PlanesText}" IsVisible="{Binding HasPlanes}"
                                                                                            Command="{Binding ToggleExpandedCommand}" ToolTip.Tip="{l:T 'Show the aircraft'}" />
                                                                                    <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center"><TextBlock Text="{Binding KindText}" /></Border>
                                                                                </Grid>
                                                                                <TextBlock Classes="caption" Text="{Binding PlaneNames}" TextWrapping="Wrap" IsVisible="{Binding IsExpanded}" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock Classes="caption" Text="{l:T 'No actions in this relation yet: add them in Relations.'}" IsVisible="{Binding ShowBindPeekEmpty}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Record the input from the device -->
                                    <Border Classes="surface" IsVisible="{Binding HasBindSelected}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Record}" /></Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Classes="h2" Text="{l:T 'Bind with your device'}" />
                                                    <TextBlock Classes="caption" Text="{l:T 'Press Record, then press the button or move the axis on your device. Looking for: {0}.', Arg0={Binding RecordModeText}}" />
                                                </StackPanel>
                                            </Grid>
                                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                                <Button Classes="icon accent" Tag="{StaticResource Icon.Record}" Command="{Binding RecordNextInputCommand}" Content="{l:T 'Record input'}"
                                                        ToolTip.Tip="{Binding RecordActionLabel}" />
                                                <Button Classes="icon" Tag="{StaticResource Icon.Close}" Command="{Binding CancelRecordInputCommand}" Content="{l:T 'Cancel Record'}" IsEnabled="{Binding IsRecordingInput}" />
                                                <Button Classes="icon ghost" Tag="{StaticResource Icon.Delete}" Command="{Binding ClearSelectedInputCommand}" Content="{l:T 'Clear Input'}"
                                                        ToolTip.Tip="{l:T 'Take the input off this relation'}" />
                                                <Button Classes="icon ghost" Tag="{StaticResource Icon.Shift}" Command="{Binding ClearModifiersFromSelectedBindCommand}" Content="{l:T 'Clear Modifiers'}" />
                                            </WrapPanel>
                                            <Border Classes="raised" Padding="10,8">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <PathIcon Data="{StaticResource Icon.Info}" Width="14" Height="14" Classes="info" />
                                                    <TextBlock Grid.Column="1" Text="{Binding RecordStatusText}" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                            <Expander Header="{l:T 'Pick the input by hand'}" IsExpanded="{Binding ShowQuickBindActions}" HorizontalAlignment="Stretch">
                                                <StackPanel Margin="0,6,0,0" Spacing="8">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,200" ColumnSpacing="8">
                                                        <TextBlock Classes="label" Text="{l:T 'Device'}" />
                                                        <ComboBox Grid.Column="1"
                                                                  HorizontalAlignment="Stretch"
                                                                  ItemsSource="{Binding BindDeviceChoices}"
                                                                  SelectedItem="{Binding SelectedBindDeviceChoice}"
                                                                  DisplayMemberBinding="{Binding Label, x:DataType=vm:BindDeviceChoice}"
                                                                  PlaceholderText="{l:T 'Pick your device'}"
                                                                  ToolTip.Tip="{Binding BindDeviceInput}" />
                                                        <TextBlock Grid.Column="2" Classes="label" Text="{l:T 'Input'}" />
                                                        <ComboBox Grid.Column="3"
                                                                  HorizontalAlignment="Stretch"
                                                                  ItemsSource="{Binding BindInputChoices}"
                                                                  SelectedItem="{Binding BindInputValue}"
                                                                  Text="{Binding BindInputValue}"
                                                                  PlaceholderText="{Binding BindInputPlaceholder}"
                                                                  IsEditable="True" />
                                                    </Grid>
                                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                                        <Button Classes="accent" Command="{Binding SetSelectedBindCommand}" Content="{l:T 'Set Bind'}" />
                                                        <Button Command="{Binding RefreshQuickBindOptionsCommand}" Content="{l:T 'Refresh Options'}" />
                                                        <Button Command="{Binding ClearSelectedBindCommand}" Content="{l:T 'Clear Bind'}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Expander>
                                            <Expander Header="{l:T 'Recording settings'}" HorizontalAlignment="Stretch">
                                                <Grid Margin="0,6,0,0" ColumnDefinitions="Auto,110,Auto,110,Auto,110" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                                    <TextBlock Classes="label" Text="{l:T 'Timeout ms'}" />
                                                    <TextBox Grid.Column="1" Text="{Binding RecordTimeoutMs}" />
                                                    <TextBlock Grid.Column="2" Classes="label" Text="{l:T 'Warmup ms'}" />
                                                    <TextBox Grid.Column="3" Text="{Binding RecordWarmupMs}" />
                                                    <TextBlock Grid.Column="4" Classes="label" Text="{l:T 'Axis threshold %'}" />
                                                    <TextBox Grid.Column="5" Text="{Binding RecordAxisThresholdPercent}" />
                                                    <CheckBox Grid.Row="1" Grid.ColumnSpan="6" Margin="0,6,0,0" IsChecked="{Binding RecordReleaseOfHeldButtons}"
                                                              Content="{l:T 'Also take a button that rests pressed when it is released'}"
                                                              ToolTip.Tip="{l:T 'Record only takes a button that changes state. A button that was already pressed when recording started (the middle of a 3-way switch, a mode switch) never counts; with this ticked, letting it go counts as that button.'}" />
                                                </Grid>
                                            </Expander>
                                        </StackPanel>
                                    </Border>

                                    <!-- Modifiers on this bind -->
                                    <Border Classes="surface" IsVisible="{Binding HasBindSelected}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Keycap}" /></Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Classes="h2" Text="{l:T 'Modifiers on this bind'}" />
                                                    <TextBlock Classes="caption" Text="{l:T 'While you hold a modifier (shift button) this input does something else. Tick modifiers and attach them.'}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="ghost small" Command="{Binding OpenModifierManagerCommand}" Content="{l:T 'Open Modifier Page'}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,12,*">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="label" Text="{l:T 'Your modifiers (tick to attach or detach)'}" />
                                                    <ListBox Classes="cards"
                                                             AutoScrollToSelectedItem="False"
                                                             ItemsSource="{Binding ModifierItems}"
                                                             SelectedItem="{Binding SelectedModifierItem}"
                                                             MinHeight="90"
                                                             MaxHeight="240">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ModifierListItem">
                                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" />
                                                                    <Border Grid.Column="1" Classes="keycap" IsVisible="{Binding HasInput}"><TextBlock Text="{Binding InputLabel}" /></Border>
                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Classes="caption" Text="{Binding DeviceShort}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <Border Grid.Column="3" Classes="chip"><TextBlock Text="{Binding UsageText}" /></Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <TextBlock Classes="caption" IsVisible="{Binding HasNoModifiers}" Text="{l:T 'No modifiers yet. Create one below.'}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="6">
                                                    <TextBlock Classes="label" Text="{l:T 'The picked modifier is used in'}" />
                                                    <ListBox Classes="cards" AutoScrollToSelectedItem="False" ItemsSource="{Binding SelectedModifierRelations}" MinHeight="90" MaxHeight="240" />
                                                </StackPanel>
                                            </Grid>
                                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                                <Button Classes="icon accent" Tag="{StaticResource Icon.Plus}" Command="{Binding ApplySelectedModifiersToBindCommand}" Content="{l:T 'Attach Selected To Bind'}" />
                                                <Button Classes="icon" Tag="{StaticResource Icon.Close}" Command="{Binding DetachSelectedModifiersFromBindCommand}" Content="{l:T 'Detach Selected From Bind'}" />
                                                <Button Classes="ghost" Command="{Binding ClearModifiersFromSelectedBindCommand}" Content="{l:T 'Clear All On Bind'}" />
                                                <Button Classes="ghost" Command="{Binding RefreshModifiersCommand}" Content="{l:T 'Refresh Modifier List'}" />
                                            </WrapPanel>
                                            <Expander Header="{l:T 'Create a modifier'}" HorizontalAlignment="Stretch">
                                                <StackPanel Margin="0,6,0,0" Spacing="8">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,220" ColumnSpacing="8">
                                                        <TextBlock Classes="label" Text="{l:T 'Name'}" />
                                                        <TextBox Grid.Column="1" Text="{Binding ModifierCreateName}" Watermark="{l:T 'e.g. Pinky'}" />
                                                        <TextBlock Grid.Column="2" Classes="label" Text="{l:T 'Device'}" />
                                                        <ComboBox Grid.Column="3"
                                                                  HorizontalAlignment="Stretch"
                                                                  ItemsSource="{Binding QuickBindDeviceOptions}"
                                                                  SelectedItem="{Binding ModifierCreateDevice}"
                                                                  Text="{Binding ModifierCreateDevice}"
                                                                  IsEditable="True" />
                                                        <TextBlock Grid.Column="4" Classes="label" Text="{l:T 'Input'}" />
                                                        <ComboBox Grid.Column="5"
                                                                  HorizontalAlignment="Stretch"
                                                                  ItemsSource="{Binding QuickBindInputOptions}"
                                                                  SelectedItem="{Binding ModifierCreateInput}"
                                                                  Text="{Binding ModifierCreateInput}"
                                                                  IsEditable="True" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                                        <TextBlock Classes="label" Text="{l:T 'On relation'}" />
                                                        <ComboBox Grid.Column="1"
                                                                  HorizontalAlignment="Stretch"
                                                                  ItemsSource="{Binding ModifierTargetRelationOptions}"
                                                                  SelectedItem="{Binding ModifierCreateTargetRelation}"
                                                                  IsEditable="False"
                                                                  IsEnabled="{Binding HasModifierTargetRelations}" />
                                                        <TextBlock Grid.Column="2" Classes="label" Text="{l:T 'Current bind'}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding SelectedBindRelationDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                                        <CheckBox Content="{l:T 'Invert'}" IsChecked="{Binding ModifierCreateInverted}" />
                                                        <Button Classes="icon" Tag="{StaticResource Icon.Record}" Command="{Binding RecordModifierInputCommand}" Content="{l:T 'Record Modifier Input'}" />
                                                        <Button Classes="accent" Command="{Binding CreateModifierOnSelectedBindCommand}" Content="{l:T 'Create Modifier'}" IsEnabled="{Binding CanCreateModifier}" />
                                                        <Button Classes="danger" Command="{Binding DeleteSelectedModifiersEverywhereCommand}" Content="{l:T 'Delete Selected (Profile-Wide)'}" />
                                                        <Button Classes="ghost" Command="{Binding ClearModifierSelectionCommand}" Content="{l:T 'Clear Selection'}" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding ModifierCreateValidationMessage}" Classes="warnText" FontSize="11.5"
                                                               IsVisible="{Binding HasModifierCreateValidationMessage}" />
                                                    <TextBlock Text="{Binding ModifierCapturePreview}" Classes="caption" />
                                                    <TextBlock Classes="caption" Text="{l:T 'Create without a relation = a temporary modifier; it is kept once it is attached to a bind. Rename it on the Modifiers page.'}" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>

                                    <!-- The axis response curve -->
                                    <Border IsVisible="{Binding SelectedBindIsAxis}">
                                <Expander Header="{l:T 'Axis response: curve, dead zone, saturation'}" HorizontalAlignment="Stretch" IsEnabled="{Binding SelectedBindIsAxis}" IsExpanded="{Binding IsAxisTuningExpanded}">
                                    <StackPanel Margin="0,6,0,0" Spacing="8">
                                        <TextBlock Text="{l:T 'The response curve of this axis: one setting for all games, or its own per game, DCS aircraft or game family. The most specific one wins (aircraft, game, family, all games).'}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{l:T 'Scope'}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding AxisTuningScopes}"
                                                      SelectedItem="{Binding SelectedAxisTuningScope}"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:AxisTuningScopeItem">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="2" Command="{Binding ReloadAxisTuningCommand}" Content="{l:T 'Reload'}" />
                                        </Grid>
                                        <TextBlock Text="{Binding AxisTuningStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AxisTuningModelText}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="300,*" ColumnSpacing="14">
                                            <StackPanel Spacing="4" VerticalAlignment="Top">
                                                <controls:AxisCurveView Width="300"
                                                                        Height="300"
                                                                        Curve="{Binding AxisTuningCurve}"
                                                                        ReferenceCurve="{Binding AxisTuningReferenceCurve}"
                                                                        StickInput="{Binding AxisTuningStickInput}"
                                                                        StickOutput="{Binding AxisTuningStickOutput}"
                                                                        Handles="{Binding AxisTuningHandles}"
                                                                        HandleMovedCommand="{Binding DragAxisTuningHandleCommand}" />
                                                <TextBlock Text="{l:T 'Blue: this scope. Dashed orange: all games (base), while inherited. Drag the white points (user curve or curve points) to shape the curve.'}"
                                                           FontSize="11"
                                                           Opacity="0.8"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding AxisTuningLiveText}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <ItemsControl ItemsSource="{Binding AxisTuningEditors}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:AxisParameterEditor">
                                                            <StackPanel Spacing="2" Margin="0,0,0,4">
                                                                <Grid IsVisible="{Binding IsNumber}" ColumnDefinitions="150,*,80" ColumnSpacing="8">
                                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" ToolTip.Tip="{Binding RangeText}" />
                                                                    <Slider Grid.Column="1"
                                                                            Minimum="{Binding Minimum}"
                                                                            Maximum="{Binding Maximum}"
                                                                            SmallChange="{Binding Step}"
                                                                            LargeChange="{Binding Step}"
                                                                            TickFrequency="{Binding Step}"
                                                                            IsSnapToTickEnabled="True"
                                                                            Value="{Binding Value}"
                                                                            IsEnabled="{Binding IsActive}" />
                                                                    <TextBox Grid.Column="2"
                                                                             Text="{Binding Text}"
                                                                             IsEnabled="{Binding IsActive}"
                                                                             VerticalAlignment="Center" />
                                                                </Grid>
                                                                <CheckBox IsVisible="{Binding IsToggle}" Content="{Binding Label}" IsChecked="{Binding IsOn}" />
                                                                <StackPanel IsVisible="{Binding IsUserCurve}" IsEnabled="{Binding IsActive}" Spacing="2">
                                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" />
                                                                    <ItemsControl ItemsSource="{Binding Points}" IsVisible="{Binding IsOn}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" Spacing="2" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:AxisCurvePointEditor">
                                                                                <StackPanel Width="28" Spacing="1">
                                                                                    <Slider Orientation="Vertical"
                                                                                            Height="110"
                                                                                            Minimum="0"
                                                                                            Maximum="1"
                                                                                            SmallChange="0.01"
                                                                                            LargeChange="0.05"
                                                                                            Value="{Binding Value}"
                                                                                            HorizontalAlignment="Center" />
                                                                                    <TextBlock Text="{Binding PositionLabel}" FontSize="9" HorizontalAlignment="Center" Opacity="0.8" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel IsVisible="{Binding AxisTuningSupportsControlPoints}" Spacing="4">
                                                    <CheckBox Content="{l:T 'Curve points (free stops, replace dead zone, saturation and curvature)'}" IsChecked="{Binding AxisTuningUseControlPoints}"
                                                              ToolTip.Tip="{l:T 'The game\'s response curve with any number of stops: x = axis travel, y = output, both 0..1, x increasing'}" />
                                                    <StackPanel IsVisible="{Binding AxisTuningUseControlPoints}" Spacing="2">
                                                        <Grid ColumnDefinitions="90,90,Auto" ColumnSpacing="6">
                                                            <TextBlock Text="{l:T 'x (travel)'}" FontSize="11" Opacity="0.8" />
                                                            <TextBlock Grid.Column="1" Text="{l:T 'y (output)'}" FontSize="11" Opacity="0.8" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding AxisTuningControlPoints}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:AxisControlPointEditor">
                                                                    <Grid ColumnDefinitions="90,90,Auto" ColumnSpacing="6" Margin="0,1">
                                                                        <TextBox Text="{Binding XText}" />
                                                                        <TextBox Grid.Column="1" Text="{Binding YText}" />
                                                                        <Button Grid.Column="2" Content="{l:T 'Remove'}" Command="{Binding #RootWindow.DataContext.RemoveAxisTuningControlPointCommand}" CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button Command="{Binding AddAxisTuningControlPointCommand}" Content="{l:T 'Add point'}" HorizontalAlignment="Left" ToolTip.Tip="{l:T 'A new point in the middle of the widest gap'}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="{Binding AxisTuningValidation}"
                                                           Foreground="#F59E0B"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding HasAxisTuningValidation}" />
                                                <WrapPanel>
                                                    <Button Command="{Binding SaveAxisTuningCommand}"
                                                            Content="{l:T 'Save for this scope'}"
                                                            IsEnabled="{Binding CanSaveAxisTuning}"
                                                            Margin="0,0,8,0" />
                                                    <Button Command="{Binding ClearAxisTuningCommand}"
                                                            Content="{l:T 'Inherit (clear)'}"
                                                            IsEnabled="{Binding CanClearAxisTuning}"
                                                            ToolTip.Tip="{l:T 'Remove this scope\'s own settings; it then uses the next broader scope.'}"
                                                            Margin="0,0,8,0" />
                                                </WrapPanel>
                                                <TextBlock Text="{l:T 'Changed, not saved yet.'}"
                                                           Foreground="#F59E0B"
                                                           FontSize="11"
                                                           IsVisible="{Binding AxisTuningHasEdits}" />
                                                <TextBlock Text="{l:T 'Edits preview immediately; nothing is stored until you save.'}"
                                                           FontSize="11"
                                                           Opacity="0.8"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                                    </Border>

                                    <!-- Detent mode: one throttle relation for all aircraft (docs/axis-curves.md "Detent mode") -->
                                    <Border IsVisible="{Binding SelectedBindIsAxis}">
                                <Expander Header="{l:T 'Detent mode: one throttle for all aircraft (afterburner detent)'}" HorizontalAlignment="Stretch" IsEnabled="{Binding SelectedBindIsAxis}" IsExpanded="{Binding IsDetentExpanded}">
                                    <StackPanel Margin="0,6,0,0" Spacing="8">
                                        <TextBlock Text="{l:T 'With detent mode, this one throttle relation serves every aircraft: JoyPro bends the curve per aircraft so that your device\'s afterburner detent is exactly where that aircraft\'s afterburner starts. Aircraft with the same start share one curve.'}"
                                                   FontSize="11" TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <CheckBox Content="{l:T 'Detent mode on'}" IsChecked="{Binding DetentOn}" IsEnabled="{Binding DetentLoaded}" Margin="0,0,16,0" />
                                            <CheckBox Content="{l:T 'Aircraft without afterburner: full power at the detent'}" IsChecked="{Binding DetentNoAbFull}" IsEnabled="{Binding DetentLoaded}"
                                                      ToolTip.Tip="{l:T 'Off: they keep the relation\'s curve over the whole travel.'}" Margin="0,0,16,0" />
                                            <Button Command="{Binding StartDetentWizardCommand}" Content="{l:T 'Calibrate detent...'}" Margin="0,0,8,0"
                                                    ToolTip.Tip="{l:T 'Move the throttle to idle, to the detent and to full; JoyPro reads the device live.'}" />
                                            <Button Command="{Binding OpenDetentMergeCommand}" Content="{l:T 'Merge my throttle relations...'}" Margin="0,0,8,0"
                                                    ToolTip.Tip="{l:T 'Your per-aircraft throttle relations on one device axis become one relation in detent mode (preview first, undo afterwards).'}" />
                                            <Button Command="{Binding ReloadDetentCommand}" Content="{l:T 'Reload'}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding DetentStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DetentCalibrationText}" FontSize="11.5" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DetentWarningText}" Foreground="#F59E0B" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasDetentWarning}" />

                                        <!-- Calibration wizard -->
                                        <Border IsVisible="{Binding IsDetentWizardOpen}" Background="#14223A" BorderBrush="#0EA5E9" BorderThickness="1" CornerRadius="6" Padding="10">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding DetentWizardStepTitle}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding DetentWizardStepText}" TextWrapping="Wrap" />
                                                <controls:DetentTravelBar Raw="{Binding DetentWizardRaw}" Marks="{Binding DetentWizardMarks}" IsVisible="{Binding IsDetentWizardCapturing}" />
                                                <TextBlock Text="{Binding DetentWizardLiveText}" FontSize="11" IsVisible="{Binding IsDetentWizardCapturing}" />
                                                <TextBlock Text="{Binding DetentWizardMarksText}" FontSize="11" Opacity="0.85" />
                                                <TextBlock Text="{Binding DetentWizardError}" Foreground="#F59E0B" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasDetentWizardError}" />
                                                <WrapPanel>
                                                    <Button Command="{Binding ConfirmDetentWizardStepCommand}" Content="{l:T 'Confirm'}" IsEnabled="{Binding CanConfirmDetentWizardStep}" IsVisible="{Binding IsDetentWizardCapturing}" Margin="0,0,8,0" />
                                                    <Button Command="{Binding SkipDetentWizardStepCommand}" Content="{l:T 'Skip'}" IsVisible="{Binding CanSkipDetentWizardStep}" Margin="0,0,8,0" />
                                                    <Button Command="{Binding SaveDetentWizardCommand}" Content="{l:T 'Save calibration'}" IsVisible="{Binding IsDetentWizardSummary}" Margin="0,0,8,0" />
                                                    <Button Command="{Binding BackDetentWizardStepCommand}" Content="{l:T 'Back'}" IsEnabled="{Binding CanGoBackDetentWizard}" Margin="0,0,8,0" />
                                                    <Button Command="{Binding CancelDetentWizardCommand}" Content="{l:T 'Cancel'}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Merge helper -->
                                        <Border IsVisible="{Binding IsDetentMergeOpen}" Background="#16202E" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="10">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{l:T 'Merge per-aircraft throttle relations into one relation in detent mode'}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DetentMergeStatus}" FontSize="11.5" TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding DetentMergeProposals}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:DetentMergeProposalItem">
                                                            <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding CalibrationText}" FontSize="11" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding GroupsText}" FontSize="11" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding NotesText}" FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap" IsVisible="{Binding HasNotes}" />
                                                                    <Button Content="{l:T 'Merge'}" Command="{Binding #RootWindow.DataContext.ApplyDetentMergeCommand}" CommandParameter="{Binding}" IsEnabled="{Binding CanApply}" HorizontalAlignment="Left" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <WrapPanel>
                                                    <Button Command="{Binding UndoDetentMergeCommand}" Content="{l:T 'Undo merge'}" IsVisible="{Binding DetentMergeUndoAvailable}" Margin="0,0,8,0" />
                                                    <Button Command="{Binding CloseDetentMergeCommand}" Content="{l:T 'Close'}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Aircraft groups -->
                                        <ItemsControl ItemsSource="{Binding DetentGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:DetentGroupItem">
                                                    <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
                                                            <controls:DetentCurveView Width="220" Height="150" VerticalAlignment="Top"
                                                                                      Points="{Binding Throttle}" DetentTravel="{Binding DetentTravel}" AbStart="{Binding AbStartOrNaN}"
                                                                                      IsVisible="{Binding HasCurve}" />
                                                            <StackPanel Grid.Column="1" Spacing="4">
                                                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding SourceText}" FontSize="11" Opacity="0.85" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding GamesText}" FontSize="11" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding WarningText}" FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap" IsVisible="{Binding HasWarnings}" />
                                                                <WrapPanel>
                                                                    <TextBlock Text="{l:T 'Afterburner starts at'}" VerticalAlignment="Center" FontSize="11.5" Margin="0,0,6,0" />
                                                                    <TextBox Text="{Binding AbText}" Width="64" Watermark="{l:T 'game data'}" Margin="0,0,6,0" />
                                                                    <TextBlock Text="{l:T '% of the game\'s throttle'}" VerticalAlignment="Center" FontSize="11.5" Margin="0,0,6,0" />
                                                                    <Button Content="{l:T 'Set'}" Command="{Binding #RootWindow.DataContext.SetDetentGroupAbCommand}" CommandParameter="{Binding}" Margin="0,0,6,0"
                                                                            ToolTip.Tip="{l:T 'Every aircraft of this group gets this afterburner start; empty = the game data.'}" />
                                                                    <Button Content="{l:T 'Game data'}" Command="{Binding #RootWindow.DataContext.ResetDetentGroupCommand}" CommandParameter="{Binding}"
                                                                            ToolTip.Tip="{l:T 'Back to the afterburner start JoyPro\'s game data has for these aircraft.'}" />
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{l:T 'Orange band: the afterburner range of the game\'s throttle; dashed line: your device\'s detent. Resting in the detent stays just below the afterburner, pushing over it lights it.'}"
                                                   FontSize="11" Opacity="0.8" TextWrapping="Wrap" IsVisible="{Binding HasDetentGroups}" />
                                    </StackPanel>
                                </Expander>
                                    </Border>

                                    <Border Classes="surface tight">
                                        <StackPanel Spacing="6">
                                            <Expander Header="{l:T 'Bind behavior (advanced)'}" HorizontalAlignment="Stretch">
                                                <StackPanel Margin="0,6,0,0" Spacing="6">
                                                    <TextBlock Classes="caption" Text="{l:T 'Behavior flags for the currently selected bind. They are saved with Set Bind.'}" />
                                                    <WrapPanel ItemSpacing="12" LineSpacing="6">
                                                        <CheckBox Content="{l:T 'Inverted (axis, DCS + IL2)'}" IsChecked="{Binding BindInverted}" IsEnabled="{Binding SelectedBindIsAxis}" />
                                                        <CheckBox Content="{l:T 'Slider'}" IsChecked="{Binding BindSlider}" IsEnabled="{Binding SelectedBindIsAxis}" />
                                                        <CheckBox Content="{l:T 'Double tap (profile only)'}" IsChecked="{Binding BindDoubleTap}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Expander>
                                            <Expander Header="{l:T 'Unbind an input everywhere (advanced)'}" HorizontalAlignment="Stretch">
                                                <StackPanel Margin="0,6,0,0" Spacing="8">
                                                    <TextBlock Classes="caption" Text="{l:T 'Frees a physical input everywhere in the profile. Empty device = that input on any device.'}" />
                                                    <Grid ColumnDefinitions="Auto,*,Auto,140,Auto,110" ColumnSpacing="8">
                                                        <TextBlock Classes="label" Text="{l:T 'Device'}" />
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding QuickBindDeviceOptions}" SelectedItem="{Binding UnbindDevice}" Text="{Binding UnbindDevice}" IsEditable="True" HorizontalAlignment="Stretch" />
                                                        <TextBlock Grid.Column="2" Classes="label" Text="{l:T 'Input'}" />
                                                        <TextBox Grid.Column="3" Text="{Binding UnbindInput}" Watermark="JOY_BTN3" />
                                                        <TextBlock Grid.Column="4" Classes="label" Text="{l:T 'Game'}" />
                                                        <TextBox Grid.Column="5" Text="{Binding UnbindGame}" Watermark="{l:T 'optional'}" />
                                                    </Grid>
                                                    <WrapPanel ItemSpacing="10" LineSpacing="6">
                                                        <CheckBox Content="{l:T 'In all relations (otherwise only if exactly one relation uses it)'}" IsChecked="{Binding UnbindAll}" />
                                                        <Button Classes="danger" Command="{Binding UnbindInputCommand}" Content="{l:T 'Unbind'}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Modifiers: the shift buttons of the profile as cards (key cap, device, how many binds use them); on the right
                     the picked one with where it is used, and creating, renaming and deleting modifiers. -->
                <Border IsVisible="{Binding IsModifiersStage}" Padding="0,4,0,0">
                    <Grid ColumnDefinitions="400,12,*">
                        <Border Classes="surface" Padding="12">
                            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Keycap}" /></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Classes="h2" FontSize="18" FontWeight="Bold" Text="{l:T 'Modifier Library'}" />
                                        <TextBlock Classes="caption" Text="{l:T '{}{0} modifiers in your profile', Arg0={Binding ModifierCount}}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Classes="caption"
                                           Text="{l:T 'A modifier is a shift button: while you hold it, your other buttons do something else. One button, several jobs.'}" />
                                <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="8">
                                    <Button Classes="icon small" Tag="{StaticResource Icon.Refresh}" Command="{Binding RefreshModifiersCommand}" Content="{l:T 'Refresh Modifiers'}" />
                                    <Button Classes="icon small ghost" Tag="{StaticResource Icon.Close}" Command="{Binding ClearModifierSelectionCommand}" Content="{l:T 'Clear Selection'}" />
                                    <Button Classes="icon small ghost" Tag="{StaticResource Icon.ArrowLeft}" Command="{Binding GoBindsCommand}" Content="{l:T 'Back To Binds'}" />
                                </WrapPanel>
                                <Panel Grid.Row="3">
                                    <ListBox Classes="cards"
                                             ItemsSource="{Binding ModifierItems}"
                                             SelectedItem="{Binding SelectedModifierItem}"
                                             MinHeight="160">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ModifierListItem">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" ToolTip.Tip="{l:T 'Tick for Delete or for attaching on the Binds page'}" />
                                                    <Border Grid.Column="1" Classes="keycap" IsVisible="{Binding HasInput}"><TextBlock Text="{Binding InputLabel}" /></Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="caption" Text="{Binding DeviceShort}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DeviceInputPreview}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="3" Classes="chip modifier"><TextBlock Text="{Binding UsageText}" /></Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border Classes="emptyState" IsVisible="{Binding HasNoModifiers}" VerticalAlignment="Top">
                                        <StackPanel Spacing="10">
                                            <PathIcon Classes="emptyIcon" Data="{StaticResource Icon.Shift}" />
                                            <TextBlock Classes="h2" HorizontalAlignment="Center" Text="{l:T 'No modifiers yet'}" />
                                            <TextBlock Classes="caption" TextAlignment="Center"
                                                       Text="{l:T 'Make one on the right: give it a name and press Record to pick the shift button on your device. Then attach it to binds on the Binds page.'}" />
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12" Margin="0,0,10,0">
                                <!-- The picked modifier -->
                                <Border Classes="surface" IsVisible="{Binding HasModifierSelected}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                            <Border Classes="keycap large" VerticalAlignment="Center" IsVisible="{Binding SelectedModifierItem.HasInput}">
                                                <TextBlock Text="{Binding SelectedModifierItem.InputLabel}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedModifierItem.DisplayName}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <WrapPanel ItemSpacing="6" LineSpacing="4">
                                                    <Border Classes="chip device" ToolTip.Tip="{Binding SelectedModifierItem.PrimaryDevice}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <PathIcon Data="{StaticResource Icon.Joystick}" />
                                                            <TextBlock Text="{Binding SelectedModifierItem.DeviceShort}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Classes="chip modifier"><TextBlock Text="{Binding SelectedModifierItem.UsageText}" /></Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Classes="label" Text="{l:T 'Used In Relations'}" />
                                        <ListBox Classes="cards" AutoScrollToSelectedItem="False" ItemsSource="{Binding SelectedModifierRelations}" MinHeight="60" MaxHeight="300" />
                                        <TextBlock Classes="caption" Text="{l:T 'Usage means: how many relations use this modifier now. Attach and detach it on the Binds page.'}" />
                                    </StackPanel>
                                </Border>

                                <!-- Create -->
                                <Border Classes="surface">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Plus}" /></Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="h2" Text="{l:T 'New modifier'}" />
                                                <TextBlock Classes="caption" Text="{l:T 'Name it, then Record and press the shift button on your device (or pick device and input). Without a relation it stays temporary until you attach it to a bind.'}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,220" ColumnSpacing="8">
                                            <TextBlock Classes="label" Text="{l:T 'Name'}" />
                                            <TextBox Grid.Column="1" Text="{Binding ModifierCreateName}" Watermark="{l:T 'e.g. Pinky'}" />
                                            <TextBlock Grid.Column="2" Classes="label" Text="{l:T 'Device'}" />
                                            <ComboBox Grid.Column="3"
                                                      HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding QuickBindDeviceOptions}"
                                                      SelectedItem="{Binding ModifierCreateDevice}"
                                                      Text="{Binding ModifierCreateDevice}"
                                                      IsEditable="True" />
                                            <TextBlock Grid.Column="4" Classes="label" Text="{l:T 'Input'}" />
                                            <ComboBox Grid.Column="5"
                                                      HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding QuickBindInputOptions}"
                                                      SelectedItem="{Binding ModifierCreateInput}"
                                                      Text="{Binding ModifierCreateInput}"
                                                      IsEditable="True" />
                                        </Grid>
                                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                                            <CheckBox Content="{l:T 'Invert'}" IsChecked="{Binding ModifierCreateInverted}" ToolTip.Tip="{l:T 'Active while the button is NOT held'}" />
                                            <Button Classes="icon" Tag="{StaticResource Icon.Record}" Command="{Binding RecordModifierInputCommand}" Content="{l:T 'Record Modifier Input'}" />
                                            <Button Classes="icon accent" Tag="{StaticResource Icon.Check}" Command="{Binding CreateModifierOnSelectedBindCommand}" Content="{l:T 'Create Modifier'}" IsEnabled="{Binding CanCreateModifier}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ModifierCreateValidationMessage}" Classes="warnText" FontSize="11.5"
                                                   IsVisible="{Binding HasModifierCreateValidationMessage}" />
                                        <TextBlock Text="{Binding ModifierCapturePreview}" Classes="caption" />
                                    </StackPanel>
                                </Border>

                                <!-- Rename -->
                                <Border Classes="surface">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Pencil}" /></Border>
                                            <TextBlock Grid.Column="1" Classes="h2" Text="{l:T 'Rename'}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock Classes="label" Text="{l:T 'From'}" />
                                            <ComboBox Grid.Column="1"
                                                      HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding ModifierNames}"
                                                      SelectedItem="{Binding ModifierRenameOld}"
                                                      Text="{Binding ModifierRenameOld}"
                                                      IsEditable="True" />
                                            <TextBlock Grid.Column="2" Classes="label" Text="{l:T 'To'}" />
                                            <TextBox Grid.Column="3" Text="{Binding ModifierRenameNew}" />
                                            <Button Grid.Column="4" Command="{Binding RenameModifierCommand}" Content="{l:T 'Rename'}" IsEnabled="{Binding CanRenameModifier}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Delete -->
                                <Border Classes="callout error">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel>
                                            <TextBlock Classes="h3" Text="{l:T 'Delete the ticked modifiers'}" />
                                            <TextBlock Classes="caption" Text="{l:T 'They come off every bind in the profile; the binds stay. JoyPro asks first, and Undo (Ctrl+Z) puts them back.'}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="icon danger" Tag="{StaticResource Icon.Delete}" VerticalAlignment="Center"
                                                Command="{Binding DeleteSelectedModifiersEverywhereCommand}" Content="{l:T 'Delete Selected (Profile-Wide)'}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Layout: "Device pictures" (one device's picture with its markers; modes View / Edit markers / Bind around the
                     picture canvas, MainWindowViewModel.LayoutWorkspace.cs) and "Cheat sheets" (printable pictures of the devices
                     with what every button does, MainWindowViewModel.CheatSheets.cs). The canvas region DeviceReferenceHost is the
                     place of the device reference control; its contract: docs/ui/layout-redesign.md. -->
                <Border IsVisible="{Binding IsLayoutStage}" Padding="0,4,0,0">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Classes="iconBadge large"><PathIcon Data="{StaticResource Icon.Image}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="pageTitle" Text="{l:T 'Layout'}" />
                                <TextBlock Classes="pageSubtitle" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Text="{l:T 'Your devices as pictures: see what every button does, put the markers on the real buttons, bind by clicking a button, print cheat sheets.'}" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="segmented">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <ToggleButton Classes="icon" Tag="{StaticResource Icon.Joystick}" Content="{l:T 'Device pictures'}"
                                                  IsChecked="{Binding IsDevicePicturesSection, Mode=OneWay}" Command="{Binding ShowDevicePicturesSectionCommand}"
                                                  ToolTip.Tip="{l:T 'The picture of one device: what its inputs do, edit the markers, bind on the picture'}" />
                                    <ToggleButton Classes="icon" Tag="{StaticResource Icon.Printer}" Content="{l:T 'Cheat sheets'}"
                                                  IsChecked="{Binding IsCheatSheetsSection, Mode=OneWay}" Command="{Binding ShowCheatSheetsSectionCommand}"
                                                  ToolTip.Tip="{l:T 'Printable pictures of your devices with what every button does (changes no game)'}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Device pictures -->
                        <Grid Grid.Row="1" IsVisible="{Binding IsDevicePicturesSection}" ColumnDefinitions="270,*,340" ColumnSpacing="12" MinHeight="0">
                            <!-- The devices -->
                            <Border Classes="surface" Padding="12">
                                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Joystick}" /></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Classes="h2" Text="{l:T 'Your devices'}" />
                                            <TextBlock Classes="caption" Text="{l:T 'Pick one to see its picture'}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="icon small ghost iconOnly" Tag="{StaticResource Icon.Refresh}" Command="{Binding SuggestLayoutsCommand}"
                                                ToolTip.Tip="{l:T 'Find the pictures of your devices again'}" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Classes="caption" Text="{Binding LayoutSuggestStatus}"
                                               IsVisible="{Binding LayoutSuggestStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <Panel Grid.Row="2">
                                        <ListBox Classes="cards" ItemsSource="{Binding LayoutSuggestions}" SelectedItem="{Binding SelectedLayoutSuggestion}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:LayoutSuggestionItem">
                                                    <StackPanel Spacing="3" ToolTip.Tip="{Binding DeviceTip}">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="caption" Text="{Binding ModelLine}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <Border Classes="chip ok" IsVisible="{Binding IsOwnLayout}" ToolTip.Tip="{l:T 'Your own layout file of this device (markers, tables and lines of the cheat sheets)'}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <PathIcon Data="{StaticResource Icon.MapMarker}" />
                                                                    <TextBlock Text="{Binding MarkerSummary}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Classes="chip device" IsVisible="{Binding !IsOwnLayout}"><TextBlock Text="{l:T 'Reference picture'}" /></Border>
                                                            <Button Classes="icon small ghost iconOnly" Tag="{StaticResource Icon.Swap}" Padding="4,1"
                                                                    Command="{Binding #RootWindow.DataContext.OpenReplaceDeviceCommand}" CommandParameter="{Binding Device}"
                                                                    ToolTip.Tip="{l:T 'Replace this device: move its binds to another device, input by input'}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border Classes="emptyState" IsVisible="{Binding HasNoLayoutSuggestions}" VerticalAlignment="Top" Padding="16">
                                            <StackPanel Spacing="8">
                                                <PathIcon Classes="emptyIcon" Data="{StaticResource Icon.Joystick}" />
                                                <TextBlock Classes="h3" HorizontalAlignment="Center" Text="{l:T 'No devices listed'}" />
                                                <TextBlock Classes="caption" TextAlignment="Center" Text="{l:T 'JoyPro looks for a picture of every connected stick, throttle and pedals.'}" />
                                                <Button Classes="icon small accent" Tag="{StaticResource Icon.Search}" Content="{l:T 'Find my devices'}" Command="{Binding SuggestLayoutsCommand}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Panel>
                                    <StackPanel Grid.Row="3" Spacing="8">
                                        <StackPanel Spacing="4">
                                            <Button Classes="icon small accent" Tag="{StaticResource Icon.FolderOpen}" Content="{l:T 'Use my old JoyPro layouts...'}" Click="OldLayoutsClicked"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTip.Tip="{l:T 'Your JoyPro 1 layouts (.layout files with your pictures): JoyPro copies them and shows them for the devices they were made for. The old folder is only read.'}" />
                                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding OldLayoutsStatus}" IsVisible="{Binding HasOldLayoutsStatus}" />
                                        </StackPanel>
                                        <Expander HorizontalAlignment="Stretch" Header="{l:T 'Use your own picture'}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="caption" Text="{l:T 'Search a picture of the model, save it (or copy its image address). JoyPro puts the device\'s real buttons and axes on it.'}" />
                                                <Button Classes="icon small" Tag="{StaticResource Icon.Search}" Command="{Binding OpenLayoutBackdropWebSearchCommand}" Content="{l:T 'Search a picture'}"
                                                        HorizontalAlignment="Stretch" ToolTip.Tip="{l:T 'Opens an image search for the selected device\'s vendor and model'}" />
                                                <TextBox Text="{Binding LayoutPictureSource}" Watermark="{l:T 'Picture file or image address'}" />
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                                    <Button Classes="icon small" Tag="{StaticResource Icon.FolderOpen}" Content="{l:T 'Browse...'}" Click="BrowseLayoutPictureClicked" HorizontalAlignment="Stretch" />
                                                    <Button Grid.Column="1" Classes="icon small accent" Tag="{StaticResource Icon.Wand}" Command="{Binding UseLayoutPictureCommand}" Content="{l:T 'Use picture'}"
                                                            IsEnabled="{Binding CanRun}" HorizontalAlignment="Stretch" />
                                                </Grid>
                                            </StackPanel>
                                        </Expander>
                                        <Expander HorizontalAlignment="Stretch" Header="{l:T 'Where JoyPro looks'}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="label" Text="{l:T 'Picture catalog (json)'}" />
                                                <TextBox Text="{Binding LayoutCatalogPath}" Watermark="{l:T 'Optional catalog path'}" />
                                                <TextBlock Classes="label" Text="{l:T 'JoyPro 1 layout folders'}" />
                                                <TextBox Text="{Binding LayoutLegacyLayoutDirs}" Watermark="C:\Layouts,D:\Templates" />
                                                <TextBlock Classes="label" Text="{l:T 'JoyPro 1 output folders'}" />
                                                <TextBox Text="{Binding LayoutLegacyOutputDirs}" />
                                                <CheckBox Content="{l:T 'Connected devices'}" IsChecked="{Binding LayoutSuggestIncludeConnected}" />
                                                <CheckBox Content="{l:T 'Devices of the profile'}" IsChecked="{Binding LayoutSuggestIncludeProfileDevices}" />
                                                <CheckBox Content="{l:T 'Store the picks in the profile'}" IsChecked="{Binding LayoutSuggestApplyToProfile}" />
                                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                    <Button Classes="small" Command="{Binding SuggestLayoutsCommand}" Content="{l:T 'Suggest'}" />
                                                    <Button Classes="small" Command="{Binding ApplySelectedLayoutSuggestionsCommand}" Content="{l:T 'Apply Selected'}" ToolTip.Tip="{l:T 'Use the picked pictures for the cheat sheets'}" />
                                                    <Button Classes="small" Command="{Binding OpenSelectedLayoutInEditorCommand}" Content="{l:T 'Open + Load Selected'}" />
                                                    <Button Classes="small" Command="{Binding LoadLayoutEditorSourceCommand}" Content="{l:T 'Reload Source Path'}" />
                                                </WrapPanel>
                                                <TextBlock Classes="label" Text="{l:T 'Layout file'}" />
                                                <TextBox Text="{Binding LayoutEditorSourcePath}" Watermark="{l:T 'Path to .layout or picture'}" />
                                                <TextBlock Classes="label" Text="{l:T 'Save as'}" />
                                                <TextBox Text="{Binding LayoutEditorOutputPath}" Watermark="{l:T 'Edited .layout output path'}" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- The picture: the device reference (your photo > the maker's photo > JoyPro's drawing) or the device's
                                 layout file, on the one picture canvas (Workspace* in MainWindowViewModel.LayoutReference.cs). -->
                            <Border Grid.Column="1" Classes="surface" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <!-- A narrow canvas (1280 px window): the drawing style, rows and Save go onto a second line instead
                                         of being cut off. -->
                                    <Border Classes="toolbar" Container.Name="LayoutCanvasBar" Container.Sizing="Width">
                                        <Border.Styles>
                                            <Style Selector="StackPanel.layoutBarRight">
                                                <Setter Property="Grid.Column" Value="2" />
                                            </Style>
                                            <ContainerQuery Name="LayoutCanvasBar" Query="max-width:760">
                                                <Style Selector="StackPanel.layoutBarRight">
                                                    <Setter Property="Grid.Row" Value="1" />
                                                    <Setter Property="Grid.Column" Value="0" />
                                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="Margin" Value="0,8,0,0" />
                                                </Style>
                                            </ContainerQuery>
                                        </Border.Styles>
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                            <Border Classes="segmented">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <ToggleButton Classes="icon" Tag="{StaticResource Icon.Eye}" Content="{l:T 'View'}" IsChecked="{Binding IsLayoutViewMode, Mode=OneWay}"
                                                                  Command="{Binding SetLayoutCanvasModeCommand}" CommandParameter="view" ToolTip.Tip="{l:T 'Look: what every input does (V)'}" />
                                                    <ToggleButton Classes="icon" Tag="{StaticResource Icon.Pencil}" Content="{l:T 'Edit'}" IsChecked="{Binding IsLayoutEditMode, Mode=OneWay}"
                                                                  Command="{Binding SetLayoutCanvasModeCommand}" CommandParameter="edit" ToolTip.Tip="{l:T 'Drag the markers onto the real parts, names, your photo, the marker assistant (E)'}" />
                                                    <ToggleButton Classes="icon" Tag="{StaticResource Icon.Link}" Content="{l:T 'Bind'}" IsChecked="{Binding IsLayoutBindMode, Mode=OneWay}"
                                                                  Command="{Binding SetLayoutCanvasModeCommand}" CommandParameter="bind" ToolTip.Tip="{l:T 'Click an input and pick what it does (B)'}" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsLayoutEditMode}">
                                                <ToggleButton Classes="icon small iconOnly" Tag="{StaticResource Icon.MapMarker}" IsChecked="{Binding LayoutPlaceMarkerMode}" IsVisible="{Binding LayoutShowsLayoutFile}"
                                                              ToolTip.Tip="{l:T 'Place marker: click on the picture to put a new marker there (N). The input and type come from the panel on the right.'}" />
                                                <Button Classes="icon small ghost iconOnly" Tag="{StaticResource Icon.Undo}" Command="{Binding UndoLayoutEditCommand}" IsEnabled="{Binding CanUndoLayoutEdit}"
                                                        ToolTip.Tip="{Binding LayoutUndoTip}" />
                                                <Button Classes="icon small ghost iconOnly" Tag="{StaticResource Icon.Redo}" Command="{Binding RedoLayoutEditCommand}" IsEnabled="{Binding CanRedoLayoutEdit}"
                                                        ToolTip.Tip="{Binding LayoutRedoTip}" />
                                                <Border Width="1" Height="20" Background="{DynamicResource JP.BorderBrush}" />
                                                <ToggleButton Classes="icon small iconOnly" Tag="{StaticResource Icon.Magnet}" IsChecked="{Binding LayoutSnapEnabled}"
                                                              ToolTip.Tip="{l:T 'Snap to the other markers (hold Alt to drag freely)'}" />
                                                <ToggleButton Classes="icon small iconOnly" Tag="{StaticResource Icon.Grid}" IsChecked="{Binding LayoutShowGrid}"
                                                              ToolTip.Tip="{l:T 'Show a 10 px grid and snap to it'}" />
                                                <ToggleButton Classes="icon small iconOnly" Tag="{StaticResource Icon.Tag}" IsChecked="{Binding LayoutShowOverlays}" IsVisible="{Binding LayoutShowsLayoutFile}"
                                                              ToolTip.Tip="{l:T 'Tables and lines: show the legend tables and connector lines of the cheat sheets on the picture (edit them under \'Tables, lines and label style\' on the right)'}" />
                                                <Button Classes="icon small ghost iconOnly" Tag="{StaticResource Icon.Wand}" Command="{Binding CalloutAutoArrangeCommand}"
                                                        IsVisible="{Binding IsCalloutEditMode}" ToolTip.Tip="{l:T 'Auto arrange: the tables and lines again; pinned tables (moved by you) stay where they are'}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding IsLayoutViewMode}" Text="{Binding LayoutLegendSummary}" />
                                            <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding IsLayoutBindMode}" TextTrimming="CharacterEllipsis"
                                                       Text="{l:T 'Click an input, then pick what it does on the right. The bind goes into your profile.'}" />
                                            <StackPanel Classes="layoutBarRight" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <!-- Tables and lines on the reference picture, and what their rows show -->
                                                <ToggleButton Classes="icon small iconOnly" Tag="{StaticResource Icon.Grid}" IsChecked="{Binding LayoutCalloutsEnabled}"
                                                              IsVisible="{Binding CanShowLayoutCallouts}"
                                                              ToolTip.Tip="{l:T 'Tables: tables around the picture with lines to the parts (JoyPro 1\'s cheat sheets); off: labels at the markers'}" />
                                                <!-- Drawing style of JoyPro's drawings: Lines | Cel-shaded (Settings > Drawings has the colours) -->
                                                <ToggleButton Classes="small" Content="{l:T '3D view'}" IsChecked="{Binding WorkspaceShows3D}" IsVisible="{Binding HasWorkspaceTurntable}"
                                                              ToolTip.Tip="{l:T 'Turn the device around (drag; wheel zooms; double click resets): JoyPro\'s render of a 3D model of the device. Off: the flat drawing, which is what the cheat sheets print and what Edit mode works on.'}" />
                                                <ComboBox ItemsSource="{Binding ScreenDrawing.ModeChoices}" SelectedItem="{Binding ScreenDrawing.Mode}" MinWidth="110"
                                                          IsVisible="{Binding WorkspaceShowsLineArt}"
                                                          ToolTip.Tip="{l:T 'Drawing style of JoyPro\'s drawing: lines, or flat colours under bold outlines (colours: Settings &gt; Drawings)'}" />
                                                <ComboBox ItemsSource="{Binding CalloutPreviewOptions}" SelectedItem="{Binding SelectedCalloutPreview}" MinWidth="130" MaxWidth="220"
                                                          IsVisible="{Binding ShowCalloutPreviewBox}"
                                                          ToolTip.Tip="{l:T 'What the rows show: the relation names, or one game and aircraft with that game\'s own menu titles'}" />
                                                <Border Classes="chip warn" IsVisible="{Binding WorkspaceHasUnsavedChanges}" ToolTip.Tip="{l:T 'The markers changed; Save keeps them'}">
                                                    <TextBlock Text="{l:T 'Unsaved'}" />
                                                </Border>
                                                <Button Classes="icon small accent" Tag="{StaticResource Icon.Save}" Content="{l:T 'Save'}" Command="{Binding SaveWorkspaceCommand}"
                                                        IsEnabled="{Binding CanSaveWorkspace}" ToolTip.Tip="{Binding SaveWorkspaceTip}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Panel Grid.Row="1">
                                        <!-- Tables and lines (JoyPro 1's cheat sheet look) on a reference picture with known positions:
                                             MainWindowViewModel.LayoutCallouts.cs, CalloutSheetCanvas. -->
                                        <Border Classes="canvasHost" IsVisible="{Binding LayoutShowsCallouts}">
                                            <controls:CalloutSheetCanvas x:Name="LayoutCalloutCanvas"
                                                                         TopInset="104"
                                                                         Callouts="{Binding LayoutCallouts}"
                                                                         Source="{Binding WorkspaceImage}"
                                                                         Schematic="{Binding WorkspaceSchematic}"
                                                                         Mode="{Binding LayoutCanvasMode}"
                                                                         ShowGrid="{Binding LayoutShowGrid}"
                                                                         HeaderGame="{Binding CalloutHeaderGame}"
                                                                         HeaderPlane="{Binding CalloutHeaderPlane}"
                                                                         LiveInput="{Binding WorkspaceLiveInput}"
                                                                         RowClicked="LayoutCalloutRowClicked"
                                                                         RowChangeRequested="LayoutCalloutRowChangeRequested" />
                                        </Border>
                                        <Border x:Name="DeviceReferenceHost" Classes="canvasHost" IsVisible="{Binding LayoutShowsMarkerCanvas}">
                                            <controls:DeviceMarkerCanvas x:Name="LayoutCanvas"
                                                                         Source="{Binding WorkspaceImage}"
                                                                         Schematic="{Binding WorkspaceSchematic}"
                                                                         SourceWidth="{Binding WorkspaceWidth}"
                                                                         SourceHeight="{Binding WorkspaceHeight}"
                                                                         Markers="{Binding WorkspaceMarkers}"
                                                                         SelectedMarker="{Binding WorkspaceSelectedMarker}"
                                                                         Mode="{Binding LayoutCanvasMode}"
                                                                         Zoom="{Binding LayoutEditorZoom}"
                                                                         SnapEnabled="{Binding LayoutSnapEnabled}"
                                                                         ShowGrid="{Binding LayoutShowGrid}"
                                                                         ShowOverlay="{Binding LayoutShowOverlays}"
                                                                         PlainLabels="{Binding WorkspacePlainLabels}"
                                                                         LabelFontFamily="{Binding WorkspaceLabelFont}"
                                                                         LabelFontSize="{Binding WorkspaceLabelSize}"
                                                                         LabelForeground="{Binding WorkspaceLabelBrush}"
                                                                         MarkerMovedCommand="{Binding LayoutCanvasMarkerMovedCommand}"
                                                                         FlashMarker="{Binding WorkspaceFlashMarker}"
                                                                         LiveInput="{Binding WorkspaceLiveInput}"
                                                                         CanvasClickedCommand="{Binding LayoutCanvasClickedCommand}"
                                                                         PictureFileDroppedCommand="{Binding DropWorkspacePhotoCommand}">
                                                <controls:DeviceMarkerCanvas.Overlay>
                                                    <Canvas x:Name="LayoutOverlayCanvas" Width="{Binding LayoutEditorCanvasWidth}" Height="{Binding LayoutEditorCanvasHeight}">
                                                        <ItemsControl ItemsSource="{Binding LayoutEditorTables}" Width="{Binding LayoutEditorCanvasWidth}" Height="{Binding LayoutEditorCanvasHeight}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerTheme>
                                                                <ControlTheme TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{ReflectionBinding X}" />
                                                                    <Setter Property="Canvas.Top" Value="{ReflectionBinding Y}" />
                                                                </ControlTheme>
                                                            </ItemsControl.ItemContainerTheme>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:LayoutEditorTableItem">
                                                                    <Border Width="{Binding Width}" Height="{Binding Height}" Background="{Binding DisplayBackground}"
                                                                            BorderBrush="{Binding DisplayBorder}" BorderThickness="{Binding DisplayBorderThickness}" BoxShadow="{Binding DisplayBoxShadow}"
                                                                            CornerRadius="8"
                                                                            PointerPressed="LayoutEditorTablePointerPressed"
                                                                            PointerMoved="LayoutEditorTablePointerMoved"
                                                                            PointerReleased="LayoutEditorTablePointerReleased">
                                                                        <Grid RowDefinitions="Auto,*">
                                                                            <Border Background="{Binding DisplayHeaderBackground}" Padding="10,4" CornerRadius="7,7,0,0">
                                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                                                    <TextBlock Text="{Binding Mode}" FontSize="12" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{l:T '{}{0} column(s)', Arg0={Binding Columns}}"
                                                                                       Foreground="#334155" FontSize="13" />
                                                                            <Border Width="14" Height="14" Background="#3B82F6" BorderBrush="White" BorderThickness="2" CornerRadius="7"
                                                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-7,-7,0,0" Tag="tl"
                                                                                    PointerPressed="LayoutEditorTableResizePointerPressed" PointerMoved="LayoutEditorTableResizePointerMoved" PointerReleased="LayoutEditorTableResizePointerReleased" />
                                                                            <Border Width="14" Height="14" Background="#3B82F6" BorderBrush="White" BorderThickness="2" CornerRadius="7"
                                                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0" Tag="tr"
                                                                                    PointerPressed="LayoutEditorTableResizePointerPressed" PointerMoved="LayoutEditorTableResizePointerMoved" PointerReleased="LayoutEditorTableResizePointerReleased" />
                                                                            <Border Grid.Row="1" Width="14" Height="14" Background="#3B82F6" BorderBrush="White" BorderThickness="2" CornerRadius="7"
                                                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-7,0,0,-7" Tag="bl"
                                                                                    PointerPressed="LayoutEditorTableResizePointerPressed" PointerMoved="LayoutEditorTableResizePointerMoved" PointerReleased="LayoutEditorTableResizePointerReleased" />
                                                                            <Border Grid.Row="1" Width="14" Height="14" Background="#3B82F6" BorderBrush="White" BorderThickness="2" CornerRadius="7"
                                                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-7,-7" Tag="br"
                                                                                    PointerPressed="LayoutEditorTableResizePointerPressed" PointerMoved="LayoutEditorTableResizePointerMoved" PointerReleased="LayoutEditorTableResizePointerReleased" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ItemsControl ItemsSource="{Binding LayoutEditorConnectors}" Width="{Binding LayoutEditorCanvasWidth}" Height="{Binding LayoutEditorCanvasHeight}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerTheme>
                                                                <ControlTheme TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="0" />
                                                                    <Setter Property="Canvas.Top" Value="0" />
                                                                </ControlTheme>
                                                            </ItemsControl.ItemContainerTheme>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:LayoutEditorConnectorItem">
                                                                    <Canvas>
                                                                        <Polyline Points="{Binding Points}" Stroke="{Binding DisplayStroke}" StrokeThickness="{Binding DisplayStrokeThickness}" IsHitTestVisible="False" />
                                                                        <Polyline Points="{Binding Points}" Stroke="#01FFFFFF" StrokeThickness="{Binding HitStrokeThickness}" PointerPressed="LayoutEditorConnectorPointerPressed" />
                                                                    </Canvas>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ItemsControl ItemsSource="{Binding SelectedLayoutEditorConnectorPointHandles}" Width="{Binding LayoutEditorCanvasWidth}" Height="{Binding LayoutEditorCanvasHeight}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerTheme>
                                                                <ControlTheme TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{ReflectionBinding X}" />
                                                                    <Setter Property="Canvas.Top" Value="{ReflectionBinding Y}" />
                                                                </ControlTheme>
                                                            </ItemsControl.ItemContainerTheme>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:LayoutEditorConnectorPointHandleItem">
                                                                    <Border Width="18" Height="18" CornerRadius="9" Background="#22D3EE" BorderBrush="#FFFFFF" BorderThickness="2"
                                                                            PointerPressed="LayoutEditorConnectorPointPointerPressed"
                                                                            PointerMoved="LayoutEditorConnectorPointPointerMoved"
                                                                            PointerReleased="LayoutEditorConnectorPointPointerReleased">
                                                                        <Border.RenderTransform>
                                                                            <TranslateTransform X="-9" Y="-9" />
                                                                        </Border.RenderTransform>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Canvas>
                                                </controls:DeviceMarkerCanvas.Overlay>
                                            </controls:DeviceMarkerCanvas>
                                        </Border>
                                        <!-- The rotatable 3D view (devices with a game model): over the flat picture while switched on -->
                                        <Border Classes="canvasHost" IsVisible="{Binding ShowWorkspace3D}">
                                            <controls:TurntableView x:Name="LayoutTurntable"
                                                                    Turntable="{Binding WorkspaceTurntable}"
                                                                    Parts="{Binding DeviceReference.Markers}"
                                                                    SelectedPart="{Binding DeviceReference.SelectedMarker}"
                                                                    LiveInput="{Binding WorkspaceLiveInput}"
                                                                    RelationDroppedCommand="{Binding BindSelectedLayoutMarkerCommand}" />
                                        </Border>

                                        <!-- The device, the picture choice and the grip on a base -->
                                        <Border Classes="floatingLabel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" IsVisible="{Binding ShowWorkspaceLabel}">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource Icon.Joystick}" Width="14" Height="14" Foreground="{DynamicResource JP.AccentTextBrush}" />
                                                    <TextBlock Text="{Binding LayoutWorkspaceDeviceTitle}" FontWeight="SemiBold" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <!-- The pictures of the device: your layout, your photo, the maker's photos (one per view), JoyPro's drawing -->
                                                <ItemsControl ItemsSource="{Binding WorkspacePictures}" IsVisible="{Binding HasSeveralWorkspacePictures}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemSpacing="4" LineSpacing="4" MaxWidth="460" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:WorkspacePictureChoice">
                                                            <ToggleButton Classes="small" Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip.Tip="{Binding Tip}"
                                                                          FontSize="11.5" Padding="8,3"
                                                                          Command="{Binding #RootWindow.DataContext.SelectWorkspacePictureCommand}" CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- The maker's photo a line drawing was made from: downloaded only by this click (and the device's photo consent) -->
                                                <Button x:Name="DownloadReferencePhotoButton" Classes="icon small" Tag="{StaticResource Icon.Import}" FontSize="11.5" HorizontalAlignment="Left"
                                                        Content="{l:T 'Download the reference photo'}" Command="{Binding DeviceReference.DownloadReferencePhotoCommand}"
                                                        IsVisible="{Binding DeviceReference.CanDownloadReferencePhoto, FallbackValue=False}"
                                                        ToolTip.Tip="{l:T 'Download the maker\'s product photo this drawing was made from (stored on this PC only, never shipped)'}" />
                                                <StackPanel Spacing="4" MaxWidth="460">
                                                    <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding DeviceReference.ReferencePhotoProgress, FallbackValue=0}"
                                                                 IsIndeterminate="{Binding !DeviceReference.ReferencePhotoProgressKnown, FallbackValue=False}"
                                                                 IsVisible="{Binding DeviceReference.IsDownloadingReferencePhoto, FallbackValue=False}" />
                                                    <Border Classes="sunken" Padding="6" IsVisible="{Binding DeviceReference.AwaitsReferencePhotoConsent, FallbackValue=False}">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{Binding DeviceReference.PhotoConsentText}" TextWrapping="Wrap" FontSize="11.5" />
                                                            <WrapPanel ItemSpacing="4" LineSpacing="4">
                                                                <Button Content="{l:T 'Yes'}" Classes="small accent" Command="{Binding DeviceReference.AnswerPhotoConsentCommand}" CommandParameter="yes" />
                                                                <Button Content="{l:T 'No'}" Classes="small" Command="{Binding DeviceReference.AnswerPhotoConsentCommand}" CommandParameter="no" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding DeviceReference.ReferencePhotoStatus}" TextWrapping="Wrap" FontSize="11.5" Classes="muted"
                                                               IsVisible="{Binding DeviceReference.ReferencePhotoStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                                                    <Button Classes="icon small" Tag="{StaticResource Icon.FolderOpen}" Content="{l:T 'Show in folder'}" HorizontalAlignment="Left"
                                                            Command="{Binding DeviceReference.ShowReferencePhotoInFolderCommand}" IsVisible="{Binding DeviceReference.HasReferencePhotoFile, FallbackValue=False}"
                                                            ToolTip.Tip="{l:T 'Open the folder with the saved photo'}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ComboBox ItemsSource="{Binding DeviceReference.GripChoices}" SelectedItem="{Binding DeviceReference.SelectedGrip}" MinWidth="170" FontSize="12"
                                                              IsVisible="{Binding HasReferenceGripChoices}" PlaceholderText="{l:T 'Grip on this base'}"
                                                              ToolTip.Tip="{l:T 'This base takes several grips: the one on it decides the picture and the names (the best fit is shown)'}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="dr:RefDevice">
                                                                <TextBlock Text="{Binding DisplayName}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <!-- The device's icon everywhere (cards, bind list, HUD): which of its pictures -->
                                                    <Button x:Name="DeviceIconButton" Classes="small" Padding="4,2" Command="{Binding OpenDeviceIconPickerCommand}"
                                                            ToolTip.Tip="{l:T 'The device\'s icon on the device cards, in the bind list and on the HUD: pick one of its pictures or a picture of your own'}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Border Width="22" Height="22" CornerRadius="4" Background="#1A94A3B8" ClipToBounds="True">
                                                                <Image Source="{Binding WorkspaceDeviceIcon}" Stretch="Uniform" />
                                                            </Border>
                                                            <TextBlock FontSize="11.5" VerticalAlignment="Center" Text="{l:T 'Icon: {0}', Arg0={Binding WorkspaceDeviceIconTitle}}" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <!-- The device's alias (a name of the user's own) everywhere a device name is shown; display only -->
                                                <StackPanel x:Name="DeviceAliasRow" Orientation="Horizontal" Spacing="6">
                                                    <TextBox x:Name="DeviceAliasBox" Text="{Binding WorkspaceDeviceAlias}" Width="170" FontSize="11.5" MaxLength="60"
                                                             Watermark="{l:T 'Your name for this device'}"
                                                             ToolTip.Tip="{l:T 'A name of your own for this device (Left panel, Main throttle): JoyPro shows it everywhere instead of the device\'s name. The games keep getting the real device.'}">
                                                        <TextBox.KeyBindings>
                                                            <KeyBinding Gesture="Enter" Command="{Binding SaveDeviceAliasCommand}" />
                                                        </TextBox.KeyBindings>
                                                    </TextBox>
                                                    <Button Classes="small" Command="{Binding SaveDeviceAliasCommand}" Content="{l:T 'Name it'}" IsEnabled="{Binding CanRun}"
                                                            ToolTip.Tip="{l:T 'Keep the name in the profile'}" />
                                                    <Button Classes="icon small ghost iconOnly" Tag="{StaticResource Icon.Close}" Command="{Binding ClearDeviceAliasCommand}" IsVisible="{Binding HasWorkspaceDeviceAlias}"
                                                            IsEnabled="{Binding CanRun}" ToolTip.Tip="{l:T 'Take the name back: the device\'s real name is shown again'}" />
                                                    <TextBlock Classes="caption" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasWorkspaceDeviceAlias}"
                                                               Text="{l:T 'alias of {0}', Arg0={Binding WorkspaceDeviceRealName}}" ToolTip.Tip="{Binding WorkspaceDeviceRealName}" />
                                                </StackPanel>
                                                <TextBlock Classes="caption" Text="{Binding DeviceAliasStatus}" TextWrapping="Wrap" MaxWidth="470"
                                                           IsVisible="{Binding DeviceAliasStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <!-- The icon picker: one tile per picture (line drawings as lines, cel-shaded and two-colour) -->
                                                <Border x:Name="DeviceIconPicker" Classes="sunken" Padding="8" IsVisible="{Binding IsDeviceIconPickerOpen}" MaxWidth="470">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Classes="caption" Text="{Binding DeviceIconStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Classes="icon small ghost iconOnly" Tag="{StaticResource Icon.Close}" Command="{Binding CloseDeviceIconPickerCommand}" ToolTip.Tip="{l:T 'Close'}" />
                                                        </Grid>
                                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding DeviceIconOptions}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:DeviceIconOption">
                                                                    <Button Classes="ghost" Padding="3" Width="80" ToolTip.Tip="{Binding Title}"
                                                                            Command="{Binding #RootWindow.DataContext.ChooseDeviceIconCommand}" CommandParameter="{Binding}">
                                                                        <Border CornerRadius="6" BorderThickness="2" Padding="3" Classes.picked="{Binding IsCurrent}">
                                                                            <Border.Styles>
                                                                                <Style Selector="Border">
                                                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                                                </Style>
                                                                                <Style Selector="Border.picked">
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource JP.AccentBrush}" />
                                                                                </Style>
                                                                            </Border.Styles>
                                                                            <StackPanel Spacing="3">
                                                                                <Panel Width="50" Height="50" HorizontalAlignment="Center">
                                                                                    <Image Source="{Binding Preview}" Stretch="Uniform" />
                                                                                    <PathIcon Data="{StaticResource Icon.Wand}" Width="22" Height="22" IsVisible="{Binding IsAutomatic}" />
                                                                                </Panel>
                                                                                <TextBlock Text="{Binding Title}" FontSize="10.5" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="72" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        </ScrollViewer>
                                                        <Button Classes="icon small" Tag="{StaticResource Icon.FolderOpen}" Content="{l:T 'Your own picture...'}" Click="DeviceIconFileClicked" HorizontalAlignment="Left"
                                                                ToolTip.Tip="{l:T 'A picture file of your own becomes the icon (cut out of a plain background and cropped square)'}" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Classes="caption" Text="{Binding DeviceReference.PhotoCredit}" IsVisible="{Binding DeviceReference.PhotoCredit, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- The marker assistant (reference): press a button, click where it is -->
                                        <Border Classes="floatingLabel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,12,12,0" MaxWidth="560"
                                                IsVisible="{Binding HasReferenceAssistant}">
                                            <StackPanel Spacing="8" DataContext="{Binding DeviceReference.Assistant}" x:DataType="vm:MarkerAssistantViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Wand}" /></Border>
                                                    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="460" />
                                                </StackPanel>
                                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                    <Button Classes="icon small accent" Tag="{StaticResource Icon.Play}" Content="{l:T 'Start'}" Command="{Binding StartCommand}" ToolTip.Tip="{l:T 'Press a button or hat direction on the device next'}" />
                                                    <Button Classes="small" Content="{l:T 'Axis'}" Command="{Binding CaptureAxisCommand}" ToolTip.Tip="{l:T 'Move an axis of the device next'}" />
                                                    <Button Classes="small" Content="{l:T 'Skip'}" Command="{Binding SkipCommand}" />
                                                    <Button Classes="icon small" Tag="{StaticResource Icon.Undo}" Content="{l:T 'Undo'}" Command="{Binding UndoCommand}" />
                                                    <Button Classes="small" Content="{l:T 'Stop'}" Command="{Binding StopCommand}" />
                                                    <Button Classes="icon small" Tag="{StaticResource Icon.Check}" Content="{l:T 'Finish'}" Command="{Binding FinishCommand}" ToolTip.Tip="{l:T 'Save the markers (and your device definition)'}" />
                                                    <Button Classes="small ghost" Content="{l:T 'Close'}" Command="{Binding #RootWindow.DataContext.CloseReferenceAssistantCommand}" />
                                                    <TextBlock Classes="caption" Text="{Binding PlacedCount, StringFormat='{}{0} placed'}" VerticalAlignment="Center" />
                                                </WrapPanel>
                                                <!-- Add a control JoyPro does not know (a hat the device reports as buttons ...) by its kind -->
                                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                    <ComboBox ItemsSource="{Binding ControlKindOptions}" SelectedItem="{Binding ControlKind}" MinWidth="170"
                                                              ToolTip.Tip="{l:T 'The kind of the control to add: JoyPro asks for each of its inputs in turn'}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <TextBlock Text="{Binding Converter={x:Static l:TConverter.Instance}}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBox Text="{Binding ControlName}" Watermark="{l:T 'Name (optional)'}" MinWidth="140" />
                                                    <Button Classes="icon small" Tag="{StaticResource Icon.Plus}" Content="{l:T 'Add control'}" Command="{Binding AddControlCommand}"
                                                            ToolTip.Tip="{l:T 'Press (or move) each input of the control on your device, then click its spot on the picture'}" />
                                                    <Button Classes="small" Content="{l:T 'Remove from picture'}" Command="{Binding RemoveSelectedCommand}"
                                                            ToolTip.Tip="{l:T 'Take the picked part off the picture (JoyPro put it on the wrong spot)'}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- A connected device has a 3D view in JoyPro's releases (not shipped): download it? -->
                                        <Border Classes="floatingLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" MaxWidth="420"
                                                IsVisible="{Binding HasDevice3DOffer}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding Device3DOfferText}" TextWrapping="Wrap" MaxWidth="390" />
                                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                    <Button Classes="small accent" Content="{l:T 'Download'}" Command="{Binding AcceptDevice3DCommand}" />
                                                    <Button Classes="small" Content="{l:T 'Not now'}" Command="{Binding DismissDevice3DCommand}" />
                                                    <Button Classes="small ghost" Content="{l:T 'Always download'}" Command="{Binding AlwaysDevice3DCommand}"
                                                            ToolTip.Tip="{l:T 'Download the 3D views and cockpit pictures from JoyPro\'s releases without asking (Settings &gt; Privacy)'}" />
                                                    <Button Classes="small ghost" Content="{l:T 'Never'}" Command="{Binding NeverDevice3DCommand}"
                                                            ToolTip.Tip="{l:T 'Do not look for 3D views and cockpit pictures in JoyPro\'s releases (Settings &gt; Privacy); the flat drawing stays'}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Some inputs have no place: press them to place them; send the correction to JoyPro -->
                                        <Border Classes="floatingLabel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" MaxWidth="400"
                                                IsVisible="{Binding ShowMissingMarkersHint}">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.MapMarker}" /></Border>
                                                    <TextBlock Text="{Binding DeviceReference.MissingMarkersText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" />
                                                </StackPanel>
                                                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding DeviceReference.MissingMarkersList}" />
                                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                    <Button Classes="icon small accent" Tag="{StaticResource Icon.Wand}" Content="{l:T 'Place them'}" Command="{Binding PlaceMissingMarkersCommand}" />
                                                    <Button Classes="icon small" Tag="{StaticResource Icon.Export}" Content="{l:T 'Send correction to JoyPro...'}" Command="{Binding DeviceReference.SendCorrectionCommand}"
                                                            ToolTip.Tip="{l:T 'Saves your positions and controls as a small file and opens a prefilled issue form on JoyPro\'s GitHub page; you decide there whether to send it'}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- The picture knows no part's position: offer the marker assistant (never guessed markers) -->
                                        <Border Classes="floatingLabel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" MaxWidth="400"
                                                IsVisible="{Binding ShowPlaceMarkersHint}">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.MapMarker}" /></Border>
                                                    <TextBlock Text="{l:T 'No positions on this picture yet'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                                           Text="{l:T 'The legend lists every input. Place them in a minute: start the marker assistant, press a button on the device, then click its spot on the picture. Axes: move them.'}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Button Classes="icon small accent" Tag="{StaticResource Icon.Wand}" Content="{l:T 'Place the markers'}" Command="{Binding OpenReferenceAssistantCommand}" />
                                                    <Button Classes="icon small" Tag="{StaticResource Icon.Import}" Content="{l:T 'Import positions...'}" Click="ReferenceLayoutImportClicked"
                                                            ToolTip.Tip="{l:T 'A layout someone shared (joypro-device-layout .json)'}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- "Which one is it?": a base that does not say which grip is on it, a USB id several products share,
                                             a device JoyPro does not know. Asked once; JoyPro remembers the answer. -->
                                        <!-- A grid, not a stack: on a small window the candidates scroll and the buttons stay in the card. -->
                                        <Border Classes="floatingLabel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" MaxWidth="780"
                                                IsVisible="{Binding ShowReferenceQuestion}">
                                            <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10" DataContext="{Binding DeviceReference}" x:DataType="vm:DeviceReferenceViewModel">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <Border Classes="iconBadge" VerticalAlignment="Top"><PathIcon Data="{StaticResource Icon.Joystick}" /></Border>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Classes="h2" Text="{Binding QuestionTitle}" TextWrapping="Wrap" />
                                                        <TextBlock Classes="caption" Text="{Binding QuestionHint}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <ScrollViewer Grid.Row="1" MaxHeight="300" IsVisible="{Binding ShowsCandidates}">
                                                    <ItemsControl ItemsSource="{Binding QuestionCandidates}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ChoiceCandidate">
                                                                <Button Width="172" Padding="8" HorizontalContentAlignment="Stretch" ToolTip.Tip="{Binding Why}"
                                                                        Command="{Binding #RootWindow.DataContext.DeviceReference.ChooseCandidateCommand}" CommandParameter="{Binding}">
                                                                    <StackPanel Spacing="4">
                                                                        <controls:DeviceThumbnail Picture="{Binding Picture}" Schematic="{Binding Drawing}" Height="118" />
                                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" />
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <Border Classes="chip ok" IsVisible="{Binding IsBest}"><TextBlock Text="{l:T 'Most likely'}" /></Border>
                                                                            <TextBlock Classes="caption" Text="{Binding ScoreText}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <StackPanel Grid.Row="2" Spacing="8" IsVisible="{Binding ShowsFind}">
                                                    <TextBox Classes="search" Text="{Binding FindText}" Watermark="{l:T 'Find your device: maker and model (e.g. virpil alpha)'}" />
                                                    <ScrollViewer MaxHeight="160">
                                                        <ItemsControl ItemsSource="{Binding FindResults}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:ChoiceCandidate">
                                                                    <Button Width="172" Padding="6" HorizontalContentAlignment="Stretch"
                                                                            Command="{Binding #RootWindow.DataContext.DeviceReference.ChooseCandidateCommand}" CommandParameter="{Binding}">
                                                                        <StackPanel Spacing="3">
                                                                            <controls:DeviceThumbnail Picture="{Binding Picture}" Schematic="{Binding Drawing}" Height="76" />
                                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="11.5" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                    <TextBlock Classes="label" Text="{l:T 'Not in the list? What kind of device is it?'}" IsVisible="{Binding IsUnknownQuestion}" />
                                                    <ItemsControl ItemsSource="{Binding ClassChoices}" IsVisible="{Binding IsUnknownQuestion}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ClassChoice">
                                                                <Button Width="112" Padding="6" HorizontalContentAlignment="Stretch"
                                                                        Command="{Binding #RootWindow.DataContext.DeviceReference.ChooseClassCommand}" CommandParameter="{Binding}">
                                                                    <StackPanel Spacing="3">
                                                                        <controls:DeviceThumbnail Schematic="{Binding Drawing}" Height="58" />
                                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" FontSize="11" TextAlignment="Center" />
                                                                        <Border Classes="chip ok" IsVisible="{Binding IsGuess}" HorizontalAlignment="Center"><TextBlock Text="{l:T 'Likely'}" /></Border>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <WrapPanel Grid.Row="3" ItemSpacing="6" LineSpacing="6">
                                                    <Button Classes="icon small accent" Tag="{StaticResource Icon.Check}" Content="{l:T 'Keep the most likely'}" Command="{Binding KeepBestCandidateCommand}"
                                                            IsVisible="{Binding ShowsCandidates}" ToolTip.Tip="{l:T 'Take the first one and do not ask again'}" />
                                                    <Button Classes="icon small" Tag="{StaticResource Icon.Search}" Content="{l:T 'Not listed: search the catalog'}" Command="{Binding ToggleFindCommand}"
                                                            IsVisible="{Binding !IsUnknownQuestion}" />
                                                    <Button Classes="small ghost" Content="{l:T 'Not now'}" Command="{Binding DismissQuestionCommand}" />
                                                </WrapPanel>
                                            </Grid>
                                        </Border>

                                        <Border Classes="emptyState" IsVisible="{Binding HasNoLayoutWorkspacePicture}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24">
                                            <StackPanel Spacing="10">
                                                <PathIcon Classes="emptyIcon" Data="{StaticResource Icon.Image}" />
                                                <TextBlock Classes="h2" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding LayoutEmptyTitle}" />
                                                <TextBlock Classes="caption" TextAlignment="Center" Text="{Binding LayoutEmptyHint}" />
                                                <Button Classes="icon small accent" Tag="{StaticResource Icon.Search}" Content="{l:T 'Find my devices'}" Command="{Binding SuggestLayoutsCommand}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Panel>

                                    <Border Grid.Row="2" Classes="statusbar">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Classes="caption" Text="{Binding WorkspaceStatus}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding WorkspaceStatus}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Opacity="0.85">
                                                <Border Classes="keycap small"><TextBlock Text="V" /></Border>
                                                <Border Classes="keycap small"><TextBlock Text="E" /></Border>
                                                <Border Classes="keycap small"><TextBlock Text="B" /></Border>
                                                <TextBlock Classes="caption" Text="{l:T 'modes'}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <Border Classes="keycap small"><TextBlock Text="Ctrl+Z" /></Border>
                                                <TextBlock Classes="caption" Text="{l:T 'undo'}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <Border Classes="keycap small"><TextBlock Text="0" /></Border>
                                                <TextBlock Classes="caption" Text="{l:T 'fit'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- The selected input and the legend -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12" Margin="0,0,8,0">
                                    <Border Classes="surface">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Classes="label" Text="{l:T 'SELECTED INPUT'}" />
                                                <Button Grid.Column="1" Classes="icon small ghost" Tag="{StaticResource Icon.Plus}" Content="{l:T 'Add marker'}" Command="{Binding AddLayoutEditorMarkerCommand}"
                                                        IsVisible="{Binding IsLayoutFileEditMode}" ToolTip.Tip="{l:T 'A new marker in the middle of the picture (or switch on \'Place marker\' and click the spot)'}" />
                                            </Grid>
                                            <TextBlock Classes="caption" IsVisible="{Binding HasNoWorkspaceInput}" Text="{l:T 'Click a marker on the picture or a row of the legend.'}" />
                                            <StackPanel Spacing="10" IsVisible="{Binding HasWorkspaceInput}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                    <Border Classes="keycap large"><TextBlock Text="{Binding WorkspaceInputTitle}" /></Border>
                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding WorkspaceInputName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <Border Classes="chip axis"><TextBlock Text="{Binding WorkspaceInputKind}" /></Border>
                                                            <Border Classes="chip" IsVisible="{Binding LayoutShowsReference}"><TextBlock Classes="mono" Text="{Binding WorkspaceInputToken}" /></Border>
                                                            <Border Classes="chip modifier" IsVisible="{Binding WorkspaceInputHasModifier}">
                                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                                    <PathIcon Data="{StaticResource Icon.Shift}" />
                                                                    <TextBlock Text="{Binding WorkspaceInputModifier}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                                <!-- A part with several inputs (a hat's directions and press): which one -->
                                                <ListBox Classes="cards compact" ItemsSource="{Binding SelectedPartRows}" SelectedItem="{Binding DeviceReference.SelectedLegendRow}"
                                                         IsVisible="{Binding HasSelectedPartRows}">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ReferenceLegendRow">
                                                            <Border Classes="liveRow" Classes.live="{Binding IsLive}">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" ToolTip.Tip="{Binding InputText}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <Border Classes="sunken" Padding="10,8">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Classes="caption" Text="{l:T 'Does'}" />
                                                        <TextBlock Text="{Binding WorkspaceInputCommand}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding WorkspaceInputIsBound}" />
                                                        <TextBlock Classes="warnText" Text="{l:T 'Nothing yet'}" IsVisible="{Binding !WorkspaceInputIsBound}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Edit markers -->
                                                <StackPanel Spacing="8" IsVisible="{Binding IsLayoutFileEditMode}">
                                                    <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Classes="label" Text="{l:T 'Input'}" />
                                                            <ComboBox ItemsSource="{Binding LayoutEditorInputOptions}" SelectedItem="{Binding LayoutEditorNewToken}" Text="{Binding LayoutEditorNewToken}"
                                                                      IsEditable="True" HorizontalAlignment="Stretch" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock Classes="label" Text="{l:T 'Type'}" />
                                                            <ComboBox SelectedItem="{Binding LayoutEditorNewType}" HorizontalAlignment="Stretch">
                                                                <x:String>button</x:String>
                                                                <x:String>axis</x:String>
                                                                <x:String>pov</x:String>
                                                                <x:String>slider</x:String>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Classes="label" Text="{l:T 'Modifiers'}" />
                                                    <ItemsControl ItemsSource="{Binding LayoutEditorModifierOptions}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:SelectableTagItem">
                                                                <ToggleButton Classes="filterChip" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Classes="caption" Text="{Binding LayoutEditorModifierPreview}" />
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <Button Classes="icon small accent" Tag="{StaticResource Icon.Check}" Content="{l:T 'Apply'}" Command="{Binding ApplySelectedLayoutEditorMarkerDraftCommand}"
                                                                HorizontalAlignment="Stretch" ToolTip.Tip="{l:T 'Give the selected marker this input, type and modifier'}" />
                                                        <Button Grid.Column="1" Classes="icon small danger" Tag="{StaticResource Icon.Delete}" Content="{l:T 'Remove'}" Command="{Binding RemoveSelectedLayoutEditorMarkerCommand}"
                                                                ToolTip.Tip="{l:T 'Remove the marker (Del)'}" />
                                                    </Grid>
                                                    <TextBlock Classes="caption" Text="{Binding SelectedLayoutEditorMarker.PositionLabel}" />
                                                </StackPanel>

                                                <!-- Bind -->
                                                <StackPanel Spacing="8" IsVisible="{Binding IsLayoutBindMode}">
                                                    <!-- The modifier combination the bind gets (none, mod 1, mod 2, mod 1 + 2 ...). -->
                                                    <ItemsControl ItemsSource="{Binding VisualAssignCombos}" IsVisible="{Binding HasVisualAssignCombos}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:VisualAssignComboRow">
                                                                <ToggleButton Classes="filterChip" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                              Command="{Binding #RootWindow.DataContext.SelectVisualAssignComboCommand}" CommandParameter="{Binding}"
                                                                              ToolTip.Tip="{Binding Display}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBox Classes="search" Text="{Binding LayoutBindSearch}" Watermark="{l:T 'Search what it should do'}" />
                                                    <ListBox Classes="cards compact" ItemsSource="{Binding LayoutBindCandidates}" SelectedItem="{Binding SelectedLayoutBindCandidate}" MaxHeight="230">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <Button Classes="icon small accent" Tag="{StaticResource Icon.Link}" Content="{l:T 'Bind to this input'}" Command="{Binding BindSelectedLayoutMarkerCommand}"
                                                                CommandParameter="{x:Null}" HorizontalAlignment="Stretch" />
                                                        <Button Grid.Column="1" Classes="icon small" Tag="{StaticResource Icon.Close}" Content="{l:T 'Free'}" Command="{Binding FreeSelectedLayoutMarkerCommand}"
                                                                ToolTip.Tip="{l:T 'Remove the bind from this input'}" />
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tables and lines (callout sheet): the selected table's tools, the modifier column, the relations to drop on rows -->
                                    <Border Classes="surface" IsVisible="{Binding LayoutShowsCallouts}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Grid}" /></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="h2" Text="{l:T 'Tables and lines'}" />
                                                    <TextBlock Classes="caption" Text="{Binding LayoutCallouts.Summary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Spacing="6" IsVisible="{Binding IsCalloutEditMode}">
                                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                                           Text="{l:T 'Drag a table to move it (it stays there), its right edge to resize it, a line sideways to bend it, a spot to move it. Drag the round handle of a table to a spot to give it a line. Del removes the selected line.'}" />
                                                <TextBlock Text="{Binding LayoutCallouts.SelectedTableTitle}" FontWeight="SemiBold" IsVisible="{Binding LayoutCallouts.HasSelectedTable}" />
                                                <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding LayoutCallouts.HasSelectedTable}">
                                                    <ToggleButton Classes="small" Content="{l:T 'Modifier column'}" IsChecked="{Binding LayoutCallouts.SelectedTableHasModifier, Mode=OneWay}"
                                                                  Command="{Binding CalloutToggleModifierColumnCommand}" ToolTip.Tip="{l:T 'The second text column with the modifier (shift) bind'}" />
                                                    <Button Classes="small" Content="{l:T 'Row +'}" Command="{Binding CalloutAddRowCommand}" ToolTip.Tip="{l:T 'An axis gets a zone row (0-20 %, 20-40 % ...); other tables show a hidden row again'}" />
                                                    <Button Classes="small" Content="{l:T 'Row −'}" Command="{Binding CalloutRemoveRowCommand}" ToolTip.Tip="{l:T 'Removes the last zone row of an axis, or hides the last row'}" />
                                                    <ToggleButton Classes="small" Content="{l:T 'Pinned'}" IsChecked="{Binding LayoutCallouts.SelectedTableIsPinned, Mode=OneWay}" Command="{Binding CalloutTogglePinCommand}"
                                                                  ToolTip.Tip="{l:T 'A pinned table stays where it is when the tables are arranged again'}" />
                                                    <Button Classes="small" Content="{l:T 'Re-route line'}" Command="{Binding CalloutRerouteLineCommand}" ToolTip.Tip="{l:T 'A fresh line from the spot to the table (also brings back a removed line)'}" />
                                                    <Button Classes="small danger" Content="{l:T 'Remove line'}" Command="{Binding CalloutDeleteLineCommand}" ToolTip.Tip="{l:T 'Removes the table\'s line (Del)'}" />
                                                    <Button Classes="small" Content="{l:T 'Split into single tables'}" Command="{Binding CalloutSplitGroupCommand}" IsVisible="{Binding LayoutCallouts.SelectedTableIsGroup}"
                                                            ToolTip.Tip="{l:T 'A grid of keys (or the table of parts on one spot) becomes one table per part, each with its own line'}" />
                                                </WrapPanel>
                                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                    <Button Classes="icon small" Tag="{StaticResource Icon.Wand}" Content="{l:T 'Auto arrange'}" Command="{Binding CalloutAutoArrangeCommand}"
                                                            ToolTip.Tip="{l:T 'Arrange again; pinned tables stay'}" />
                                                    <Button Classes="small" Content="{l:T 'Group again'}" Command="{Binding CalloutRegroupCommand}" IsVisible="{Binding LayoutCallouts.HasSplitGroups}"
                                                            ToolTip.Tip="{l:T 'Keys and parts on one spot share their tables again (undoes every Split)'}" />
                                                    <Button Classes="icon small ghost" Tag="{StaticResource Icon.Undo}" Content="{l:T 'Reset'}" Command="{Binding CalloutResetLayoutCommand}"
                                                            ToolTip.Tip="{l:T 'JoyPro\'s arrangement again: also pins, widths, rows and bent lines (Undo brings yours back)'}" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="label" Text="{l:T 'Modifier columns show'}" />
                                                <ComboBox ItemsSource="{Binding CalloutModifierOptions}" SelectedItem="{Binding CalloutModifier}" HorizontalAlignment="Stretch" PlaceholderText="{l:T '(combinations in use)'}"
                                                          ToolTip.Tip="{l:T 'One column per modifier combination: the ones your binds use, all of them (2, 4, 8 ... for 1, 2, 3 modifiers), or one picked combination'}" />
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Classes="caption" Text="{l:T 'Columns per table at most'}" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding CalloutMaxColumnsOptions}" SelectedItem="{Binding CalloutMaxColumns}" MinWidth="70"
                                                              ToolTip.Tip="{l:T 'The unmodified column included; more combinations than fit: the most used ones'}" />
                                                </Grid>
                                                <TextBlock Classes="caption" Text="{Binding CalloutModifierInUse}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="label" Text="{l:T 'Drag a relation onto a row'}" />
                                                <TextBox Classes="search" Text="{Binding CalloutRelationSearch}" Watermark="{l:T 'Search relations'}" />
                                                <ListBox x:Name="CalloutRelationList" Classes="cards compact" ItemsSource="{Binding CalloutRelationItems}" MaxHeight="220">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Background="Transparent"
                                                                       PointerPressed="CalloutRelationPointerPressed" PointerMoved="CalloutRelationPointerMoved"
                                                                       ToolTip.Tip="{l:T 'Drag onto a row of a table to bind it there (right-click a row to clear it)'}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- The reference's own tools in Edit mode -->
                                    <Border Classes="surface" IsVisible="{Binding IsReferenceEditMode}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Image}" /></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="h2" Text="{l:T 'Picture and markers'}" />
                                                    <TextBlock Classes="caption" Text="{l:T 'Found by: {0}', Arg0={Binding DeviceReference.MatchReason}}" TextWrapping="Wrap"
                                                               IsVisible="{Binding DeviceReference.MatchReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                            </Grid>
                                            <Button Classes="icon small accent" Tag="{StaticResource Icon.Wand}" Content="{l:T 'Marker assistant'}" Command="{Binding OpenReferenceAssistantCommand}" HorizontalAlignment="Stretch"
                                                    ToolTip.Tip="{l:T 'Press each button of the device and click where it is on the picture; for unknown devices it also names the parts'}" />
                                            <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                <Button Classes="icon small" Tag="{StaticResource Icon.FolderOpen}" Content="{l:T 'Your photo...'}" Click="ReferencePhotoClicked"
                                                        ToolTip.Tip="{l:T 'Use your own photo of the device (or drop a picture file on the picture)'}" />
                                                <Button Classes="small" Content="{l:T 'Remove photo'}" Command="{Binding DeviceReference.RemoveUserPhotoCommand}" IsVisible="{Binding DeviceReference.HasUserPhoto}" />
                                                <Button Classes="icon small" Tag="{StaticResource Icon.Refresh}" Content="{l:T 'Reset markers'}" Command="{Binding ResetReferenceMarkersCommand}"
                                                        ToolTip.Tip="{l:T 'Put the markers back where JoyPro puts them'}" />
                                            </WrapPanel>
                                            <Border Classes="sunken" Padding="8" IsVisible="{Binding DeviceReference.AsksPhotoConsent}">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding DeviceReference.PhotoConsentText}" TextWrapping="Wrap" />
                                                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                        <Button Content="{l:T 'Yes'}" Classes="small accent" Command="{Binding DeviceReference.AnswerPhotoConsentCommand}" CommandParameter="yes" />
                                                        <Button Content="{l:T 'No'}" Classes="small" Command="{Binding DeviceReference.AnswerPhotoConsentCommand}" CommandParameter="no" />
                                                        <Button Content="{l:T 'Always for all my devices'}" Classes="small" Command="{Binding DeviceReference.AnswerPhotoConsentCommand}" CommandParameter="always" />
                                                        <Button Content="{l:T 'Never'}" Classes="small" Command="{Binding DeviceReference.AnswerPhotoConsentCommand}" CommandParameter="never" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                            <CheckBox Content="{l:T 'Maker\'s photo of this device'}" IsChecked="{Binding DeviceReference.VendorPhotosEnabled}"
                                                      ToolTip.Tip="{l:T 'Download the maker\'s product photo of this device from its web site and show it (stored on this PC only, never shipped). Off: JoyPro\'s drawing. Settings &gt; Privacy: ask, always or never for all devices.'}" />
                                            <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                <Button Classes="icon small" Tag="{StaticResource Icon.Save}" Content="{l:T 'Save definition'}" Command="{Binding DeviceReference.SaveDefinitionCommand}"
                                                        ToolTip.Tip="{l:T 'Keep this device (names, new inputs, markers on the drawing) as your device definition'}" />
                                                <Button Classes="icon small" Tag="{StaticResource Icon.Export}" Content="{l:T 'Export...'}" Click="ReferenceExportClicked" ToolTip.Tip="{l:T 'Save this device as a definition file (JSON) to share'}" />
                                                <Button Classes="icon small" Tag="{StaticResource Icon.Import}" Content="{l:T 'Import...'}" Click="ReferenceImportClicked" ToolTip.Tip="{l:T 'Add a device definition file (JSON)'}" />
                                                <Button Classes="icon small" Tag="{StaticResource Icon.Export}" Content="{l:T 'Share layout...'}" Click="ReferenceLayoutExportClicked"
                                                        ToolTip.Tip="{l:T 'Save the marker positions of the shown picture to share (the maker\'s photo goes by its address only; your own photo goes inside)'}" />
                                                <Button Classes="icon small" Tag="{StaticResource Icon.Import}" Content="{l:T 'Import layout...'}" Click="ReferenceLayoutImportClicked"
                                                        ToolTip.Tip="{l:T 'Add marker positions someone shared (joypro-device-layout .json)'}" />
                                                <Button Classes="icon small" Tag="{StaticResource Icon.Export}" Content="{l:T 'Send correction to JoyPro...'}" Command="{Binding DeviceReference.SendCorrectionCommand}"
                                                        ToolTip.Tip="{l:T 'Saves your positions and controls as a small file and opens a prefilled issue form on JoyPro\'s GitHub page; you decide there whether to send it'}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="surface">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Classes="h2" Text="{l:T 'Legend'}" />
                                                <Border Grid.Column="1" Classes="chip"><TextBlock Text="{Binding LayoutLegendSummary}" /></Border>
                                            </Grid>
                                            <TextBox Classes="search" Text="{Binding LayoutLegendFilter}" Watermark="{l:T 'Filter inputs, parts or commands'}" />
                                            <TextBlock Classes="caption" IsVisible="{Binding LayoutShowsReference}"
                                                       Text="{l:T 'Part and command can be edited; your texts are kept for this model. Empty command = the bind of your profile.'}" />
                                            <!-- Reference: input, physical name, bound command (editable) -->
                                            <ListBox Classes="cards compact" ItemsSource="{Binding ReferenceLegendItems}" SelectedItem="{Binding DeviceReference.SelectedLegendRow}" MaxHeight="520"
                                                     IsVisible="{Binding LayoutShowsReference}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ReferenceLegendRow">
                                                        <Border Classes="liveRow" Classes.live="{Binding IsLive}">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <Border Background="{DynamicResource JP.AccentBrush}" CornerRadius="9" MinWidth="22" Height="18" Padding="5,0">
                                                                    <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <Border Classes="keycap small"><TextBlock Text="{Binding InputText}" /></Border>
                                                            </StackPanel>
                                                            <TextBox Grid.Column="1" Classes="cell" Text="{Binding Name}" Watermark="{l:T 'part'}" ToolTip.Tip="{l:T 'The part\'s name (yours is kept for this model)'}" />
                                                            <TextBox Grid.Row="1" Grid.ColumnSpan="2" Classes="cell" Text="{Binding Command}" Watermark="{l:T 'not bound'}" ToolTip.Tip="{l:T 'What it does: the bind of your profile, or your own text'}" />
                                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="caption" Text="{l:T 'On: {0}', Arg0={Binding ViewText}}"
                                                                       ToolTip.Tip="{l:T 'The pictures of this device that show the part (its position is known there)'}" />
                                                        </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Panel IsVisible="{Binding LayoutShowsLayoutFile}">
                                            <ListBox Classes="cards compact" ItemsSource="{Binding LayoutLegendItems}" SelectedItem="{Binding SelectedLayoutEditorMarker}" MaxHeight="440">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:LayoutEditorMarkerItem">
                                                        <Border Classes="liveRow" Classes.live="{Binding IsLive}">
                                                        <Grid ColumnDefinitions="92,*" ColumnSpacing="8">
                                                            <Border Classes="keycap" HorizontalAlignment="Left"><TextBlock Text="{Binding ShortLabel}" /></Border>
                                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Command}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsBound}" />
                                                                <TextBlock Classes="caption" Text="{l:T 'not bound'}" IsVisible="{Binding !IsBound}" />
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Classes="caption" Text="{Binding KindLabel}" />
                                                                    <TextBlock Classes="caption" Foreground="{DynamicResource JP.Chip.ModifierTextBrush}" Text="{Binding Modifier}" IsVisible="{Binding HasModifier}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            </Panel>
                                        </StackPanel>
                                    </Border>
                                    <Panel IsVisible="{Binding LayoutShowsLayoutFile}">
                                    <!-- Tables, connector lines and label style of the cheat sheets (experts) -->
                                    <Expander HorizontalAlignment="Stretch"
                                              Header="{l:T 'Tables, lines and label style'}">
                                        <StackPanel>
                                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Classes="h3" Text="{l:T 'Legend tables'}" />
                                                    <TextBlock Classes="caption" Text="{l:T 'panel = an empty box behind labels; list = filled with the binds. Drag them on the picture with \'Tables &amp; lines\' on.'}" />
                                                    <DataGrid ItemsSource="{Binding LayoutEditorTables}" SelectedItem="{Binding SelectedLayoutEditorTable}" SelectionChanged="LayoutEditorTablesSelectionChanged"
                                                              CanUserResizeColumns="True" GridLinesVisibility="Horizontal" AutoGenerateColumns="False" Height="130">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="{l:T 'Table'}" Binding="{Binding Name}" Width="*" />
                                                            <DataGridTextColumn Header="{l:T 'Mode'}" Binding="{Binding Mode}" Width="64" />
                                                            <DataGridTextColumn Header="W" Binding="{Binding Width}" Width="56" />
                                                            <DataGridTextColumn Header="H" Binding="{Binding Height}" Width="56" />
                                                            <DataGridTextColumn Header="{l:T 'Cols'}" Binding="{Binding Columns}" Width="50" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <TextBox Text="{Binding LayoutEditorNewTableName}" Watermark="{l:T 'Name'}" />
                                                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                        <ComboBox SelectedItem="{Binding LayoutEditorNewTableMode}" Width="90">
                                                            <x:String>panel</x:String>
                                                            <x:String>list</x:String>
                                                        </ComboBox>
                                                        <TextBox Text="{Binding LayoutEditorNewTableWidth}" Width="70" Watermark="W" ToolTip.Tip="{l:T 'Width (px)'}" />
                                                        <TextBox Text="{Binding LayoutEditorNewTableHeight}" Width="70" Watermark="H" ToolTip.Tip="{l:T 'Height (px)'}" />
                                                        <ComboBox SelectedItem="{Binding LayoutEditorNewTableColumns}" Width="64" ToolTip.Tip="{l:T 'Columns'}">
                                                            <x:String>1</x:String>
                                                            <x:String>2</x:String>
                                                            <x:String>3</x:String>
                                                            <x:String>4</x:String>
                                                            <x:String>5</x:String>
                                                            <x:String>6</x:String>
                                                        </ComboBox>
                                                        <TextBox Text="{Binding LayoutEditorNewTableBackgroundColor}" Width="100" Watermark="#RRGGBB" ToolTip.Tip="{l:T 'Background color'}" />
                                                        <TextBox Text="{Binding LayoutEditorNewTableBackgroundOpacity}" Width="60" ToolTip.Tip="{l:T 'Opacity 0..1'}" />
                                                        <CheckBox Content="{l:T 'Shadow'}" IsChecked="{Binding LayoutEditorNewTableDropShadow}" />
                                                    </WrapPanel>
                                                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                        <Button Classes="icon small" Tag="{StaticResource Icon.Plus}" Command="{Binding AddLayoutEditorTableCommand}" Content="{l:T 'Add'}" />
                                                        <Button Classes="icon small" Tag="{StaticResource Icon.Check}" Command="{Binding ApplySelectedLayoutEditorTableDraftCommand}" Content="{l:T 'Apply'}" />
                                                        <Button Classes="icon small danger" Tag="{StaticResource Icon.Delete}" Command="{Binding RemoveSelectedLayoutEditorTableCommand}" Content="{l:T 'Remove'}" />
                                                        <ToggleButton Classes="small" IsChecked="{Binding LayoutPlaceTableMode}" Content="{l:T 'Place on click'}" />
                                                    </WrapPanel>
                                                </StackPanel>
            
                                                <StackPanel Grid.Row="1" Spacing="8">
                                                    <TextBlock Classes="h3" Text="{l:T 'Connector lines'}" />
                                                    <TextBlock Classes="caption" Text="{l:T 'A line from the real button on the picture to its label. Pick the start on the picture, choose the route, add.'}" />
                                                    <DataGrid ItemsSource="{Binding LayoutEditorConnectors}" SelectedItem="{Binding SelectedLayoutEditorConnector}" SelectionChanged="LayoutEditorConnectorsSelectionChanged"
                                                              CanUserResizeColumns="True" GridLinesVisibility="Horizontal" AutoGenerateColumns="False" Height="130">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="{l:T 'Name'}" Binding="{Binding Name}" Width="*" />
                                                            <DataGridTextColumn Header="{l:T 'Target'}" Binding="{Binding TargetToken}" Width="100" />
                                                            <DataGridTextColumn Header="{l:T 'Route'}" Binding="{Binding Route}" Width="80" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                        <TextBox Text="{Binding LayoutEditorNewConnectorName}" Width="120" Watermark="{l:T 'Name'}" />
                                                        <TextBox Text="{Binding LayoutEditorNewConnectorColor}" Width="90" Watermark="{l:T 'Color'}" />
                                                        <TextBox Text="{Binding LayoutEditorNewConnectorWidth}" Width="50" ToolTip.Tip="{l:T 'Line width'}" />
                                                        <ComboBox SelectedItem="{Binding LayoutEditorNewConnectorRoute}" Width="110">
                                                            <x:String>orthogonal</x:String>
                                                            <x:String>diagonal</x:String>
                                                            <x:String>manual</x:String>
                                                        </ComboBox>
                                                        <TextBox Text="{Binding LayoutEditorNewConnectorSteps}" Width="50" ToolTip.Tip="{l:T '90° steps'}" />
                                                        <ComboBox ItemsSource="{Binding LayoutEditorMarkerTokenOptions}" SelectedItem="{Binding LayoutEditorNewConnectorTargetInput}"
                                                                  Text="{Binding LayoutEditorNewConnectorTargetInput}" IsEditable="True" Width="150" ToolTip.Tip="{l:T 'Target input'}" />
                                                    </WrapPanel>
                                                    <TextBox Text="{Binding LayoutEditorNewConnectorPoints, UpdateSourceTrigger=PropertyChanged}" Watermark="{l:T 'Points x,y;x,y;...'}" />
                                                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                        <ToggleButton Classes="small" IsChecked="{Binding LayoutPlaceConnectorSourceMode}" Content="{l:T 'Pick start on picture'}" />
                                                        <ToggleButton Classes="small" IsChecked="{Binding LayoutPlaceConnectorPointMode}" Content="{l:T 'Add corner on click'}" />
                                                        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{l:T 'Start: {0}', Arg0={Binding LayoutEditorConnectorSourcePointLabel}}" />
                                                        <Button Classes="small ghost" Command="{Binding ClearLayoutEditorConnectorSourcePointCommand}" Content="{l:T 'Clear start'}" />
                                                    </WrapPanel>
                                                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                        <Button Classes="icon small" Tag="{StaticResource Icon.Plus}" Command="{Binding AddLayoutEditorConnectorCommand}" Content="{l:T 'Add'}" />
                                                        <Button Classes="icon small" Tag="{StaticResource Icon.Check}" Command="{Binding ApplySelectedLayoutEditorConnectorDraftCommand}" Content="{l:T 'Apply'}" />
                                                        <Button Classes="icon small danger" Tag="{StaticResource Icon.Delete}" Command="{Binding RemoveSelectedLayoutEditorConnectorCommand}" Content="{l:T 'Remove'}" />
                                                    </WrapPanel>
                                                </StackPanel>
            
                                                <StackPanel Grid.Row="2" Spacing="8">
                                                    <TextBlock Classes="h3" Text="{l:T 'Label style'}" />
                                                    <TextBlock Classes="caption" Text="{l:T 'The text of the labels on the cheat sheets. Colors: #RRGGBB or #AARRGGBB.'}" />
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                                                        <TextBlock Classes="label" Text="{l:T 'Font'}" />
                                                        <TextBox Grid.Column="1" Text="{Binding LayoutFontFamily}" />
                                                        <TextBlock Grid.Row="1" Classes="label" Text="{l:T 'Size'}" />
                                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LayoutFontSize}" />
                                                        <TextBlock Grid.Row="2" Classes="label" Text="{l:T 'Text'}" />
                                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LayoutTextColor}" />
                                                        <TextBlock Grid.Row="3" Classes="label" Text="{l:T 'Outline'}" />
                                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LayoutOutlineColor}" />
                                                        <TextBlock Grid.Row="4" Classes="label" Text="{l:T 'Background'}" />
                                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LayoutBackgroundColor}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                    </Panel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Cheat sheets -->
                        <Grid Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsCheatSheetsSection}" ColumnDefinitions="420,*" ColumnSpacing="12" MinHeight="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12" Margin="0,0,8,0">
                                    <Border Classes="callout">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <PathIcon Data="{StaticResource Icon.Printer}" Width="18" Height="18" VerticalAlignment="Top" Foreground="{DynamicResource JP.AccentTextBrush}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5"
                                                       Text="{l:T 'Cheat sheets are pictures of your devices with what every button does: to print, or to keep on a second screen. Making them never changes a game.'}" />
                                        </Grid>
                                    </Border>

                                    <Border Classes="surface">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Joystick}" /></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="h2" Text="{l:T 'Devices'}" />
                                                    <TextBlock Classes="caption" Text="{l:T 'None ticked = every device with a picture'}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Content="{l:T 'All'}" IsChecked="{Binding LayoutSelectAllDevices}" MinWidth="0" />
                                                <CheckBox Grid.Column="3" Content="{l:T 'None'}" IsChecked="{Binding LayoutSelectNoneDevices}" MinWidth="0" />
                                            </Grid>
                                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding LayoutDeviceOptions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:SelectableTagItem">
                                                            <ToggleButton Classes="filterChip" IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding Name}" MaxWidth="370">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            </ToggleButton>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="surface">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Airplane}" /></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="h2" Text="{l:T 'What to make'}" />
                                                    <TextBlock Classes="caption" Text="{l:T 'An overview per device, and one picture per aircraft with that aircraft\'s binds'}" />
                                                </StackPanel>
                                            </Grid>
                                            <WrapPanel ItemSpacing="12" LineSpacing="6">
                                                <CheckBox Content="{l:T 'Overview per device'}" IsChecked="{Binding LayoutIncludeOverview}" />
                                                <CheckBox Content="{l:T 'One per aircraft'}" IsChecked="{Binding LayoutIncludePlanes}" />
                                                <CheckBox Content="{l:T 'Skip devices without a picture'}" IsChecked="{Binding LayoutSkipMissing}" />
                                                <CheckBox Content="{l:T 'One page with all devices'}" IsChecked="{Binding LayoutCombinePages}"
                                                          ToolTip.Tip="Also a page per aircraft (and for the overview) with the sheets of all devices under each other: All devices.png" />
                                                <CheckBox Content="{l:T 'White page'}" IsChecked="{Binding LayoutSheetLightStyle}"
                                                          ToolTip.Tip="{l:T 'Sheets with tables and lines on a white page; off: JoyPro 1\'s grey page'}" />
                                            </WrapPanel>
                                            <!-- JoyPro's drawings in the sheets: lines or cel-shaded, colours (the engine's drawing-style option) -->
                                            <controls:DrawingStyleEditor DataContext="{Binding ExportDrawing}" />

                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                <TextBlock Classes="label" Text="{l:T 'Games'}" />
                                                <CheckBox Grid.Column="1" Content="{l:T 'All'}" IsChecked="{Binding LayoutSelectAllGames}" MinWidth="0" />
                                                <CheckBox Grid.Column="2" Content="{l:T 'None'}" IsChecked="{Binding LayoutSelectNoneGames}" MinWidth="0" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding LayoutGameOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SelectableTagItem">
                                                        <ToggleButton Classes="filterChip" Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" IsEnabled="{Binding LayoutIncludePlanes}">
                                                <TextBlock Classes="label" Text="{l:T 'Aircraft (none ticked = all of the games)'}" />
                                                <CheckBox Grid.Column="1" Content="{l:T 'All'}" IsChecked="{Binding LayoutSelectAllPlanes}" MinWidth="0" />
                                                <CheckBox Grid.Column="2" Content="{l:T 'None'}" IsChecked="{Binding LayoutSelectNonePlanes}" MinWidth="0" />
                                            </Grid>
                                            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding LayoutIncludePlanes}">
                                                <ItemsControl ItemsSource="{Binding LayoutPlaneOptions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:SelectableTagItem">
                                                            <ToggleButton Classes="filterChip" Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>

                                    <Expander HorizontalAlignment="Stretch" Header="{l:T 'Look: markers, legend table, symbols'}">
                                        <StackPanel Spacing="8">
                                            <WrapPanel ItemSpacing="12" LineSpacing="6">
                                                <CheckBox Content="{l:T 'Draw markers'}" IsChecked="{Binding LayoutDrawMarkers}" />
                                                <CheckBox Content="{l:T 'Draw legend table'}" IsChecked="{Binding LayoutDrawLegendTable}" />
                                            </WrapPanel>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="6">
                                                <TextBlock Classes="label" Text="{l:T 'Marker size'}" />
                                                <TextBox Grid.Column="1" Text="{Binding LayoutMarkerSize}" Width="80" HorizontalAlignment="Left" />
                                                <TextBlock Grid.Row="1" Classes="label" Text="{l:T 'Modifier colors'}" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LayoutModifierColors}" Watermark="LAlt=#38BDF8,LCtrl=#F59E0B" />
                                            </Grid>
                                            <WrapPanel IsEnabled="{Binding LayoutDrawLegendTable}" ItemSpacing="6" LineSpacing="6">
                                                <TextBlock Classes="label" Text="{l:T 'Legend: width'}" />
                                                <TextBox Text="{Binding LayoutLegendWidth}" Width="64" />
                                                <TextBlock Classes="label" Text="{l:T 'rows'}" />
                                                <TextBox Text="{Binding LayoutLegendMaxRows}" Width="54" />
                                                <TextBlock Classes="label" Text="{l:T 'font'}" />
                                                <TextBox Text="{Binding LayoutLegendFontSize}" Width="54" />
                                            </WrapPanel>
                                            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="6">
                                                <TextBlock Classes="label" Text="{l:T 'Button'}" />
                                                <ComboBox Grid.Column="1" SelectedItem="{Binding LayoutButtonSymbol}" HorizontalAlignment="Stretch">
                                                    <x:String>circle</x:String>
                                                    <x:String>square</x:String>
                                                    <x:String>triangle</x:String>
                                                    <x:String>diamond</x:String>
                                                    <x:String>bar</x:String>
                                                </ComboBox>
                                                <TextBlock Grid.Column="2" Classes="label" Text="{l:T 'Axis'}" />
                                                <ComboBox Grid.Column="3" SelectedItem="{Binding LayoutAxisSymbol}" HorizontalAlignment="Stretch">
                                                    <x:String>diamond</x:String>
                                                    <x:String>circle</x:String>
                                                    <x:String>square</x:String>
                                                    <x:String>triangle</x:String>
                                                    <x:String>bar</x:String>
                                                </ComboBox>
                                                <TextBlock Grid.Row="1" Classes="label" Text="{l:T 'Hat'}" />
                                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding LayoutPovSymbol}" HorizontalAlignment="Stretch">
                                                    <x:String>triangle</x:String>
                                                    <x:String>circle</x:String>
                                                    <x:String>square</x:String>
                                                    <x:String>diamond</x:String>
                                                    <x:String>bar</x:String>
                                                </ComboBox>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" Text="{l:T 'Slider'}" />
                                                <ComboBox Grid.Row="1" Grid.Column="3" SelectedItem="{Binding LayoutSliderSymbol}" HorizontalAlignment="Stretch">
                                                    <x:String>bar</x:String>
                                                    <x:String>circle</x:String>
                                                    <x:String>square</x:String>
                                                    <x:String>triangle</x:String>
                                                    <x:String>diamond</x:String>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Classes="caption" Text="{l:T 'The label font and colors are set under Device pictures &gt; Tables, lines and label style.'}" />
                                        </StackPanel>
                                    </Expander>

                                    <Border Classes="surface">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Folder}" /></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="h2" Text="{l:T 'Output folder'}" />
                                                    <TextBlock Classes="caption" Text="{Binding CheatSheetFolderDisplay}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CheatSheetFolderDisplay}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <TextBox Text="{Binding LayoutExportPath}" Watermark="{l:T 'Empty = JoyPro\'s LayoutExport folder'}" />
                                                <Button Grid.Column="1" Classes="small" Click="BrowseLayoutExportFolderClicked" Content="{l:T 'Browse...'}" />
                                                <Button Grid.Column="2" Classes="icon small" Tag="{StaticResource Icon.FolderOpen}" Content="{l:T 'Open'}" Command="{Binding OpenCheatSheetFolderCommand}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Column="1" Classes="surface" Padding="0" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Border Classes="toolbar" Padding="14,12">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Classes="iconBadge"><PathIcon Data="{StaticResource Icon.Image}" /></Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Classes="h2" Text="{l:T 'Preview'}" />
                                                <TextBlock Classes="caption" Text="{Binding CheatSheetPlanSummary}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                <Button Classes="icon small ghost iconOnly" Tag="{StaticResource Icon.Refresh}" Command="{Binding RefreshCheatSheetPreviewsCommand}"
                                                        ToolTip.Tip="{l:T 'Show the newest pictures of the output folder'}" />
                                                <Button Classes="icon small" Tag="{StaticResource Icon.FolderOpen}" Content="{l:T 'Open folder'}" Command="{Binding OpenCheatSheetFolderCommand}" />
                                                <Button Classes="icon accent" Tag="{StaticResource Icon.Printer}" Content="{l:T 'Create cheat sheets'}" Command="{Binding RenderLayoutCommand}"
                                                        ToolTip.Tip="{l:T 'Makes the pictures (PNG) into the output folder. Games are not touched.'}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Panel Grid.Row="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,16,4,4" IsVisible="{Binding HasCheatSheetPreviews}">
                                            <ItemsControl ItemsSource="{Binding CheatSheetPreviews}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:CheatSheetPreviewItem">
                                                        <Button Classes="preview" Command="{Binding #RootWindow.DataContext.OpenCheatSheetCommand}" CommandParameter="{Binding}"
                                                                ToolTip.Tip="{Binding FilePath}">
                                                            <Border Classes="sunken" Width="200" Padding="8">
                                                                <StackPanel Spacing="6">
                                                                    <Border Height="230" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource JP.SurfaceRaisedBrush}">
                                                                        <Panel>
                                                                            <PathIcon Data="{StaticResource Icon.Image}" Width="36" Height="36" Opacity="0.5" IsVisible="{Binding HasNoThumbnail}" />
                                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                                        </Panel>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <Border Classes="chip aircraft"><TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" MaxWidth="170" /></Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <Border Classes="emptyState" IsVisible="{Binding HasNoCheatSheetPreviews}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="24">
                                            <StackPanel Spacing="10">
                                                <PathIcon Classes="emptyIcon" Data="{StaticResource Icon.Printer}" />
                                                <TextBlock Classes="h2" HorizontalAlignment="Center" Text="{l:T 'No cheat sheets yet'}" />
                                                <TextBlock Classes="caption" TextAlignment="Center"
                                                           Text="{l:T 'Pick your devices and what to make on the left, then press Create cheat sheets. The pictures show up here; click one to open it.'}" />
                                                <Button Classes="icon accent" Tag="{StaticResource Icon.Printer}" Content="{l:T 'Create cheat sheets'}" Command="{Binding RenderLayoutCommand}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Panel>
                                    <Border Grid.Row="2" Classes="statusbar">
                                        <TextBlock Classes="caption" Text="{Binding CheatSheetStatus}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border IsVisible="{Binding IsExportStage}" CornerRadius="12" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource Icon.Export}" Width="26" Height="26" />
                            <TextBlock Text="{l:T 'Export'}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="hint" Text="{l:T 'Three steps: check your profile, choose how JoyPro writes into the games, export. Every export backs up the game files first; Undo export on a game puts them back.'}" />

                        <!-- Step 1: check -->
                        <Border Classes="card">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Classes="step"><TextBlock Text="1" /></Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Classes="section" Text="{l:T 'Check your profile'}" />
                                    <TextBlock Classes="hint" Text="{Binding ValidationSummary}" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="icon" Tag="{StaticResource Icon.Ok}" Content="{l:T 'Check now'}" Command="{Binding ValidateProfileCommand}"
                                        ToolTip.Tip="{l:T 'Looks for relations without binds, the same button twice and other problems (list further down)'}" />
                            </Grid>
                        </Border>

                        <!-- Step 2: how (export mode in plain words) -->
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Classes="step"><TextBlock Text="2" /></Border>
                                    <TextBlock Classes="section" Text="{l:T 'How JoyPro writes into the games'}" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding ExportModeOptions}" SelectedItem="{Binding SelectedExportModeOption}" Background="Transparent">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChoiceOption">
                                            <Grid Width="270" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="2" ToolTip.Tip="{Binding Description}">
                                                <PathIcon Data="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Top" Margin="0,2,0,0" Classes.warn="{Binding IsRisky}" Classes.ok="{Binding IsRecommended}" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <CheckBox IsChecked="{Binding ExportNukeUntouchedDevices}"
                                          ToolTip.Tip="{l:T 'Removes every bind of the devices your profile does not use (asks first; a backup is made)'}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" Classes="warn" />
                                        <TextBlock Text="{l:T 'Also clear my other devices (devices without a bind in my profile lose all their binds)'}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- Step 3: the games -->
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Classes="step"><TextBlock Text="3" /></Border>
                                    <TextBlock Classes="section" Text="{l:T 'Export to games'}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ExportGamesStatus}" TextWrapping="Wrap" Opacity="0.8" />
                                <WrapPanel IsVisible="{Binding ExportsMsfs2024}">
                                    <CheckBox Content="{l:T 'MSFS 2024: write into my MSFS profiles'}" IsChecked="{Binding MsfsWriteUserProfiles}" Margin="0,0,10,0"
                                              ToolTip.Tip="{l:T 'The export puts the binds into the profile MSFS 2024 uses for each device and category (Steam or Microsoft Store), backed up first. Off: only import files.'}" />
                                    <CheckBox Content="{l:T 'MSFS 2024: import files for every device'}" IsChecked="{Binding MsfsAlwaysImportFiles}" Margin="0,0,10,0"
                                              ToolTip.Tip="{l:T 'Off: import files only where JoyPro could not write your profile.'}" />
                                </WrapPanel>
                                <Border IsVisible="{Binding HasMsfsProfileUpdates}" BorderBrush="{DynamicResource JP.AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{l:T 'Your MSFS 2024 profiles'}" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding MsfsProfileUpdates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border IsVisible="{Binding HasMsfsImportFiles}" BorderBrush="{DynamicResource JP.AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <PathIcon Data="{StaticResource Icon.Info}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="{l:T 'Microsoft Flight Simulator 2024: import your binds in the sim'}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding MsfsImportFilesHint}" TextWrapping="Wrap" />
                                            <WrapPanel>
                                                <TextBlock Text="{Binding MsfsImportFilesFolder}" TextWrapping="Wrap" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button Command="{Binding OpenMsfsImportFilesFolderCommand}" Content="{l:T 'Open folder'}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ExportGamesNotInstalled, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding ExportGamesNotInstalled}" TextWrapping="Wrap" Foreground="#D97706" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding GoSettingsCommand}" Content="{l:T 'Settings &gt; Games'}" />
                                </Grid>
                                <WrapPanel>
                                    <Button Command="{Binding ExportSelectedGamesCommand}" Content="{l:T 'Export ticked games'}" Classes="icon accent" Tag="{StaticResource Icon.Export}" Margin="0,0,8,6"
                                            ToolTip.Tip="{l:T 'Exports every ticked game one after the other (DCS: only the ticked aircraft)'}" />
                                    <Button Command="{Binding RefreshExportGamesCommand}" Content="{l:T 'Refresh'}" Classes="icon" Tag="{StaticResource Icon.Refresh}" Margin="0,0,16,6" />
                                    <PathIcon Data="{StaticResource Icon.Shield}" Width="16" Height="16" Classes="ok" Margin="0,0,6,6" />
                                    <TextBlock Text="{l:T 'Every export backs up the game files first. Paths, keyboard and DCS options: \'Options and paths\' below.'}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6" />
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding ExportGames}">
                                    <ItemsControl.Styles>
                                        <Style Selector="TextBlock.state">
                                            <Setter Property="Foreground" Value="#16A34A" />
                                        </Style>
                                        <Style Selector="TextBlock.state.failed">
                                            <Setter Property="Foreground" Value="#DC2626" />
                                        </Style>
                                    </ItemsControl.Styles>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ExportGameItem">
                                            <Border BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,8">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="Auto,64,*,Auto" ColumnSpacing="12">
                                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanExport}" VerticalAlignment="Center"
                                                                  ToolTip.Tip="{l:T 'Included in \'Export ticked games\''}" />
                                                        <Border Grid.Column="1" Width="64" Height="96" CornerRadius="6" ClipToBounds="True" Background="#1A94A3B8">
                                                            <Panel>
                                                                <controls:GameBadge GameId="{Binding GameId}" Title="{Binding Name}" />
                                                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                            </Panel>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.8" />
                                                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ExportState, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                <PathIcon Data="{StaticResource Icon.Ok}" Width="16" Height="16" Classes="ok" IsVisible="{Binding ExportSucceeded}" />
                                                                <PathIcon Data="{StaticResource Icon.Error}" Width="16" Height="16" Classes="error" IsVisible="{Binding ExportFailed}" />
                                                                <TextBlock Text="{Binding ExportState}" TextWrapping="Wrap" Classes="state" Classes.failed="{Binding ExportFailed}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Content="{Binding ExpandLabel}" Command="{Binding ToggleExpandedCommand}" IsVisible="{Binding HasPlanes}"
                                                                    ToolTip.Tip="{l:T 'Shows the aircraft; only the ticked ones are exported'}" />
                                                            <Button Content="{l:T 'Preview'}" Classes="icon" Tag="{StaticResource Icon.Eye}" Command="{Binding #RootWindow.DataContext.PreviewExportGameCommand}" CommandParameter="{Binding}"
                                                                    IsVisible="{Binding CanPreview}" ToolTip.Tip="{l:T 'Shows what the export would change, without writing (output panel)'}" />
                                                            <Button Content="{l:T 'Undo last export'}" Classes="icon" Tag="{StaticResource Icon.Undo}" Command="{Binding #RootWindow.DataContext.UndoLastExportCommand}" CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding CanUndoExport}" ToolTip.Tip="{l:T 'Puts the game\'s control files back from before JoyPro\'s last export (asks first; only after an export of this game)'}" />
                                                            <Button Content="{l:T 'Export now'}" Classes="icon accent" Tag="{StaticResource Icon.Export}" Command="{Binding #RootWindow.DataContext.ExportGameNowCommand}" CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding CanExport}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Border IsVisible="{Binding IsExpanded}" Padding="6" CornerRadius="6" Background="#1A94A3B8">
                                                        <StackPanel Spacing="6">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Button Content="{l:T 'All'}" Command="{Binding SelectAllPlanesCommand}" Padding="8,2" FontSize="11" />
                                                                <Button Content="{l:T 'None'}" Command="{Binding SelectNoPlanesCommand}" Padding="8,2" FontSize="11" />
                                                                <TextBlock Text="{Binding PlanesLabel}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                            </StackPanel>
                                                            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding Planes}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:ExportPlaneItem">
                                                                            <CheckBox IsChecked="{Binding IsSelected}" Width="210" Margin="0,0,6,6" VerticalContentAlignment="Center">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <Image Source="{Binding Image}" Width="40" Height="40" />
                                                                                    <StackPanel VerticalAlignment="Center" MaxWidth="140">
                                                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                                        <TextBlock Text="{Binding Plane}" FontSize="10" Opacity="0.6" IsVisible="{Binding ShowPlaneId}" TextWrapping="Wrap" />
                                                                                        <TextBlock Text="{Binding Summary}" FontSize="10" Opacity="0.7" />
                                                                                    </StackPanel>
                                                                                </StackPanel>
                                                                            </CheckBox>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Expander Header="{l:T 'Options and paths (for experts)'}" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8" Margin="0,6,0,0">
                                <TextBlock Classes="hint" Text="{l:T 'Your own paths for single games, the keyboard and DCS details. Empty paths: JoyPro finds the game\'s files itself.'}" />
                                <Grid ColumnDefinitions="Auto,160,Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="{l:T 'Export Mode'}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding ExportMode}">
                                        <x:String>clean</x:String>
                                        <x:String>add</x:String>
                                        <x:String>merge</x:String>
                                        <x:String>merge-overwrite</x:String>
                                    </ComboBox>
                                    <TextBlock Grid.Column="2" Text="{l:T 'DCS Path'}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="3" Text="{Binding ExportDcsPath}" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{l:T 'IL2 Path'}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding ExportIl2Path}" />
                                    <Button Grid.Column="2" Command="{Binding ExportIl2Command}" Content="{l:T 'Export IL2'}" IsEnabled="{Binding CanRunIl2}" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{l:T 'Star Citizen Path'}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding ExportStarCitizenPath}" />
                                    <Button Grid.Column="2" Command="{Binding ExportStarCitizenCommand}" Content="{l:T 'Export Star Citizen'}" IsEnabled="{Binding CanRunStarCitizen}" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="{l:T 'Star Citizen Source'}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding StarCitizenSourcePath}" Watermark="{l:T 'Optional source (actionmaps/defaultProfile)'}" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto,260,*,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{l:T 'Other Game'}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding RegistryGames}" SelectedItem="{Binding SelectedRegistryGame}" HorizontalAlignment="Stretch" PlaceholderText="{l:T 'Load Games on the Start page'}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:RegistryGameItem">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="2" Text="{Binding RegistryGamePath}" Watermark="{l:T 'File / folder (empty = detected)'}" />
                                    <CheckBox Grid.Column="3" Content="{l:T 'Dry run'}" IsChecked="{Binding RegistryGameDryRun}" />
                                    <Button Grid.Column="4" Command="{Binding ExportRegistryGameCommand}" Content="{l:T 'Export Game'}" IsEnabled="{Binding CanRunRegistryGame}" />
                                </Grid>
                                <Border IsVisible="{Binding HasMsfsImportFiles}" BorderBrush="{DynamicResource JP.AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding MsfsImportFilesHint}" TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <TextBlock Text="{Binding MsfsImportFilesFolder}" TextWrapping="Wrap" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Command="{Binding OpenMsfsImportFilesFolderCommand}" Content="{l:T 'Open folder'}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <WrapPanel>
                                    <CheckBox Content="{l:T 'DCS: keep keyboard defaults'}" IsChecked="{Binding ExportKeepKeyboardDefaults}" Margin="0,0,10,0" />
                                    <CheckBox Content="{l:T 'DCS: my devices lose the DCS default binds in every other aircraft too'}" IsChecked="{Binding ExportDcsCleanAllAircraft}" Margin="0,0,10,0"
                                              ToolTip.Tip="{l:T 'A device JoyPro writes loses its DCS default binds also in the aircraft your profile does not bind (its own binds there stay; Replace mode clears them too). Off: only the aircraft of the profile.'}" />
                                    <CheckBox Content="{l:T 'Nuke: remove all binds from devices JoyPro does not use (DCS and other games)'}" IsChecked="{Binding ExportNukeUntouchedDevices}" Margin="0,0,10,0" />
                                    <CheckBox Content="{l:T 'SC: keep keyboard defaults'}" IsChecked="{Binding ExportStarCitizenKeepKeyboardDefaults}" Margin="0,0,10,0" />
                                    <CheckBox Content="{l:T 'SC: prefer local order'}" IsChecked="{Binding ExportStarCitizenPreferLocalOrder}" Margin="0,0,10,0" />
                                    <Button Command="{Binding ExportDcsCommand}" Content="{l:T 'Export DCS'}" Margin="0,0,10,0" IsEnabled="{Binding CanRunDcs}" />
                                    <Button Command="{Binding ValidateProfileCommand}" Content="{l:T 'Validate Profile'}" Margin="0,0,10,0" />
                                    <Button Command="{Binding OpenIssueContextCommand}" Content="{l:T 'Open Issue Context'}" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>

                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="8">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource Icon.Ok}" Width="18" Height="18" />
                                    <TextBlock Text="{l:T 'Problems found by the check'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <CheckBox Content="{l:T 'Show Errors'}" IsChecked="{Binding ValidationShowErrors}" Margin="0,0,10,0" />
                                    <CheckBox Content="{l:T 'Show Warnings'}" IsChecked="{Binding ValidationShowWarnings}" />
                                </WrapPanel>
                                <ListBox ItemsSource="{Binding ValidationIssues}" SelectedItem="{Binding SelectedValidationIssue}" MinHeight="180">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ValidationIssueItem">
                                            <Grid ColumnDefinitions="80,*,220" Margin="0,2,0,2">
                                                <TextBlock Text="{Binding Type}" FontWeight="Bold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding ActionHint}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="8">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource Icon.Warning}" Width="18" Height="18" Classes="warn" />
                                    <TextBlock Text="{l:T 'Same button used twice'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding ConflictSummary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="8">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource Icon.History}" Width="18" Height="18" Classes="info" />
                                    <TextBlock Text="{l:T 'Game config backups'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                           Text="{l:T 'Before every export JoyPro copies the game files it changes (DCS, IL-2, Star Citizen and every other game). If a game\'s controls break, pick the backup from before that export and restore it. Close the game first. A restore backs up the current files too, so it can be undone.'}" />
                                <WrapPanel>
                                    <TextBlock Text="{l:T 'Game'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding GameBackupGames}" SelectedItem="{Binding SelectedGameBackupGame}" MinWidth="180" Margin="0,0,8,0" />
                                    <Button Command="{Binding RefreshGameBackupsCommand}" Content="{l:T 'Refresh'}" Classes="icon" Tag="{StaticResource Icon.Refresh}" Margin="0,0,8,0" />
                                    <Button Command="{Binding ShowGameBackupCommand}" Content="{l:T 'Show Files'}" Classes="icon" Tag="{StaticResource Icon.File}" Margin="0,0,8,0" />
                                    <Button Command="{Binding PreviewRestoreGameBackupCommand}" Content="{l:T 'Preview Restore'}" Classes="icon" Tag="{StaticResource Icon.Eye}" Margin="0,0,8,0" IsEnabled="{Binding CanRestoreGameBackup}" />
                                    <Button Command="{Binding RestoreGameBackupCommand}" Content="{l:T 'Restore'}" Classes="icon" Tag="{StaticResource Icon.Undo}" IsEnabled="{Binding CanRestoreGameBackup}"
                                            ToolTip.Tip="{l:T 'Puts the game files back the way they were before the selected export (only for installed games)'}" />
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding GameBackups}" SelectedItem="{Binding SelectedGameBackup}" AutoGenerateColumns="False" IsReadOnly="True"
                                          Height="170" CanUserSortColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{l:T 'Taken'}" Binding="{Binding Created}" Width="175" />
                                        <DataGridTextColumn Header="{l:T 'Game'}" Binding="{Binding Game}" Width="120" />
                                        <DataGridTextColumn Header="{l:T 'When'}" Binding="{Binding Kind}" Width="140" />
                                        <DataGridTextColumn Header="{l:T 'Files'}" Binding="{Binding FileCount}" Width="80" />
                                        <DataGridTextColumn Header="{l:T 'Command'}" Binding="{Binding Command}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBox Text="{Binding GameBackupOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                         FontFamily="Consolas,Menlo,monospace" MaxHeight="220" MinHeight="60"
                                         IsVisible="{Binding GameBackupOutput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border IsVisible="{Binding IsHudStage}" CornerRadius="12" Padding="10">
                    <Grid ColumnDefinitions="310,*,300" ColumnSpacing="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource Icon.Monitor}" Width="26" Height="26" />
                                    <TextBlock Text="{l:T 'HUD Designer'}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding HudStatus}" TextWrapping="Wrap" Opacity="0.8" />
                                <Button Command="{Binding ToggleOverlayCommand}" Content="{Binding OverlayToggleLabel}" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <TextBlock Text="{Binding OverlayStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <CheckBox Content="{l:T 'Stream window (for OBS) instead of on screen'}" IsChecked="{Binding HudStreamWindow}"
                                          ToolTip.Tip="{l:T 'A normal window with a plain background: add it in OBS as Window Capture and key out the background colour'}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding HudStreamWindow}">
                                    <TextBlock Text="{l:T 'Background'}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding HudStreamBackground}" Watermark="#00FF00" />
                                </Grid>

                                <TextBlock Text="{l:T 'Widgets'}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <ListBox ItemsSource="{Binding HudWidgets}" SelectedItem="{Binding SelectedHudWidget}" MaxHeight="340">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:HudWidget">
                                            <Grid ColumnDefinitions="Auto,40,*" ColumnSpacing="8">
                                                <CheckBox IsChecked="{Binding Visible}" VerticalAlignment="Center" ToolTip.Tip="{l:T 'Show on the HUD'}" />
                                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="6" Background="#1A94A3B8" ClipToBounds="True">
                                                    <Image Source="{Binding Device.ListIcon}" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel>
                                    <Button Command="{Binding LoadHudDevicesCommand}" Content="{l:T 'Reload devices'}" IsEnabled="{Binding CanRun}" Margin="0,0,6,6" />
                                    <Button Command="{Binding ShowAllHudDevicesCommand}" Content="{l:T 'Show all'}" Margin="0,0,6,6" />
                                    <Button Command="{Binding ArrangeHudCommand}" Content="{l:T 'Arrange automatically'}" Margin="0,0,6,6" ToolTip.Tip="{l:T 'Throttle and left hand left, pedals in the middle, right-hand stick right, along the bottom'}" />
                                    <Button Command="{Binding ResetHudLayoutCommand}" Content="{l:T 'Reset places'}" Margin="0,0,6,6" />
                                </WrapPanel>

                                <TextBlock Text="{l:T 'Look'}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                    <TextBlock Text="{l:T 'Style'}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding HudStyles}" SelectedItem="{Binding HudStyle}" HorizontalAlignment="Stretch" />
                                    <TextBlock Grid.Row="1" Text="{l:T 'Opacity'}" VerticalAlignment="Center" />
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0.3" Maximum="1" Value="{Binding HudOpacity}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding HudAccentOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:HudAccentOption">
                                            <Button Command="{Binding #RootWindow.DataContext.SetHudAccentCommand}" CommandParameter="{Binding Hex}" Padding="0" Margin="0,0,6,6"
                                                    Width="28" Height="28" CornerRadius="14" Background="{Binding Brush}" BorderBrush="#80FFFFFF" BorderThickness="1" ToolTip.Tip="{l:T 'Accent colour'}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{l:T 'What the button does'}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                    <TextBlock Text="{l:T 'Lines'}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding OverlayMaxLines}" Minimum="1" Maximum="20" Increment="1" FormatString="0" />
                                    <TextBlock Grid.Row="1" Text="{l:T 'Seconds'}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding OverlaySeconds}" Minimum="1" Maximum="30" Increment="0.5" FormatString="0.0" />
                                    <TextBlock Grid.Row="2" Text="{l:T 'Font size'}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding OverlayFontSize}" Minimum="10" Maximum="60" Increment="1" FormatString="0" />
                                </Grid>
                                <CheckBox Content="{l:T 'Show device and button'}" IsChecked="{Binding OverlayShowDevice}" />
                                <CheckBox Content="{l:T 'Only while a game runs'}" IsChecked="{Binding OverlayOnlyInGame}" />
                                <CheckBox Content="{l:T 'Click-through (applies on start)'}" IsChecked="{Binding OverlayClickThrough}" />

                                <TextBlock Text="{l:T 'DCS aircraft'}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <ComboBox ItemsSource="{Binding OverlayPlaneOptions}" SelectedItem="{Binding OverlayPlaneChoice}" HorizontalAlignment="Stretch" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                           Text="Or let DCS tell JoyPro the aircraft: a small addition to Saved Games\DCS\Scripts\Export.lua (keeps SRS, Tacview and other scripts working, backed up first). Close DCS before installing." />
                                <WrapPanel>
                                    <Button Command="{Binding InstallDcsHookCommand}" Content="{l:T 'Install DCS hook'}" IsEnabled="{Binding CanRun}" Margin="0,0,6,6" />
                                    <Button Command="{Binding RemoveDcsHookCommand}" Content="{l:T 'Remove'}" IsEnabled="{Binding CanRun}" Margin="0,0,6,6" />
                                    <Button Command="{Binding DcsHookStatusCommand}" Content="{l:T 'Check'}" IsEnabled="{Binding CanRun}" Margin="0,0,6,6" />
                                </WrapPanel>
                                <TextBlock Text="{Binding DcsHookStatus}" TextWrapping="Wrap" Opacity="0.85"
                                           IsVisible="{Binding DcsHookStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <TextBlock Text="{l:T 'Preview with live input: move the axes of your devices, press buttons. Drag a widget to move it; click it to edit it on the right.'}" TextWrapping="Wrap" Opacity="0.8" />
                            <Border Grid.Row="1" CornerRadius="12" ClipToBounds="True" Background="#0B1220" BorderBrush="#334155" BorderThickness="1">
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="1920" Height="1080">
                                        <Image Source="{Binding HudPreviewBackground}" Stretch="UniformToFill" />
                                        <Border Background="#40000000" />
                                        <controls:HudSurface x:Name="HudDesignerSurface" Designer="True" Fixed="True" Widgets="{Binding HudWidgets}" Context="{Binding HudContext}" SelectedWidget="{Binding SelectedHudWidget}" />
                                    </Grid>
                                </Viewbox>
                            </Border>
                        </Grid>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8" IsVisible="{Binding HasSelectedHudWidget}">
                                <TextBlock Text="{Binding SelectedHudWidget.Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedHudWidget.Subtitle}" Opacity="0.7" TextWrapping="Wrap" />
                                <CheckBox Content="{l:T 'Show on the HUD'}" IsChecked="{Binding SelectedHudWidget.Visible}" />
                                <TextBlock Text="{l:T 'Size'}" />
                                <Slider Minimum="0.4" Maximum="2.5" Value="{Binding SelectedHudWidget.Scale}" />
                                <StackPanel Spacing="6" IsVisible="{Binding SelectedHudWidgetIsDevice}">
                                    <CheckBox Content="{l:T 'Name'}" IsChecked="{Binding SelectedHudWidget.ShowName}" />
                                    <CheckBox Content="{l:T 'Picture'}" IsChecked="{Binding SelectedHudWidget.ShowPicture}" />
                                    <CheckBox Content="{l:T 'Picture tilts with the stick'}" IsChecked="{Binding SelectedHudWidget.Tilt}" />
                                    <CheckBox Content="{l:T 'Buttons light up'}" IsChecked="{Binding SelectedHudWidget.ShowButtons}" />
                                    <CheckBox Content="{l:T 'Axes and levers'}" IsChecked="{Binding SelectedHudWidget.ShowAxes}" />
                                    <CheckBox Content="{l:T 'Stick position (gimbal)'}" IsChecked="{Binding SelectedHudWidget.ShowGimbal}" />
                                    <CheckBox Content="{l:T 'Hats'}" IsChecked="{Binding SelectedHudWidget.ShowHats}" />
                                    <TextBlock Text="{l:T 'Picture'}" Margin="0,4,0,0" />
                                    <ComboBox ItemsSource="{Binding HudPictureSources}" SelectedItem="{Binding SelectedHudWidget.PictureSource}" HorizontalAlignment="Stretch" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                                               Text="{l:T 'Photo: the manufacturer\'s picture. Layout: your JoyPro layout picture, where the pressed buttons light up at their place. Auto: the photo when there is one.'}" />
                                    <StackPanel Spacing="4" IsVisible="{Binding SelectedHudWidget.HasGripChoices}">
                                        <TextBlock Text="{l:T 'Grip on this base'}" Margin="0,4,0,0" />
                                        <ComboBox ItemsSource="{Binding SelectedHudWidget.Device.GripChoices}" SelectedItem="{Binding SelectedHudGrip}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border IsVisible="{Binding IsFfbTelemetryStage}" CornerRadius="12" Padding="10">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource Icon.Vibrate}" Width="26" Height="26" />
                                <TextBlock Text="{l:T 'Force Feedback (Telemetry)'}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1A38BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FfbTelemetryStatusText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FfbTelemetryStatusText}" />
                            </Border>
                            <ToggleSwitch Grid.Column="2" IsChecked="{Binding FfbTelemetryEnabled}" OnContent="{l:T 'On'}" OffContent="{l:T 'Off'}" VerticalAlignment="Center"
                                          ToolTip.Tip="{l:T 'On: JoyPro starts its force feedback process whenever a supported game runs (checked every 5 seconds). Off: nothing runs or polls.'}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding FfbTelemetryMessage}" Opacity="0.8" TextWrapping="Wrap"
                                   IsVisible="{Binding FfbTelemetryMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TabControl Grid.Row="2" SelectedIndex="{Binding FfbTelemetryTab}">
                            <TabItem Header="{l:T 'Settings'}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="8" Margin="0,8,8,0">
                                        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                                   Text="{l:T 'JoyPro reads the game\'s telemetry (airspeed, angle of attack, G, gear, guns, hits ...) and drives your force feedback stick through a graph of nodes, like the Forza haptics blueprint. It runs only while DCS World, IL-2 Great Battles, IL-2 Korea or War Thunder runs, and stops by itself when the game exits.'}" />
                                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="8">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{l:T 'Device and forces'}" FontSize="16" FontWeight="SemiBold" />
                                                <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                                    <TextBlock Text="{l:T 'Device'}" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding FfbTelemetryDevices}" SelectedItem="{Binding SelectedFfbTelemetryDevice}" HorizontalAlignment="Stretch"
                                                              PlaceholderText="{l:T 'First force feedback device (press Refresh to pick one)'}" />
                                                    <Button Grid.Column="2" Command="{Binding RefreshFfbTelemetryDevicesCommand}" Content="{l:T 'Refresh'}" MinWidth="120"
                                                            ToolTip.Tip="{l:T 'Lists the force feedback devices (read-only: nothing moves)'}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding FfbTelemetryDeviceInfo}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="2" Text="{l:T 'Strength'}" VerticalAlignment="Center" />
                                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FfbTelemetryStrength}" ToolTip.Tip="{l:T 'Overall strength of every effect'}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding FfbTelemetryStrengthText}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="3" Text="{l:T 'Max force'}" VerticalAlignment="Center" />
                                                    <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FfbTelemetryMaxForce}"
                                                            ToolTip.Tip="{l:T 'Hard cap per axis: no effect and no sum of effects goes above it (default 60 %)'}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding FfbTelemetryMaxForceText}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="4" Text="{l:T 'Direction'}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="18">
                                                        <CheckBox Content="{l:T 'Invert X (left/right)'}" IsChecked="{Binding FfbTelemetryInvertX}"
                                                                  ToolTip.Tip="{l:T 'Saved for this device. The direction test below finds it for you.'}" />
                                                        <CheckBox Content="{l:T 'Invert Y (forward/back)'}" IsChecked="{Binding FfbTelemetryInvertY}"
                                                                  ToolTip.Tip="{l:T 'Saved for this device. The direction test below finds it for you.'}" />
                                                    </StackPanel>
                                                    <Button Grid.Row="4" Grid.Column="2" Command="{Binding StartFfbDirectionTestCommand}" Content="{l:T '↔ Direction test'}" MinWidth="120"
                                                            ToolTip.Tip="{l:T 'JoyPro gently pushes the stick (20 %), asks which way it went and sets Invert X / Y. Also checks the centring spring and trim.'}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                                    <TextBlock Text="{l:T 'Centring'}" VerticalAlignment="Center" />
                                                    <CheckBox Grid.Column="1" Content="{l:T 'JoyPro provides the centring spring (needed for trim)'}" IsChecked="{Binding FfbTelemetryCentringSpring}"
                                                              ToolTip.Tip="{l:T 'On: while JoyPro drives the stick it always keeps a centring spring (also while the game pauses), and trim moves its centre. Off: JoyPro sends no spring; the stick\'s own centring acts (no trim from JoyPro).'}" />
                                                    <TextBlock Grid.Row="1" Text="{l:T 'Spring stiffness'}" VerticalAlignment="Center" />
                                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="100" Value="{Binding FfbTelemetryCentringStiffness}" IsEnabled="{Binding FfbTelemetryCentringSpring}"
                                                            ToolTip.Tip="{l:T 'The plain centring spring on axes the graph has no spring for (the built-in graph\'s own springs stiffen with airspeed)'}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding FfbTelemetryCentringStiffnessText}" VerticalAlignment="Center" MinWidth="60" />
                                                </Grid>
                                                <Border IsVisible="{Binding FfbTelemetryIsVpforce}" Background="#1AF59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="8">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <TextBlock Text="&#x26A0;" FontSize="18" VerticalAlignment="Top" />
                                                        <TextBlock Grid.Column="1" Text="{Binding FfbTelemetryVpforceHint}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                                <Border IsVisible="{Binding FfbWizardOpen}" BorderBrush="#38BDF8" BorderThickness="2" CornerRadius="10" Padding="12">
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="8">
                                                        <TextBlock Grid.RowSpan="2" Text="{Binding FfbWizardGlyph}" FontSize="44" VerticalAlignment="Top" MinWidth="56" TextAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding FfbWizardTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FfbWizardText}" TextWrapping="Wrap" />
                                                        <WrapPanel Grid.Row="2" Grid.Column="1">
                                                            <!-- Fixed texts, one button each, and a little room after the text: a button whose text changed
                                                                 from "Start" to "Ready" was cut to "Read" (at 100 % and 150 % display scaling). -->
                                                            <Button Name="FfbWizardStartButton" Command="{Binding FfbWizardReadyCommand}" Margin="0,0,8,6" MinWidth="130"
                                                                    HorizontalContentAlignment="Center" Classes="accent">
                                                                <Button.IsVisible>
                                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                        <Binding Path="FfbWizardCanReady" />
                                                                        <Binding Path="FfbWizardIsIntro" />
                                                                    </MultiBinding>
                                                                </Button.IsVisible>
                                                                <TextBlock Text="{l:T '▶  Start'}" TextWrapping="NoWrap" Padding="0,0,4,0" />
                                                            </Button>
                                                            <Button Name="FfbWizardReadyButton" Command="{Binding FfbWizardReadyCommand}" Margin="0,0,8,6" MinWidth="130"
                                                                    HorizontalContentAlignment="Center" Classes="accent">
                                                                <Button.IsVisible>
                                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                        <Binding Path="FfbWizardCanReady" />
                                                                        <Binding Path="!FfbWizardIsIntro" />
                                                                    </MultiBinding>
                                                                </Button.IsVisible>
                                                                <TextBlock Text="{l:T '▶  Ready'}" TextWrapping="NoWrap" Padding="0,0,4,0" />
                                                            </Button>
                                                            <ItemsControl ItemsSource="{Binding FfbWizardChoices}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:FfbWizardChoiceItem">
                                                                        <Button Command="{Binding #RootWindow.DataContext.FfbWizardAnswerCommand}" CommandParameter="{Binding}" Margin="0,0,8,6" MinWidth="130"
                                                                                HorizontalContentAlignment="Center">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <TextBlock Text="{Binding Glyph}" FontSize="16" Padding="0,0,2,0" />
                                                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="NoWrap" Padding="0,0,4,0" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Command="{Binding FfbWizardRetryCommand}" IsVisible="{Binding FfbWizardCanRetry}" Margin="0,0,8,6"
                                                                    ToolTip.Tip="{l:T 'Repeat this step: the same push, spring or trim once more'}">
                                                                <TextBlock Text="{l:T '↻  Repeat this step'}" TextWrapping="NoWrap" Padding="0,0,4,0" />
                                                            </Button>
                                                            <Button Command="{Binding FfbWizardCancelCommand}" IsVisible="{Binding !FfbWizardFinished}" Margin="0,0,8,6">
                                                                <TextBlock Text="{l:T '■  Cancel (stop all forces)'}" TextWrapping="NoWrap" Padding="0,0,4,0" />
                                                            </Button>
                                                            <Button Command="{Binding FfbWizardStartOverCommand}" IsVisible="{Binding FfbWizardCanStartOver}" Margin="0,0,8,6"
                                                                    ToolTip.Tip="{l:T 'Stop every force and begin the test again from the first step'}">
                                                                <TextBlock Text="{l:T '⏮  Start over'}" TextWrapping="NoWrap" Padding="0,0,4,0" />
                                                            </Button>
                                                            <Button Command="{Binding FfbWizardCloseCommand}" Margin="0,0,8,6">
                                                                <TextBlock Text="{l:T 'Close'}" TextWrapping="NoWrap" Padding="0,0,4,0" />
                                                            </Button>
                                                        </WrapPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="8">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="Auto,320,*,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{l:T 'Game'}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding FfbTelemetryGames}" SelectedItem="{Binding SelectedFfbTelemetryGame}" HorizontalAlignment="Stretch" />
                                                    <Button Grid.Column="3" Command="{Binding RefreshFfbTelemetryStatusCommand}" Content="{l:T 'Reload settings'}" />
                                                </Grid>
                                                <ContentControl Content="{Binding SelectedFfbTelemetryGame}">
                                                    <ContentControl.ContentTemplate>
                                                        <DataTemplate x:DataType="models:FfbTelemetryGameItem">
                                                            <StackPanel Spacing="8">
                                                                <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                                                    <CheckBox Grid.ColumnSpan="2" Content="{l:T 'Force feedback for this game'}" IsChecked="{Binding Enabled}" />
                                                                    <TextBlock Grid.Row="1" Text="{l:T 'Strength'}" VerticalAlignment="Center" />
                                                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding Strength}" IsEnabled="{Binding Enabled}" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding StrengthText}" VerticalAlignment="Center" MinWidth="60" />
                                                                    <TextBlock Grid.Row="2" Text="{l:T 'Graph'}" VerticalAlignment="Center" />
                                                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding GraphOptions}" SelectedItem="{Binding Graph}" HorizontalAlignment="Stretch" />
                                                                    <Button Grid.Row="2" Grid.Column="2" Command="{Binding #RootWindow.DataContext.EditFfbTelemetryGameGraphCommand}" Content="{l:T 'Open in editor'}" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                                                               Text="{l:T 'Telemetry from {0}', Arg0={Binding Endpoint}}"
                                                                               IsVisible="{Binding Endpoint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                </Grid>

                                                                <TextBlock Text="{l:T 'Effects of the built-in graph'}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                                <ItemsControl ItemsSource="{Binding Effects}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:FfbTelemetryEffectItem">
                                                                            <Grid ColumnDefinitions="330,*,60" ColumnSpacing="8" Margin="0,0,0,2">
                                                                                <CheckBox Content="{Binding Title}" IsChecked="{Binding Enabled}" ToolTip.Tip="{Binding Name}" />
                                                                                <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding Strength}" IsEnabled="{Binding Enabled}" />
                                                                                <TextBlock Grid.Column="2" Text="{Binding StrengthText}" VerticalAlignment="Center" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <TextBlock Text="{l:T 'Aircraft with their own graph or strength'}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                                <ItemsControl ItemsSource="{Binding Aircraft}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:FfbTelemetryAircraftItem">
                                                                            <Grid ColumnDefinitions="180,260,*,60,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                                <ComboBox Grid.Column="1" ItemsSource="{Binding GraphOptions}" SelectedItem="{Binding Graph}" HorizontalAlignment="Stretch" />
                                                                                <Slider Grid.Column="2" Minimum="0" Maximum="200" Value="{Binding Strength}" />
                                                                                <TextBlock Grid.Column="3" Text="{Binding StrengthText}" VerticalAlignment="Center" />
                                                                                <Button Grid.Column="4" Content="{l:T 'Remove'}" Command="{Binding #RootWindow.DataContext.RemoveFfbTelemetryAircraftCommand}" CommandParameter="{Binding}" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ContentControl.ContentTemplate>
                                                </ContentControl>
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <TextBox Text="{Binding FfbTelemetryNewAircraft}" Watermark="{l:T 'Aircraft as the game names it, e.g. F-16C_50 (empty: the one flying now)'}" />
                                                    <Button Grid.Column="1" Command="{Binding AddFfbTelemetryAircraftCommand}" Content="{l:T 'Add aircraft'}" />
                                                    <TextBlock Grid.Column="2" Text="{l:T 'Flying: {0}', Arg0={Binding FfbTelemetryCurrentAircraft}}" VerticalAlignment="Center" Opacity="0.75"
                                                               IsVisible="{Binding FfbTelemetryCurrentAircraft, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </Grid>

                                                <TextBlock Text="{l:T 'Telemetry export'}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding SelectedFfbTelemetryGame.SetupStateText}" TextWrapping="Wrap" Opacity="0.85" />
                                                <WrapPanel IsVisible="{Binding FfbTelemetryGameNeedsSetup}">
                                                    <Button Command="{Binding FfbTelemetrySetupCommand}" CommandParameter="install" Content="{l:T 'Install'}" IsEnabled="{Binding CanRun}" Margin="0,0,6,6"
                                                            ToolTip.Tip="{l:T 'Adds JoyPro\'s telemetry export to the game (backed up first; other exports keep working). Close the game first.'}" />
                                                    <Button Command="{Binding FfbTelemetrySetupCommand}" CommandParameter="remove" Content="{l:T 'Remove'}" IsEnabled="{Binding CanRun}" Margin="0,0,6,6" />
                                                    <Button Command="{Binding FfbTelemetrySetupCommand}" CommandParameter="dry-run" Content="{l:T 'Dry run'}" IsEnabled="{Binding CanRun}" Margin="0,0,6,6"
                                                            ToolTip.Tip="{l:T 'Shows what Install would change without changing anything'}" />
                                                </WrapPanel>
                                                <SelectableTextBlock Text="{Binding FfbTelemetrySetupChanges}" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                                     IsVisible="{Binding FfbTelemetrySetupChanges, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                        </Border>

                                        <Expander Header="{l:T 'JoyPro.Ffb process log'}" HorizontalAlignment="Stretch">
                                            <ListBox ItemsSource="{Binding FfbTelemetryLog}" MaxHeight="220" FontFamily="Consolas,Menlo,monospace" FontSize="12" />
                                        </Expander>
                                        <TextBlock Text="{l:T 'Settings file: {0}', Arg0={Binding FfbTelemetryConfigPath}}" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                                   IsVisible="{Binding FfbTelemetryConfigPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="{l:T 'Graph editor'}">
                                <Grid ColumnDefinitions="210,*,300" ColumnSpacing="10" Margin="0,8,0,0">
                                    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="6">
                                        <TextBlock Text="{l:T 'Nodes'}" FontWeight="SemiBold" />
                                        <ListBox Grid.Row="1" ItemsSource="{Binding FfbGraphEditor.Palette}" SelectedItem="{Binding FfbGraphEditor.SelectedPaletteItem}">
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                    <Setter Property="Padding" Value="8,3" />
                                                </Style>
                                            </ListBox.Styles>
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FfbPaletteItem">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.6" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Grid.Row="2" Command="{Binding FfbGraphEditor.AddSelectedPaletteNodeCommand}" Content="{l:T 'Add to the graph'}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                        <TextBlock Grid.Row="3" TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                                                   Text="{l:T 'Round ports take one wire, square ports several (merged by the node\'s mode). Blue: numbers, green: vectors, amber: events.'}" />
                                    </Grid>

                                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
                                        <WrapPanel>
                                            <Button Command="{Binding FfbGraphEditor.NewFromBuiltInCommand}" Content="{l:T 'New from built-in'}" Margin="0,0,6,6" />
                                            <ComboBox ItemsSource="{Binding FfbGraphEditor.GraphFiles}" SelectedItem="{Binding FfbGraphEditor.SelectedGraphFile}" MinWidth="200" Margin="0,0,6,6"
                                                      PlaceholderText="{l:T 'Graph files'}" />
                                            <Button Command="{Binding FfbGraphEditor.LoadSelectedGraphCommand}" Content="{l:T 'Load'}" Margin="0,0,6,6" />
                                            <Button Command="{Binding FfbGraphEditor.RefreshGraphFilesCommand}" Content="{l:T 'Rescan'}" ToolTip.Tip="{l:T 'Read the Graphs folder again'}" Margin="0,0,14,6" />
                                            <Button Command="{Binding FfbGraphEditor.SaveCommand}" Content="{l:T 'Save'}" Margin="0,0,6,6" />
                                            <TextBox Text="{Binding FfbGraphEditor.SaveAsName}" Watermark="{l:T 'File name'}" MinWidth="160" Margin="0,0,6,6" />
                                            <Button Command="{Binding FfbGraphEditor.SaveAsCommand}" Content="{l:T 'Save as'}" Margin="0,0,14,6" />
                                            <Button Command="{Binding FfbGraphEditor.FitCommand}" Content="{l:T 'Fit'}" Margin="0,0,6,6" ToolTip.Tip="{l:T 'Zoom so the whole graph is visible'}" />
                                            <Button Command="{Binding FfbGraphEditor.DeleteSelectedCommand}" Content="{l:T 'Delete selected'}" Margin="0,0,6,6" ToolTip.Tip="{l:T 'The selected node or wire (Delete key)'}" />
                                        </WrapPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding FfbGraphEditor.DocumentTitle}" FontWeight="SemiBold" />
                                        <Border Grid.Row="2" CornerRadius="8" ClipToBounds="True" BorderBrush="#334155" BorderThickness="1" MinHeight="240">
                                            <controls:FfbGraphCanvas Editor="{Binding FfbGraphEditor}" />
                                        </Border>
                                        <TextBlock Grid.Row="3" Text="{Binding FfbGraphEditor.Message}" TextWrapping="Wrap" Opacity="0.85" />
                                    </Grid>

                                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="6" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding FfbGraphEditor.SelectedNodeHeader}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding FfbGraphEditor.Properties}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:FfbNodePropertyItem">
                                                        <StackPanel Spacing="2" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding Label}" FontSize="12" Opacity="0.8" IsVisible="{Binding !IsToggle}" />
                                                            <TextBox Text="{Binding Text}" IsVisible="{Binding IsNumber}" />
                                                            <TextBox Text="{Binding Text}" IsVisible="{Binding IsText}" />
                                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" IsVisible="{Binding IsToggle}" />
                                                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch" />
                                                            <AutoCompleteBox Text="{Binding Text}" ItemsSource="{Binding Options}" FilterMode="Contains" MinimumPrefixLength="0"
                                                                             IsVisible="{Binding IsTelemetryKey}" Watermark="{l:T 'ac.ias, ac.aoa, ...'}" />
                                                            <TextBlock Text="{Binding Error}" Foreground="#EF4444" FontSize="11" IsVisible="{Binding HasError}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Command="{Binding FfbGraphEditor.CaptureSelectedInputCommand}" IsVisible="{Binding FfbGraphEditor.CanCaptureInput}"
                                                    Content="{l:T '⏺ Press the button now...'}" HorizontalAlignment="Stretch"
                                                    ToolTip.Tip="{l:T 'Then press the button or hat on any device (stick, throttle, panel): it becomes this node\'s input.'}" />
                                            <Button Command="{Binding FfbGraphEditor.AssignTrimButtonsCommand}" IsVisible="{Binding FfbGraphEditor.CanAssignTrimButtons}"
                                                    Content="{l:T '⇕ Assign trim buttons (press each one)'}" HorizontalAlignment="Stretch"
                                                    ToolTip.Tip="{l:T 'Asks for six buttons in turn: trim to stick position, nose down, nose up, left, right, reset. Wait to skip one.'}" />
                                            <Button Command="{Binding FfbGraphEditor.CancelCaptureCommand}" IsVisible="{Binding FfbGraphEditor.Capturing}"
                                                    Content="{l:T 'Cancel waiting for a button'}" HorizontalAlignment="Stretch" />
                                            <StackPanel Spacing="6" IsVisible="{Binding FfbGraphEditor.SelectedIsCurve}">
                                                <TextBlock Text="{l:T 'Curve'}" FontWeight="SemiBold" />
                                                <controls:FfbCurveEditor Editor="{Binding FfbGraphEditor}" Height="210" />
                                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                                                           Text="{l:T 'Drag the points and their handles. Double-click adds a point; right-click a point (or select it and press Delete) removes it.'}" />
                                                <WrapPanel>
                                                    <Button Command="{Binding FfbGraphEditor.RemoveSelectedCurvePointCommand}" Content="{l:T 'Remove point'}" Margin="0,0,6,6" />
                                                    <Button Command="{Binding FfbGraphEditor.ResetCurveLinearCommand}" Content="{l:T 'Linear'}" Margin="0,0,6,6" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <Button Command="{Binding FfbGraphEditor.DeleteSelectedCommand}" Content="{l:T 'Delete node'}" IsVisible="{Binding FfbGraphEditor.HasSelectedNode}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <TabItem Header="{l:T 'Telemetry inspector'}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="6" Margin="0,8,0,0">
                                    <Grid ColumnDefinitions="320,*" ColumnSpacing="10">
                                        <TextBox Text="{Binding FfbTelemetryFieldFilter}" Watermark="{l:T 'Filter by key or title'}" />
                                        <TextBlock Grid.Column="1" Text="{Binding FfbTelemetryFieldCount}" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap" />
                                    </Grid>
                                    <Border Grid.Row="1" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="4">
                                        <Grid RowDefinitions="Auto,*">
                                            <Grid ColumnDefinitions="280,130,*,100" ColumnSpacing="10" Margin="12,4,12,4">
                                                <TextBlock Text="{l:T 'Key'}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{l:T 'Value'}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{l:T 'Title'}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="3" Text="{l:T 'Unit'}" FontWeight="SemiBold" />
                                            </Grid>
                                            <!-- A plain StackPanel: a few dozen rows whose values change in place (no item churn). -->
                                            <ListBox Grid.Row="1" ItemsSource="{Binding FfbTelemetryFields}">
                                                <ListBox.Styles>
                                                    <Style Selector="ListBoxItem">
                                                        <Setter Property="Padding" Value="8,2" />
                                                    </Style>
                                                </ListBox.Styles>
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:FfbTelemetryFieldItem">
                                                        <Grid ColumnDefinitions="280,130,*,100" ColumnSpacing="10">
                                                            <TextBlock Text="{Binding Key}" FontFamily="Consolas,Menlo,monospace" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontFamily="Consolas,Menlo,monospace" HorizontalAlignment="Right" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Title}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Unit}" Opacity="0.7" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <views:VirtualJoystickView IsVisible="{Binding IsVirtualJoystickStage}" />

                <Panel IsVisible="{Binding IsCockpitsStage}">
                    <views:CockpitsView DataContext="{Binding Cockpits}" />
                </Panel>

                <Border IsVisible="{Binding IsSettingsStage}" CornerRadius="12" Padding="10">
                    <!-- Settings (MainWindowViewModel.SettingsPage.cs): sections that open and close, in the user's order (drag a
                         section's handle or a tab), a search over every setting, open all / close all. -->
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource Icon.Cog}" Width="26" Height="26" />
                                <TextBlock Text="{l:T 'Settings'}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" MaxWidth="560" HorizontalAlignment="Stretch" Margin="12,0,0,0">
                                <TextBox Text="{Binding SettingsSearchText}" Watermark="{l:T 'Search the settings (e.g. tray, update, photos)'}" Classes="search"
                                         ToolTip.Tip="{l:T 'Shows only the sections with a matching setting, opened'}" />
                                <Button Grid.Column="1" Classes="icon iconOnly ghost" Tag="{StaticResource Icon.Close}" Command="{Binding ClearSettingsSearchCommand}"
                                        IsVisible="{Binding IsSearchingSettings}" ToolTip.Tip="{l:T 'Clear the search'}" />
                            </Grid>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SettingsSectionsSummary}" Opacity="0.65" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <Button Classes="icon small" Tag="{StaticResource Icon.ExpandAll}" Content="{l:T 'Open all'}" Command="{Binding ExpandAllSettingsCommand}" />
                                <Button Classes="icon small" Tag="{StaticResource Icon.CollapseAll}" Content="{l:T 'Close all'}" Command="{Binding CollapseAllSettingsCommand}" />
                                <Button Classes="icon small iconOnly ghost" Tag="{StaticResource Icon.Undo}" Command="{Binding ResetSettingsLayoutCommand}"
                                        ToolTip.Tip="{l:T 'JoyPro\'s order of the sections again, only Games open'}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <controls:SettingsTabStrip Sections="{Binding SettingsSections}" />
                            <TextBlock Text="{Binding SettingsSearchStatus}" Opacity="0.75" FontSize="12" IsVisible="{Binding IsSearchingSettings}" />
                        </StackPanel>
                        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <controls:SettingsSectionsPanel x:Name="SettingsSectionsHost" Sections="{Binding SettingsSections}" Spacing="8" Margin="0,0,10,0">

                            <!-- Settings > Language (MainWindowViewModel.Language.cs, docs/localization.md) -->
                            <controls:SettingsSection SectionId="language" Title="{l:T 'Language'}" Icon="{StaticResource Icon.Translate}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Text="{l:T 'Language of JoyPro'}" VerticalAlignment="Center" />
                                        <ComboBox x:Name="LanguagePicker" Grid.Column="1" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguageChoice}" MinWidth="260"
                                                  ToolTip.Tip="{l:T 'The language of the menus and texts. Windows language: the display language of Windows, or English when JoyPro does not have it.'}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LanguageChoice">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="{l:T 'Translations are made by a machine and may sound odd. Game command names stay as the game names them.'}" />
                                    <TextBlock x:Name="LanguageInUseText" Classes="caption" TextWrapping="Wrap"
                                               Text="{l:T 'JoyPro shows: {0}', Arg0={Binding LanguageInUse}}" />
                                </StackPanel>
                            </controls:SettingsSection>

                            <controls:SettingsSection SectionId="games" Title="{l:T 'Games'}" Icon="{StaticResource Icon.Gamepad}">
                                <controls:SettingsSection.HeaderContent>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding RunGameSetupAgainCommand}" Content="{l:T 'Run setup again'}" Classes="icon" Tag="{StaticResource Icon.Wand}" IsEnabled="{Binding CanRun}"
                                                ToolTip.Tip="{l:T 'The first-start setup: which games you have, linked folders (portable installs) and config locations'}" />
                                        <Button Command="{Binding RefreshGameInstallsCommand}" Content="{l:T 'Detect again'}" Classes="icon" Tag="{StaticResource Icon.Search}" IsEnabled="{Binding CanRun}" />
                                    </StackPanel>
                                </controls:SettingsSection.HeaderContent>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding GameInstallsStatus}" TextWrapping="Wrap" Opacity="0.8" />
                                    <CheckBox Content="{l:T 'Watch game configs'}" IsChecked="{Binding WatchGameConfigs}"
                                              ToolTip.Tip="{l:T 'When you change controls JoyPro manages in a game, JoyPro asks after the game has closed whether to take them into your profile'}" />
                                    <TextBlock Text="{Binding GameWatchStatus}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                               Text="{l:T 'Command lists: JoyPro comes without game data. It builds each game\'s command list on this PC from your own installation (Start page notice, or Update on the game\'s card).'}" />
                                    <CheckBox Content="{l:T 'War Thunder: read the full command list from the game\'s archives'}" IsChecked="{Binding ReadWarThunderArchives}"
                                              ToolTip.Tip="{l:T 'On (default): JoyPro unpacks gui.vromfs.bin and lang.vromfs.bin (read only) for every aircraft and helicopter action. Off: JoyPro uses only its own list of the War Thunder actions it knows. Gaijin\'s EULA restricts unpacking game files; you decide.'}" />
                                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                                        <CheckBox Content="{l:T 'Hell Let Loose: Vietnam: use the Oodle library of another installed game to read its files'}" IsChecked="{Binding HllvOodleAllowed}"
                                                  ToolTip.Tip="{l:T 'HLL Vietnam\'s files are Oodle-compressed and the game ships no Oodle library of its own. With your yes JoyPro uses the one another game on this PC ships (from where it is, never copied; it belongs to its maker and is licensed with that game; private use only). Off: JoyPro\'s own list of the gamepad keys, which is all the Xbox-pad mode needs.'}" />
                                        <Button Classes="small" Content="{l:T 'Ask again'}" Command="{Binding AskHllvOodleAgainCommand}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding HllvOodleStatus}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                               Text="{l:T 'JoyPro finds the games through Steam, their launchers and Windows\' apps list. If a game is installed somewhere else, choose its folder: that folder then counts as the installation (also for config files kept in it, e.g. IL-2 data\\input, Falcon BMS User\\Config, X-Plane preferences). Run setup again: tick the games you have (the others are hidden everywhere), link portable installs and set config locations such as Saved Games\\DCS.openbeta.'}" />
                                    <ItemsControl ItemsSource="{Binding OwnedGameInstalls}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:GameInstallItem">
                                                <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                                        <Border Width="44" Height="66" CornerRadius="5" ClipToBounds="True" Background="#1A94A3B8" VerticalAlignment="Top">
                                                            <Panel>
                                                                <controls:GameBadge GameId="{Binding GameId}" Title="{Binding Name}" />
                                                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                            </Panel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                <Border CornerRadius="8" Padding="6,1" Background="#3322C55E" IsVisible="{Binding Installed}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <PathIcon Data="{StaticResource Icon.Ok}" Width="12" Height="12" Classes="ok" />
                                                                        <TextBlock Text="{Binding Status}" FontSize="11" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border CornerRadius="8" Padding="6,1" Background="#33EF4444" IsVisible="{Binding NotInstalled}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <PathIcon Data="{StaticResource Icon.Warning}" Width="12" Height="12" Classes="warn" />
                                                                        <TextBlock Text="{Binding Status}" FontSize="11" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Where}" FontSize="12" TextWrapping="Wrap" Opacity="0.85" />
                                                            <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" Foreground="#D97706" IsVisible="{Binding HasNote}" />
                                                            <TextBlock Text="{Binding ConfigPaths}" FontSize="11" TextWrapping="Wrap" Opacity="0.6" ToolTip.Tip="{l:T 'Where the game keeps its controls'}" />
                                                        </StackPanel>
                                                        <!-- One width for the buttons, so they line up on every card. -->
                                                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" Width="160">
                                                            <StackPanel.Styles>
                                                                <Style Selector="Button">
                                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                                </Style>
                                                            </StackPanel.Styles>
                                                            <Button Content="{l:T 'Choose folder...'}" Classes="icon" Tag="{StaticResource Icon.FolderOpen}" Click="ChooseGameInstallFolderClicked" IsEnabled="{Binding #RootWindow.DataContext.CanRun}"
                                                                    ToolTip.Tip="{l:T 'This folder then counts as the game\'s installation (the game\'s folder, its launcher folder or its bin folder)'}" />
                                                            <Button Content="{l:T 'Choose .exe...'}" Classes="icon" Tag="{StaticResource Icon.FolderOpen}" Click="ChooseGameInstallExeClicked" IsEnabled="{Binding #RootWindow.DataContext.CanRun}"
                                                                    ToolTip.Tip="{l:T 'Pick the game\'s .exe or its launcher; JoyPro links the game\'s folder'}" />
                                                            <Button Content="{l:T 'Use detected'}" Classes="icon" Tag="{StaticResource Icon.Search}" Command="{Binding #RootWindow.DataContext.ClearGameInstallFolderCommand}" CommandParameter="{Binding}"
                                                                    IsVisible="{Binding Overridden}" ToolTip.Tip="{l:T 'Forget your folder and detect the game again'}" />
                                                            <Button Content="{l:T 'Hide'}" Classes="icon" Tag="{StaticResource Icon.EyeOff}" Command="{Binding #RootWindow.DataContext.ToggleGameOwnedCommand}" CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{l:T 'You do not have it or are not interested: hidden everywhere in JoyPro (cards, export, watcher, game lists); it counts as not installed. Your binds for it stay.'}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Expander IsVisible="{Binding HasHiddenGames}" Header="{Binding HiddenGamesHeader}" HorizontalAlignment="Stretch">
                                        <ItemsControl ItemsSource="{Binding HiddenGameInstalls}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:GameInstallItem">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,4">
                                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Opacity="0.75" />
                                                            <TextBlock Text="{Binding Where}" FontSize="11" TextWrapping="Wrap" Opacity="0.6" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{l:T 'Show again'}" Classes="icon" Tag="{StaticResource Icon.Eye}" Command="{Binding #RootWindow.DataContext.ToggleGameOwnedCommand}" CommandParameter="{Binding}"
                                                                IsEnabled="{Binding #RootWindow.DataContext.CanRun}" ToolTip.Tip="{l:T 'Show the game in JoyPro again (cards, export, watcher)'}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </controls:SettingsSection>

                            <!-- Settings > Binds (MainWindowViewModel live input): follow input, record options -->
                            <controls:SettingsSection SectionId="binds" Title="{l:T 'Binds'}" Icon="{StaticResource Icon.Gamepad}">
                                <StackPanel Spacing="6">
                                    <CheckBox Content="{l:T 'Follow input on the Binds and Relations pages'}" IsChecked="{Binding FollowInputOnBinds}"
                                              ToolTip.Tip="{l:T 'Press a button (or move an axis a long way) and the Binds or Relations page jumps to its relation; press it again for the next relation on it, the ones without modifiers first. Not while recording or typing in a box.'}" />
                                    <CheckBox Content="{l:T 'Show the note over the list when follow input jumps'}" IsChecked="{Binding ShowFollowInputNote}" Margin="20,0,0,0"
                                              IsEnabled="{Binding FollowInputOnBinds}"
                                              ToolTip.Tip="{l:T 'The short note at the bottom of the list (BTN 8 on WarBRD: Gear) after follow input jumped. The list still jumps when it is off.'}" />
                                    <CheckBox Content="{l:T 'Record: also take a button that rests pressed when it is released'}" IsChecked="{Binding RecordReleaseOfHeldButtons}"
                                              ToolTip.Tip="{l:T 'Record only takes a button that changes state; a button already pressed when recording starts (a 3-way switch\'s middle, a mode switch) never counts. Ticked: letting it go counts as that button.'}" />
                                </StackPanel>
                            </controls:SettingsSection>

                            <controls:SettingsSection SectionId="startup" Title="{l:T 'Startup'}" Icon="{StaticResource Icon.Play}">
                                <StackPanel Spacing="6">
                                    <CheckBox Content="{l:T 'Open the last profile at start'}" IsChecked="{Binding LoadLastProfileOnStartup}"
                                              ToolTip.Tip="{l:T 'JoyPro opens the profile you had open last, right after its window shows. Untick it to start with no profile open.'}" />
                                    <TextBlock Text="{Binding LastProfilePath}" Opacity="0.75" TextWrapping="Wrap" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="{l:T 'Every change is saved by itself, and every save is a version in the profile\'s History (top bar). Old versions are thinned out: all of the last day, then one per hour for 7 days, one per day for 60 days, one per week after that; at most 200 MB per profile and 1 GB for all. Versions you keep stay.'}" />
                                </StackPanel>
                            </controls:SettingsSection>

                            <controls:SettingsSection SectionId="tray" Title="{l:T 'Run in the background (system tray)'}" Icon="{StaticResource Icon.Monitor}">
                                <StackPanel Spacing="6">
                                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                               Text="{l:T 'JoyPro can only notice that you changed controls in a game while it is running. With these options a tiny helper keeps watching as an icon in the system tray (next to the clock, maybe behind the ^ arrow) after you closed JoyPro, and tells you when a game changed controls JoyPro manages. The helper is not the full JoyPro: it uses no noticeable CPU and only a few MB of memory.'}" />
                                    <CheckBox Content="{l:T 'Start with Windows (in the tray)'}" IsChecked="{Binding StartWithWindows}"
                                              ToolTip.Tip="{l:T 'The tray helper starts by itself when you sign in to Windows; JoyPro\'s window does not open. No administrator rights are needed; untick to remove it from Windows\' startup again.'}" />
                                    <TextBlock Text="{Binding AutostartStatus}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                                    <CheckBox Content="{l:T 'Close to tray'}" IsChecked="{Binding CloseToTray}"
                                              ToolTip.Tip="{l:T 'Closing JoyPro (X) leaves the tray helper watching your games. Untick it and closing JoyPro ends the watching too.'}" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                                               Text="{l:T 'Tray icon: click it to open JoyPro (or to review a game\'s changes); right-click it for \'Watching game configs\' on/off and \'Exit\'. While JoyPro is open it watches the games itself and the helper waits.'}" />
                                </StackPanel>
                            </controls:SettingsSection>

                            <controls:SettingsSection SectionId="confirmations" Title="{l:T 'Confirmations'}" Icon="{StaticResource Icon.Shield}">
                                <!-- Settings > Confirmations: one switch per question JoyPro asks before it changes something (MainWindowViewModel.Confirm.cs). -->
                                <StackPanel x:Name="ConfirmationSettings" Spacing="6">
                                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                               Text="{l:T 'JoyPro asks before it changes something that is hard to take back: an export that removes binds, restoring a backup, starting over from a game, removing a device, merging profiles. The questions you can switch off are listed here.'}" />
                                    <!-- Questions switched off with "Do not ask again" (MainWindowViewModel.Confirmations.cs) -->
                                    <controls:ConfirmationSettingsPanel />
                                </StackPanel>
                            </controls:SettingsSection>

                            <controls:SettingsSection SectionId="about" Title="{l:T 'About JoyPro and updates'}" Icon="{StaticResource Icon.Info}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Viewbox Width="44" Height="44" VerticalAlignment="Top">
                                            <Image Source="{StaticResource Brand.Logo}" />
                                        </Viewbox>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding AppVersionText}" FontSize="18" FontWeight="SemiBold" />
                                            <SelectableTextBlock Text="{Binding AppBuildText}" Opacity="0.8" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding AppLicenseText}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                                        <Button Command="{Binding OpenProjectPageCommand}" Content="{l:T 'Project page'}" Classes="icon" Tag="{StaticResource Icon.Link}"
                                                ToolTip.Tip="{l:T 'JoyPro on GitHub: the source, the releases, problem reports'}" />
                                        <Button Command="{Binding OpenReleasePageCommand}" Content="{l:T 'Release page'}" Classes="icon" Tag="{StaticResource Icon.History}"
                                                ToolTip.Tip="{l:T 'Every release with what changed'}" />
                                    </WrapPanel>
                                    <Expander Header="{l:T 'Third-party notices'}" HorizontalAlignment="Stretch">
                                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                            <SelectableTextBlock Text="{Binding ThirdPartyNoticesText}" TextWrapping="Wrap" FontSize="12" Opacity="0.85" />
                                        </ScrollViewer>
                                    </Expander>
                                    <TextBlock Text="{l:T 'Updates'}" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Opacity="0.85" />
                                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                                        <Button Command="{Binding CheckForUpdatesCommand}" Content="{l:T 'Check for updates'}" Classes="icon" Tag="{StaticResource Icon.Search}"
                                                ToolTip.Tip="{l:T 'Asks GitHub for the latest release of JoyPro; a newer one is offered with what changed'}" />
                                        <Button Command="{Binding InstallUpdateCommand}" Content="{l:T 'Install update'}" Classes="icon accent" Tag="{StaticResource Icon.Import}" IsEnabled="{Binding UpdateAvailable}"
                                                ToolTip.Tip="{l:T 'Downloads the new version, checks it, installs it and starts JoyPro again'}" />
                                        <CheckBox Content="{l:T 'Check for updates at start'}" IsChecked="{Binding CheckUpdatesOnStartup}"
                                                  ToolTip.Tip="{l:T 'At every start JoyPro asks GitHub once whether there is a newer version and asks you before it updates'}" />
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSkippedUpdate}">
                                        <TextBlock Text="{Binding SkippedUpdateText}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" VerticalAlignment="Center" />
                                        <Button Classes="small" Content="{l:T 'Offer it again'}" Command="{Binding ClearSkippedUpdateCommand}" />
                                    </StackPanel>
                                    <Expander Header="{l:T 'Where updates come from (for experts)'}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="6" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding UpdateSourceText}" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <TextBlock Text="{l:T 'GitHub repository'}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding UpdateRepository}" Watermark="{l:T 'Holdi601/JoystickProfiler2 (empty: JoyPro\'s own)'}"
                                                         ToolTip.Tip="{l:T 'owner/repository on GitHub whose releases JoyPro installs. Only change it if you know the releases there are JoyPro\'s.'}" />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </controls:SettingsSection>

                            <!-- Settings > Privacy: makers' photos per device (DevicePhotoConsent), game covers -->
                            <controls:SettingsSection SectionId="privacy" Title="{l:T 'Privacy'}" Icon="{StaticResource Icon.Eye}">
                                <StackPanel Spacing="6">
                                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                               Text="{l:T 'No account, no telemetry. JoyPro goes online only for update checks (GitHub), the makers\' product photos of your devices (the maker\'s site, only after you said yes), game covers missing on this PC (Steam\'s store, the game publisher\'s site), the optional AI model download (GitHub, Hugging Face), optional drivers and a missing .NET Framework (Microsoft). These sites see your IP address. Details: docs/privacy.md.'}" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Text="{l:T 'Makers\' product photos'}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding PhotoConsentModes}" SelectedItem="{Binding PhotoConsentMode}" MinWidth="220"
                                                  ToolTip.Tip="{l:T 'When JoyPro recognizes a device and knows the address of its product photo on the maker\'s site, it asks before it downloads it (Layout page, Start page). Always: download without asking. Never: only JoyPro\'s drawings.'}" />
                                    </Grid>
                                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                                        <TextBlock Text="{Binding PhotoConsentSummary}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" />
                                        <Button Classes="small" Content="{l:T 'Ask again for every device'}" Command="{Binding ForgetPhotoAnswersCommand}"
                                                ToolTip.Tip="{l:T 'Forget the yes / no you gave per device; JoyPro asks again before it shows a maker\'s photo'}" />
                                    </WrapPanel>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Text="{l:T 'Pictures from JoyPro\'s releases (cockpits, 3D device views)'}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding CockpitPictureDownloadModes}" SelectedItem="{Binding CockpitPictureDownloadMode}" MinWidth="220"
                                                  ToolTip.Tip="{l:T 'When you open an aircraft on the Cockpits page that has no pictures from your games, or connect a device with a 3D view, JoyPro looks whether its releases have a pack for it (GitHub) and asks before it downloads it. Always: download without asking. Never: JoyPro does not look; the buttons on the Cockpits page still work and the Layout page shows the flat drawing.'}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{Binding Converter={x:Static l:TConverter.Instance}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12"
                                               Text="{l:T 'The cockpit picture packs and the 3D device views come from JoyPro\'s releases on GitHub (pictures JoyPro rendered from the games and from 3D models of the devices); GitHub sees your IP address. Kept with your game data and device pictures.'}" />
                                    <CheckBox Content="{l:T 'Game covers from the internet'}" IsChecked="{Binding GameCoverDownloads}"
                                              ToolTip.Tip="{l:T 'Covers of games Steam has no picture of on this PC are downloaded once from Steam\'s store or the publisher\'s site (engine media sources). Off: JoyPro\'s badges and the pictures already on this PC. Takes effect at the next start.'}" />
                                </StackPanel>
                            </controls:SettingsSection>

                            <!-- Settings > Telemetry recording (docs/telemetry-recording.md): opt-in, Tacview-like recording of every game's telemetry -->
                            <controls:SettingsSection SectionId="telemetry-recording" Title="{l:T 'Telemetry recording'}" Icon="{StaticResource Icon.Record}">
                                <controls:TelemetryRecordingPanel />
                            </controls:SettingsSection>

                            <!-- Settings > Drawings: how JoyPro's own drawings of the devices are painted (DrawingStyleOptions) -->
                            <controls:SettingsSection SectionId="drawings" Title="{l:T 'Drawings'}" Icon="{StaticResource Icon.Joystick}">
                                <StackPanel Spacing="6">
                                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                               Text="{l:T 'JoyPro\'s own drawings of your devices on the Layout page and the device cards: lines or cel-shaded, in JoyPro\'s colours or your own.'}" />
                                    <controls:DrawingStyleEditor DataContext="{Binding ScreenDrawing}" />
                                    <TextBlock Text="{l:T 'Cheat sheets and exports'}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <controls:DrawingStyleEditor DataContext="{Binding ExportDrawing}" />
                                </StackPanel>
                            </controls:SettingsSection>

                            <controls:SettingsSection SectionId="report" Title="{l:T 'Report a problem'}" Icon="{StaticResource Icon.Bug}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{l:T '1. Write below what happened.  2. Press \'Create Report\': JoyPro saves one zip with your text, versions, your device list, the logs of the last 3 days and crash reports, and shows it in Explorer.  3. Attach the zip to a GitHub issue (\'Open GitHub Issue Page\') or send it to the developer. Nothing is sent by itself; your user name, e-mail addresses and passwords are removed from the files, and you can open the zip first to look.'}" TextWrapping="Wrap" Opacity="0.85" />
                                    <TextBlock Text="{l:T 'What happened?'}" />
                                    <TextBox Text="{Binding ProblemDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Watermark="{l:T 'What did you do, what did you expect, what happened instead?'}" />
                                    <WrapPanel>
                                        <CheckBox Content="{l:T 'Attach my profile'}" IsChecked="{Binding ProblemIncludeProfile}" Margin="0,0,10,0" />
                                        <Button Command="{Binding CreateProblemReportCommand}" Content="{l:T 'Create Report'}" Classes="icon accent" Tag="{StaticResource Icon.Send}" Margin="0,0,8,0" />
                                        <Button Command="{Binding ShowProblemReportCommand}" Content="{l:T 'Show Report'}" IsEnabled="{Binding HasProblemReport}" Margin="0,0,8,0" />
                                        <Button Command="{Binding OpenProblemIssuePageCommand}" Content="{l:T 'Open GitHub Issue Page'}" IsEnabled="{Binding HasProblemReport}" />
                                    </WrapPanel>
                                    <WrapPanel>
                                        <Button Command="{Binding CreateSupportFileCommand}" Content="{l:T 'Create support file'}" Classes="icon" Tag="{StaticResource Icon.Bug}" Margin="0,0,8,0"
                                                ToolTip.Tip="{l:T 'One zip with the logs of the last 3 days, the environment of your games (install, folders, drives, devices) and JoyPro\'s copies of the small config files it read or wrote. Shows what is in it first; nothing is sent.'}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ProblemReportStatus}" TextWrapping="Wrap" />
                                    <WrapPanel>
                                        <TextBlock Text="{l:T 'Keep background logs for'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <NumericUpDown Value="{Binding LogRetentionDays}" Minimum="1" Maximum="365" Increment="1" FormatString="0" Width="130" Margin="0,0,8,0" />
                                        <TextBlock Text="{l:T 'days'}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Button Command="{Binding OpenLogFolderCommand}" Content="{l:T 'Open Log Folder'}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding LogFolderText}" Opacity="0.75" TextWrapping="Wrap" />
                                </StackPanel>
                            </controls:SettingsSection>

                            <controls:SettingsSection SectionId="components" Title="{l:T 'Components'}" Icon="{StaticResource Icon.Shield}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{l:T 'Needed by JoyPro'}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RequirementsStatus}" TextWrapping="Wrap" Opacity="0.85" />
                                    <ItemsControl ItemsSource="{Binding RequirementItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel>
                                        <Button Command="{Binding CheckRequirementsCommand}" Content="{l:T 'Check Again'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding InstallMissingRequirementsCommand}" Content="{l:T 'Install Missing'}" IsEnabled="{Binding HasInstallableRequirements}" />
                                    </WrapPanel>

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                        <TextBlock Text="{l:T 'Optional: only for the features named on each card'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Command="{Binding RefreshComponentsCommand}" Content="{l:T 'Check again'}" Classes="icon" Tag="{StaticResource Icon.Refresh}"
                                                ToolTip.Tip="{l:T 'Looks at what is installed and running (read-only)'}" />
                                    </Grid>
                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                               Text="{l:T 'These free programs are not part of JoyPro. JoyPro downloads one only when you tick &quot;I have read...&quot; and press Install: always the official installer of its project, checked (checksum and digital signature) before it runs. Windows asks once for administrator rights; drivers may need a restart.'}" />
                                    <TextBlock Text="{Binding ComponentsSummary}" TextWrapping="Wrap" Opacity="0.85" />
                                    <ItemsControl ItemsSource="{Binding Components}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ComponentItem">
                                                <controls:ComponentCard />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{l:T 'Local AI model (llama.cpp + a language model)'}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.85"
                                                           Text="{l:T 'Optional help for &quot;Group by description&quot; with unusual wording. It has its own download with size, license and checksum on the Relations page; JoyPro works fully without it.'}" />
                                                <TextBlock Text="{Binding LlmStatusText}" TextWrapping="Wrap" FontSize="12" Opacity="0.7"
                                                           IsVisible="{Binding LlmStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding OpenLlmSetupCommand}" Content="{l:T 'Set up'}" Classes="icon" Tag="{StaticResource Icon.ArrowRight}" VerticalAlignment="Center"
                                                    ToolTip.Tip="{l:T 'Opens the local AI model section (Relations page, Group by description)'}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                               Text="{l:T 'Force feedback (FFB) needs no extra component: JoyPro talks to your force feedback device directly.'}" />
                                </StackPanel>
                            </controls:SettingsSection>

                            <controls:SettingsSection SectionId="devices" Title="{l:T 'Devices'}" Icon="{StaticResource Icon.Joystick}">
                                <controls:SettingsSection.HeaderContent>
                                    <Button Command="{Binding LoadDeviceCardsCommand}" Content="{l:T 'Look again'}" Classes="icon" Tag="{StaticResource Icon.Refresh}" IsEnabled="{Binding CanRun}"
                                            ToolTip.Tip="{l:T 'Your connected sticks, throttles and pedals, and the devices your profile uses'}" />
                                </controls:SettingsSection.HeaderContent>
                                <StackPanel Spacing="6">
                                    <!-- Device names: the aliases given on the Layout page or the devices' real names -->
                                    <StackPanel x:Name="DeviceNamesSetting" Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{l:T 'Device names:'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <RadioButton Content="{l:T 'show the alias'}" IsChecked="{Binding ShowDeviceAliases}"
                                                     ToolTip.Tip="{l:T 'Devices you named on the Layout page are shown by that name (the real name is in the tooltip)'}" />
                                        <RadioButton Content="{l:T 'show the device\'s real name'}" IsChecked="{Binding ShowDeviceRealNames}"
                                                     ToolTip.Tip="{l:T 'Every device is shown by the name Windows gives it'}" />
                                    </StackPanel>
                                    <TextBlock Classes="hint" Text="{l:T 'Bought a new device, or Windows gave a device a new name? Move its binds to the new device. A device you sold: remove it from the profile. JoyPro asks first and keeps a copy of your profile.'}" />
                                    <TextBlock Classes="hint" Text="{l:T 'Press Look again to see your devices.'}" IsVisible="{Binding !HasDeviceCards}" />
                                    <ItemsControl ItemsSource="{Binding DeviceCards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DeviceCardItem">
                                                <Border Classes="tile" Width="350" Margin="0,0,8,8">
                                                    <Grid ColumnDefinitions="112,*" ColumnSpacing="10">
                                                        <Button Classes="deviceCard" Padding="0" Width="112" Height="112" VerticalAlignment="Top" ToolTip.Tip="{Binding Tooltip}"
                                                                Command="{Binding #RootWindow.DataContext.OpenDeviceCardInLayoutCommand}" CommandParameter="{Binding}">
                                                            <Border Width="112" Height="112" CornerRadius="6" Background="{DynamicResource JP.SurfaceAltBrush}"
                                                                    BorderBrush="{DynamicResource JP.BorderBrush}" BorderThickness="1" ClipToBounds="True">
                                                                <Panel>
                                                                    <PathIcon Data="{StaticResource Icon.Joystick}" Width="36" Height="36" Opacity="0.45" IsVisible="{Binding HasNoPicture}" />
                                                                    <controls:DeviceThumbnail Picture="{Binding Picture}" Schematic="{Binding Schematic}" Margin="6" />
                                                                </Panel>
                                                            </Border>
                                                        </Button>
                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip.Tip="{Binding Tooltip}" />
                                                            <TextBlock Text="{Binding DeviceName}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" IsVisible="{Binding ShowsDeviceName}" />
                                                            <Border Classes="chip device" HorizontalAlignment="Left" IsVisible="{Binding HasKindLabel}"><TextBlock Text="{Binding KindLabel}" /></Border>
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <PathIcon Data="{StaticResource Icon.Ok}" Width="13" Height="13" Classes="ok" IsVisible="{Binding Connected}" />
                                                                <PathIcon Data="{StaticResource Icon.Warning}" Width="13" Height="13" Classes="warn" IsVisible="{Binding NotConnected}" />
                                                                <TextBlock Text="{Binding InputsText}" FontSize="11" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <PathIcon Data="{StaticResource Icon.Link}" Width="13" Height="13" Classes="info" IsVisible="{Binding InProfile}" />
                                                                <TextBlock Text="{Binding ProfileText}" FontSize="11" Opacity="0.85" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <CheckBox IsVisible="{Binding IsKeyboardLike}" IsChecked="{Binding UsesAxes}" FontSize="12"
                                                                      Content="{l:T 'Use its axes for follow input and recording'}"
                                                                      Command="{Binding #RootWindow.DataContext.ToggleDeviceAxesInputCommand}" CommandParameter="{Binding}"
                                                                      ToolTip.Tip="{l:T 'An analog keyboard reports its keys as axes too: typing moves them. JoyPro leaves its axes out of follow input and axis recording unless this is ticked. Its keys and buttons always count.'}" />
                                                            <WrapPanel IsVisible="{Binding InProfile}">
                                                                <Button Content="{l:T 'Replace...'}" Classes="icon" Tag="{StaticResource Icon.Swap}" Padding="8,3" FontSize="12" Margin="0,2,4,0"
                                                                        Command="{Binding #RootWindow.DataContext.OpenReplaceDeviceCommand}" CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{l:T 'Give this device\'s binds to another device, input by input, with a preview'}" />
                                                                <Button Content="{l:T 'Remove'}" Classes="icon" Tag="{StaticResource Icon.Delete}" Padding="8,3" FontSize="12" Margin="0,2,4,0"
                                                                        Command="{Binding #RootWindow.DataContext.RemoveDeviceCardCommand}" CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{l:T 'Remove this device\'s binds from your profile (asks first)'}" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasOtherDevices}"
                                               Text="{l:T 'Also connected (keyboards, mice and other devices JoyPro does not use): {0}', Arg0={Binding OtherDevicesText}}" />
                                    <Border Classes="card">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{l:T 'Replace a device'}" FontWeight="SemiBold" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Classes="hint" TextWrapping="Wrap" VerticalAlignment="Center"
                                                           Text="{l:T 'A new stick, or your profile from an old PC: move every bind and modifier of a device to another one, input by input, with a preview (same product: same inputs; another device: trigger to trigger, hat to hat). Devices that only got a new ID move by themselves when the profile opens.'}" />
                                                <Button Grid.Column="1" Command="{Binding OpenReplaceDeviceCommand}" Content="{l:T 'Replace device...'}" Classes="icon accent" Tag="{StaticResource Icon.Swap}" IsEnabled="{Binding CanRun}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Expander Header="{l:T 'Device lists and names (for experts)'}" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="6" Margin="0,6,0,0">
                                    <WrapPanel>
                                        <Button Command="{Binding RefreshDevicesCommand}" Content="{l:T 'List Devices'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding RefreshDeviceInputCatalogCommand}" Content="{l:T 'Input Catalog'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding ShowDeviceDetailsCommand}" Content="{l:T 'Device Details'}" Margin="0,0,8,0" ToolTip.Tip="{l:T 'Connected devices with VID:PID, HID name and their DirectInput axes, buttons and hats (in the output panel)'}" />
                                    </WrapPanel>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                        <TextBlock Text="{l:T 'Exchange Old'}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding ExchangeOldDevice}" />
                                        <TextBlock Grid.Column="2" Text="{l:T 'Exchange New'}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3" Text="{Binding ExchangeNewDevice}" />
                                    </Grid>
                                    <WrapPanel>
                                        <Button Command="{Binding ExchangeDeviceCommand}" Content="{l:T 'Exchange Device'}" Margin="0,0,8,0" />
                                        <TextBox Text="{Binding DeviceRemoveName}" Width="320" Watermark="{l:T 'Device to remove from profile'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding RemoveDeviceFromProfileCommand}" Content="{l:T 'Remove Device Refs'}" />
                                    </WrapPanel>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="{l:T 'Connected Devices'}" FontWeight="SemiBold" />
                                            <ListBox ItemsSource="{Binding ConnectedDevices}" MinHeight="110" MaxHeight="170" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{l:T 'Profile Devices'}" FontWeight="SemiBold" />
                                            <ListBox ItemsSource="{Binding ProfileDevices}" MinHeight="110" MaxHeight="170" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'Input Catalog'}" FontWeight="SemiBold" />
                                        <ListBox ItemsSource="{Binding DeviceInputsCatalog}" MinHeight="90" MaxHeight="170" />
                                    </StackPanel>
                                    </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </controls:SettingsSection>

                            <controls:SettingsSection SectionId="db-expert" Title="{l:T 'Command lists (DB) and game paths: information for experts'}" Icon="{StaticResource Icon.Database}">
                                <StackPanel Spacing="6">
                                    <StackPanel Spacing="6">
                                    <TextBlock Classes="hint" Text="{l:T 'What JoyPro knows about each game. To read a game\'s new commands after a game update, use Update on the game\'s card (Start page).'}" />
                                    <WrapPanel>
                                        <Button Command="{Binding RefreshDbSummaryCommand}" Content="{l:T 'DB Summary'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding RefreshDbCheckCommand}" Content="{l:T 'DB Check'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding RefreshDbListCommand}" Content="{l:T 'DB List'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding RefreshDbGamesCommand}" Content="{l:T 'DB Games'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding RefreshDbPlanesCommand}" Content="{l:T 'DB Planes'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding RefreshDbFingerprintCommand}" Content="{l:T 'DB Fingerprint'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding RefreshGamePathsCommand}" Content="{l:T 'Game Paths'}" />
                                        <Button Command="{Binding RefreshGamesListCommand}" Content="{l:T 'Games List'}" Margin="8,0,8,0" />
                                        <Button Command="{Binding DetectGamesCommand}" Content="{l:T 'Games Detect'}" />
                                    </WrapPanel>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                        <TextBlock Text="{l:T 'Game Filter'}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding DbGameFilter}" />
                                        <TextBlock Grid.Column="2" Text="{l:T 'Plane Filter'}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3" Text="{Binding DbPlaneFilter}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,260" ColumnSpacing="8">
                                        <TextBlock Text="{l:T 'Planes Game'}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedDbGame}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="{l:T 'DB Games'}" FontWeight="SemiBold" />
                                            <ListBox ItemsSource="{Binding DbGames}" MinHeight="110" MaxHeight="170" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{l:T 'DB Planes'}" FontWeight="SemiBold" />
                                            <ListBox ItemsSource="{Binding DbPlanes}" MinHeight="110" MaxHeight="170" />
                                        </StackPanel>
                                    </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </controls:SettingsSection>

                            <controls:SettingsSection SectionId="dcs-defaults" Title="{l:T 'DCS: default binds'}" Icon="{StaticResource Icon.Airplane}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                               Text="{l:T 'DCS puts its own default binds on every device. JoyPro\'s DCS export removes them from every device it writes, in every aircraft, built from your own DCS installation. The two options below change the DCS installation itself, for all devices (also those JoyPro does not write). Both are off unless you switch them on.'}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{l:T 'Saved Games'}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding DcsSavedGamesPath}" />
                                        <TextBlock Grid.Column="2" Text="{l:T 'Install'}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3" Text="{Binding DcsInstallPath}" />
                                        <Button Grid.Column="4" Command="{Binding AutoDetectSettingsPathsCommand}" Content="{l:T 'Find the folders'}" Classes="icon" Tag="{StaticResource Icon.Search}" />
                                    </Grid>
                                    <CheckBox Content="{l:T 'Strip DCS default binds in the DCS install'}" IsChecked="{Binding DcsStripDefaults}" IsEnabled="{Binding CanRunDcs}"
                                              ToolTip.Tip="{l:T 'Every joystick input file of DCS gets its default binds switched off (combos = nil); each original is kept as &lt;file&gt;.nocombo.bak. Works together with the DCS_STRIP_JOYSTICK_DEFAULTS script.'}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="24,0,0,0">
                                        <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" Classes="warn" VerticalAlignment="Top" />
                                        <TextBlock Text="{l:T 'Changes DCS\'s own files. Multiplayer servers that check file integrity (pure scripts / IC) do not let you in while it is on; Restore puts DCS\'s files back. A DCS update or repair brings the original files back, JoyPro then switches it on again at its next start and before each DCS list update.'}" TextWrapping="Wrap" FontSize="12" Foreground="#D97706" MaxWidth="900" />
                                    </StackPanel>
                                    <CheckBox Content="{l:T 'Keep the UI layer\'s default binds (menus, VR)'}" IsChecked="{Binding DcsStripSkipUiLayer}" Margin="24,0,0,0" IsEnabled="{Binding CanRunDcs}"
                                              ToolTip.Tip="{l:T 'Leaves the UI layer (Config > Input > UiLayer) as DCS ships it (same as --skip-ui-layer of the strip script)'}" />
                                    <CheckBox Content="{l:T 'Remove DCS\'s device-specific default files from the install'}" IsChecked="{Binding DcsRemoveDeviceFiles}" IsEnabled="{Binding CanRunDcs}"
                                              ToolTip.Tip="{l:T 'Files such as &quot;Joystick - HOTAS Warthog.lua&quot; move into JoyPro\'s backup folder, so DCS uses default.lua for every device (what JoyPro 1 did). Files another DCS file uses stay, and so do the UI layer\'s VR controller files.'}" />
                                    <TextBlock Text="{Binding DcsDefaultsStatus}" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                                    <TextBlock Text="{Binding DcsDefaultsAttention}" TextWrapping="Wrap" FontSize="12" Foreground="#D97706" IsVisible="{Binding HasDcsDefaultsAttention}" />
                                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                                        <Button Command="{Binding PreviewDcsStripDefaultsCommand}" Content="{l:T 'Preview files'}" Classes="icon" Tag="{StaticResource Icon.Eye}" IsEnabled="{Binding CanRunDcs}"
                                                ToolTip.Tip="{l:T 'Lists the DCS files the strip option changes; nothing is written'}" />
                                        <Button Command="{Binding PreviewDcsDeviceFilesCommand}" Content="{l:T 'Preview device files'}" Classes="icon" Tag="{StaticResource Icon.Eye}" IsEnabled="{Binding CanRunDcs}" />
                                        <Button Command="{Binding ApplyDcsInstallDefaultsNowCommand}" Content="{l:T 'Apply now'}" Classes="icon" Tag="{StaticResource Icon.Refresh}" IsEnabled="{Binding CanRunDcs}"
                                                ToolTip.Tip="{l:T 'Does again what is switched on, e.g. right after a DCS update'}" />
                                        <Button Command="{Binding RestoreDcsInstallDefaultsCommand}" Content="{l:T 'Restore DCS files'}" Classes="icon" Tag="{StaticResource Icon.Undo}" IsEnabled="{Binding CanRunDcs}" />
                                        <Button Command="{Binding RefreshDcsDefaultsStatusCommand}" Content="{l:T 'Check again'}" Classes="icon" Tag="{StaticResource Icon.Search}" IsEnabled="{Binding CanRunDcs}" />
                                    </WrapPanel>
                                    <Border IsVisible="{Binding HasDcsDefaultsPreview}" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="6">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding DcsDefaultsPreviewTitle}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" />
                                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding DcsDefaultsPreviewFiles}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                    <Expander Header="{l:T 'Folders and older JoyPro backups (for experts)'}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                                <TextBlock Text="{l:T 'Saved Games'}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding DcsSavedGamesPath}" />
                                                <TextBlock Grid.Column="2" Text="{l:T 'Install'}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="3" Text="{Binding DcsInstallPath}" />
                                            </Grid>
                                            <WrapPanel ItemSpacing="8">
                                                <Button Command="{Binding AutoDetectSettingsPathsCommand}" Content="{l:T 'Find the folders'}" Classes="icon" Tag="{StaticResource Icon.Search}" />
                                                <Button Command="{Binding DcsDefaultsRestoreCommand}" Content="{l:T 'Put back files an older JoyPro moved'}" Classes="icon" Tag="{StaticResource Icon.Undo}" IsEnabled="{Binding CanRunDcs}"
                                                        ToolTip.Tip="{l:T 'From Saved Games > DCS > BACKUP_JOYSTICK_DEFAULTS (engine dcs defaults restore)'}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </controls:SettingsSection>

                            <controls:SettingsSection SectionId="command-lists" Title="{l:T 'Command lists of DCS, Star Citizen and IL-2 (for experts)'}" Icon="{StaticResource Icon.Database}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="hint" Text="{l:T 'Normally: Start page, the game\'s card, Update. Here: only some DCS aircraft, a test run without writing, and the old click mode.'}" />
                                    <TextBlock Text="{l:T 'Select DCS aircraft to refresh'}" FontWeight="SemiBold" />
                                    <WrapPanel>
                                        <CheckBox Content="{l:T 'All'}" IsChecked="{Binding DcsRefreshSelectAllPlanes}" Margin="0,0,12,0" />
                                        <CheckBox Content="{l:T 'None'}" IsChecked="{Binding DcsRefreshSelectNonePlanes}" />
                                    </WrapPanel>
                                    <Border BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="6">
                                        <ScrollViewer Height="120" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding DcsRefreshPlaneOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SelectableTagItem">
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2,8,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <WrapPanel>
                                        <CheckBox Content="{l:T 'Headless (recommended: DCS stays closed, uses DCS\'s own Lua export)'}" IsChecked="{Binding DcsRefreshHeadlessLua}" Margin="0,0,10,0" />
                                        <CheckBox Content="{l:T 'Dry Run'}" IsChecked="{Binding DcsRefreshDryRun}" Margin="0,0,10,0" />
                                    </WrapPanel>
                                    <StackPanel Spacing="6" IsVisible="{Binding !DcsRefreshHeadlessLua}">
                                        <TextBlock Text="{l:T 'Legacy click mode: starts DCS and clicks through the controls menu.'}" Opacity="0.75" TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                            <TextBlock Text="{l:T 'Clicks XML'}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding DcsClicksXmlPath}" />
                                            <TextBlock Grid.Column="2" Text="{l:T 'Clicks Dir'}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="3" Text="{Binding DcsClicksDirPath}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                            <TextBlock Text="{l:T 'Preview Image'}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding DcsPreviewImagePath}" />
                                            <TextBlock Grid.Column="2" Text="{l:T 'DCS EXE'}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="3" Text="{Binding DcsExePath}" />
                                        </Grid>
                                        <WrapPanel>
                                            <CheckBox Content="OCR" IsChecked="{Binding DcsRefreshUseOcr}" Margin="0,0,10,0" />
                                            <CheckBox Content="{l:T 'Launch'}" IsChecked="{Binding DcsRefreshLaunch}" Margin="0,0,10,0" />
                                            <CheckBox Content="{l:T 'Keep Running'}" IsChecked="{Binding DcsRefreshKeepRunning}" Margin="0,0,10,0" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <WrapPanel>
                                        <Button Command="{Binding DcsRefreshIdCommand}" Content="{l:T 'Refresh ID DB'}" Margin="0,0,8,0" IsEnabled="{Binding CanRunDcs}" />
                                        <Button Command="{Binding DcsRefreshCleanCommand}" Content="{l:T 'Refresh Clean DB'}" Margin="0,0,8,0" IsEnabled="{Binding CanRunDcs}" />
                                        <Button Command="{Binding DcsPreviewClicksCommand}" Content="{l:T 'Preview Clicks'}" IsVisible="{Binding !DcsRefreshHeadlessLua}" />
                                    </WrapPanel>
                                    <TextBlock Text="{l:T 'Star Citizen DB'}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <TextBlock Text="{l:T 'Rebuilds the Star Citizen action list from the installed game (Data.p4k): actions, option groups, the joystick option tree and the game\'s default joystick binds (clean mode switches those off).'}" Opacity="0.75" TextWrapping="Wrap" />
                                    <WrapPanel>
                                        <TextBlock Text="{l:T 'Branch'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding StarCitizenRefreshBranch}" Watermark="{l:T 'LIVE, PTU, ... (empty: first found)'}" Width="200" Margin="0,0,10,0" />
                                        <CheckBox Content="{l:T 'Dry Run'}" IsChecked="{Binding StarCitizenRefreshDryRun}" Margin="0,0,10,0" />
                                        <Button Command="{Binding RefreshStarCitizenDbCommand}" Content="{l:T 'Refresh Star Citizen DB'}" IsEnabled="{Binding CanRun}" />
                                    </WrapPanel>
                                    <TextBlock Text="{l:T 'IL-2 Great Battles DB'}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <TextBlock Text="Adds the actions of the installed game's key mapping files (data\input\*.actions, or the IL-2 export path when set) that JoyPro's IL-2 list lacks. Known actions keep their titles; the list is written only when something is new." Opacity="0.75" TextWrapping="Wrap" />
                                    <WrapPanel>
                                        <CheckBox Content="{l:T 'Dry Run'}" IsChecked="{Binding Il2RefreshDryRun}" Margin="0,0,10,0" />
                                        <Button Command="{Binding RefreshIl2DbCommand}" Content="{l:T 'Refresh IL-2 DB'}" IsEnabled="{Binding CanRun}" />
                                    </WrapPanel>
                                </StackPanel>
                            </controls:SettingsSection>

                            <controls:SettingsSection SectionId="ffb-games" Title="{l:T 'Force feedback settings of the games'}" Icon="{StaticResource Icon.Vibrate}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{l:T 'Every force feedback setting a game offers. JoyPro stores them in the profile and writes them into the game on export; settings you do not store stay as the game has them.'}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{l:T 'Game'}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding FfbGames}"
                                                  SelectedItem="{Binding SelectedFfbGame}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:FfbGameItem">
                                                    <TextBlock Text="{Binding Title}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="2" Command="{Binding RefreshFfbSettingsCommand}" Content="{l:T 'Reload'}" />
                                    </Grid>
                                    <TextBlock Text="{Binding FfbGameDescription}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding FfbNeedsDevice}">
                                        <TextBlock Text="{l:T 'Device'}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding FfbDeviceOptions}"
                                                  SelectedItem="{Binding SelectedFfbDevice}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:FfbPickerOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding FfbHasPlanes}">
                                        <TextBlock Text="{l:T 'Aircraft'}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding FfbPlaneOptions}"
                                                  SelectedItem="{Binding SelectedFfbPlane}"
                                                  HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="{l:T 'All aircraft: the device\'s settings for every aircraft. An aircraft\'s own values win over them.'}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:FfbPickerOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="{Binding FfbStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding FfbEditors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:FfbParameterEditor">
                                                <StackPanel Spacing="2" Margin="0,0,0,4">
                                                    <Grid ColumnDefinitions="230,*,80,260,64" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip.Tip="{Binding ToolTipText}" />
                                                        <Slider Grid.Column="1"
                                                                IsVisible="{Binding IsNumber}"
                                                                Minimum="{Binding Minimum}"
                                                                Maximum="{Binding Maximum}"
                                                                SmallChange="{Binding Step}"
                                                                LargeChange="{Binding Step}"
                                                                TickFrequency="{Binding Step}"
                                                                IsSnapToTickEnabled="True"
                                                                Value="{Binding Value}"
                                                                ToolTip.Tip="{Binding ToolTipText}" />
                                                        <TextBox Grid.Column="2"
                                                                 IsVisible="{Binding IsNumber}"
                                                                 Text="{Binding Text}"
                                                                 VerticalAlignment="Center"
                                                                 ToolTip.Tip="{Binding RangeText}" />
                                                        <CheckBox Grid.Column="1"
                                                                  IsVisible="{Binding IsToggle}"
                                                                  Content="{l:T 'On'}"
                                                                  IsChecked="{Binding IsOn}"
                                                                  ToolTip.Tip="{Binding ToolTipText}" />
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SourceText}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" MaxWidth="200" />
                                                            <TextBlock Text="{l:T 'changed'}" FontSize="11" Foreground="#F59E0B" IsVisible="{Binding HasEdit}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="4"
                                                                Content="{l:T 'Unset'}"
                                                                Padding="8,2"
                                                                IsVisible="{Binding IsStored}"
                                                                Command="{Binding #RootWindow.DataContext.UnsetFfbParameterCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="{l:T 'Stop storing this setting: the game keeps its own value again.'}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding ValidationMessage}"
                                                               Foreground="#F59E0B"
                                                               FontSize="11"
                                                               IsVisible="{Binding HasValidationMessage}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel>
                                        <Button Command="{Binding ApplyFfbSettingsCommand}"
                                                Content="{l:T 'Apply'}"
                                                IsEnabled="{Binding CanApplyFfb}"
                                                ToolTip.Tip="{l:T 'Store the changed settings in the profile (ffb set).'}"
                                                Margin="0,0,8,0" />
                                        <Button Command="{Binding RevertFfbEditsCommand}"
                                                Content="{l:T 'Revert'}"
                                                IsEnabled="{Binding FfbHasEdits}"
                                                Margin="0,0,8,0" />
                                        <Button Command="{Binding ClearFfbSettingsCommand}"
                                                Content="{l:T 'Clear'}"
                                                IsEnabled="{Binding CanClearFfb}"
                                                ToolTip.Tip="{l:T 'Remove every stored setting shown here (ffb clear); the game keeps its own values.'}"
                                                Margin="0,0,8,0" />
                                    </WrapPanel>
                                    <TextBlock Text="{l:T 'Changed, not applied yet.'}"
                                               Foreground="#F59E0B"
                                               FontSize="11"
                                               IsVisible="{Binding FfbHasEdits}" />
                                    <TextBlock Text="{l:T 'DCS: invert and swap fall back to the per-device values of the DCS Force Feedback table below when no setting here stores them.'}"
                                               FontSize="11"
                                               Opacity="0.8"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding FfbHasPlanes}" />
                                </StackPanel>
                            </controls:SettingsSection>

                            <controls:SettingsSection SectionId="dcs-ffb" Title="{l:T 'DCS force feedback: swap and invert per device'}" Icon="{StaticResource Icon.Vibrate}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="hint" Text="{l:T 'If your force feedback stick pushes the wrong way in DCS: tick Swap Axis or Invert for it, then Apply. Clear gives the device DCS\'s defaults back.'}" />
                                    <Grid ColumnDefinitions="Auto,280,Auto,Auto,Auto,*" ColumnSpacing="8">
                                        <TextBlock Text="{l:T 'Filter'}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding DcsFfbFilterText}" Watermark="{l:T 'Filter by device name...'}" />
                                        <CheckBox Grid.Column="2" Content="{l:T 'Connected only'}" IsChecked="{Binding DcsFfbShowConnectedOnly}" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="3" Content="{l:T 'Profile only'}" IsChecked="{Binding DcsFfbShowProfileOnly}" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="4" Content="{l:T 'Auto-apply toggle changes'}" IsChecked="{Binding DcsFfbAutoApplyOnToggle}" VerticalAlignment="Center" />
                                    </Grid>
                                    <WrapPanel>
                                        <Button Command="{Binding DcsFfbListCommand}" Content="{l:T 'Refresh Devices'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding SelectAllDcsFfbDevicesCommand}" Content="{l:T 'Select All'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding ClearDcsFfbDeviceSelectionCommand}" Content="{l:T 'Select None'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding SelectConnectedDcsFfbDevicesCommand}" Content="{l:T 'Select Connected'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding SelectProfileDcsFfbDevicesCommand}" Content="{l:T 'Select Profile'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding DcsFfbApplySelectedCommand}" Content="{l:T 'Apply Selected'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding DcsFfbClearSelectedCommand}" Content="{l:T 'Clear Selected'}" Margin="0,0,8,0" />
                                        <Button Command="{Binding DcsFfbClearAllCommand}" Content="{l:T 'Clear All'}" />
                                    </WrapPanel>
                                    <Border BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="6">
                                        <DataGrid ItemsSource="{Binding VisibleDcsFfbDeviceSettings}"
                                                  AutoGenerateColumns="False"
                                                  CanUserResizeColumns="True"
                                                  CanUserSortColumns="True"
                                                  GridLinesVisibility="Horizontal"
                                                  MinHeight="220"
                                                  MaxHeight="320">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="{l:T 'Sel'}" Binding="{Binding IsSelected}" Width="58" />
                                                <DataGridTextColumn Header="{l:T 'Device'}" Binding="{Binding Device}" Width="*" />
                                                <DataGridCheckBoxColumn Header="{l:T 'Swap Axis'}" Binding="{Binding SwapAxis}" Width="86" />
                                                <DataGridCheckBoxColumn Header="{l:T 'Invert X'}" Binding="{Binding InvertX}" Width="80" />
                                                <DataGridCheckBoxColumn Header="{l:T 'Invert Y'}" Binding="{Binding InvertY}" Width="80" />
                                                <DataGridCheckBoxColumn Header="{l:T 'Configured'}" Binding="{Binding HasSetting}" Width="92" IsReadOnly="True" />
                                                <DataGridCheckBoxColumn Header="{l:T 'Connected'}" Binding="{Binding Connected}" Width="86" IsReadOnly="True" />
                                                <DataGridCheckBoxColumn Header="{l:T 'Profile'}" Binding="{Binding Profile}" Width="74" IsReadOnly="True" />
                                                <DataGridTemplateColumn Header="{l:T 'Apply'}" Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="models:DcsFfbDeviceSettingItem">
                                                            <Button Command="{Binding #RootWindow.DataContext.DcsFfbApplyDeviceCommand}" CommandParameter="{Binding}" Content="{l:T 'Apply'}" Padding="10,2" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="{l:T 'Clear'}" Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="models:DcsFfbDeviceSettingItem">
                                                            <Button Command="{Binding #RootWindow.DataContext.DcsFfbClearDeviceCommand}" CommandParameter="{Binding}" Content="{l:T 'Clear'}" Padding="10,2" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                    <Expander Header="{l:T 'Manual single-device (advanced)'}" IsExpanded="False">
                                        <StackPanel Margin="0,6,0,0" Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <TextBlock Text="{l:T 'Device'}" VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DcsKnownDevices}" Text="{Binding DcsFfbDevice}" IsEditable="True" />
                                            </Grid>
                                            <WrapPanel>
                                                <CheckBox Content="{l:T 'Invert X'}" IsChecked="{Binding DcsFfbInvertX}" Margin="0,0,10,0" />
                                                <CheckBox Content="{l:T 'Invert Y'}" IsChecked="{Binding DcsFfbInvertY}" Margin="0,0,10,0" />
                                                <CheckBox Content="{l:T 'Swap Axis'}" IsChecked="{Binding DcsFfbSwapAxis}" Margin="0,0,10,0" />
                                            </WrapPanel>
                                            <WrapPanel>
                                                <Button Command="{Binding DcsFfbSetCommand}" Content="{l:T 'Set FFB'}" Margin="0,0,8,0" />
                                                <Button Command="{Binding DcsFfbClearCommand}" Content="{l:T 'Clear FFB'}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </controls:SettingsSection>
                        </controls:SettingsSectionsPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border IsVisible="{Binding IsAdvancedStage}" CornerRadius="12" Padding="10">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource Icon.Console}" Width="26" Height="26" />
                            <TextBlock Text="{l:T 'Advanced Console'}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="hint" Text="{l:T 'For experts: type any engine command yourself (the commands of engine/docs/ENGINE_CLI_WIKI.md). Everything a normal user needs has its own button on the other pages. Example: relations edit or binds edit'}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Text="{l:T 'Editor Command'}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding GlobalEditorCommand}" Watermark="{l:T 'Optional --editor command (use {file})'}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{l:T 'Output File'}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding GlobalOutputPath}" Watermark="{l:T 'Optional --out file path (custom commands only)'}" />
                            <CheckBox Grid.Column="2" Content="{l:T 'Text output'}" IsChecked="{Binding UseTextOutput}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Text="{l:T 'Global Args'}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding CustomCommandExtraGlobal}" Watermark="{l:T 'Optional global args'}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Text="{l:T 'Command'}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding CustomCommandText}" Watermark="{l:T 'dcs import --path C:\\Saved Games\\DCS --plane A-10C_2'}" />
                        </Grid>
                        <WrapPanel>
                            <CheckBox Content="{l:T 'Include --profile'}" IsChecked="{Binding CustomCommandIncludeProfile}" Margin="0,0,10,0" />
                            <Button Command="{Binding RunCustomCommandCommand}" Content="{l:T 'Run'}" Margin="0,0,8,0" />
                            <Button Command="{Binding RelationsEditCommand}" Content="{l:T 'Relations Edit'}" Margin="0,0,8,0" />
                            <Button Command="{Binding BindsEditCommand}" Content="{l:T 'Binds Edit'}" Margin="0,0,8,0" />
                            <Button Command="{Binding RunEngineSummaryCommand}" Content="{l:T 'Engine Summary'}" Margin="0,0,8,0" />
                            <Button Command="{Binding RunProfileSummaryCommand}" Content="{l:T 'Profile Summary'}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Game config watcher: what a game changed after it closed (engine sync diff), shown over every page. -->
                <Border IsVisible="{Binding HasGameSyncChanges}" ZIndex="100" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="1000" MaxHeight="660" Margin="24" Padding="14" CornerRadius="12" BorderBrush="#3B82F6" BorderThickness="2"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BoxShadow="0 8 32 0 #80000000">
                    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
                        <TextBlock Text="{Binding GameSyncTitle}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" TextWrapping="Wrap" Opacity="0.85"
                                   Text="{l:T 'Take these changes into your profile? Untick what you do not want. Where several relations use the button, pick the one the change belongs to, or a new relation.'}" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding GameSyncChanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:GameSyncChangeItem">
                                        <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,280" ColumnSpacing="10">
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#3B82F6" />
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="4" IsEnabled="{Binding IsSelected}">
                                                    <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" HorizontalAlignment="Stretch"
                                                              ToolTip.Tip="{l:T 'The relation this change belongs to'}" />
                                                    <TextBox Text="{Binding NewRelationName}" IsVisible="{Binding IsNewRelation}" Watermark="{l:T 'Name of the new relation'}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Grid.Row="3" Text="{Binding GameSyncStatus}" TextWrapping="Wrap" Foreground="#EF4444" IsVisible="{Binding GameSyncStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <WrapPanel Grid.Row="4">
                            <Button Command="{Binding TakeOverGameChangesCommand}" Content="{l:T 'Take over'}" Classes="accent" Margin="0,0,8,0" IsEnabled="{Binding CanRun}"
                                    ToolTip.Tip="{l:T 'The ticked changes go into the chosen relations'}" />
                            <Button Command="{Binding PostponeGameChangesCommand}" Content="{l:T 'Not now'}" Margin="0,0,8,0"
                                    ToolTip.Tip="{l:T 'Keep the changes for later; JoyPro asks again'}" />
                            <Button Command="{Binding IgnoreGameChangesCommand}" Content="{l:T 'Ignore these'}" IsEnabled="{Binding CanRun}"
                                    ToolTip.Tip="{l:T 'The profile stays as it is; the next export writes it over the game\'s changes'}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Updates (MainWindowViewModel.Updates.cs, docs/updates.md): a newer version with what changed and Update now /
                     Later / Skip this version; the download, the check and a failure; or what a manual check found. -->
                <Border IsVisible="{Binding UpdatePromptVisible}" ZIndex="109" Background="#99000000" />
                <Border x:Name="UpdatePrompt" IsVisible="{Binding UpdatePromptVisible}" ZIndex="110" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="640" MaxHeight="600" Margin="24" Padding="18" CornerRadius="14" BorderBrush="{DynamicResource JP.AccentBrush}" BorderThickness="2"
                        Background="{DynamicResource JP.SurfaceBrush}" BoxShadow="0 8 32 0 #80000000">
                    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Panel Width="34" Height="34" VerticalAlignment="Top">
                                <PathIcon Data="{StaticResource Icon.Import}" Width="30" Height="30" Classes="info" IsVisible="{Binding UpdatePromptIsNews}" />
                                <PathIcon Data="{StaticResource Icon.Ok}" Width="30" Height="30" Classes="ok" IsVisible="{Binding UpdatePromptIsOk}" />
                                <PathIcon Data="{StaticResource Icon.Warning}" Width="30" Height="30" Classes="warn" IsVisible="{Binding UpdatePromptIsWarn}" />
                                <PathIcon Data="{StaticResource Icon.Error}" Width="30" Height="30" Classes="error" IsVisible="{Binding UpdatePromptIsError}" />
                                <PathIcon Data="{StaticResource Icon.Info}" Width="30" Height="30" Classes="info"
                                          IsVisible="{Binding UpdatePromptIsInfoKind}" />
                            </Panel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{Binding UpdatePromptTitle}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding UpdatePromptMessage}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{l:T 'What\'s new'}" FontWeight="SemiBold" IsVisible="{Binding HasUpdatePromptNotes}" Margin="46,0,0,0" />
                        <Border Grid.Row="2" Classes="sunken" Padding="10" Margin="46,0,0,0" IsVisible="{Binding HasUpdatePromptNotes}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                <SelectableTextBlock Text="{Binding UpdatePromptNotes}" TextWrapping="Wrap" FontSize="13" />
                            </ScrollViewer>
                        </Border>
                        <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding UpdatePromptProgress}" Height="6" Margin="46,0,0,0"
                                     IsVisible="{Binding UpdatePromptShowsProgress}" IsIndeterminate="{Binding UpdatePromptProgressUnknown}" />
                        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="6">
                            <Button Content="{l:T 'Release page'}" Command="{Binding OpenReleasePageCommand}" IsVisible="{Binding UpdatePromptCanOpenPage}"
                                    ToolTip.Tip="{l:T 'The release on GitHub (download it yourself from there)'}" />
                            <Button Content="{l:T 'Skip this version'}" Command="{Binding SkipUpdateVersionCommand}" IsVisible="{Binding UpdatePromptOffersUpdate}"
                                    ToolTip.Tip="{l:T 'JoyPro does not offer this version at start again (Check for updates still shows it)'}" />
                            <Button Content="{l:T 'Later'}" Command="{Binding UpdateLaterCommand}" IsVisible="{Binding UpdatePromptOffersUpdate}"
                                    ToolTip.Tip="{l:T 'Ask again at the next start'}" />
                            <Button Content="{l:T 'Update now'}" Classes="icon accent" Tag="{StaticResource Icon.Import}" Command="{Binding UpdateNowCommand}" IsVisible="{Binding UpdatePromptOffersUpdate}"
                                    ToolTip.Tip="{l:T 'Download, check, install and start JoyPro again (your profiles and settings stay)'}" />
                            <Button Content="{l:T 'OK'}" Classes="accent" Command="{Binding CloseUpdatePromptCommand}" IsVisible="{Binding UpdatePromptIsInfo}" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="BasedOnAlignment"
                      IsVisible="{Binding EngineOutputExpanded}"
                      ShowsPreview="True" />

        <Border x:Name="EngineOutputBorder" Grid.Row="3" Background="#0F172A" CornerRadius="12" Padding="10">
            <Grid x:Name="EngineOutputHostGrid" ColumnDefinitions="*">
                <Expander x:Name="EngineOutputExpander"
                          Grid.Column="0"
                          Header="{l:T 'Engine Output'}"
                          HorizontalAlignment="Stretch"
                          IsExpanded="{Binding EngineOutputExpanded, Mode=TwoWay}"
                          Expanded="EngineOutputExpanderExpanded"
                          Collapsed="EngineOutputExpanderCollapsed">
                    <TextBox x:Name="EngineOutputTextBox"
                             Margin="0,8,0,0"
                             Height="180"
                             MinHeight="90"
                             MaxHeight="320"
                             Text="{Binding OutputText}"
                             IsReadOnly="True"
                             Focusable="False"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             FontFamily="Consolas"
                             Background="#020617"
                             Foreground="#E2E8F0"
                             BorderBrush="#38BDF8"
                             CaretBrush="#E2E8F0"
                             SelectionBrush="#1D4ED8"
                             SelectionForegroundBrush="#F8FAFC" />
                </Expander>
            </Grid>
        </Border>

        <!-- Bottom bar: the status line on its own row (never covered), the page buttons below it; they wrap on small windows. -->
        <Border Grid.Row="4" CornerRadius="12" Padding="8,4">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                    <!-- A longer command on any page but Start (which has the large busy area): bar, step, count, time,
                         Cancel. Its own row above the status line, so neither covers the other. -->
                    <Grid x:Name="CompactBusyRow" ColumnDefinitions="160,*,Auto,Auto,Auto" ColumnSpacing="10" MinHeight="24"
                          DataContext="{Binding BusyProgress}" IsVisible="{Binding ShowCompact}">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding !IsDeterminate}" Height="6"
                                     MinWidth="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Text="{Binding StepText}" ToolTip.Tip="{Binding Title}" />
                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="mono" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding TimeText}" Classes="caption" VerticalAlignment="Center" />
                        <Button Grid.Column="4" Classes="small" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"
                                IsVisible="{Binding ShowCancel}" IsEnabled="{Binding CanCancel}" VerticalAlignment="Center"
                                ToolTip.Tip="{l:T 'Stops the command before it writes anything (JoyPro offers this only while it reads)'}" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center" MinHeight="22">
                        <ToolTip.Tip>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{l:T 'Last exit code:'}" FontWeight="Bold" />
                                <TextBlock Text="{Binding LastExitCode}" />
                                <TextBlock Text="{l:T 'Duration:'}" FontWeight="Bold" />
                                <TextBlock Text="{Binding LastRunDuration}" />
                            </StackPanel>
                        </ToolTip.Tip>
                        <PathIcon Data="{StaticResource Icon.Info}" Width="18" Height="18" Classes="info" IsVisible="{Binding !IsBusy}" />
                        <PathIcon Data="{StaticResource Icon.Sync}" Width="18" Height="18" Classes="warn" IsVisible="{Binding IsBusy}" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <!-- JoyPro's version (an update on offer is named too): opens Settings > About JoyPro and updates. -->
                        <Button x:Name="VersionCorner" Grid.Column="2" Classes="ghost small" Padding="8,1" MinHeight="0" Command="{Binding OpenAboutCommand}"
                                ToolTip.Tip="{Binding VersionCornerTip}" Classes.accent="{Binding AvailableUpdateVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding VersionCornerText}" FontSize="11" Opacity="0.75" Classes="mono" />
                        </Button>
                    </Grid>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Center" ItemSpacing="6" LineSpacing="4">
                    <ToggleButton Command="{Binding GoStartCommand}" Classes="nav" Tag="{StaticResource Icon.Home}" Content="{l:T 'Start'}" ToolTip.Tip="{l:T 'Your games: import, export, update, undo'}" IsChecked="{Binding IsStartStage}" />
                    <ToggleButton Command="{Binding GoRelationsCommand}" Classes="nav" Tag="{StaticResource Icon.Link}" Content="{l:T 'Relations'}" ToolTip.Tip="{l:T 'Which game commands belong together (one button for the same thing in every game and aircraft)'}" IsChecked="{Binding IsRelationsStage}" />
                    <ToggleButton Command="{Binding GoBindsCommand}" Classes="nav" Tag="{StaticResource Icon.Gamepad}" Content="{l:T 'Binds'}" ToolTip.Tip="{l:T 'Which button or axis of your devices does what; axis curves'}" IsChecked="{Binding IsBindsStage}" />
                    <ToggleButton Command="{Binding GoModifiersCommand}" Classes="nav" Tag="{StaticResource Icon.Keycap}" Content="{l:T 'Modifiers'}" ToolTip.Tip="{l:T 'Shift buttons: a button held down gives the other buttons a second job'}" IsChecked="{Binding IsModifiersStage}" />
                    <ToggleButton Command="{Binding GoLayoutCommand}" Classes="nav" Tag="{StaticResource Icon.Image}" Content="{l:T 'Layout'}" ToolTip.Tip="{l:T 'Pictures of your devices with what every button does'}" IsChecked="{Binding IsLayoutStage}" />
                    <ToggleButton Command="{Binding GoExportCommand}" Classes="nav" Tag="{StaticResource Icon.Export}" Content="{l:T 'Export'}" ToolTip.Tip="{l:T 'Write your binds into the games; backups and undo'}" IsChecked="{Binding IsExportStage}" />
                    <ToggleButton Command="{Binding GoHudCommand}" Classes="nav" Tag="{StaticResource Icon.Monitor}" Content="HUD" IsChecked="{Binding IsHudStage}" ToolTip.Tip="{l:T 'HUD designer: your sticks, throttles and pedals live on screen or for streaming'}" />
                    <ToggleButton Command="{Binding GoFfbTelemetryCommand}" Classes="nav" Tag="{StaticResource Icon.Vibrate}" Content="{l:T 'Force Feedback'}" IsChecked="{Binding IsFfbTelemetryStage}" ToolTip.Tip="{l:T 'Force feedback from the game\'s telemetry: settings, graph editor, telemetry inspector'}" />
                    <ToggleButton Command="{Binding GoVirtualJoystickCommand}" Classes="nav" Tag="{StaticResource Icon.Joystick}" Content="{l:T 'Virtual Joystick'}" IsChecked="{Binding IsVirtualJoystickStage}" ToolTip.Tip="{l:T 'Virtual joystick (vJoy + HidHide): per game one virtual device instead of your real ones'}" />
                    <ToggleButton Command="{Binding GoCockpitsCommand}" Classes="nav" Tag="{StaticResource Icon.Airplane}" Content="{l:T 'Cockpits'}" IsChecked="{Binding IsCockpitsStage}" ToolTip.Tip="{l:T 'Cockpit reference: stick and throttle of real and fictional aircraft per version, with JoyPro\'s drawings, the panels and sources'}" />
                    <ToggleButton Command="{Binding GoSettingsCommand}" Classes="nav" Tag="{StaticResource Icon.Cog}" Content="{l:T 'Settings'}" ToolTip.Tip="{l:T 'Games and their folders, devices, command lists, force feedback, updates, report a problem'}" IsChecked="{Binding IsSettingsStage}" />
                    <ToggleButton Command="{Binding GoAdvancedCommand}" Classes="nav" Tag="{StaticResource Icon.Console}" Content="{l:T 'Advanced'}" ToolTip.Tip="{l:T 'For experts: type engine commands yourself'}" IsChecked="{Binding IsAdvancedStage}" />
                    <Button Command="{Binding ValidateProfileCommand}" Classes="nav" Tag="{StaticResource Icon.Ok}" Content="{l:T 'Check'}" ToolTip.Tip="{l:T 'Check the profile for problems (results on the Export page)'}" />
                    <ToggleButton x:Name="EngineOutputQuickToggle" Classes="nav" Tag="{StaticResource Icon.Console}" Content="{l:T 'Output'}" ToolTip.Tip="{l:T 'What JoyPro\'s engine printed (details of the last action)'}" IsChecked="{Binding EngineOutputExpanded}" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
