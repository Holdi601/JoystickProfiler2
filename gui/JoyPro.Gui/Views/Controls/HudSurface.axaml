<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:JoyPro.Gui.Localization"
             xmlns:models="using:JoyPro.Gui.Models"
             xmlns:controls="using:JoyPro.Gui.Views.Controls"
             x:Class="JoyPro.Gui.Views.Controls.HudSurface"
             x:Name="Surface"
             x:DataType="controls:HudSurface"
             FontFamily="{DynamicResource JP.UiFont}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="HudAccent" Color="#38BDF8" />
        <SolidColorBrush x:Key="HudAccentSoft" Color="#4038BDF8" />
        <SolidColorBrush x:Key="HudCardBackground" Color="#B00B1220" />
        <SolidColorBrush x:Key="HudCardBorder" Color="#5538BDF8" />
        <SolidColorBrush x:Key="HudTrack" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="HudText" Color="#F1F5F9" />
        <SolidColorBrush x:Key="HudTextDim" Color="#94A3B8" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource HudCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HudCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="TextBlock.caps">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource HudTextDim}" />
            <Setter Property="LetterSpacing" Value="1.5" />
        </Style>
        <Style Selector="Border.btn">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.btn.pressed">
            <Setter Property="Background" Value="{DynamicResource HudAccent}" />
            <Setter Property="BorderBrush" Value="#CCFFFFFF" />
        </Style>
        <Style Selector="Border.marker">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource HudAccentSoft}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.35" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.marker.pressed">
            <Setter Property="Background" Value="{DynamicResource HudAccent}" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Ellipse.hatdot">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Fill" Value="#4DFFFFFF" />
        </Style>
        <Style Selector="Ellipse.hatdot.active">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource HudAccent}" />
        </Style>
        <Style Selector="ItemsControl.markers > ContentPresenter" x:DataType="models:HudMarker">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
        <Style Selector="ItemsControl.hatdots > ContentPresenter" x:DataType="models:HudHatDot">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
        <Style Selector="ItemsControl.widgets > ContentPresenter" x:DataType="models:HudWidget">
            <Setter Property="controls:HudPanel.Left" Value="{Binding X}" />
            <Setter Property="controls:HudPanel.Top" Value="{Binding Y}" />
            <Setter Property="IsVisible" Value="{Binding Visible}" />
        </Style>
        <Style Selector="Rectangle.outline">
            <Setter Property="Stroke" Value="#80FFFFFF" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeDashArray" Value="4,3" />
        </Style>
        <Style Selector="Rectangle.outline.selected">
            <Setter Property="Stroke" Value="{DynamicResource HudAccent}" />
            <Setter Property="StrokeThickness" Value="2.5" />
        </Style>
        <Style Selector="Border.line">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <ItemsControl x:Name="WidgetItems" Classes="widgets" ItemsSource="{Binding #Surface.Widgets}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <controls:HudPanel Fixed="{Binding #Surface.Fixed}" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:HudWidget">
                <Grid Background="Transparent" Cursor="{Binding #Surface.DragCursor}"
                      PointerPressed="WidgetPointerPressed" PointerMoved="WidgetPointerMoved" PointerReleased="WidgetPointerReleased">
                    <LayoutTransformControl>
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                        </LayoutTransformControl.LayoutTransform>
                        <Panel Opacity="{Binding Theme.Opacity}">

                            <!-- Device -->
                            <Border Classes="card" IsVisible="{Binding IsDevice}" BoxShadow="{Binding Theme.CardShadow}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowName}">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource HudAccent}" BoxShadow="{Binding Theme.Glow}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Device.ShortTitle}" Foreground="{DynamicResource HudText}" FontSize="14" FontWeight="SemiBold" LetterSpacing="0.6" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Device.DeviceKind}" Classes="caps" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <!-- Picture: tilts with the stick; button positions glow on a layout picture. -->
                                        <Panel IsVisible="{Binding PictureVisible}" Width="{Binding Device.PictureWidth}" Height="230">
                                            <Panel RenderTransformOrigin="50%,88%">
                                                <Panel.RenderTransform>
                                                    <Rotate3DTransform AngleX="{Binding Device.Pitch}" AngleY="{Binding Device.Twist}" AngleZ="{Binding Device.Roll}" Depth="700" />
                                                </Panel.RenderTransform>
                                                <Image Source="{Binding Device.Picture}" Stretch="Uniform" />
                                                <ItemsControl Classes="markers" ItemsSource="{Binding Device.Markers}" IsVisible="{Binding MarkersVisible}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:HudMarker">
                                                            <Border Classes="marker" Classes.pressed="{Binding IsPressed}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Panel>
                                        </Panel>

                                        <StackPanel Spacing="12" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <!-- Gimbal: stick position as a dot, twist as the tick on the ring. -->
                                                <Grid Width="84" Height="84" IsVisible="{Binding GimbalVisible}">
                                                    <Ellipse Stroke="{DynamicResource HudAccentSoft}" StrokeThickness="2" Fill="#14FFFFFF" />
                                                    <Ellipse Width="30" Height="30" Stroke="#26FFFFFF" StrokeThickness="1" />
                                                    <Line StartPoint="42,8" EndPoint="42,76" Stroke="#1FFFFFFF" StrokeThickness="1" />
                                                    <Line StartPoint="8,42" EndPoint="76,42" Stroke="#1FFFFFFF" StrokeThickness="1" />
                                                    <Border Width="4" Height="11" CornerRadius="2" Background="{DynamicResource HudAccent}" VerticalAlignment="Top" HorizontalAlignment="Center"
                                                            IsVisible="{Binding Device.HasTwist}" RenderTransformOrigin="50%,381%">
                                                        <Border.RenderTransform>
                                                            <RotateTransform Angle="{Binding Device.TwistTick}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                    <Border Width="14" Height="14" CornerRadius="7" Background="{DynamicResource HudAccent}" BorderBrush="White" BorderThickness="2" BoxShadow="{Binding Theme.Glow}">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform X="{Binding Device.GimbalX}" Y="{Binding Device.GimbalY}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>

                                                <!-- Levers: throttles, collective, brakes. -->
                                                <ItemsControl ItemsSource="{Binding Device.Levers}" IsVisible="{Binding LeversVisible}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="10" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:HudAxis">
                                                            <StackPanel Spacing="4">
                                                                <Border Width="20" Height="92" CornerRadius="10" Background="{DynamicResource HudTrack}" HorizontalAlignment="Center" ClipToBounds="True">
                                                                    <Border VerticalAlignment="Bottom" Height="{Binding LeverFill}" CornerRadius="10" Background="{DynamicResource HudAccent}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Label}" Classes="caps" HorizontalAlignment="Center" MaxWidth="64" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Percent}" FontSize="10" Foreground="{DynamicResource HudText}" HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Hats: 8 directions around a centre. -->
                                                <ItemsControl ItemsSource="{Binding Device.Hats}" IsVisible="{Binding HatsVisible}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel MaxWidth="80" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:HudHat">
                                                            <Grid Width="32" Height="32" Margin="0,0,6,6">
                                                                <Ellipse Stroke="#26FFFFFF" StrokeThickness="1" />
                                                                <ItemsControl Classes="hatdots" ItemsSource="{Binding Dots}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Canvas />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:HudHatDot">
                                                                            <Ellipse Classes="hatdot" Classes.active="{Binding IsActive}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Ellipse Width="6" Height="6" Fill="#66FFFFFF" IsVisible="{Binding IsCentered}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Axis bars. -->
                                            <ItemsControl ItemsSource="{Binding Device.Bars}" IsVisible="{Binding AxesVisible}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:HudAxis">
                                                        <Grid ColumnDefinitions="84,112,34" ColumnSpacing="6" Height="15">
                                                            <TextBlock Text="{Binding Label}" Classes="caps" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <Canvas Grid.Column="1" Width="112" Height="6" VerticalAlignment="Center">
                                                                <Border Width="112" Height="6" CornerRadius="3" Background="{DynamicResource HudTrack}" />
                                                                <Border Canvas.Left="{Binding FillLeft}" Width="{Binding FillWidth}" Height="6" CornerRadius="3" Background="{DynamicResource HudAccent}" />
                                                                <Border Canvas.Left="55" Width="2" Height="6" Background="#80FFFFFF" IsVisible="{Binding Bipolar}" />
                                                            </Canvas>
                                                            <TextBlock Grid.Column="2" Text="{Binding Percent}" FontSize="10" Foreground="{DynamicResource HudText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Button grid (when the picture does not show the buttons). -->
                                            <ItemsControl ItemsSource="{Binding Device.ButtonCells}" IsVisible="{Binding ButtonGridVisible}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel MaxWidth="260" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:HudButton">
                                                        <Border Classes="btn" Classes.pressed="{Binding IsPressed}">
                                                            <TextBlock Text="{Binding Number}" FontSize="9" Foreground="{DynamicResource HudText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Held buttons by name. -->
                                    <ItemsControl ItemsSource="{Binding Device.PressedChips}" IsVisible="{Binding ShowButtons}" MaxWidth="520">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border CornerRadius="11" Padding="10,3" Margin="0,0,6,6" Background="{DynamicResource HudAccentSoft}" BorderBrush="{DynamicResource HudAccent}" BorderThickness="1">
                                                    <TextBlock Text="{Binding}" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Binds ticker: what the pressed button does. -->
                            <StackPanel Spacing="6" MinWidth="300" IsVisible="{Binding IsBinds}">
                                <Border Classes="card" Padding="12,8">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="#Surface.Designer" />
                                            <Binding Path="Theme.HasNoLines" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'Gear Toggle'}" Foreground="{DynamicResource HudText}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{l:T 'Landing Gear Lever - UP/DOWN (example)'}" Foreground="{DynamicResource HudTextDim}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Theme.Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:OverlayLine">
                                            <Border Classes="card line" Padding="0" Margin="0,0,0,6" Opacity="{Binding Opacity}" HorizontalAlignment="{Binding Align}">
                                                <Grid ColumnDefinitions="4,*">
                                                    <Border Background="{DynamicResource HudAccent}" CornerRadius="16,0,0,16" />
                                                    <StackPanel Grid.Column="1" Margin="12,6,16,7">
                                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource HudText}" FontSize="{Binding FontSize}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource HudTextDim}" FontSize="{Binding DetailFontSize}" IsVisible="{Binding HasDetail}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Header: game / aircraft. -->
                            <Border Classes="card" Padding="8,6,16,6" IsVisible="{Binding IsHeader}" BoxShadow="{Binding Theme.CardShadow}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="36" Height="36" CornerRadius="8" ClipToBounds="True" Background="#1AFFFFFF">
                                        <Image Source="{Binding Theme.HeaderPicture}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="JOYPRO" Classes="caps" />
                                        <TextBlock Text="{Binding Theme.HeaderText}" Foreground="{DynamicResource HudText}" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Panel>
                    </LayoutTransformControl>
                    <Rectangle Classes="outline" Classes.selected="{Binding IsSelected}" IsVisible="{Binding #Surface.Designer}" Margin="-4" RadiusX="18" RadiusY="18" IsHitTestVisible="False" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
