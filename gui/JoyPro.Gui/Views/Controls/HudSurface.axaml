<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:JoyPro.Gui.Localization"
             xmlns:models="using:JoyPro.Gui.Models"
             xmlns:controls="using:JoyPro.Gui.Views.Controls"
             x:Class="JoyPro.Gui.Views.Controls.HudSurface"
             x:Name="Surface"
             x:DataType="controls:HudSurface"
             FontFamily="{DynamicResource JP.UiFont}">
    <!-- Every widget's design comes from its HudWidgetHost (HudLook.ApplyTo: the widget's own style or the HUD's); these
         are only the defaults until the host has its widget. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="HudAccent" Color="#38BDF8" />
        <SolidColorBrush x:Key="HudAccentSoft" Color="#6638BDF8" />
        <SolidColorBrush x:Key="HudPressed" Color="#38BDF8" />
        <SolidColorBrush x:Key="HudChipBackground" Color="#4038BDF8" />
        <SolidColorBrush x:Key="HudCardBackground" Color="#B00B1220" />
        <SolidColorBrush x:Key="HudCardBorder" Color="#5538BDF8" />
        <SolidColorBrush x:Key="HudTrack" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="HudText" Color="#F1F5F9" />
        <SolidColorBrush x:Key="HudTextDim" Color="#94A3B8" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.hudcard">
            <Setter Property="Background" Value="{DynamicResource HudCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HudCardBorder}" />
            <Setter Property="BorderThickness" Value="{DynamicResource HudCardBorderThickness}" />
            <Setter Property="CornerRadius" Value="{DynamicResource HudCardRadius}" />
            <Setter Property="BoxShadow" Value="{DynamicResource HudCardShadow}" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource HudFont}" />
        </Style>
        <Style Selector="TextBlock.caps">
            <Setter Property="FontSize" Value="{DynamicResource HudSmallSize}" />
            <Setter Property="Foreground" Value="{DynamicResource HudTextDim}" />
            <Setter Property="LetterSpacing" Value="1.5" />
        </Style>
        <Style Selector="TextBlock.hudtitle">
            <Setter Property="FontSize" Value="{DynamicResource HudTitleSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource HudTitleWeight}" />
            <Setter Property="Foreground" Value="{DynamicResource HudText}" />
            <Setter Property="LetterSpacing" Value="{DynamicResource HudLetterSpacing}" />
        </Style>
        <Style Selector="TextBlock.hudvalue">
            <Setter Property="FontSize" Value="{DynamicResource HudTinySize}" />
            <Setter Property="Foreground" Value="{DynamicResource HudText}" />
        </Style>
        <Style Selector="Border.btn">
            <Setter Property="Width" Value="{DynamicResource HudButtonSize}" />
            <Setter Property="Height" Value="{DynamicResource HudButtonSize}" />
            <Setter Property="CornerRadius" Value="{DynamicResource HudButtonRadius}" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Background" Value="{DynamicResource HudTrack}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HudTrack}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.btn.pressed">
            <Setter Property="Background" Value="{DynamicResource HudPressed}" />
            <Setter Property="BorderBrush" Value="#CCFFFFFF" />
        </Style>
        <Style Selector="Border.marker">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="{DynamicResource HudMarkerRadius}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource HudAccentSoft}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.35" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.marker.pressed">
            <Setter Property="Background" Value="{DynamicResource HudPressed}" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="BoxShadow" Value="{DynamicResource HudGlow}" />
        </Style>
        <Style Selector="Border.marker.big">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Opacity" Value="0.0" />
        </Style>
        <Style Selector="Border.marker.big.pressed">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.hudchip">
            <Setter Property="CornerRadius" Value="{DynamicResource HudChipRadius}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Background" Value="{DynamicResource HudChipBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HudAccent}" />
            <Setter Property="BorderThickness" Value="{DynamicResource HudChipBorder}" />
        </Style>
        <Style Selector="Ellipse.hatdot">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Fill" Value="{DynamicResource HudTextDim}" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Ellipse.hatdot.active">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource HudPressed}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ItemsControl.markers > ContentPresenter" x:DataType="models:HudMarker">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
        <Style Selector="ItemsControl.aircraftmarkers > ContentPresenter" x:DataType="models:HudAircraftMarker">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
        <Style Selector="ItemsControl.hatdots > ContentPresenter" x:DataType="models:HudHatDot">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
        <!-- On screen: the widgets ticked for the screen; stream outputs: the ones ticked for the stream. -->
        <Style Selector="ItemsControl.widgets > ContentPresenter" x:DataType="models:HudWidget">
            <Setter Property="controls:HudPanel.Left" Value="{Binding X}" />
            <Setter Property="controls:HudPanel.Top" Value="{Binding Y}" />
            <Setter Property="IsVisible" Value="{Binding Visible}" />
        </Style>
        <Style Selector="ItemsControl.widgets.stream > ContentPresenter" x:DataType="models:HudWidget">
            <Setter Property="IsVisible" Value="{Binding StreamVisible}" />
        </Style>
        <Style Selector="Rectangle.outline">
            <Setter Property="Stroke" Value="#80FFFFFF" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeDashArray" Value="4,3" />
        </Style>
        <Style Selector="Rectangle.outline.selected">
            <Setter Property="Stroke" Value="{DynamicResource HudAccent}" />
            <Setter Property="StrokeThickness" Value="2.5" />
        </Style>
        <Style Selector="Border.line">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <ItemsControl x:Name="WidgetItems" Classes="widgets" Classes.stream="{Binding #Surface.Stream}" ItemsSource="{Binding #Surface.Widgets}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <controls:HudPanel Fixed="{Binding #Surface.Fixed}" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:HudWidget">
                <controls:HudWidgetHost Background="Transparent" Cursor="{Binding #Surface.DragCursor}"
                                        PointerPressed="WidgetPointerPressed" PointerMoved="WidgetPointerMoved" PointerReleased="WidgetPointerReleased">
                    <LayoutTransformControl>
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                        </LayoutTransformControl.LayoutTransform>
                        <Panel Opacity="{DynamicResource HudOpacity}">

                            <!-- Device -->
                            <Border Classes="hudcard" IsVisible="{Binding IsDevice}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowName}">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource HudAccent}" BoxShadow="{DynamicResource HudGlow}" VerticalAlignment="Center" />
                                        <TextBlock Classes="hudtitle" Text="{Binding Device.ShortTitle}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Device.DeviceKind}" Classes="caps" VerticalAlignment="Center" IsVisible="{Binding ShowKind}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <!-- Picture: tilts with the stick; button positions glow on a layout picture. -->
                                        <Panel IsVisible="{Binding PictureVisible}" Width="{Binding Device.PictureWidth}" Height="230">
                                            <Panel RenderTransformOrigin="50%,88%">
                                                <Panel.RenderTransform>
                                                    <Rotate3DTransform AngleX="{Binding Device.Pitch}" AngleY="{Binding Device.Twist}" AngleZ="{Binding Device.Roll}" Depth="700" />
                                                </Panel.RenderTransform>
                                                <Image Source="{Binding Device.Picture}" Stretch="Uniform" />
                                                <ItemsControl Classes="markers" ItemsSource="{Binding Device.Markers}" IsVisible="{Binding MarkersVisible}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:HudMarker">
                                                            <Border Classes="marker" Classes.pressed="{Binding IsPressed}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Panel>
                                        </Panel>

                                        <StackPanel Spacing="12" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <!-- Stick element: position and twist, in the style's shape. -->
                                                <controls:HudGimbalView Width="{DynamicResource HudGimbalSize}" Height="{DynamicResource HudGimbalSize}" IsVisible="{Binding GimbalVisible}"
                                                                        X="{Binding Device.StickX}" Y="{Binding Device.StickY}" Twist="{Binding Device.StickTwist}" ShowTwist="{Binding Device.HasTwist}"
                                                                        Shape="{DynamicResource HudGimbalShape}" Accent="{DynamicResource HudAccent}" Soft="{DynamicResource HudAccentSoft}" Track="{DynamicResource HudTrack}" />

                                                <!-- Levers: throttles, collective, brakes. -->
                                                <ItemsControl ItemsSource="{Binding Device.Levers}" IsVisible="{Binding LeversVisible}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="10" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:HudAxis">
                                                            <StackPanel Spacing="4" MinWidth="34">
                                                                <controls:HudBarView Vertical="True" Width="{DynamicResource HudLeverWidth}" Height="92" HorizontalAlignment="Center"
                                                                                     Value="{Binding Value}" Shape="{DynamicResource HudLeverShape}" Fill="{DynamicResource HudAccent}" Track="{DynamicResource HudTrack}" />
                                                                <TextBlock Text="{Binding Label}" Classes="caps" HorizontalAlignment="Center" MaxWidth="64" TextTrimming="CharacterEllipsis"
                                                                           IsVisible="{Binding $parent[controls:HudWidgetHost].((models:HudWidget)DataContext).ShowLabels}" />
                                                                <TextBlock Text="{Binding Percent}" Classes="hudvalue" HorizontalAlignment="Center"
                                                                           IsVisible="{Binding $parent[controls:HudWidgetHost].((models:HudWidget)DataContext).ShowValues}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Hats: 8 directions around a centre. -->
                                                <ItemsControl ItemsSource="{Binding Device.Hats}" IsVisible="{Binding HatsVisible}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel MaxWidth="80" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:HudHat">
                                                            <Grid Width="32" Height="32" Margin="0,0,6,6">
                                                                <Ellipse Stroke="{DynamicResource HudTrack}" StrokeThickness="1.5" />
                                                                <ItemsControl Classes="hatdots" ItemsSource="{Binding Dots}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Canvas />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:HudHatDot">
                                                                            <Ellipse Classes="hatdot" Classes.active="{Binding IsActive}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource HudTextDim}" IsVisible="{Binding IsCentered}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Axis bars. -->
                                            <ItemsControl ItemsSource="{Binding Device.Bars}" IsVisible="{Binding AxesVisible}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:HudAxis">
                                                        <Grid ColumnDefinitions="Auto,112,Auto" ColumnSpacing="6" MinHeight="15">
                                                            <TextBlock Text="{Binding Label}" Classes="caps" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Width="84"
                                                                       IsVisible="{Binding $parent[controls:HudWidgetHost].((models:HudWidget)DataContext).ShowLabels}" />
                                                            <controls:HudBarView Grid.Column="1" Width="112" Height="{DynamicResource HudBarHeight}" VerticalAlignment="Center"
                                                                                 Value="{Binding Value}" Bipolar="{Binding Bipolar}" Shape="{DynamicResource HudBarShape}" Fill="{DynamicResource HudAccent}" Track="{DynamicResource HudTrack}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Percent}" Classes="hudvalue" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" Width="34"
                                                                       IsVisible="{Binding $parent[controls:HudWidgetHost].((models:HudWidget)DataContext).ShowValues}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Button grid (when the picture does not show the buttons). -->
                                            <ItemsControl ItemsSource="{Binding Device.ButtonCells}" IsVisible="{Binding ButtonGridVisible}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel MaxWidth="260" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:HudButton">
                                                        <Border Classes="btn" Classes.pressed="{Binding IsPressed}">
                                                            <TextBlock Text="{Binding Number}" FontSize="9" Foreground="{DynamicResource HudText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Held buttons by name. -->
                                    <ItemsControl ItemsSource="{Binding Device.PressedChips}" IsVisible="{Binding ChipsVisible}" MaxWidth="520">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Classes="hudchip">
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource HudText}" FontSize="{DynamicResource HudTextSize}" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Aircraft: its own stick and throttle (from the game's model), moving with the user's. -->
                            <Border Classes="hudcard" IsVisible="{Binding IsAircraft}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowName}">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource HudAccent}" BoxShadow="{DynamicResource HudGlow}" VerticalAlignment="Center" />
                                        <TextBlock Classes="hudtitle" Text="{Binding Aircraft.Title, FallbackValue={l:T 'Aircraft stick and throttle'}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="18">
                                        <!-- Throttle: slides forward with the user's throttle. -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding AircraftThrottleVisible}">
                                            <controls:HudBarView Vertical="True" Width="{DynamicResource HudLeverWidth}" Height="150" VerticalAlignment="Center"
                                                                 Value="{Binding Aircraft.ThrottleValue}" Shape="{DynamicResource HudLeverShape}" Fill="{DynamicResource HudAccent}" Track="{DynamicResource HudTrack}"
                                                                 IsVisible="{Binding ShowAxes}" />
                                            <Panel Width="{Binding Aircraft.ThrottleWidth}" Height="240" ClipToBounds="False">
                                                <Panel RenderTransformOrigin="50%,80%">
                                                    <Panel.RenderTransform>
                                                        <TransformGroup>
                                                            <Rotate3DTransform AngleX="{Binding Aircraft.ThrottleTilt}" Depth="700" />
                                                            <TranslateTransform Y="{Binding Aircraft.ThrottleOffset}" />
                                                        </TransformGroup>
                                                    </Panel.RenderTransform>
                                                    <Image Source="{Binding Aircraft.ThrottlePicture}" Stretch="Uniform" />
                                                    <ItemsControl Classes="aircraftmarkers" ItemsSource="{Binding Aircraft.ThrottleMarkers}" IsVisible="{Binding ShowButtons}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:HudAircraftMarker">
                                                                <Border Classes="marker big" Classes.pressed="{Binding IsPressed}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Panel>
                                            </Panel>
                                        </StackPanel>
                                        <!-- Stick: tilts and twists with the user's stick. -->
                                        <Panel Width="{Binding Aircraft.StickWidth}" Height="240" IsVisible="{Binding AircraftStickVisible}">
                                            <Panel RenderTransformOrigin="50%,92%">
                                                <Panel.RenderTransform>
                                                    <Rotate3DTransform AngleX="{Binding Aircraft.StickPitch}" AngleY="{Binding Aircraft.StickYaw}" AngleZ="{Binding Aircraft.StickRoll}" Depth="700" />
                                                </Panel.RenderTransform>
                                                <Image Source="{Binding Aircraft.StickPicture}" Stretch="Uniform" />
                                                <ItemsControl Classes="aircraftmarkers" ItemsSource="{Binding Aircraft.StickMarkers}" IsVisible="{Binding ShowButtons}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:HudAircraftMarker">
                                                            <Border Classes="marker big" Classes.pressed="{Binding IsPressed}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Panel>
                                        </Panel>
                                        <controls:HudGimbalView Width="{DynamicResource HudGimbalSize}" Height="{DynamicResource HudGimbalSize}" VerticalAlignment="Center"
                                                                IsVisible="{Binding ShowGimbal}"
                                                                X="{Binding Aircraft.StickSource.StickX, FallbackValue=0}" Y="{Binding Aircraft.StickSource.StickY, FallbackValue=0}"
                                                                Twist="{Binding Aircraft.StickSource.StickTwist, FallbackValue=0}" ShowTwist="{Binding Aircraft.StickSource.HasTwist, FallbackValue=False}"
                                                                Shape="{DynamicResource HudGimbalShape}" Accent="{DynamicResource HudAccent}" Soft="{DynamicResource HudAccentSoft}" Track="{DynamicResource HudTrack}" />
                                    </StackPanel>
                                    <!-- Without pictures (in the designer): what is needed. -->
                                    <TextBlock TextWrapping="Wrap" MaxWidth="360" FontSize="{DynamicResource HudSmallSize}" Foreground="{DynamicResource HudTextDim}" IsVisible="{Binding Aircraft, Converter={x:Static ObjectConverters.IsNull}}"
                                               Text="{l:T 'No aircraft yet: pick one under DCS aircraft or for this widget, or install the DCS hook. The pictures come from Cockpits > Build pictures from my games.'}" />
                                    <ItemsControl ItemsSource="{Binding Aircraft.PressedChips}" IsVisible="{Binding ChipsVisible}" MaxWidth="520">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Classes="hudchip">
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource HudText}" FontSize="{DynamicResource HudTextSize}" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Binds ticker: what the pressed button does. -->
                            <StackPanel Spacing="6" MinWidth="300" IsVisible="{Binding IsBinds}">
                                <Border Classes="hudcard" Padding="12,8">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="#Surface.Designer" />
                                            <Binding Path="Theme.HasNoLines" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'Gear Toggle'}" Foreground="{DynamicResource HudText}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{l:T 'Landing Gear Lever - UP/DOWN (example)'}" Foreground="{DynamicResource HudTextDim}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Theme.Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:OverlayLine">
                                            <Border Classes="hudcard line" Padding="0" Margin="0,0,0,6" Opacity="{Binding Opacity}" HorizontalAlignment="{Binding Align}">
                                                <Grid ColumnDefinitions="4,*">
                                                    <Border Background="{DynamicResource HudAccent}" CornerRadius="16,0,0,16" />
                                                    <StackPanel Grid.Column="1" Margin="12,6,16,7">
                                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource HudText}" FontSize="{Binding FontSize}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource HudTextDim}" FontSize="{Binding DetailFontSize}" IsVisible="{Binding HasDetail}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Header: game / aircraft. -->
                            <Border Classes="hudcard" Padding="8,6,16,6" IsVisible="{Binding IsHeader}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="36" Height="36" CornerRadius="8" ClipToBounds="True" Background="#1AFFFFFF" IsVisible="{Binding ShowHeaderPicture}">
                                        <Image Source="{Binding Theme.HeaderPicture}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="JOYPRO" Classes="caps" />
                                        <TextBlock Classes="hudtitle" Text="{Binding Theme.HeaderText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Panel>
                    </LayoutTransformControl>
                    <Rectangle Classes="outline" Classes.selected="{Binding IsSelected}" IsVisible="{Binding #Surface.Designer}" Margin="-4" RadiusX="18" RadiusY="18" IsHitTestVisible="False" />
                </controls:HudWidgetHost>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
