<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:JoyPro.Gui.Localization"
             xmlns:vm="using:JoyPro.Gui.ViewModels"
             xmlns:models="using:JoyPro.Gui.Models"
             xmlns:controls="using:JoyPro.Gui.Views.Controls"
             x:Class="JoyPro.Gui.Views.Controls.ListFilterGamesPanel"
             x:DataType="vm:ListFilterViewModel">
    <!-- The games of the filter bar, each with its aircraft (in the Games drop-down of ListFilterBar). -->
    <UserControl.Styles>
        <Style Selector="CheckBox.dim">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </UserControl.Styles>
    <StackPanel Width="340" Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h3" Text="{l:T 'Games and aircraft'}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="small ghost" Content="{l:T 'Clear'}" Command="{Binding ClearGamesCommand}" IsVisible="{Binding HasGameFilter}" />
        </Grid>
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="{l:T 'Tick a game for every relation with it; open it (&gt;) to tick only some aircraft.'}" />
        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:FilterGameItem">
                        <StackPanel Spacing="2" Margin="0,1">
                            <Grid ColumnDefinitions="22,*" ColumnSpacing="2">
                                <Button Classes="ghost small" Padding="2" Width="20" Height="20" IsVisible="{Binding HasPlanes}"
                                        Command="{Binding $parent[controls:ListFilterGamesPanel].((vm:ListFilterViewModel)DataContext).ToggleGameExpandedCommand}" CommandParameter="{Binding}"
                                        ToolTip.Tip="{l:T 'Show its aircraft'}">
                                    <Panel>
                                        <TextBlock Text="&gt;" FontWeight="Bold" IsVisible="{Binding !IsExpanded}" HorizontalAlignment="Center" />
                                        <TextBlock Text="v" FontWeight="Bold" IsVisible="{Binding IsExpanded}" HorizontalAlignment="Center" />
                                    </Panel>
                                </Button>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Classes.dim="{Binding IsEmpty}" ToolTip.Tip="{l:T 'Every relation with an action of this game'}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding PlanesSummary}" />
                                        <TextBlock Grid.Column="2" Classes="caption" Text="{Binding CountText}" />
                                    </Grid>
                                </CheckBox>
                            </Grid>
                            <StackPanel Margin="24,0,0,4" Spacing="4" IsVisible="{Binding IsExpanded}">
                                <WrapPanel ItemSpacing="4" LineSpacing="4">
                                    <Button Classes="small" Content="{l:T 'All'}" Command="{Binding $parent[controls:ListFilterGamesPanel].((vm:ListFilterViewModel)DataContext).SelectAllPlanesCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="{l:T 'Tick every aircraft shown (with a filter typed: only those)'}" />
                                    <Button Classes="small" Content="{l:T 'None'}" Command="{Binding $parent[controls:ListFilterGamesPanel].((vm:ListFilterViewModel)DataContext).SelectNoPlanesCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="{l:T 'Untick every aircraft shown'}" />
                                    <TextBox Text="{Binding PlaneFilterText}" Watermark="{l:T 'Filter, e.g. A-10'}" MinWidth="140" IsVisible="{Binding HasManyPlanes}"
                                             ToolTip.Tip="{l:T 'Shows only the aircraft with these letters; All and None then tick only those'}" />
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding Planes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:FilterOptionItem">
                                            <CheckBox IsChecked="{Binding IsChecked}" IsVisible="{Binding IsVisible}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                      Classes.dim="{Binding IsEmpty}" ToolTip.Tip="{l:T 'Relations with an action for this aircraft'}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding CountText}" />
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
