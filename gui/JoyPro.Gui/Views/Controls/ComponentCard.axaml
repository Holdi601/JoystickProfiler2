<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:JoyPro.Gui.Localization"
             xmlns:models="using:JoyPro.Gui.Models"
             x:Class="JoyPro.Gui.Views.Controls.ComponentCard"
             x:DataType="models:ComponentItem">
    <!-- One optional component (docs/components.md): Settings > Components and the Virtual Joystick page. -->
    <Border Classes="card" Margin="0,0,0,6">
        <StackPanel Spacing="5">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Panel VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.Ok}" Width="18" Height="18" Classes="ok" IsVisible="{Binding IsOk}" />
                    <PathIcon Data="{StaticResource Icon.Warning}" Width="18" Height="18" Classes="warn" IsVisible="{Binding !IsOk}" />
                </Panel>
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                    <Button Content="{l:T 'Project page'}" Classes="icon" Tag="{StaticResource Icon.Link}" Command="{Binding OpenProjectCommand}" Padding="8,3" FontSize="12"
                            ToolTip.Tip="{l:T 'Opens the component\'s official release page in your browser'}" />
                    <Button Content="{l:T 'Windows apps'}" Classes="icon" Tag="{StaticResource Icon.Cog}" Command="{Binding OpenAppsSettingsCommand}" Padding="8,3" FontSize="12"
                            IsVisible="{Binding !IsMissing}"
                            ToolTip.Tip="{l:T 'Repair or uninstall: opens Windows\' Installed apps list, where the component\'s own uninstaller is'}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding WhatItIs}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding WhyJoyProNeedsIt}" TextWrapping="Wrap" Opacity="0.85" />
            <TextBlock Text="{Binding UsedBy}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
            <StackPanel Spacing="5" IsVisible="{Binding CanOffer}">
                <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
                <TextBlock Text="{Binding VerificationText}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
                <Expander Header="{Binding LicenseHeader}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4">
                        <SelectableTextBlock Text="{Binding LicenseText}" TextWrapping="Wrap" FontSize="12" MaxHeight="260" />
                        <Button Content="{l:T 'License on the project page'}" Classes="ghost small" Command="{Binding OpenLicenseCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Expander>
                <CheckBox IsChecked="{Binding Consent}" IsEnabled="{Binding IsIdle}">
                    <TextBlock Text="{Binding ConsentText}" TextWrapping="Wrap" />
                </CheckBox>
                <WrapPanel>
                    <Button Content="{Binding InstallButtonText}" Classes="accent" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" Margin="0,0,8,0"
                            ToolTip.Tip="{l:T 'Downloads the official installer, checks it, then runs it. Windows asks once for administrator rights.'}" />
                    <Button Content="{l:T 'Cancel download'}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
                </WrapPanel>
            </StackPanel>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="8" IsVisible="{Binding IsBusy}" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Border Classes="callout warn" IsVisible="{Binding RestartRequired}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.Warning}" Width="16" Height="16" Classes="warn" />
                    <TextBlock Text="{l:T 'Restart Windows before you use it. Save your work first; JoyPro does not restart the PC by itself.'}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
