<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:JoyPro.Gui.Localization"
             xmlns:vm="using:JoyPro.Gui.ViewModels"
             xmlns:models="using:JoyPro.Gui.Models"
             xmlns:controls="using:JoyPro.Gui.Views.Controls"
             x:Class="JoyPro.Gui.Views.Controls.CheckProblemsPanel"
             x:DataType="vm:MainWindowViewModel">
    <!-- The check's problems (MainWindowViewModel.Duplicates.cs, MainWindowViewModel.CheckCards.cs, docs/ui/check.md):
         sections by kind with a count, what they mean and their icon (errors red, warnings amber), a search, a filter,
         sorting into groups, collapse/expand; each card in game words: a short title, the buttons, one sentence, aircraft
         -> command, what caused it, one recommended fix, the other fixes and "More", an "Open" per relation and the
         details collapsed; fixes for many with a preview and ticks (one undo step). -->
    <UserControl.Styles>
        <!-- A card's left edge in the color of its kind -->
        <Style Selector="Border.checkCard">
            <Setter Property="BorderThickness" Value="4,1,1,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource StatusInfoBrush}" />
        </Style>
        <Style Selector="Border.checkCard.checkWarn">
            <Setter Property="BorderBrush" Value="{DynamicResource StatusWarnBrush}" />
        </Style>
        <Style Selector="Border.checkCard.checkError">
            <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
        </Style>
        <!-- The card's open/close arrow: no accent fill while open -->
        <Style Selector="ToggleButton.cardToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource JP.TextBrush}" />
        </Style>
        <Style Selector="TextBlock.checkButtons">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource JP.AccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.checkGroup">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,6,0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource JP.TextMutedBrush}" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <PathIcon Data="{StaticResource Icon.Ok}" Width="18" Height="18" />
            <TextBlock Grid.Column="1" Text="{l:T 'Problems found by the check'}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>
        <!-- The counts of the cards below (the engine's line count only while there are none) -->
        <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" IsVisible="{Binding CheckSummaryText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
        <TextBlock Text="{Binding CheckSummaryText}" TextWrapping="Wrap" IsVisible="{Binding CheckSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Search, filter, sort, collapse -->
        <WrapPanel ItemSpacing="8" LineSpacing="6">
            <TextBox x:Name="CheckSearchBox" Width="260" Text="{Binding CheckSearchText}" Watermark="{l:T 'Search relations, aircraft, actions'}" />
            <ComboBox x:Name="CheckKindBox" MinWidth="200" ItemsSource="{Binding CheckKindChoices}" SelectedItem="{Binding SelectedCheckKind}" PlaceholderText="{l:T 'All problems'}"
                      ToolTip.Tip="{l:T 'Show only one kind of problem'}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:DuplicateRuleChoice">
                        <TextBlock Text="{Binding Label, Converter={x:Static l:TConverter.Instance}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="CheckSortBox" MinWidth="170" ItemsSource="{Binding CheckSortChoices}" SelectedItem="{Binding SelectedCheckSort}" PlaceholderText="{l:T 'By relation'}"
                      ToolTip.Tip="{l:T 'Order of the cards'}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:DuplicateRuleChoice">
                        <TextBlock Text="{Binding Label, Converter={x:Static l:TConverter.Instance}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="small ghost" Content="{l:T 'Expand all'}" Command="{Binding ExpandAllCheckCardsCommand}" />
            <Button Classes="small ghost" Content="{l:T 'Collapse all'}" Command="{Binding CollapseAllCheckCardsCommand}" />
        </WrapPanel>

        <!-- Fixes for many -->
        <Border Classes="sunken" Padding="10,8" CornerRadius="8" IsVisible="{Binding HasDuplicates}">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding AutoFixThresholdText}" TextWrapping="Wrap" />
                        <Slider x:Name="AutoFixSlider" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding DuplicateAutoFixThreshold}" MaxWidth="420" HorizontalAlignment="Left" MinWidth="200" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="accent" VerticalAlignment="Center" Command="{Binding PreviewSureDuplicatesCommand}" IsEnabled="{Binding HasSureDuplicates}"
                            ToolTip.Tip="{l:T 'Shows the fixes JoyPro is at least this sure about; you tick which ones to apply. One undo step.'}">
                        <TextBlock Text="{Binding FixSureOnesText}" TextWrapping="Wrap" />
                    </Button>
                </Grid>
                <CheckBox Content="{l:T 'Also right after imports and take-overs'}" IsChecked="{Binding AutoFixDuplicatesAfterImport}"
                          ToolTip.Tip="{l:T 'When an import or a take-over puts an action into a second relation, JoyPro fixes it at once if it is at least this sure; the rest stays here for you.'}" />
                <WrapPanel ItemSpacing="8" LineSpacing="6">
                    <ToggleButton Classes="small" Content="{l:T 'Fix all with a rule'}" IsChecked="{Binding IsDuplicateRuleOpen, Mode=OneWay}" Command="{Binding ToggleDuplicateRuleCommand}" />
                    <ToggleButton Classes="small" Content="{l:T 'Fix with AI'}" IsChecked="{Binding IsDuplicateAiOpen, Mode=OneWay}" Command="{Binding ToggleDuplicateAiCommand}" />
                </WrapPanel>
                <!-- A rule -->
                <StackPanel Spacing="6" IsVisible="{Binding IsDuplicateRuleOpen}">
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                        <ComboBox x:Name="DuplicateRuleBox" MinWidth="320" MaxWidth="560" ItemsSource="{Binding DuplicateRuleChoices}" SelectedItem="{Binding SelectedDuplicateRule}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:DuplicateRuleChoice">
                                    <TextBlock Text="{Binding Label, Converter={x:Static l:TConverter.Instance}}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox MinWidth="180" ItemsSource="{Binding DuplicateDeviceChoices}" SelectedItem="{Binding SelectedDuplicateDevice}" IsVisible="{Binding RuleNeedsDevice}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:DuplicateRuleChoice">
                                    <TextBlock Text="{Binding Label, Converter={x:Static l:TConverter.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Width="220" Text="{Binding DuplicateRuleWords}" Watermark="{l:T 'Words of the relation names, e.g. trim'}" IsVisible="{Binding RuleNeedsWords}" />
                        <Button Classes="small accent" Content="{l:T 'Preview'}" Command="{Binding PreviewDuplicateRuleCommand}" />
                    </WrapPanel>
                </StackPanel>
                <!-- In words -->
                <StackPanel Spacing="6" IsVisible="{Binding IsDuplicateAiOpen}">
                    <TextBox Text="{Binding DuplicateInstruction}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54"
                             Watermark="{l:T 'e.g. keep trim functions in the Trim relations, everything else in the Mode Button relations'}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                        <Button Classes="small accent" Content="{l:T 'Preview'}" Command="{Binding PreviewDuplicateInstructionCommand}" />
                        <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                                   Text="{l:T 'JoyPro reads simple sentences itself (keep ... in ..., everything else in ..., switch off ..., prefer the throttle); the local AI only helps with the rest.'}" />
                    </WrapPanel>
                    <controls:LocalAiStatusChip />
                </StackPanel>
                <!-- The preview -->
                <Border Classes="callout" Padding="10,8" IsVisible="{Binding HasDuplicatePreview}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding DuplicatePreviewTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="hint" Text="{Binding DuplicatePreviewNotes}" TextWrapping="Wrap" IsVisible="{Binding DuplicatePreviewNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding DuplicatePreview}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DuplicateChangeItem">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,1">
                                            <CheckBox IsChecked="{Binding IsTicked}" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="caption" Text="{Binding ConfidenceText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <WrapPanel ItemSpacing="8" LineSpacing="6">
                            <Button Classes="small accent" Content="{l:T 'Apply the ticked ones'}" Command="{Binding ApplyDuplicatePreviewCommand}"
                                    ToolTip.Tip="{l:T 'One version of your profile; Ctrl+Z takes all of it back'}" />
                            <Button Classes="small" Content="{l:T 'Tick all / none'}" Command="{Binding TickAllDuplicatePreviewCommand}" />
                            <Button Classes="small ghost" Content="{l:T 'Cancel'}" Command="{Binding CancelDuplicatePreviewCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- The sections and their cards: errors (red, their own icon), warnings (amber), notes -->
        <ItemsControl x:Name="CheckSectionList" ItemsSource="{Binding CheckSections}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:CheckIssueSection">
                    <Expander IsExpanded="{Binding IsExpanded}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,6">
                        <Expander.Header>
                            <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource Icon.Error}" Width="16" Height="16" Classes="error" IsVisible="{Binding IsError}" />
                                    <PathIcon Data="{StaticResource Icon.Warning}" Width="16" Height="16" Classes="warn" IsVisible="{Binding IsWarning}" />
                                    <PathIcon Data="{StaticResource Icon.Info}" Width="16" Height="16" Classes="info" IsVisible="{Binding IsNote}" />
                                    <TextBlock Text="{Binding CountText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Classes="hint" Text="{Binding Severity}" TextWrapping="Wrap" />
                                <TextBlock Classes="hint" Text="{Binding Breakdown}" TextWrapping="Wrap" IsVisible="{Binding HasBreakdown}" />
                            </StackPanel>
                        </Expander.Header>
                        <!-- A page of cards at a time: thousands of findings never build thousands of cards at once. -->
                        <StackPanel Spacing="0">
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.DataTemplates>
                                <!-- The check's own lines (other errors, notes): a light card; thousands of them can come. -->
                                <DataTemplate x:DataType="models:PlainCheckIssueCard">
                                    <Border Classes="card checkCard" Classes.checkError="{Binding IsError}" Classes.checkWarn="{Binding IsWarning}" Padding="12,8" Margin="0,0,0,6">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="checkGroup" Text="{Binding GroupHeader}" IsVisible="{Binding HasGroupHeader}" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <PathIcon Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,0,0" Data="{Binding Severity, Converter={x:Static controls:CheckIconConverter.Instance}}"
                                                          Classes.error="{Binding IsError}" Classes.warn="{Binding IsWarning}" Classes.info="{Binding IsNote}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </Grid>
                                            <TextBlock Classes="checkButtons" Text="{Binding ButtonsLine}" IsVisible="{Binding PlainShowsButtonsLine}" />
                                            <TextBlock Text="{Binding Sentence}" TextWrapping="Wrap" IsVisible="{Binding PlainShowsSentence}" />
                                            <!-- Its fixes and one "Open" per relation, light: thousands of these cards can come -->
                                            <Button Classes="small ghost" HorizontalAlignment="Left" IsVisible="{Binding PlainShowsOpenMenu}" Click="OpenMenuClicked"
                                                    Content="{l:T 'Open a relation ▾'}" ToolTip.Tip="{l:T 'Opens one of the relations with the actions of this card marked; Back returns here.'}" />
                                            <ItemsControl ItemsSource="{Binding PlainButtons}" IsVisible="{Binding PlainShowsButtons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel ItemSpacing="6" LineSpacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:CheckFix">
                                                        <Button Classes="small" Classes.ghost="{Binding IsOpen}" Command="{Binding Command}" ToolTip.Tip="{Binding Tip}" Content="{Binding Label}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                                <!-- A card in words: title, the buttons, one sentence, aircraft -> command, the cause, the fixes -->
                                <DataTemplate x:DataType="models:CheckIssueCard">
                                    <StackPanel Spacing="2" Margin="0,0,0,8">
                                        <TextBlock Classes="checkGroup" Text="{Binding GroupHeader}" IsVisible="{Binding HasGroupHeader}" />
                                        <Border Classes="card checkCard" Classes.checkError="{Binding IsError}" Classes.checkWarn="{Binding IsWarning}" Padding="12,10">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                                    <Panel VerticalAlignment="Top" Margin="0,2,0,0">
                                                        <PathIcon Data="{StaticResource Icon.Error}" Width="16" Height="16" Classes="error" IsVisible="{Binding IsError}" />
                                                        <PathIcon Data="{StaticResource Icon.Warning}" Width="16" Height="16" Classes="warn" IsVisible="{Binding IsWarning}" />
                                                        <PathIcon Data="{StaticResource Icon.Info}" Width="16" Height="16" Classes="info" IsVisible="{Binding IsNote}" />
                                                    </Panel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource JP.FontSize.14}" TextWrapping="Wrap" />
                                                    <Border Grid.Column="2" Classes="chip" IsVisible="{Binding IsNew}" VerticalAlignment="Top">
                                                        <TextBlock Text="{l:T 'New'}" FontSize="{DynamicResource JP.FontSize.11}" />
                                                    </Border>
                                                    <ToggleButton Grid.Column="3" Classes="small ghost cardToggle" Padding="4,0" VerticalAlignment="Top" IsChecked="{Binding IsExpanded}"
                                                                  ToolTip.Tip="{l:T 'Show or hide this card'}">
                                                        <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12" />
                                                    </ToggleButton>
                                                </Grid>
                                                <StackPanel Spacing="6" IsVisible="{Binding IsExpanded}">
                                                    <TextBlock Classes="checkButtons" Text="{Binding ButtonsLine}" IsVisible="{Binding HasButtonsLine}" />
                                                    <TextBlock Text="{Binding Sentence}" TextWrapping="Wrap" IsVisible="{Binding HasSentence}" />
                                                    <!-- Aircraft -> command, the first rows; "Show all" opens the rest -->
                                                    <Border Classes="sunken" Padding="8,6" IsVisible="{Binding HasRows}">
                                                        <StackPanel Spacing="2">
                                                            <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12">
                                                                <TextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding RowsHeaderLeft}" />
                                                                <TextBlock Grid.Column="1" Classes="caption" FontWeight="SemiBold" Text="{Binding RowsHeaderRight}" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding ShownRows}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:CheckTableRow">
                                                                        <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12" Margin="0,1">
                                                                            <TextBlock Text="{Binding Left}" TextWrapping="Wrap" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding Right}" TextWrapping="Wrap" Classes.warnText="{Binding IsUnknown}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Classes="small ghost" HorizontalAlignment="Left" Padding="4,1" Command="{Binding ToggleRowsCommand}" IsVisible="{Binding HasHiddenRows}">
                                                                <TextBlock Text="{Binding ShowRowsText}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasCaused}">
                                                        <PathIcon Data="{StaticResource Icon.History}" Width="13" Height="13" Classes="info" VerticalAlignment="Center" />
                                                        <TextBlock Classes="hint" Text="{Binding CausedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <!-- The fixes: the recommended one first (accent), the others, the rest under "More" -->
                                                    <WrapPanel ItemSpacing="6" LineSpacing="4" IsVisible="{Binding HasAnyFix}">
                                                        <ItemsControl ItemsSource="{Binding MainFixes}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel ItemSpacing="6" LineSpacing="4" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:CheckFix">
                                                                    <Button Classes="small" Classes.accent="{Binding IsRecommended}" Command="{Binding Command}" ToolTip.Tip="{Binding Tip}">
                                                                        <TextBlock Text="{Binding RecommendedLabel}" TextWrapping="Wrap" MaxWidth="420" />
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <!-- "More": a menu of the other fixes, made when it opens (CheckProblemsPanel.axaml.cs) -->
                                                        <Button Classes="small" IsVisible="{Binding HasMoreFixes}" ToolTip.Tip="{l:T 'More ways to fix it'}" Click="MoreFixesClicked"
                                                                Content="{l:T 'More ▾'}" />
                                                    </WrapPanel>
                                                    <!-- One "Open" per relation: it opens with this card's commands and aircraft marked; Back returns here -->
                                                    <ItemsControl ItemsSource="{Binding OpenButtons}" IsVisible="{Binding HasOpenButtons}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel ItemSpacing="6" LineSpacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:CheckFix">
                                                                <Button Classes="small ghost checkOpen" Command="{Binding Command}" ToolTip.Tip="{Binding Tip}">
                                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="460" />
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- How sure JoyPro is and why, where an unknown command came from -->
                                                    <StackPanel Spacing="3" IsVisible="{Binding HasDetails}">
                                                        <ToggleButton Classes="small ghost cardToggle" Padding="4,1" HorizontalAlignment="Left" IsChecked="{Binding IsDetailsOpen}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <PathIcon Data="{StaticResource Icon.ChevronRight}" Width="9" Height="9" IsVisible="{Binding !IsDetailsOpen}" />
                                                                <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="9" Height="9" IsVisible="{Binding IsDetailsOpen}" />
                                                                <TextBlock Classes="caption" Text="{l:T 'Details'}" />
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <!-- Built only while open (a page of cards stays light) -->
                                                        <ContentControl Content="{Binding DetailsHost}" Margin="14,0,0,0">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="models:CheckIssueCard">
                                                                    <StackPanel Spacing="2">
                                                                        <ItemsControl ItemsSource="{Binding DetailLines}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="x:String">
                                                                                    <TextBlock Classes="hint" Text="{Binding}" TextWrapping="Wrap" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <SelectableTextBlock Classes="caption" Text="{Binding TechnicalLine}" TextWrapping="Wrap" IsVisible="{Binding HasTechnicalLine}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                        <Button Classes="small" HorizontalAlignment="Left" Command="{Binding ShowMoreCommand}" IsVisible="{Binding HasMore}"
                                ToolTip.Tip="{l:T 'Shows the next cards of this kind; the search finds any of them'}">
                            <TextBlock Text="{Binding ShowMoreText}" TextWrapping="Wrap" />
                        </Button>
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
