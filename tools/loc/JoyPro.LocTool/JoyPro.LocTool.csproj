<Project Sdk="Microsoft.NET.Sdk">
  <!-- The localization tool: string inventory of the GUI, untranslated texts, merging translations (docs/localization.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>JoyPro.LocTool</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The GUI's language list and plural rules (plain C#). -->
    <Compile Include="..\..\..\gui\JoyPro.Gui\Localization\Languages.cs" Link="Languages.cs" />
  </ItemGroup>
</Project>
